// src/providers/upstream_cfg.uya — ChatPlan 字段 → HttppConfig 的纯映射（无网络/无 TLS）
//
// 单独成模块，是为了让映射逻辑能脱网单测：serve 拿到 ChatPlan 后调用这里，
// 再把 cfg 交给 upstream_post。`cfg` 必须是 `httpp_empty()` 的初值。

export fn upstream_config(host: &const byte, host_len: usize, port: i32,
    auth_type: i32, secret: &const byte, secret_len: usize, cfg: &HttppConfig) bool {
    if port <= 0 || port > 65535 || auth_type < 0 || auth_type > 3
        || host_len == 0 || host_len > HTTPP_HOST_MAX || secret_len > HTTPP_SECRET_MAX {
        return false;
    }
    cfg.port = port as u16;
    cfg.auth_type = auth_type as u8;
    cfg.host_len = 0;
    cfg.secret_len = 0;
    cfg.base_path_len = 0;
    cfg.alias_count = 0;
    cfg.tls_mode = 0;
    cfg.allow_plaintext = false;
    cfg.allow_private = false;
    if !httpp_set_host(cfg, host, host_len) {
        return false;
    }
    // D6：额外上游头（如 opencode 的 x-opencode-session）。格式 `Name: Value`。
    {
        const ev: &byte = getenv(&"AIGW_UPSTREAM_HEADER"[0] as &const byte);
        if (ev as usize) != 0 {
            var nm: [byte: 128] = [0: 128];
            var nn: usize = 0;
            var vv: [byte: 256] = [0: 256];
            var vn: usize = 0;
            var i: usize = 0;
            var seen: bool = false;
            while ev[i] != (0 as byte) && i < 4096 {
                const ch: byte = ev[i];
                if ch == (58 as byte) && !seen {
                    seen = true;
                } else if seen {
                    if vn < 256 && !(vn == 0 && (ch == (32 as byte) || ch == (9 as byte))) {
                        vv[vn] = ch;
                        vn = vn + 1;
                    }
                } else if nn < 128 {
                    nm[nn] = ch;
                    nn = nn + 1;
                }
                i = i + 1;
            }
            if nn > 0 && seen {
                _ = httpp_set_extra_header(cfg, &nm[0], nn, &vv[0], vn);
            }
        }
    }
    if secret_len > 0 {
        if !httpp_set_secret(cfg, secret, secret_len) {
            return false;
        }
    }
    return true;
}

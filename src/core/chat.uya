// src/core/chat.uya — A4 chat 请求编排：解析 → 路由 → 重写上游请求 → 结算
//
// 传输层（TLS 上游）不在这里：serve/A8 拿到 ChatPlan 后交给 htc_* 执行，
// 再把响应体交给 chat_settle。这样路由/重写/金额都能脱离网络做单测。
//
// ChatPlan 全部用固定缓冲（无分配）：provider 字段 + 上游 path + 重写后的请求体。

export const CHAT_MODEL_MAX: usize = 128;
export const CHAT_HOST_MAX: usize = 256;
export const CHAT_PATH_MAX: usize = 256;
export const CHAT_AUTH_NAME_MAX: usize = 64;
export const CHAT_SECRET_MAX: usize = 256;
export const CHAT_PAYLOAD_MAX: usize = 32768;

export error ChatBadRequest;
export error ChatNoRoute;
export error ChatNoUsage;
export error ChatTooLarge;
export error ChatFailed;

export struct ChatPlan {
    model: [byte: CHAT_MODEL_MAX],
    model_len: usize,
    upstream_model: [byte: CHAT_MODEL_MAX],
    upstream_len: usize,
    scheme: [byte: 8],
    scheme_len: usize,
    host: [byte: CHAT_HOST_MAX],
    host_len: usize,
    port: i32,
    path: [byte: CHAT_PATH_MAX],
    path_len: usize,
    provider_name: [byte: 64],
    provider_name_len: usize,
    auth_type: i32,
    auth_name: [byte: CHAT_AUTH_NAME_MAX],
    auth_name_len: usize,
    secret: [byte: CHAT_SECRET_MAX],
    secret_len: usize,
    timeout_ms: i32,
    provider_id: i64,
    stream: bool,
    payload: [byte: CHAT_PAYLOAD_MAX],
    payload_len: usize,
}

fn chat_copy(dst: &byte, cap: usize, src: &[byte]) usize {
    var i: usize = 0;
    while i < src.len && i < cap {
        dst[i] = src[i];
        i = i + 1;
    }
    return i;
}

fn chat_put(out: &byte, cap: usize, off: &usize, data: &[byte]) bool {
    var i: usize = 0;
    while i < data.len {
        if off[0] >= cap {
            return false;
        }
        out[off[0]] = data[i];
        off[0] = off[0] + 1;
        i = i + 1;
    }
    return true;
}

fn chat_ws(c: byte) bool {
    return c == (32 as byte) || c == (9 as byte) || c == (10 as byte) || c == (13 as byte);
}

/// 在请求体里定位顶层 `"model"` 的字符串值（不含引号）。
fn chat_find_model_value(body: &[byte], vs: &usize, ve: &usize) bool {
    var i: usize = 0;
    while i + 7 <= body.len {
        if body[i] == (34 as byte) && body[i + 1] == ('m' as byte)
            && body[i + 2] == ('o' as byte) && body[i + 3] == ('d' as byte)
            && body[i + 4] == ('e' as byte) && body[i + 5] == ('l' as byte)
            && body[i + 6] == (34 as byte) {
            var j: usize = i + 7;
            while j < body.len && chat_ws(body[j]) {
                j = j + 1;
            }
            if j < body.len && body[j] == (58 as byte) {
                j = j + 1;
                while j < body.len && chat_ws(body[j]) {
                    j = j + 1;
                }
                if j < body.len && body[j] == (34 as byte) {
                    var k: usize = j + 1;
                    while k < body.len {
                        if body[k] == (34 as byte) {
                            vs[0] = j + 1;
                            ve[0] = k;
                            return true;
                        }
                        if body[k] == (92 as byte) && k + 1 < body.len {
                            k = k + 2;
                            continue;
                        }
                        k = k + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

/// 把请求体里的 model 值换成上游模型名；没找到就原样拷贝。
fn chat_rewrite_model(body: &[byte], model: &[byte], out: &byte, cap: usize) usize {
    var vs: usize = 0;
    var ve: usize = 0;
    if !chat_find_model_value(body, &vs, &ve) {
        if body.len > cap {
            return 0;
        }
        var i: usize = 0;
        while i < body.len {
            out[i] = body[i];
            i = i + 1;
        }
        return body.len;
    }
    var off: usize = 0;
    if !chat_put(out, cap, &off, body[0: vs]) {
        return 0;
    }
    if !chat_put(out, cap, &off, model) {
        return 0;
    }
    if !chat_put(out, cap, &off, body[ve: body.len - ve]) {
        return 0;
    }
    return off;
}

/// A4 快路径：不建 DOM，只在顶层扫描 `"model"` 与 `"stream"`。
/// `unsupported` 表示形态不适合快路径（调用方回退到完整解析）。
export struct ChatScan {
    model_found: bool,
    model_vs: usize,
    model_ve: usize,
    stream_found: bool,
    stream_val: bool,
    unsupported: bool,
}

fn chat_key_eq(body: &[byte], s: usize, n: usize, lit: &const byte, ln: usize) bool {
    if n != ln {
        return false;
    }
    var i: usize = 0;
    while i < n {
        if body[s + i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// 顶层扫描：跳过字符串/嵌套对象，定位顶层 `model`（字符串）与 `stream`（布尔），
/// 同时校验字符串闭合与括号平衡。拿不准的形态置 `unsupported`，交给完整解析。
export fn chat_scan(body: &[byte], out: &ChatScan) !void {
    out.model_found = false;
    out.model_vs = 0;
    out.model_ve = 0;
    out.stream_found = false;
    out.stream_val = false;
    out.unsupported = false;
    var depth: i32 = 0;
    var root_ok: bool = false;
    var root_done: bool = false;
    var i: usize = 0;
    while i < body.len {
        const c: byte = body[i];
        if chat_ws(c) {
            i = i + 1;
            continue;
        }
        if root_done {
            return error.ChatBadRequest;
        }
        if c == (34 as byte) {
            const ks: usize = i + 1;
            var j: usize = ks;
            var esc: bool = false;
            while j < body.len && body[j] != (34 as byte) {
                if body[j] == (92 as byte) {
                    esc = true;
                    j = j + 2;
                } else {
                    j = j + 1;
                }
            }
            if j >= body.len {
                return error.ChatBadRequest;
            }
            if depth == 1 && root_ok {
                var k: usize = j + 1;
                while k < body.len && chat_ws(body[k]) {
                    k = k + 1;
                }
                if k < body.len && body[k] == (58 as byte) {
                    const kn: usize = j - ks;
                    if esc {
                        out.unsupported = true;
                    } else if chat_key_eq(body, ks, kn, &"model"[0: 5], 5) {
                        var v: usize = k + 1;
                        while v < body.len && chat_ws(body[v]) {
                            v = v + 1;
                        }
                        if v >= body.len || body[v] != (34 as byte) {
                            out.unsupported = true;
                            i = j + 1;
                            continue;
                        }
                        var e: usize = v + 1;
                        var vesc: bool = false;
                        while e < body.len && body[e] != (34 as byte) {
                            if body[e] == (92 as byte) {
                                vesc = true;
                                e = e + 2;
                            } else {
                                e = e + 1;
                            }
                        }
                        if e >= body.len {
                            return error.ChatBadRequest;
                        }
                        if out.model_found || vesc {
                            out.unsupported = true;
                        } else {
                            out.model_found = true;
                            out.model_vs = v + 1;
                            out.model_ve = e;
                        }
                        i = e + 1;
                        continue;
                    } else if chat_key_eq(body, ks, kn, &"stream"[0: 6], 6) {
                        var v: usize = k + 1;
                        while v < body.len && chat_ws(body[v]) {
                            v = v + 1;
                        }
                        if v + 4 <= body.len && body[v] == ('t' as byte)
                            && body[v + 1] == ('r' as byte) && body[v + 2] == ('u' as byte)
                            && body[v + 3] == ('e' as byte) {
                            out.stream_found = true;
                            out.stream_val = true;
                            i = v + 4;
                            continue;
                        }
                        if v + 5 <= body.len && body[v] == ('f' as byte)
                            && body[v + 1] == ('a' as byte) && body[v + 2] == ('l' as byte)
                            && body[v + 3] == ('s' as byte) && body[v + 4] == ('e' as byte) {
                            out.stream_found = true;
                            out.stream_val = false;
                            i = v + 5;
                            continue;
                        }
                        out.unsupported = true;
                    }
                }
            }
            i = j + 1;
            continue;
        }
        if c == (123 as byte) || c == (91 as byte) {
            depth = depth + 1;
            if depth == 1 {
                if c == (123 as byte) {
                    root_ok = true;
                } else {
                    out.unsupported = true;
                }
            }
            i = i + 1;
            continue;
        }
        if c == (125 as byte) || c == (93 as byte) {
            depth = depth - 1;
            if depth < 0 {
                return error.ChatBadRequest;
            }
            if depth == 0 {
                root_done = true;
            }
            i = i + 1;
            continue;
        }
        i = i + 1;
    }
    if depth != 0 || !root_done {
        return error.ChatBadRequest;
    }
    if !root_ok {
        // 根不是对象（如数组）：结构没坏，但形态不支持快路径
        out.unsupported = true;
    }
    return;
}

/// 按已知 span 重写 model 值（快路径用，避免二次扫描）。
fn chat_rewrite_model_span(body: &[byte], vs: usize, ve: usize, model: &[byte],
    out: &byte, cap: usize) usize {
    if vs > body.len || ve > body.len || ve < vs {
        return 0;
    }
    var off: usize = 0;
    if !chat_put(out, cap, &off, body[0: vs]) {
        return 0;
    }
    if !chat_put(out, cap, &off, model) {
        return 0;
    }
    if !chat_put(out, cap, &off, body[ve: body.len - ve]) {
        return 0;
    }
    return off;
}

/// 选 provider + 填 host/凭证/path（快慢路径共用）。
fn chat_route(d: &Db, model: &[byte], session: &[byte], now: i64, out: &ChatPlan) !void {
    var prov: StoreProvider = StoreProvider{};
    var up: [byte: CHAT_MODEL_MAX] = [0: CHAT_MODEL_MAX];
    var upn: usize = 0;
    const ok: bool = try lb_pick(d, model, session, now, &prov, &up[0], CHAT_MODEL_MAX, &upn);
    if !ok {
        return error.ChatNoRoute;
    }
    out.provider_id = prov.id;
    out.port = prov.port;
    out.auth_type = prov.auth_type;
    out.timeout_ms = prov.timeout_ms;
    out.scheme_len = chat_copy(&out.scheme[0], 8, prov.scheme[0: prov.scheme_len]);
    out.host_len = chat_copy(&out.host[0], CHAT_HOST_MAX, prov.host[0: prov.host_len]);
    out.provider_name_len = chat_copy(&out.provider_name[0], 64, prov.name[0: prov.name_len]);
    out.auth_name_len = chat_copy(&out.auth_name[0], CHAT_AUTH_NAME_MAX, prov.auth_name[0: prov.auth_name_len]);
    out.secret_len = chat_copy(&out.secret[0], CHAT_SECRET_MAX, prov.secret[0: prov.secret_len]);
    out.upstream_len = chat_copy(&out.upstream_model[0], CHAT_MODEL_MAX, up[0: upn]);
    if prov.base_path_len == 0 {
        out.path_len = chat_copy(&out.path[0], CHAT_PATH_MAX, &"/v1/chat/completions"[0: 20]);
    } else {
        var off: usize = 0;
        if !chat_put(&out.path[0], CHAT_PATH_MAX, &off, prov.base_path[0: prov.base_path_len]) {
            return error.ChatTooLarge;
        }
        if !chat_put(&out.path[0], CHAT_PATH_MAX, &off, &"/chat/completions"[0: 17]) {
            return error.ChatTooLarge;
        }
        out.path_len = off;
    }
    return;
}

/// A4 快路径入口：返回 false 表示「形态不支持，调用方走完整解析」。
export fn chat_prepare_fast(d: &Db, body: &[byte], session: &[byte], now: i64,
    out: &ChatPlan) !bool {
    if body.len == 0 || body.len > CHAT_PAYLOAD_MAX {
        return error.ChatTooLarge;
    }
    var sc: ChatScan = ChatScan{ model_found: false, model_vs: 0, model_ve: 0,
        stream_found: false, stream_val: false, unsupported: false };
    try chat_scan(body, &sc);
    if sc.unsupported || !sc.model_found {
        return false;
    }
    const mn: usize = sc.model_ve - sc.model_vs;
    if mn == 0 {
        return false;
    }
    out.model_len = chat_copy(&out.model[0], CHAT_MODEL_MAX, body[sc.model_vs: mn]);
    out.stream = sc.stream_val;
    try chat_route(d, out.model[0: out.model_len], session, now, out);
    const pn: usize = chat_rewrite_model_span(body, sc.model_vs, sc.model_ve,
        out.upstream_model[0: out.upstream_len], &out.payload[0], CHAT_PAYLOAD_MAX);
    if pn == 0 {
        return error.ChatTooLarge;
    }
    out.payload_len = pn;
    return true;
}

/// 无亲和的入口（单测/兼容）。
export fn chat_prepare(d: &Db, body: &[byte], now: i64, out: &ChatPlan) !void {
    return chat_prepare_session(d, body, &""[0: 0], now, out);
}

/// serve 用：请求体以「指针 + 长度」给出时的入口。
export fn chat_prepare_span(d: &Db, body: &const byte, n: usize, now: i64,
    out: &ChatPlan) !void {
    if n > CHAT_PAYLOAD_MAX {
        return error.ChatTooLarge;
    }
    const fast: bool = try chat_prepare_fast(d, body[0: n], &""[0: 0], now, out);
    if !fast {
        return chat_prepare(d, body[0: n], now, out);
    }
    return;
}

/// serve 用：带会话亲和的版本。
export fn chat_prepare_span_session(d: &Db, body: &const byte, n: usize,
    session: &[byte], now: i64, out: &ChatPlan) !void {
    if n > CHAT_PAYLOAD_MAX {
        return error.ChatTooLarge;
    }
    // A4 热路径：先无 DOM 扫描；形态不支持才回退完整解析。
    const fast: bool = try chat_prepare_fast(d, body[0: n], session, now, out);
    if !fast {
        return chat_prepare_session(d, body[0: n], session, now, out);
    }
    return;
}

/// 解析 `Authorization: Bearer <token>`；返回 token 长度（0=格式不对）。
export fn chat_bearer_span(auth: &const byte, n: usize, out: &byte, cap: usize) usize {
    if n < 8 || cap == 0 {
        return 0;
    }
    var i: usize = 0;
    while i < 6 {
        var c: byte = auth[i];
        if c >= ('A' as byte) && c <= ('Z' as byte) {
            c = c +% 32;
        }
        if c != ("bearer "[i]) {
            return 0;
        }
        i = i + 1;
    }
    if auth[6] != (32 as byte) {
        return 0;
    }
    var j: usize = 7;
    while j < n && auth[j] == (32 as byte) {
        j = j + 1;
    }
    var w: usize = 0;
    while j < n && w < cap {
        out[w] = auth[j];
        w = w + 1;
        j = j + 1;
    }
    return w;
}

/// 同上，切片版（单测用）。
export fn chat_bearer(auth: &[byte], out: &byte, cap: usize) usize {
    return chat_bearer_span(auth.ptr, auth.len, out, cap);
}

/// 解析请求 → 选 provider → 生成上游 path 与重写后的请求体。
/// `session` 用于 A8 会话亲和（空串表示无亲和，按权重哈希 0 选）。
export fn chat_prepare_session(d: &Db, body: &[byte], session: &[byte], now: i64,
    out: &ChatPlan) !void {
    if body.len == 0 || body.len > CHAT_PAYLOAD_MAX {
        return error.ChatTooLarge;
    }
    var doc: JsonDoc = JsonDoc{};
    json_parse(&doc, body) catch {
        return error.ChatBadRequest;
    };
    const root: i32 = json_root(&doc);
    if json_kind(&doc, root) != JSON_OBJ {
        return error.ChatBadRequest;
    }
    const m: i32 = json_get(&doc, root, &"model"[0: 5]);
    if json_kind(&doc, m) != JSON_STR {
        return error.ChatBadRequest;
    }
    var mbuf: [byte: CHAT_MODEL_MAX] = [0: CHAT_MODEL_MAX];
    const mn: usize = json_str(&doc, m, &mbuf[0], CHAT_MODEL_MAX);
    if mn == 0 {
        return error.ChatBadRequest;
    }
    out.model_len = chat_copy(&out.model[0], CHAT_MODEL_MAX, mbuf[0: mn]);
    out.stream = json_bool(&doc, json_get(&doc, root, &"stream"[0: 6]));

    try chat_route(d, mbuf[0: mn], session, now, out);
    const pn: usize = chat_rewrite_model(body, out.upstream_model[0: out.upstream_len],
        &out.payload[0], CHAT_PAYLOAD_MAX);
    if pn == 0 {
        return error.ChatTooLarge;
    }
    out.payload_len = pn;
    _ = now;
    return;
}

/// 同上，但只查价 + 入队（A4 批量落库）；serve 的请求路径用这个。
export fn chat_settle_deferred(request_id: &[byte], user_id: i64, now: i64,
    tz_min: i32, plan: &ChatPlan, response: &[byte], out: &BillingResult) !void {
    if response.len == 0 {
        return error.ChatFailed;
    }
    var doc: JsonDoc = JsonDoc{};
    json_parse(&doc, response) catch {
        return error.ChatFailed;
    };
    var usage: PriceUsage = PriceUsage{ input_tokens: 0, output_tokens: 0, cache_read_tokens: 0 };
    if !billing_usage_parse(&doc, json_root(&doc), &usage) {
        return error.ChatNoUsage;
    }
    billing_settle_deferred(request_id, user_id, now, tz_min,
        plan.model[0: plan.model_len], plan.provider_name[0: plan.provider_name_len],
        &usage, out) catch {
        return error.ChatFailed;
    };
    return;
}

/// 用上游响应结算：解析 usage → billing_settle（journal + ledger）。
export fn chat_settle(d: &Db, dir: &[byte], request_id: &[byte], user_id: i64,
    now: i64, tz_min: i32, plan: &ChatPlan, response: &[byte],
    out: &BillingResult) !void {
    if response.len == 0 {
        return error.ChatFailed;
    }
    var doc: JsonDoc = JsonDoc{};
    json_parse(&doc, response) catch {
        return error.ChatFailed;
    };
    var usage: PriceUsage = PriceUsage{ input_tokens: 0, output_tokens: 0, cache_read_tokens: 0 };
    if !billing_usage_parse(&doc, json_root(&doc), &usage) {
        return error.ChatNoUsage;
    }
    billing_settle(d, dir, request_id, user_id, now, tz_min,
        plan.model[0: plan.model_len], plan.provider_name[0: plan.provider_name_len],
        &usage, out) catch {
        return error.ChatFailed;
    };
    return;
}

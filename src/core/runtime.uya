// src/core/runtime.uya — A2 运行时接线：服务启动时打开库 / 重放 journal / 每日备份
//
// `aigw serve` 的启动顺序：
//
//   1. 确保数据目录存在；
//   2. `schema_open`：打开 SQLite、设 PRAGMA、跑到最新 schema 版本；
//   3. 重放最近 8 天的 journal（崩溃恢复；幂等，重复执行无害）；
//   4. 清理过期 journal；
//   5. 到点（UTC 03:00 之后且今天还没做）做一次 `VACUUM INTO` 备份 + 清理旧备份。
//
// 事件循环每轮调一次 `runtime_tick()`：它只在「日期变了」或「03:00 到了」时真正干活，
// 其余时候只做一次 clock_gettime + 字符串比较。时钟由调用方传入（测试用固定时间）。
//
// 设计上不把 Runtime 做成大结构体常量：Uya 0.11 对「含大数组字段的模块级结构体初值」
// 支持一般，这里用模块级标量 + 固定路径缓冲，状态一目了然。

use libc.syscall;

const RT_DEFAULT_DB: &[byte] = &"data/aigw.db"[0: 12];
const RT_DEFAULT_DIR: &[byte] = &"data"[0: 4];
export const RT_JOURNAL_KEEP_DAYS: i32 = 8;
export const RT_BACKUP_KEEP: i32 = 7;
/// 每天 UTC 几点之后允许备份（低峰期）。
export const RT_BACKUP_HOUR: i64 = 3;

export error RuntimeFailed;

var g_ready: bool = false;
var g_db: Db = Db{ h: null };
var g_dir: [byte: 256] = [0: 256];
var g_dir_len: usize = 0;
var g_last_backup_day: i64 = 0;
/// B1：standby 不备份，由 controller 选主结果设置（默认允许，单机模式不受影响）。
var g_backup_allowed: bool = true;
var g_last_journal_day: i64 = 0;

/// 把切片拷进 NUL 结尾的缓冲。
fn rt_copy(dst: &byte, cap: usize, s: &[byte]) usize {
    var i: usize = 0;
    while i < s.len && i + 1 < cap {
        dst[i] = s[i];
        i = i + 1;
    }
    dst[i] = 0 as byte;
    return i;
}

/// UTC 日期戳 `YYYYMMDD` 当整数用（只用于「今天变了吗」的比较）。
fn rt_day(ts: i64) i64 {
    var b: [byte: 16] = [0: 16];
    if backup_stamp(ts, &b[0], 16) != 8 {
        return 0;
    }
    var v: i64 = 0;
    var i: usize = 0;
    while i < 8 {
        const d: i64 = (b[i] as i64) -% 48;
        v = v *% (10 as i64);
        v = v +% d;
        i = i + 1;
    }
    return v;
}

fn rt_hour(ts: i64) i64 {
    var secs: i64 = ts % (86400 as i64);
    if secs < 0 {
        secs = secs +% (86400 as i64);
    }
    return secs / (3600 as i64);
}

/// 最近一次成功备份的 UTC 天序号（0 = 还没备份过）。
export fn runtime_last_backup_day() i64 {
    return g_last_backup_day;
}

export fn runtime_set_backup_allowed(v: bool) void {
    g_backup_allowed = v;
}

export fn runtime_ready() bool {
    return g_ready;
}

/// 运行时数据库句柄（A4/A7 的请求路径与查询用）。
export fn runtime_db() &Db {
    return &g_db;
}

/// 拷贝当前数据目录（serve 等模块级调用方需要局部缓冲时用）。
export fn runtime_dir_copy(out: &byte, cap: usize) usize {
    return rt_dir_copy(out, cap);
}

/// 把模块级目录缓冲拷到局部（Uya 0.11 不能直接对模块级数组做运行时切片）。
fn rt_dir_copy(out: &byte, cap: usize) usize {
    var i: usize = 0;
    while i < g_dir_len && i < cap {
        out[i] = g_dir[i];
        i = i + 1;
    }
    return i;
}

/// 初始化运行时。失败时 `aigw serve` 不应该继续启动（宁可起不来，也别带病记账）。
export fn runtime_setup_at(db_path: &[byte], data_dir: &[byte], now: i64) !void {
    if g_ready {
        return error.RuntimeFailed;
    }
    if data_dir.len >= 256 || db_path.len == 0 {
        return error.RuntimeFailed;
    }
    g_dir_len = rt_copy(&g_dir[0], 256, data_dir);
    // 数据目录不存在就建（已存在忽略）。db 自己的父目录由调用方负责。
    _ = sys_mkdir(&g_dir[0] as *const byte, 493 as i32) catch {};
    g_db = Db{ h: null };
    _ = schema_open(&g_db, db_path) catch {
        dbx_close(&g_db);
        g_db = Db{ h: null };
        return error.RuntimeFailed;
    };
    // 崩溃恢复：重放最近 8 天；坏行/半行不会阻塞启动。
    var stats: JournalStats = JournalStats{ lines: 0, applied: 0, duplicate: 0, bad: 0 };
    journal_replay_days(&g_db, data_dir, now, RT_JOURNAL_KEEP_DAYS, &stats) catch {};
    journal_prune(data_dir, now, RT_JOURNAL_KEEP_DAYS);
    g_last_journal_day = rt_day(now);
    g_last_backup_day = 0;
    g_ready = true;
    runtime_tick_at(now);
    return;
}

/// 同上，用真实时钟（`aigw serve` 用）。
export fn runtime_setup(db_path: &[byte], data_dir: &[byte]) !void {
    return runtime_setup_at(db_path, data_dir, store_now());
}

export fn runtime_shutdown() void {
    if g_ready {
        dbx_close(&g_db);
    }
    g_ready = false;
    g_db = Db{ h: null };
    g_dir_len = 0;
    g_last_backup_day = 0;
    g_last_journal_day = 0;
}

/// 每日维护。可重入、可高频调用：不满足条件时只做一次日期比较。
export fn runtime_tick_at(now: i64) void {
    if !g_ready {
        return;
    }
    const today: i64 = rt_day(now);
    var dirbuf: [byte: 256] = [0: 256];
    const dn: usize = rt_dir_copy(&dirbuf[0], 256);
    const dir: &[byte] = dirbuf[0: dn];
    // 03:00（UTC）之后且今天还没备份 → 快照 + 清理旧备份。
    if g_backup_allowed && rt_hour(now) >= RT_BACKUP_HOUR && today != g_last_backup_day {
        var path: [byte: 512] = [0: 512];
        backup_run(&g_db, dir, now, &path[0], 512) catch {};
        backup_prune(dir, now, RT_BACKUP_KEEP);
        g_last_backup_day = today;
    }
    // 跨天：清理超过保留期的 journal。
    if today != g_last_journal_day {
        journal_prune(dir, now, RT_JOURNAL_KEEP_DAYS);
        g_last_journal_day = today;
    }
}

/// 事件循环每轮调一次；用真实时钟。
export fn runtime_tick() void {
    if !g_ready {
        return;
    }
    runtime_tick_at(store_now());
}

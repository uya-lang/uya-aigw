// src/core/responses.uya — A5 responses：previous_response_id 会话存储与 chat 互转
//
// 存储的是一条 response 的输入/输出文本；下一轮把上一轮 output 作为 assistant 消息
// 拼到 chat messages 前面。结构化 tools/reasoning 暂不落库（透传给上游）。

export const RESP_ID_MAX: usize = 64;
export const RESP_MODEL_MAX: usize = 128;
export const RESP_INPUT_MAX: usize = 4096;
export const RESP_OUTPUT_MAX: usize = 8192;
export const RESP_USAGE_MAX: usize = 1024;

export error RespFailed;
export error RespNotFound;

export struct RespRow {
    id: [byte: RESP_ID_MAX],
    id_len: usize,
    user_id: i64,
    created_at: i64,
    model: [byte: RESP_MODEL_MAX],
    model_len: usize,
    previous_id: [byte: RESP_ID_MAX],
    previous_len: usize,
    input_text: [byte: RESP_INPUT_MAX],
    input_len: usize,
    output_text: [byte: RESP_OUTPUT_MAX],
    output_len: usize,
    usage_json: [byte: RESP_USAGE_MAX],
    usage_len: usize,
    found: bool,
}

export fn resp_zero(out: &RespRow) void {
    out.id_len = 0;
    out.user_id = 0;
    out.created_at = 0;
    out.model_len = 0;
    out.previous_len = 0;
    out.input_len = 0;
    out.output_len = 0;
    out.usage_len = 0;
    out.found = false;
}

export fn resp_store(d: &Db, id: &[byte], user_id: i64, now: i64, model: &[byte],
    previous_id: &[byte], input_text: &[byte], output_text: &[byte],
    usage_json: &[byte]) !void {
    if id.len == 0 || id.len > RESP_ID_MAX {
        return error.RespFailed;
    }
    var st: DbStmt = dbx_prepare(d,
        "insert or replace into responses(id, user_id, created_at, model, previous_id, input_text, output_text, status, usage_json) values(?, ?, ?, ?, ?, ?, ?, 'completed', ?)" as &const byte) catch {
        return error.RespFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, id) catch { return error.RespFailed; };
    dbx_bind_i64(&st, 2, user_id) catch { return error.RespFailed; };
    dbx_bind_i64(&st, 3, now) catch { return error.RespFailed; };
    dbx_bind_text(&st, 4, model) catch { return error.RespFailed; };
    dbx_bind_text(&st, 5, previous_id) catch { return error.RespFailed; };
    dbx_bind_text(&st, 6, input_text) catch { return error.RespFailed; };
    dbx_bind_text(&st, 7, output_text) catch { return error.RespFailed; };
    dbx_bind_text(&st, 8, usage_json) catch { return error.RespFailed; };
    if dbx_step(&st) != 0 {
        return error.RespFailed;
    }
    return;
}

export fn resp_get(d: &Db, id: &[byte], out: &RespRow) !void {
    resp_zero(out);
    var st: DbStmt = dbx_prepare(d,
        "select id, user_id, created_at, model, previous_id, input_text, output_text, usage_json from responses where id = ?" as &const byte) catch {
        return error.RespFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, id) catch { return error.RespFailed; };
    if dbx_step(&st) != 1 {
        return error.RespNotFound;
    }
    out.id_len = dbx_col_text(&st, 0, &out.id[0], RESP_ID_MAX);
    out.user_id = dbx_col_i64(&st, 1);
    out.created_at = dbx_col_i64(&st, 2);
    out.model_len = dbx_col_text(&st, 3, &out.model[0], RESP_MODEL_MAX);
    out.previous_len = dbx_col_text(&st, 4, &out.previous_id[0], RESP_ID_MAX);
    out.input_len = dbx_col_text(&st, 5, &out.input_text[0], RESP_INPUT_MAX);
    out.output_len = dbx_col_text(&st, 6, &out.output_text[0], RESP_OUTPUT_MAX);
    out.usage_len = dbx_col_text(&st, 7, &out.usage_json[0], RESP_USAGE_MAX);
    out.found = true;
    return;
}

/// 把 responses 的输入（可带上一轮 output）转成 chat 请求体。
export fn resp_build_chat(model: &[byte], previous_output: &[byte], input_text: &[byte],
    stream: bool, out: &byte, cap: usize) usize {
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"model"[0: 5]);
    jsonw_str(&w, model);
    jsonw_key(&w, &"stream"[0: 6]);
    jsonw_bool(&w, stream);
    jsonw_key(&w, &"messages"[0: 8]);
    jsonw_arr(&w);
    if previous_output.len > 0 {
        jsonw_obj(&w);
        jsonw_key(&w, &"role"[0: 4]);
        jsonw_str(&w, &"assistant"[0: 9]);
        jsonw_key(&w, &"content"[0: 7]);
        jsonw_str(&w, previous_output);
        jsonw_end_obj(&w);
    }
    jsonw_obj(&w);
    jsonw_key(&w, &"role"[0: 4]);
    jsonw_str(&w, &"user"[0: 4]);
    jsonw_key(&w, &"content"[0: 7]);
    jsonw_str(&w, input_text);
    jsonw_end_obj(&w);
    jsonw_end_arr(&w);
    jsonw_end_obj(&w);
    const n: usize = jsonw_len(&w);
    if n > cap {
        return 0;
    }
    var i: usize = 0;
    while i < n {
        out[i] = w.out[i];
        i = i + 1;
    }
    return n;
}

/// 从 chat completion 响应里取 choices[0].message.content。
export fn resp_parse_output(d: &JsonDoc, root: i32, out: &byte, cap: usize) usize {
    const choices: i32 = json_get(d, root, &"choices"[0: 7]);
    const c0: i32 = json_arr_at(d, choices, 0);
    const msg: i32 = json_get(d, c0, &"message"[0: 7]);
    const content: i32 = json_get(d, msg, &"content"[0: 7]);
    if json_kind(d, content) != JSON_STR {
        return 0;
    }
    return json_str(d, content, out, cap);
}

// ---- A5：tools / tool_choice / parallel_tool_calls / reasoning 透传 ----

fn resp_put(out: &byte, cap: usize, at: &usize, s: &[byte]) bool {
    var i: usize = 0;
    while i < s.len {
        if at[0] + i >= cap {
            return false;
        }
        out[at[0] + i] = s[i];
        i = i + 1;
    }
    at[0] = at[0] + i;
    return true;
}

/// 在 src 里找 `"key":<value>` 的值结束位置（含嵌套括号/字符串转义）。
fn resp_value_end(src: &[byte], start: usize) usize {
    if start >= src.len {
        return 0 as usize;
    }
    const c: byte = src[start];
    if c == (123 as byte) || c == (91 as byte) {
        var depth: i32 = 0;
        var i: usize = start;
        var in_str: bool = false;
        var esc: bool = false;
        while i < src.len {
            const b: byte = src[i];
            if in_str {
                if esc {
                    esc = false;
                } else if b == (92 as byte) {
                    esc = true;
                } else if b == (34 as byte) {
                    in_str = false;
                }
            } else {
                if b == (34 as byte) {
                    in_str = true;
                } else if b == (123 as byte) || b == (91 as byte) {
                    depth = depth + 1;
                } else if b == (125 as byte) || b == (93 as byte) {
                    depth = depth - 1;
                    if depth <= 0 {
                        return i + 1;
                    }
                }
            }
            i = i + 1;
        }
        return 0 as usize;
    }
    if c == (34 as byte) {
        var i: usize = start + 1;
        var esc: bool = false;
        while i < src.len {
            const b: byte = src[i];
            if esc {
                esc = false;
            } else if b == (92 as byte) {
                esc = true;
            } else if b == (34 as byte) {
                return i + 1;
            }
            i = i + 1;
        }
        return 0 as usize;
    }
    var i: usize = start;
    while i < src.len {
        const b: byte = src[i];
        if b == (44 as byte) || b == (125 as byte) || b == (93 as byte) || b == (32 as byte) || b == (10 as byte) {
            return i;
        }
        i = i + 1;
    }
    return i;
}

/// 把 src 里 `"key"` 的原始值（不含 key）拷到 out，返回字节数；不存在返回 0。
export fn resp_raw_value(src: &[byte], key: &[byte], out: &byte, cap: usize) usize {
    if key.len == 0 || src.len < key.len + 2 {
        return 0 as usize;
    }
    var i: usize = 0;
    while i < src.len && src.len - i > key.len + 1 {
        if src[i] == (34 as byte) {
            var same: bool = true;
            var k: usize = 0;
            while k < key.len {
                if src[i + 1 + k] != key[k] {
                    same = false;
                    break;
                }
                k = k + 1;
            }
            if same && src[i + 1 + key.len] == (34 as byte) {
                var j: usize = i + 2 + key.len;
                while j < src.len {
                    const b: byte = src[j];
                    if b == (58 as byte) || b == (32 as byte) || b == (9 as byte) || b == (10 as byte) || b == (13 as byte) {
                        j = j + 1;
                    } else {
                        break;
                    }
                }
                const end: usize = resp_value_end(src, j);
                if end > j {
                    var n: usize = 0;
                    while j + n < end && n < cap {
                        out[n] = src[j + n];
                        n = n + 1;
                    }
                    if j + n >= end {
                        return n;
                    }
                    return 0 as usize;
                }
            }
        }
        i = i + 1;
    }
    return 0 as usize;
}

/// 把 src 里的 tools/tool_choice/parallel_tool_calls/reasoning 透传进 chat payload。
/// 返回新 payload 长度；容量不足或无事可做返回 0（调用方保留原 payload）。
export fn resp_augment_payload(payload: &[byte], src: &[byte], out: &byte, cap: usize) usize {
    if payload.len < 2 || cap == 0 {
        return 0 as usize;
    }
    if payload[payload.len - 1] != (125 as byte) {
        return 0 as usize;
    }
    var at: usize = 0;
    if !resp_put(out, cap, &at, payload[0: payload.len - 1]) {
        return 0 as usize;
    }
    var added: bool = false;
    var tmp: [byte: 8192] = [0: 8192];
    var n: usize = 0;
    n = resp_raw_value(src, &"tools"[0: 5], &tmp[0], 8192);
    if n > 0 {
        if !resp_put(out, cap, &at, &",\"tools\":"[0: 9]) {
            return 0 as usize;
        }
        if !resp_put(out, cap, &at, tmp[0: n]) {
            return 0 as usize;
        }
        added = true;
    }
    n = resp_raw_value(src, &"tool_choice"[0: 11], &tmp[0], 8192);
    if n > 0 {
        if !resp_put(out, cap, &at, &",\"tool_choice\":"[0: 15]) {
            return 0 as usize;
        }
        if !resp_put(out, cap, &at, tmp[0: n]) {
            return 0 as usize;
        }
        added = true;
    }
    n = resp_raw_value(src, &"parallel_tool_calls"[0: 19], &tmp[0], 8192);
    if n > 0 {
        if !resp_put(out, cap, &at, &",\"parallel_tool_calls\":"[0: 23]) {
            return 0 as usize;
        }
        if !resp_put(out, cap, &at, tmp[0: n]) {
            return 0 as usize;
        }
        added = true;
    }
    n = resp_raw_value(src, &"reasoning"[0: 9], &tmp[0], 8192);
    if n > 0 {
        if !resp_put(out, cap, &at, &",\"reasoning\":"[0: 13]) {
            return 0 as usize;
        }
        if !resp_put(out, cap, &at, tmp[0: n]) {
            return 0 as usize;
        }
        added = true;
    }
    if !added {
        return 0 as usize;
    }
    if !resp_put(out, cap, &at, &"}"[0: 1]) {
        return 0 as usize;
    }
    return at;
}

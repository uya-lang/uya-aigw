// src/core/schema.uya — A2 数据模型与迁移
//
// 一次迁移 = 一个 `pragma user_version` 台阶：
//   v0 → v1：身份与凭据（users / api_keys / otp_codes / sessions）
//   v1 → v2：价目表（price_cards / price_entries，含分时 schedule）
//   v2 → v3：用量账本（usage_ledger，request_id 幂等）
//   v3 → v4：供应商与模型路由（providers / provider_models）
//   v4 → v5：用量汇总（usage_daily，按天/用户/模型/供应商/时段）
//   v5 → v6：供应商优先级/权重（A8 负载均衡）
//   v6 → v7：responses 会话（A5 previous_response_id）
//
// 约定：
//   * 迁移**幂等**：重复执行到同一版本不产生副作用（`create table if not exists`）。
//   * 每个台阶在 `begin immediate` / `commit` 里，失败整体回滚，版本号不前进。
//   * 时间一律 unix 秒（integer）；金额一律 nano-USD（integer），见 money.uya。
//   * 文本列不放二进制密钥：api_keys 只存 sha256 十六进制。
//
// 打开流程（`schema_open`）：open → pragmas → migrate。热路径不该调它。

export const SCHEMA_VERSION: i32 = 8;

export error SchemaFailed;

/// 打开库的推荐 PRAGMA。`:memory:` 上 WAL 建不起来，忽略即可。
export fn schema_pragmas(d: &Db) !void {
    _ = dbx_exec_cstr(d, "pragma journal_mode=wal" as &const byte) catch {};
    try dbx_exec_cstr(d, "pragma synchronous=normal" as &const byte);
    try dbx_exec_cstr(d, "pragma busy_timeout=5000" as &const byte);
    try dbx_exec_cstr(d, "pragma foreign_keys=on" as &const byte);
}

/// 当前 schema 版本；读不到返回 -1。
export fn schema_current(d: &Db) i32 {
    var v: i64 = 0;
    if dbx_scalar_i64(d, &"pragma user_version"[0: 19], &v) != 0 {
        return 0 - 1;
    }
    return v as i32;
}

/// 打开 + pragmas + 迁移，一步到位。
export fn schema_open(d: &Db, path: &[byte]) !i32 {
    try dbx_open(d, path);
    schema_pragmas(d) catch |_| {};
    return schema_migrate(d);
}

// ---------------------------------------------------------------
// v1：身份与凭据
// ---------------------------------------------------------------
//
// users.status      0=active 1=suspended
// api_keys.prefix   `aigw_sk_` 之后的 8 位，用来在 O(1) 里定位一条 key
// api_keys.hash     sha256(整把 key) 的十六进制，逐字节比较
// otp_codes.used_at 非 0 表示已消费；attempts 超过上限即作废
// sessions.token_hash 同 api_keys.hash 的处理方式

fn schema_v1(d: &Db) !void {
    try dbx_exec_cstr(d, "create table if not exists users (id integer primary key, email text not null unique, slug text not null unique, status integer not null default 0, created_at integer not null, password_salt text not null default '', password_hash text not null default '')" as &const byte);
    try dbx_exec_cstr(d, "create table if not exists api_keys (id integer primary key, user_id integer not null references users(id) on delete cascade, name text not null default '', prefix text not null, hash text not null, created_at integer not null, revoked_at integer not null default 0, rpm integer not null default 0, tpm integer not null default 0)" as &const byte);
    try dbx_exec_cstr(d, "create unique index if not exists idx_api_keys_prefix on api_keys(prefix)" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_api_keys_user on api_keys(user_id)" as &const byte);
    try dbx_exec_cstr(d, "create table if not exists otp_codes (id integer primary key, email text not null, code_hash text not null, created_at integer not null, expires_at integer not null, attempts integer not null default 0, used_at integer not null default 0)" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_otp_email on otp_codes(email, expires_at)" as &const byte);
    try dbx_exec_cstr(d, "create table if not exists sessions (id integer primary key, user_id integer not null references users(id) on delete cascade, token_hash text not null unique, created_at integer not null, expires_at integer not null, ip text not null default '', ua text not null default '')" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_sessions_user on sessions(user_id)" as &const byte);
}

// ---------------------------------------------------------------
// v2：价目表（版本化卡片 + 条目）
// ---------------------------------------------------------------
//
// price_cards.kind       0=卖价（模型级 + 用户覆盖） 1=进价（绑定级 provider+model）
// price_cards.version    同 kind 内唯一；改价 = 新版本 + effective_from
// price_entries.user_id  0=默认；非 0 是用户覆盖（仅卖价使用）
// price_entries.provider 进价用（上游供应商名）；卖价留空
// price_entries.schedule 分时规则（见 schedule.uya），空串表示不调价
//
// 历史请求只记录 card_id/version，改价不回写历史。

fn schema_v2(d: &Db) !void {
    try dbx_exec_cstr(d, "create table if not exists price_cards (id integer primary key, kind integer not null, version integer not null, effective_from integer not null, created_at integer not null, note text not null default '')" as &const byte);
    try dbx_exec_cstr(d, "create unique index if not exists idx_price_cards_kind_version on price_cards(kind, version)" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_price_cards_effective on price_cards(kind, effective_from)" as &const byte);
    try dbx_exec_cstr(d, "create table if not exists price_entries (id integer primary key, card_id integer not null references price_cards(id) on delete cascade, provider text not null default '', model text not null, user_id integer not null default 0, input_nano_per_mtok integer not null default 0, output_nano_per_mtok integer not null default 0, cache_read_nano_per_mtok integer not null default 0, per_request_nano integer not null default 0, schedule text not null default '')" as &const byte);
    try dbx_exec_cstr(d, "create unique index if not exists idx_price_entries_key on price_entries(card_id, provider, model, user_id)" as &const byte);
}

// ---------------------------------------------------------------
// v3：用量账本（journal 重放的落点，幂等）
// ---------------------------------------------------------------
//
// request_id 是幂等键：同一批 ingest 重放多少次，账本都只有一行。
// usage_ledger 是「明细」，A6 的 rollup 汇总表在下一台阶。

fn schema_v3(d: &Db) !void {
    try dbx_exec_cstr(d, "create table if not exists usage_ledger (request_id text primary key, user_id integer not null, ts integer not null, model text not null, provider text not null default '', input_tokens integer not null default 0, output_tokens integer not null default 0, cache_read_tokens integer not null default 0, cost_nano integer not null default 0, price_nano integer not null default 0, period text not null default '', rate_version integer not null default 0)" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_usage_ledger_ts on usage_ledger(ts)" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_usage_ledger_user on usage_ledger(user_id, ts)" as &const byte);
}

// ---------------------------------------------------------------
// v4：供应商与模型路由
// ---------------------------------------------------------------
//
// 一个 provider = 一个上游端点 + 认证方式 + 超时；provider_models 把「对外模型名」
// 映射到「上游模型名」。A4 的 chat 路由按 model 找 enabled 的 provider。
// secret 只存引用（`literal:` / `env:`），不存明文以外的二进制。

fn schema_v4(d: &Db) !void {
    try dbx_exec_cstr(d, "create table if not exists providers (id integer primary key, name text not null, kind text not null default 'openai', scheme text not null default 'https', host text not null, port integer not null default 443, base_path text not null default '', auth_type integer not null default 1, auth_name text not null default 'Authorization', secret text not null default '', timeout_ms integer not null default 60000, enabled integer not null default 1, created_at integer not null default 0, updated_at integer not null default 0)" as &const byte);
    try dbx_exec_cstr(d, "create unique index if not exists idx_providers_name on providers(name)" as &const byte);
    try dbx_exec_cstr(d, "create table if not exists provider_models (id integer primary key, provider_id integer not null references providers(id) on delete cascade, model text not null, upstream_model text not null, created_at integer not null default 0)" as &const byte);
    try dbx_exec_cstr(d, "create unique index if not exists idx_provider_models_key on provider_models(provider_id, model)" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_provider_models_model on provider_models(model)" as &const byte);
}

// ---------------------------------------------------------------
// v5：用量汇总（A6 查询不扫明细）
// ---------------------------------------------------------------

fn schema_v5(d: &Db) !void {
    try dbx_exec_cstr(d, "create table if not exists usage_daily (day integer not null, user_id integer not null, model text not null, provider text not null default '', period text not null default '', requests integer not null default 0, input_tokens integer not null default 0, output_tokens integer not null default 0, cache_read_tokens integer not null default 0, cost_nano integer not null default 0, price_nano integer not null default 0, primary key(day, user_id, model, provider, period))" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_usage_daily_user on usage_daily(user_id, day)" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_usage_daily_day on usage_daily(day)" as &const byte);
}

// ---------------------------------------------------------------
// v6：供应商优先级/权重（A8）
// ---------------------------------------------------------------

fn schema_v6(d: &Db) !void {
    _ = dbx_exec_cstr(d, "alter table providers add column priority integer not null default 100" as &const byte) catch {};
    _ = dbx_exec_cstr(d, "alter table providers add column weight integer not null default 1" as &const byte) catch {};
}

// ---------------------------------------------------------------
// v7：responses（A5）
// ---------------------------------------------------------------

fn schema_v8(d: &Db) !void {
    try dbx_exec_cstr(d, "create table if not exists budgets (user_id integer primary key, monthly_nano integer not null default 0, updated_at integer not null default 0)" as &const byte);
}

fn schema_v7(d: &Db) !void {
    try dbx_exec_cstr(d, "create table if not exists responses (id text primary key, user_id integer not null, created_at integer not null, model text not null, previous_id text not null default '', input_text text not null default '', output_text text not null default '', status text not null default 'completed', usage_json text not null default '')" as &const byte);
    try dbx_exec_cstr(d, "create index if not exists idx_responses_user on responses(user_id, created_at)" as &const byte);
}

// ---------------------------------------------------------------
// 版本号写回
// ---------------------------------------------------------------

fn schema_put_digits(out: &byte, cap: usize, off: &usize, v: i32) bool {
    var tmp: [byte: 16] = [0: 16];
    var n: usize = 0;
    var x: i32 = v;
    if x == 0 {
        tmp[0] = '0' as byte;
        n = 1;
    }
    while x > 0 && n < 16 {
        const d: i32 = x % 10;
        tmp[n] = (48 as i32 + d) as byte;
        x = x / 10;
        n = n + 1;
    }
    var i: usize = n;
    while i > 0 {
        if off[0] >= cap {
            return false;
        }
        out[off[0]] = tmp[i - 1];
        off[0] = off[0] + 1;
        i = i - 1;
    }
    return true;
}

fn schema_set_version(d: &Db, v: i32) !void {
    var buf: [byte: 64] = [0: 64];
    var off: usize = 0;
    const head: &[byte] = &"pragma user_version = "[0: 22];
    var i: usize = 0;
    while i < head.len && off < 63 {
        buf[off] = head[i];
        off = off + 1;
        i = i + 1;
    }
    if !schema_put_digits(&buf[0], 63, &off, v) {
        return error.SchemaFailed;
    }
    buf[off] = 0 as byte;
    try dbx_exec_cstr(d, &buf[0] as &const byte);
}

/// 幂等迁移：升级到 `SCHEMA_VERSION`，返回最终版本号。
export fn schema_migrate(d: &Db) !i32 {
    var cur: i32 = schema_current(d);
    if cur < 0 {
        return error.SchemaFailed;
    }
    while cur < SCHEMA_VERSION {
        try dbx_exec_cstr(d, "begin immediate" as &const byte);
        var applied: bool = false;
        var failed: bool = false;
        if cur == 0 {
            schema_v1(d) catch |_| {
                failed = true;
            };
            applied = true;
        } else if cur == 1 {
            schema_v2(d) catch |_| {
                failed = true;
            };
            applied = true;
        } else if cur == 2 {
            schema_v3(d) catch |_| {
                failed = true;
            };
            applied = true;
        } else if cur == 3 {
            schema_v4(d) catch |_| {
                failed = true;
            };
            applied = true;
        } else if cur == 4 {
            schema_v5(d) catch |_| {
                failed = true;
            };
            applied = true;
        } else if cur == 5 {
            schema_v6(d) catch |_| {
                failed = true;
            };
            applied = true;
        } else if cur == 6 {
            schema_v7(d) catch |_| {
                failed = true;
            };
            applied = true;
        } else if cur == 7 {
            schema_v8(d) catch |_| {
                failed = true;
            };
            applied = true;
        }
        if !applied || failed {
            _ = dbx_exec_cstr(d, "rollback" as &const byte) catch {};
            return error.SchemaFailed;
        }
        schema_set_version(d, cur + 1) catch |_| {
            _ = dbx_exec_cstr(d, "rollback" as &const byte) catch {};
            return error.SchemaFailed;
        };
        dbx_exec_cstr(d, "commit" as &const byte) catch |_| {
            _ = dbx_exec_cstr(d, "rollback" as &const byte) catch {};
            return error.SchemaFailed;
        };
        cur = cur + 1;
    }
    return cur;
}

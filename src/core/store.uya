// src/core/store.uya — A2 身份与凭据（用户 / API Key / OTP / 会话）
//
// 设计约定：
//   * 时间一律由调用方传入 `now`（unix 秒），本模块不读时钟 —— 单测才能确定化。
//     需要现成的秒数用 `store_now()`。
//   * 明文凭据只出现在**返回值**里（创建时给用户看一次），库里只有 sha256 十六进制。
//   * 所有 SQL 都是预编译 + 绑定，用户输入永远不当 SQL 语法。
//   * 查 Key 先按 8 位前缀定位（唯一索引），再比对整串哈希；前缀写库、明文不写库。
//
// 表结构见 `schema.uya` v1。

use tls.crypto.sha256;
use libc.syscall;

/// API Key 前缀标记；整把 key = 标记 + 32 位十六进制。
const STORE_KEY_TAG: &[byte] = &"aigw_sk_"[0: 8];
/// 整把 key 的长度（8 + 32）。
export const STORE_KEY_TOKEN_LEN: usize = 40;
/// 库里存的前缀长度（标记之后的 8 位十六进制）。
export const STORE_KEY_PREFIX_LEN: usize = 8;
/// OTP 位数。
export const STORE_OTP_LEN: usize = 6;
/// 同一封邮件最多试几次 OTP。
export const STORE_OTP_MAX_ATTEMPTS: i32 = 5;
/// slug = 'u' + 10 位 base32。
export const STORE_SLUG_LEN: usize = 11;

export error StoreFailed;
export error UserExists;
export error UserNotFound;
export error KeyInvalid;
export error OtpInvalid;
export error SessionInvalid;
export error ProviderExists;
export error ProviderNotFound;

/// 用户的最小读模型。
export struct StoreUser {
    id: i64,
    status: i32,
    found: bool,
}

/// 校验通过后的 Key 读模型（鉴权只需要这些）。
export const STORE_KEY_NAME_MAX: usize = 64;
export const STORE_KEY_PREFIX_MAX: usize = 16;

/// GET /v1/keys 的一行（不含 hash/token）。
export struct StoreKeyRow {
    key_id: i64,
    prefix: [byte: STORE_KEY_PREFIX_MAX],
    prefix_len: usize,
    name: [byte: STORE_KEY_NAME_MAX],
    name_len: usize,
    created_at: i64,
    revoked_at: i64,
}

export fn store_key_row_zero(r: &StoreKeyRow) void {
    r.key_id = 0;
    r.prefix_len = 0;
    r.name_len = 0;
    r.created_at = 0;
    r.revoked_at = 0;
}

export struct StoreKey {
    key_id: i64,
    user_id: i64,
    rpm: i32,
    tpm: i32,
}

export const STORE_PROVIDER_NAME_MAX: usize = 64;
export const STORE_PROVIDER_KIND_MAX: usize = 32;
export const STORE_PROVIDER_SCHEME_MAX: usize = 8;
export const STORE_PROVIDER_HOST_MAX: usize = 256;
export const STORE_PROVIDER_PATH_MAX: usize = 128;
export const STORE_PROVIDER_AUTH_NAME_MAX: usize = 64;
export const STORE_PROVIDER_SECRET_MAX: usize = 256;
export const STORE_PROVIDER_MODEL_MAX: usize = 128;

/// 供应商读模型：固定缓冲，避免把 DB 生命周期带进调用方。
export struct StoreProvider {
    id: i64,
    port: i32,
    auth_type: i32,
    timeout_ms: i32,
    enabled: bool,
    priority: i32,
    weight: i32,
    found: bool,
    name: [byte: STORE_PROVIDER_NAME_MAX],
    name_len: usize,
    kind: [byte: STORE_PROVIDER_KIND_MAX],
    kind_len: usize,
    scheme: [byte: STORE_PROVIDER_SCHEME_MAX],
    scheme_len: usize,
    host: [byte: STORE_PROVIDER_HOST_MAX],
    host_len: usize,
    base_path: [byte: STORE_PROVIDER_PATH_MAX],
    base_path_len: usize,
    auth_name: [byte: STORE_PROVIDER_AUTH_NAME_MAX],
    auth_name_len: usize,
    secret: [byte: STORE_PROVIDER_SECRET_MAX],
    secret_len: usize,
}

/// 当前 unix 秒。
export fn store_now() i64 {
    var ts: TimeSpec = TimeSpec{};
    const r: !i32 = sys_clock_gettime(0, &ts);
    _ = r catch {
        return 0;
    };
    return ts.tv_sec;
}

/// 列出某用户的 Key（含已撤销，revoked_at>0）。返回行数。
export fn store_list_keys(d: &Db, uid: i64, out: &StoreKeyRow, cap: usize) !usize {
    var st: DbStmt = dbx_prepare(d,
        "select id, prefix, name, created_at, revoked_at from api_keys where user_id = ? order by id limit ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, uid) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 2, cap as i64) catch {
        return error.StoreFailed;
    };
    var n: usize = 0;
    while n < cap {
        if dbx_step(&st) != 1 {
            break;
        }
        store_key_row_zero(&out[n]);
        out[n].key_id = dbx_col_i64(&st, 0);
        out[n].prefix_len = dbx_col_text(&st, 1, &out[n].prefix[0], STORE_KEY_PREFIX_MAX);
        out[n].name_len = dbx_col_text(&st, 2, &out[n].name[0], STORE_KEY_NAME_MAX);
        out[n].created_at = dbx_col_i64(&st, 3);
        out[n].revoked_at = dbx_col_i64(&st, 4);
        n = n + 1;
    }
    return n;
}

/// 撤销某用户自己的 Key；返回是否命中（越权/不存在都是 false）。
// ---- A4 快路径：最近一次校验成功的 Key 做单槽缓存（默认 2s）----
const KEY_CACHE_TTL: i64 = 2;

var g_kc_used: bool = false;
var g_kc_token: [byte: 128] = [0: 128];
var g_kc_token_len: usize = 0;
var g_kc_key: StoreKey = StoreKey{ key_id: 0, user_id: 0, rpm: 0, tpm: 0 };
var g_kc_until: i64 = 0;

export fn store_key_cache_flush() void {
    g_kc_used = false;
    g_kc_token_len = 0;
    g_kc_until = 0;
}

fn store_key_cache_hit(token: &[byte], now: i64) bool {
    if !g_kc_used || now >= g_kc_until || token.len != g_kc_token_len || token.len > 128 {
        return false;
    }
    var i: usize = 0;
    while i < token.len {
        if g_kc_token[i] != token[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn store_key_cache_put(token: &[byte], k: &const StoreKey, now: i64) void {
    if token.len == 0 || token.len > 128 {
        return;
    }
    var i: usize = 0;
    while i < token.len {
        g_kc_token[i] = token[i];
        i = i + 1;
    }
    g_kc_token_len = i;
    g_kc_key.key_id = k.key_id;
    g_kc_key.user_id = k.user_id;
    g_kc_key.rpm = k.rpm;
    g_kc_key.tpm = k.tpm;
    g_kc_until = now +% KEY_CACHE_TTL;
    g_kc_used = true;
}

/// 同 `store_verify_key`，但命中单槽缓存时跳过 DB（热路径）。
export fn store_verify_key_fast(d: &Db, token: &[byte], now: i64, out: &StoreKey) !void {
    if store_key_cache_hit(token, now) {
        out.key_id = g_kc_key.key_id;
        out.user_id = g_kc_key.user_id;
        out.rpm = g_kc_key.rpm;
        out.tpm = g_kc_key.tpm;
        return;
    }
    try store_verify_key(d, token, out);
    store_key_cache_put(token, out, now);
}

export fn store_revoke_key_owned(d: &Db, key_id: i64, uid: i64, now: i64) !bool {
    var st: DbStmt = dbx_prepare(d,
        "update api_keys set revoked_at = ? where id = ? and user_id = ? and revoked_at = 0" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, now) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 2, key_id) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 3, uid) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    store_key_cache_flush();
    return dbx_changes(d) == 1;
}

// ---------------------------------------------------------------
// 随机与编码
// ---------------------------------------------------------------

/// 从 /dev/urandom 读 `n` 字节。
fn store_random(buf: &byte, n: usize, cap: usize) !void {
    if n > cap || n == 0 {
        return error.StoreFailed;
    }
    const fd: i32 = sys_open("/dev/urandom" as *const byte, 0 as i32, 0) catch |_| {
        return error.StoreFailed;
    };
    defer { _ = sys_close(fd) catch {}; }
    var got: usize = 0;
    while got < n {
        const r: !isize = sys_read(fd, &buf[got], n - got);
        const k: isize = r catch {
            return error.StoreFailed;
        };
        if k <= 0 {
            return error.StoreFailed;
        }
        got = got +% (k as usize);
    }
    return;
}

fn store_hex_digit(v: byte) byte {
    const d: byte = v & (15 as byte);
    if d < 10 {
        return (48 as byte) + d;
    }
    return (87 as byte) + d;
}

/// 写成 2n 位小写十六进制，返回写入长度。
fn store_hex_out(data: &byte, n: usize, out: &byte, cap: usize) usize {
    var i: usize = 0;
    while i < n && (i * 2) + 1 < cap {
        const v: byte = data[i];
        out[i * 2] = store_hex_digit(v >> 4);
        out[i * 2 + 1] = store_hex_digit(v);
        i = i + 1;
    }
    return i * 2;
}

/// sha256(明文) 的十六进制，返回写入长度（正常 64）。
fn store_sha256_hex(data: &const byte, len: usize, out: &byte, cap: usize) usize {
    var digest: [byte: 32] = [0: 32];
    sha256(data, len, &digest[0]);
    return store_hex_out(&digest[0], 32, out, cap);
}

fn store_b32_char(v: byte) byte {
    const x: byte = v % (32 as byte);
    if x < 26 {
        return (97 as byte) + x;
    }
    return (50 as byte) + (x - 26);
}

/// 生成 `u` + 10 位 base32 的接入 slug。
export fn store_new_slug(out: &byte, cap: usize) !usize {
    if cap < STORE_SLUG_LEN {
        return error.StoreFailed;
    }
    var rb: [byte: 16] = [0: 16];
    try store_random(&rb[0], 16, 16);
    out[0] = 'u' as byte;
    var i: usize = 0;
    while i < STORE_SLUG_LEN - 1 {
        out[i + 1] = store_b32_char(rb[i]);
        i = i + 1;
    }
    return STORE_SLUG_LEN;
}

// ---------------------------------------------------------------
// 用户
// ---------------------------------------------------------------

/// 唯一约束冲突的判定：sqlite 的错误信息里带 "UNIQUE"。
fn store_last_error_is_unique() bool {
    const e: &byte = dbx_last_error();
    var i: usize = 0;
    while i + 6 < 200 {
        if e[i] == (0 as byte) {
            return false;
        }
        if e[i] == ('U' as byte) && e[i + 1] == ('N' as byte) && e[i + 2] == ('I' as byte)
            && e[i + 3] == ('Q' as byte) && e[i + 4] == ('U' as byte) && e[i + 5] == ('E' as byte) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// 建用户（email 唯一）。slug 不传就现生成一个。
export fn store_create_user(d: &Db, email: &[byte], slug: &[byte], now: i64,
    out: &StoreUser) !void {
    var st: DbStmt = dbx_prepare(d,
        "insert into users(email, slug, created_at) values(?, ?, ?)" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, email) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 2, slug) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 3, now) catch {
        return error.StoreFailed;
    };
    const rc: i32 = dbx_step(&st);
    if rc != 0 {
        if store_last_error_is_unique() {
            return error.UserExists;
        }
        return error.StoreFailed;
    }
    out.id = dbx_last_insert_rowid(d);
    out.status = 0;
    out.found = true;
    return;
}

/// 按 email 找用户。
export fn store_find_user(d: &Db, email: &[byte], out: &StoreUser) !void {
    var st: DbStmt = dbx_prepare(d,
        "select id, status from users where email = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, email) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 1 {
        return error.UserNotFound;
    }
    out.id = dbx_col_i64(&st, 0);
    out.status = dbx_col_i64(&st, 1) as i32;
    out.found = true;
    return;
}

/// 按 user id 取 email（reqlog 日志用）；找不到或出错返回 0。
export fn store_user_email(d: &Db, user_id: i64, out: &byte, cap: usize) usize {
    var st: DbStmt = dbx_prepare(d,
        "select email from users where id = ?" as &const byte) catch {
        return 0;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, user_id) catch {
        return 0;
    };
    if dbx_step(&st) != 1 {
        return 0;
    }
    return dbx_col_text(&st, 0, out, cap);
}

/// 改用户状态（0=active 1=suspended）。
export fn store_set_user_status(d: &Db, user_id: i64, status: i32) !void {
    var st: DbStmt = dbx_prepare(d, "update users set status = ? where id = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, status as i64) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 2, user_id) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    return;
}

// ---------------------------------------------------------------
// API Key
// ---------------------------------------------------------------

/// 建一把 Key，把明文写进 `token_out`（只此一次），返回长度。
export fn store_create_key(d: &Db, user_id: i64, name: &[byte], now: i64,
    token_out: &byte, cap: usize) !usize {
    if cap < STORE_KEY_TOKEN_LEN {
        return error.StoreFailed;
    }
    var secret: [byte: 16] = [0: 16];
    try store_random(&secret[0], 16, 16);
    var i: usize = 0;
    while i < STORE_KEY_TAG.len {
        token_out[i] = STORE_KEY_TAG[i];
        i = i + 1;
    }
    _ = store_hex_out(&secret[0], 16, &token_out[STORE_KEY_TAG.len], cap - STORE_KEY_TAG.len);
    // 前缀 = 标记之后的 8 位
    var prefix: [byte: 16] = [0: 16];
    var p: usize = 0;
    while p < STORE_KEY_PREFIX_LEN {
        prefix[p] = token_out[STORE_KEY_TAG.len + p];
        p = p + 1;
    }
    var hash: [byte: 80] = [0: 80];
    const hn: usize = store_sha256_hex(&token_out[0] as &const byte, STORE_KEY_TOKEN_LEN, &hash[0], 80);
    var st: DbStmt = dbx_prepare(d,
        "insert into api_keys(user_id, name, prefix, hash, created_at) values(?, ?, ?, ?, ?)" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, user_id) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 2, name) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 3, prefix[0: STORE_KEY_PREFIX_LEN]) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 4, hash[0: hn]) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 5, now) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    return STORE_KEY_TOKEN_LEN;
}

/// 校验一把 Key。未撤销、前缀命中且哈希一致才算通过。
export fn store_verify_key(d: &Db, token: &[byte], out: &StoreKey) !void {
    // 长度必须**精确**：只校验前 N 字节会让「正确 key + 后缀」也能通过。
    if token.len != STORE_KEY_TOKEN_LEN {
        return error.KeyInvalid;
    }
    var i: usize = 0;
    while i < STORE_KEY_TAG.len {
        if token[i] != STORE_KEY_TAG[i] {
            return error.KeyInvalid;
        }
        i = i + 1;
    }
    var prefix: [byte: 16] = [0: 16];
    var p: usize = 0;
    while p < STORE_KEY_PREFIX_LEN {
        prefix[p] = token[STORE_KEY_TAG.len + p];
        p = p + 1;
    }
    var hash: [byte: 80] = [0: 80];
    const hn: usize = store_sha256_hex(token.ptr, STORE_KEY_TOKEN_LEN, &hash[0], 80);
    var st: DbStmt = dbx_prepare(d,
        "select id, user_id, hash, rpm, tpm from api_keys where prefix = ? and revoked_at = 0" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, prefix[0: STORE_KEY_PREFIX_LEN]) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 1 {
        return error.KeyInvalid;
    }
    var stored: [byte: 80] = [0: 80];
    const sn: usize = dbx_col_text(&st, 2, &stored[0], 80);
    if sn != hn {
        return error.KeyInvalid;
    }
    var k: usize = 0;
    while k < hn {
        if stored[k] != hash[k] {
            return error.KeyInvalid;
        }
        k = k + 1;
    }
    out.key_id = dbx_col_i64(&st, 0);
    out.user_id = dbx_col_i64(&st, 1);
    out.rpm = dbx_col_i64(&st, 3) as i32;
    out.tpm = dbx_col_i64(&st, 4) as i32;
    return;
}

/// 撤销一把 Key（保留行，审计要看）。
export fn store_revoke_key(d: &Db, key_id: i64, now: i64) !void {
    var st: DbStmt = dbx_prepare(d, "update api_keys set revoked_at = ? where id = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, now) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 2, key_id) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    return;
}

// ---------------------------------------------------------------
// OTP（邮箱验证码）
// ---------------------------------------------------------------

/// 发一个验证码：库里只存哈希，明文写进 `code_out` 返回长度。
export fn store_request_otp(d: &Db, email: &[byte], now: i64, ttl: i64,
    code_out: &byte, cap: usize) !usize {
    if cap < STORE_OTP_LEN {
        return error.StoreFailed;
    }
    var rb: [byte: 4] = [0: 4];
    try store_random(&rb[0], 4, 4);
    const v: u32 = ((rb[0] as u32) << 24) | ((rb[1] as u32) << 16) | ((rb[2] as u32) << 8) | (rb[3] as u32);
    const code: u32 = v % (1000000 as u32);
    code_out[0] = (48 as byte) + ((code / (100000 as u32)) % (10 as u32)) as byte;
    code_out[1] = (48 as byte) + ((code / (10000 as u32)) % (10 as u32)) as byte;
    code_out[2] = (48 as byte) + ((code / (1000 as u32)) % (10 as u32)) as byte;
    code_out[3] = (48 as byte) + ((code / (100 as u32)) % (10 as u32)) as byte;
    code_out[4] = (48 as byte) + ((code / (10 as u32)) % (10 as u32)) as byte;
    code_out[5] = (48 as byte) + (code % (10 as u32)) as byte;
    var hash: [byte: 80] = [0: 80];
    const hn: usize = store_sha256_hex(&code_out[0] as &const byte, STORE_OTP_LEN, &hash[0], 80);
    var st: DbStmt = dbx_prepare(d,
        "insert into otp_codes(email, code_hash, created_at, expires_at) values(?, ?, ?, ?)" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, email) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 2, hash[0: hn]) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 3, now) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 4, now +% ttl) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    return STORE_OTP_LEN;
}

/// 校验验证码：取该邮箱最新一条，未过期、未消费、未超试错上限，哈希一致才通过。
export fn store_verify_otp(d: &Db, email: &[byte], code: &[byte], now: i64) !void {
    if code.len != STORE_OTP_LEN {
        return error.OtpInvalid;
    }
    var st: DbStmt = dbx_prepare(d,
        "select id, code_hash, expires_at, attempts, used_at from otp_codes where email = ? order by id desc limit 1" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, email) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 1 {
        return error.OtpInvalid;
    }
    const id: i64 = dbx_col_i64(&st, 0);
    var stored: [byte: 80] = [0: 80];
    const sn: usize = dbx_col_text(&st, 1, &stored[0], 80);
    const expires_at: i64 = dbx_col_i64(&st, 2);
    const attempts: i32 = dbx_col_i64(&st, 3) as i32;
    const used_at: i64 = dbx_col_i64(&st, 4);
    if used_at != 0 || now > expires_at || attempts >= STORE_OTP_MAX_ATTEMPTS {
        return error.OtpInvalid;
    }
    var hash: [byte: 80] = [0: 80];
    const hn: usize = store_sha256_hex(code.ptr, STORE_OTP_LEN, &hash[0], 80);
    var same: bool = sn == hn;
    var i: usize = 0;
    while same && i < hn {
        if stored[i] != hash[i] {
            same = false;
        }
        i = i + 1;
    }
    if !same {
        store_otp_bump_attempts(d, id) catch {};
        return error.OtpInvalid;
    }
    var up: DbStmt = dbx_prepare(d, "update otp_codes set used_at = ? where id = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&up); }
    dbx_bind_i64(&up, 1, now) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&up, 2, id) catch {
        return error.StoreFailed;
    };
    if dbx_step(&up) != 0 {
        return error.StoreFailed;
    }
    return;
}

fn store_otp_bump_attempts(d: &Db, id: i64) !void {
    var st: DbStmt = dbx_prepare(d, "update otp_codes set attempts = attempts + 1 where id = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, id) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    return;
}

// ---------------------------------------------------------------
// 会话
// ---------------------------------------------------------------

/// 建会话：返回 32 位十六进制明文 token（库里存哈希）。
export fn store_create_session(d: &Db, user_id: i64, now: i64, ttl: i64,
    token_out: &byte, cap: usize) !usize {
    if cap < 32 {
        return error.StoreFailed;
    }
    var secret: [byte: 16] = [0: 16];
    try store_random(&secret[0], 16, 16);
    _ = store_hex_out(&secret[0], 16, token_out, cap);
    var hash: [byte: 80] = [0: 80];
    const hn: usize = store_sha256_hex(&token_out[0] as &const byte, 32, &hash[0], 80);
    var st: DbStmt = dbx_prepare(d,
        "insert into sessions(user_id, token_hash, created_at, expires_at) values(?, ?, ?, ?)" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, user_id) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 2, hash[0: hn]) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 3, now) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 4, now +% ttl) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    return 32 as usize;
}

/// 校验会话 token，通过则写回 user_id。
export fn store_verify_session(d: &Db, token: &[byte], now: i64, user_id_out: &i64) !void {
    if token.len != 32 {
        return error.SessionInvalid;
    }
    var hash: [byte: 80] = [0: 80];
    const hn: usize = store_sha256_hex(token.ptr, 32, &hash[0], 80);
    var st: DbStmt = dbx_prepare(d,
        "select user_id, expires_at from sessions where token_hash = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, hash[0: hn]) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 1 {
        return error.SessionInvalid;
    }
    const uid: i64 = dbx_col_i64(&st, 0);
    const exp: i64 = dbx_col_i64(&st, 1);
    if now > exp {
        store_drop_session(d, token) catch {};
        return error.SessionInvalid;
    }
    user_id_out[0] = uid;
    return;
}

/// 注销会话。
export fn store_drop_session(d: &Db, token: &[byte]) !void {
    if token.len != 32 {
        return error.SessionInvalid;
    }
    var hash: [byte: 80] = [0: 80];
    const hn: usize = store_sha256_hex(token.ptr, 32, &hash[0], 80);
    var st: DbStmt = dbx_prepare(d, "delete from sessions where token_hash = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, hash[0: hn]) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    return;
}

// ---------------------------------------------------------------
// 供应商（A4）：providers / provider_models
// ---------------------------------------------------------------

export fn store_provider_zero(out: &StoreProvider) void {
    out.id = 0;
    out.port = 0;
    out.auth_type = 0;
    out.timeout_ms = 0;
    out.enabled = false;
    out.priority = 0;
    out.weight = 0;
    out.found = false;
    out.name_len = 0;
    out.kind_len = 0;
    out.scheme_len = 0;
    out.host_len = 0;
    out.base_path_len = 0;
    out.auth_name_len = 0;
    out.secret_len = 0;
}

/// 读一行的前 12 列（id..enabled）；调用方保证列顺序一致。
fn store_provider_fill(st: &DbStmt, out: &StoreProvider) void {
    out.id = dbx_col_i64(st, 0);
    out.name_len = dbx_col_text(st, 1, &out.name[0], STORE_PROVIDER_NAME_MAX);
    out.kind_len = dbx_col_text(st, 2, &out.kind[0], STORE_PROVIDER_KIND_MAX);
    out.scheme_len = dbx_col_text(st, 3, &out.scheme[0], STORE_PROVIDER_SCHEME_MAX);
    out.host_len = dbx_col_text(st, 4, &out.host[0], STORE_PROVIDER_HOST_MAX);
    out.port = dbx_col_i64(st, 5) as i32;
    out.base_path_len = dbx_col_text(st, 6, &out.base_path[0], STORE_PROVIDER_PATH_MAX);
    out.auth_type = dbx_col_i64(st, 7) as i32;
    out.auth_name_len = dbx_col_text(st, 8, &out.auth_name[0], STORE_PROVIDER_AUTH_NAME_MAX);
    out.secret_len = dbx_col_text(st, 9, &out.secret[0], STORE_PROVIDER_SECRET_MAX);
    out.timeout_ms = dbx_col_i64(st, 10) as i32;
    out.enabled = dbx_col_i64(st, 11) != 0;
    out.priority = dbx_col_i64(st, 12) as i32;
    out.weight = dbx_col_i64(st, 13) as i32;
    out.found = true;
}

const STORE_PROVIDER_COLS: &const byte =
    "select id, name, kind, scheme, host, port, base_path, auth_type, auth_name, secret, timeout_ms, enabled, priority, weight from providers where id = ?" as &const byte;

/// 建供应商（默认 openai/https/443/bearer/60s/enabled）。
export fn store_provider_create(d: &Db, name: &[byte], host: &[byte], port: i32,
    now: i64, out: &StoreProvider) !void {
    if name.len == 0 || name.len > STORE_PROVIDER_NAME_MAX || host.len == 0
        || host.len > STORE_PROVIDER_HOST_MAX || port <= 0 || port > 65535 {
        return error.StoreFailed;
    }
    var st: DbStmt = dbx_prepare(d,
        "insert into providers(name, host, port, created_at, updated_at) values(?, ?, ?, ?, ?)" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, name) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 2, host) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 3, port as i64) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 4, now) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 5, now) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        if store_last_error_is_unique() {
            return error.ProviderExists;
        }
        return error.StoreFailed;
    }
    const id: i64 = dbx_last_insert_rowid(d);
    try store_provider_get(d, id, out);
    return;
}

/// 按 id 取供应商。
export fn store_provider_get(d: &Db, id: i64, out: &StoreProvider) !void {
    store_provider_zero(out);
    var st: DbStmt = dbx_prepare(d, STORE_PROVIDER_COLS) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, id) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 1 {
        return error.ProviderNotFound;
    }
    store_provider_fill(&st, out);
    return;
}

/// 按名字取供应商（含 disabled 的；enabled 由调用方判断）。
export fn store_provider_find(d: &Db, name: &[byte], out: &StoreProvider) !void {
    store_provider_zero(out);
    var st: DbStmt = dbx_prepare(d,
        "select id, name, kind, scheme, host, port, base_path, auth_type, auth_name, secret, timeout_ms, enabled, priority, weight from providers where name = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, name) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 1 {
        return error.ProviderNotFound;
    }
    store_provider_fill(&st, out);
    return;
}

/// 更新认证配置（auth_type：0 none / 1 bearer / 2 header / 3 query）。
export fn store_provider_set_auth(d: &Db, id: i64, auth_type: i32,
    auth_name: &[byte], secret: &[byte], now: i64) !void {
    if auth_type < 0 || auth_type > 3 || auth_name.len > STORE_PROVIDER_AUTH_NAME_MAX
        || secret.len > STORE_PROVIDER_SECRET_MAX {
        return error.StoreFailed;
    }
    var st: DbStmt = dbx_prepare(d,
        "update providers set auth_type = ?, auth_name = ?, secret = ?, updated_at = ? where id = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, auth_type as i64) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 2, auth_name) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 3, secret) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 4, now) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 5, id) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    if dbx_changes(d) == 0 {
        return error.ProviderNotFound;
    }
    return;
}

/// D5：设置供应商 kind（`stdio` 走插件池；其余走内置 HTTPS）。
export fn store_provider_set_kind(d: &Db, id: i64, kind: &[byte], now: i64) !void {
    if kind.len == 0 || kind.len > STORE_PROVIDER_KIND_MAX {
        return error.StoreFailed;
    }
    var st: DbStmt = dbx_prepare(d,
        "update providers set kind = ?, updated_at = ? where id = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, kind) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 2, now) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 3, id) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    return;
}

/// 设置优先级（越小越优先）与权重（0 = 不参与分摊）。
export fn store_provider_set_priority(d: &Db, id: i64, priority: i32, weight: i32,
    now: i64) !void {
    if priority < 0 || weight < 0 || weight > 1000 {
        return error.StoreFailed;
    }
    var st: DbStmt = dbx_prepare(d,
        "update providers set priority = ?, weight = ?, updated_at = ? where id = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, priority as i64) catch { return error.StoreFailed; };
    dbx_bind_i64(&st, 2, weight as i64) catch { return error.StoreFailed; };
    dbx_bind_i64(&st, 3, now) catch { return error.StoreFailed; };
    dbx_bind_i64(&st, 4, id) catch { return error.StoreFailed; };
    if dbx_step(&st) != 0 { return error.StoreFailed; }
    if dbx_changes(d) == 0 { return error.ProviderNotFound; }
    return;
}

/// 启用/停用。
export fn store_provider_set_enabled(d: &Db, id: i64, enabled: bool, now: i64) !void {
    var st: DbStmt = dbx_prepare(d,
        "update providers set enabled = ?, updated_at = ? where id = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    var ev: i64 = 0;
    if enabled {
        ev = 1;
    }
    dbx_bind_i64(&st, 1, ev) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 2, now) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 3, id) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    if dbx_changes(d) == 0 {
        return error.ProviderNotFound;
    }
    return;
}

/// 对外模型名 → 上游模型名（同一 provider 内覆盖）。
export fn store_provider_model_put(d: &Db, provider_id: i64, model: &[byte],
    upstream_model: &[byte], now: i64) !void {
    if model.len == 0 || model.len > STORE_PROVIDER_MODEL_MAX || upstream_model.len == 0
        || upstream_model.len > STORE_PROVIDER_MODEL_MAX {
        return error.StoreFailed;
    }
    var st: DbStmt = dbx_prepare(d,
        "insert or replace into provider_models(provider_id, model, upstream_model, created_at) values(?, ?, ?, ?)" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, provider_id) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 2, model) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 3, upstream_model) catch {
        return error.StoreFailed;
    };
    dbx_bind_i64(&st, 4, now) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 0 {
        return error.StoreFailed;
    }
    return;
}

/// 按对外模型名选一个 enabled 的 provider（id 最小者），并给出上游模型名。
/// 没有可用路由返回 false（不是错误）。
export fn store_provider_route(d: &Db, model: &[byte], out: &StoreProvider,
    upstream_out: &byte, cap: usize, upstream_len: &usize) !bool {
    upstream_len[0] = 0;
    store_provider_zero(out);
    var st: DbStmt = dbx_prepare(d,
        "select p.id, p.name, p.kind, p.scheme, p.host, p.port, p.base_path, p.auth_type, p.auth_name, p.secret, p.timeout_ms, p.enabled, p.priority, p.weight, m.upstream_model from provider_models m join providers p on p.id = m.provider_id where m.model = ? and p.enabled = 1 order by p.id limit 1" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_text(&st, 1, model) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 1 {
        return false;
    }
    store_provider_fill(&st, out);
    upstream_len[0] = dbx_col_text(&st, 14, upstream_out, cap);
    return true;
}

/// 取某 provider 下某个对外模型的上游模型名（A8 选择后使用）。
export fn store_provider_upstream(d: &Db, provider_id: i64, model: &[byte],
    out: &byte, cap: usize, out_len: &usize) !void {
    var st: DbStmt = dbx_prepare(d,
        "select upstream_model from provider_models where provider_id = ? and model = ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, provider_id) catch {
        return error.StoreFailed;
    };
    dbx_bind_text(&st, 2, model) catch {
        return error.StoreFailed;
    };
    if dbx_step(&st) != 1 {
        return error.ProviderNotFound;
    }
    out_len[0] = dbx_col_text(&st, 0, out, cap);
    return;
}

// ---------------------------------------------------------------
// C5：管理后台读模型（用户/供应商列表）
// ---------------------------------------------------------------

export const STORE_EMAIL_MAX: usize = 128;

export struct StoreUserRow {
    id: i64,
    email: [byte: STORE_EMAIL_MAX],
    email_len: usize,
    status: i32,
    created_at: i64,
}

export fn store_user_row_zero(r: &StoreUserRow) void {
    r.id = 0;
    r.email_len = 0;
    r.status = 0;
    r.created_at = 0;
}

/// 列出用户（按 id 升序，最多 cap 行）。
export fn store_list_users(d: &Db, out: &StoreUserRow, cap: usize) !usize {
    var st: DbStmt = dbx_prepare(d,
        "select id, email, status, created_at from users order by id limit ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, cap as i64) catch {
        return error.StoreFailed;
    };
    var n: usize = 0;
    while n < cap {
        if dbx_step(&st) != 1 {
            break;
        }
        store_user_row_zero(&out[n]);
        out[n].id = dbx_col_i64(&st, 0);
        out[n].email_len = dbx_col_text(&st, 1, &out[n].email[0], STORE_EMAIL_MAX);
        out[n].status = dbx_col_i64(&st, 2) as i32;
        out[n].created_at = dbx_col_i64(&st, 3);
        n = n + 1;
    }
    return n;
}

/// C2：请求列表行（usage_ledger 读模型）。
export const STORE_LEDGER_ID_MAX: usize = 72;
export const STORE_LEDGER_TEXT_MAX: usize = 64;

export struct StoreLedgerRow {
    request_id: [byte: STORE_LEDGER_ID_MAX],
    request_id_len: usize,
    ts: i64,
    model: [byte: STORE_LEDGER_TEXT_MAX],
    model_len: usize,
    provider: [byte: STORE_LEDGER_TEXT_MAX],
    provider_len: usize,
    input_tokens: i64,
    output_tokens: i64,
    cache_read_tokens: i64,
    cost_nano: i64,
    period: [byte: 32],
    period_len: usize,
}

fn store_ledger_row_zero(r: &StoreLedgerRow) void {
    r.request_id_len = 0;
    r.ts = 0;
    r.model_len = 0;
    r.provider_len = 0;
    r.input_tokens = 0;
    r.output_tokens = 0;
    r.cache_read_tokens = 0;
    r.cost_nano = 0;
    r.period_len = 0;
}

/// 分页列出某用户的请求（按时间倒序）。
export fn store_list_ledger(d: &Db, user_id: i64, limit: i64, offset: i64,
    out: &StoreLedgerRow, cap: usize) !usize {
    var st: DbStmt = dbx_prepare(d,
        "select request_id, ts, model, provider, input_tokens, output_tokens, cache_read_tokens, cost_nano, period from usage_ledger where user_id = ? order by ts desc, request_id desc limit ? offset ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, user_id) catch { return error.StoreFailed; };
    dbx_bind_i64(&st, 2, limit) catch { return error.StoreFailed; };
    dbx_bind_i64(&st, 3, offset) catch { return error.StoreFailed; };
    var n: usize = 0;
    while n < cap {
        if dbx_step(&st) != 1 {
            break;
        }
        store_ledger_row_zero(&out[n]);
        out[n].request_id_len = dbx_col_text(&st, 0, &out[n].request_id[0], STORE_LEDGER_ID_MAX);
        out[n].ts = dbx_col_i64(&st, 1);
        out[n].model_len = dbx_col_text(&st, 2, &out[n].model[0], STORE_LEDGER_TEXT_MAX);
        out[n].provider_len = dbx_col_text(&st, 3, &out[n].provider[0], STORE_LEDGER_TEXT_MAX);
        out[n].input_tokens = dbx_col_i64(&st, 4);
        out[n].output_tokens = dbx_col_i64(&st, 5);
        out[n].cache_read_tokens = dbx_col_i64(&st, 6);
        out[n].cost_nano = dbx_col_i64(&st, 7);
        out[n].period_len = dbx_col_text(&st, 8, &out[n].period[0], 32);
        n = n + 1;
    }
    return n;
}

/// 取某用户的一条请求详情；不存在返回 false。
export fn store_get_ledger(d: &Db, user_id: i64, request_id: &[byte],
    out: &StoreLedgerRow) !bool {
    var st: DbStmt = dbx_prepare(d,
        "select request_id, ts, model, provider, input_tokens, output_tokens, cache_read_tokens, cost_nano, period from usage_ledger where user_id = ? and request_id = ? limit 1" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, user_id) catch { return error.StoreFailed; };
    dbx_bind_text(&st, 2, request_id) catch { return error.StoreFailed; };
    if dbx_step(&st) != 1 {
        return false;
    }
    store_ledger_row_zero(out);
    out.request_id_len = dbx_col_text(&st, 0, &out.request_id[0], STORE_LEDGER_ID_MAX);
    out.ts = dbx_col_i64(&st, 1);
    out.model_len = dbx_col_text(&st, 2, &out.model[0], STORE_LEDGER_TEXT_MAX);
    out.provider_len = dbx_col_text(&st, 3, &out.provider[0], STORE_LEDGER_TEXT_MAX);
    out.input_tokens = dbx_col_i64(&st, 4);
    out.output_tokens = dbx_col_i64(&st, 5);
    out.cache_read_tokens = dbx_col_i64(&st, 6);
    out.cost_nano = dbx_col_i64(&st, 7);
    out.period_len = dbx_col_text(&st, 8, &out.period[0], 32);
    return true;
}

/// C3：模型绑定读模型（provider_models）。
export struct StoreModelRow {
    provider_id: i64,
    provider_name: [byte: 64],
    provider_name_len: usize,
    model: [byte: STORE_PROVIDER_MODEL_MAX],
    model_len: usize,
    upstream_model: [byte: STORE_PROVIDER_MODEL_MAX],
    upstream_len: usize,
}

export fn store_list_provider_models(d: &Db, out: &StoreModelRow, cap: usize) !usize {
    var st: DbStmt = dbx_prepare(d,
        "select m.provider_id, p.name, m.model, m.upstream_model from provider_models m join providers p on p.id = m.provider_id order by m.model, m.provider_id limit ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, cap as i64) catch { return error.StoreFailed; };
    var n: usize = 0;
    while n < cap {
        if dbx_step(&st) != 1 {
            break;
        }
        out[n].provider_id = dbx_col_i64(&st, 0);
        out[n].provider_name_len = dbx_col_text(&st, 1, &out[n].provider_name[0], 64);
        out[n].model_len = dbx_col_text(&st, 2, &out[n].model[0], STORE_PROVIDER_MODEL_MAX);
        out[n].upstream_len = dbx_col_text(&st, 3, &out[n].upstream_model[0], STORE_PROVIDER_MODEL_MAX);
        n = n + 1;
    }
    return n;
}

/// 按名字找供应商 id；找不到返回 0。
export fn store_provider_id_by_name(d: &Db, name: &[byte]) !i64 {
    var rows: [StoreProvider: 64] = [];
    const n: usize = try store_list_providers(d, &rows[0], 64);
    var i: usize = 0;
    while i < n {
        if rows[i].name_len == name.len {
            var same: bool = true;
            var k: usize = 0;
            while k < name.len {
                if rows[i].name[k] != name[k] {
                    same = false;
                    break;
                }
                k = k + 1;
            }
            if same {
                return rows[i].id;
            }
        }
        i = i + 1;
    }
    return 0 as i64;
}

/// 列出供应商（按 id 升序）。
export fn store_list_providers(d: &Db, out: &StoreProvider, cap: usize) !usize {
    var st: DbStmt = dbx_prepare(d,
        "select id, name, kind, scheme, host, port, base_path, auth_type, auth_name, secret, timeout_ms, enabled, priority, weight from providers order by id limit ?" as &const byte) catch {
        return error.StoreFailed;
    };
    defer { dbx_finalize(&st); }
    dbx_bind_i64(&st, 1, cap as i64) catch {
        return error.StoreFailed;
    };
    var n: usize = 0;
    while n < cap {
        if dbx_step(&st) != 1 {
            break;
        }
        store_provider_zero(&out[n]);
        store_provider_fill(&st, &out[n]);
        n = n + 1;
    }
    return n;
}

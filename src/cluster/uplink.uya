// src/cluster/uplink.uya — B2 node → controller 的明文 HTTP 客户端（IP 直连）
//
// 控制面只在内网直连（IP:port），不做 DNS/TLS；用 tcpx 建连后切阻塞读写。
// Connection: close：读到 EOF 即完成，响应体按 Content-Length/剩余字节取。

use std.async;
use libc.syscall;

export error UplinkFailed;

/// 与 x86_64 `struct timeval` 布局一致（SO_RCVTIMEO 用）。
struct UpTimeval {
    tv_sec: i64,
    tv_usec: i64,
}

/// 把 s 追加到 out[at[0]..cap)，成功返回 true。
fn up_put(out: &byte, cap: usize, at: &usize, s: &[byte]) bool {
    var i: usize = 0;
    while i < s.len {
        if at[0] + i >= cap {
            return false;
        }
        out[at[0] + i] = s[i];
        i = i + 1;
    }
    at[0] = at[0] + i;
    return true;
}

fn up_send_all(fd: i32, data: &[byte]) bool {
    var off: usize = 0;
    while off < data.len {
        const r: !isize = sys_write(fd, &data.ptr[off], data.len - off);
        const n: isize = r catch |_| {
            return false;
        };
        if n <= 0 {
            return false;
        }
        off = off +% (n as usize);
    }
    return true;
}

fn up_find(hay: &[byte], needle: &[byte], from: usize) usize {
    if needle.len == 0 || hay.len < needle.len {
        return hay.len;
    }
    var i: usize = from;
    while i + needle.len <= hay.len {
        var j: usize = 0;
        var same: bool = true;
        while j < needle.len {
            if hay[i + j] != needle[j] {
                same = false;
                break;
            }
            j = j + 1;
        }
        if same {
            return i;
        }
        i = i + 1;
    }
    return hay.len;
}

/// 发一个请求并读完整响应；返回 HTTP 状态码，响应体拷到 out。
export fn uplink_request(ip: &[byte], port: u16, method: &[byte], path: &[byte],
    body: &[byte], timeout_ms: u32, out: &byte, cap: usize, out_len: &usize) !i32 {
    out_len[0] = 0;
    if ip.len == 0 || port == 0 {
        return error.UplinkFailed;
    }
    // 同步阻塞建连：事件循环里不能用 tcpx_connect_v4（其 block_on 只空转，
    // 等不到 connect 完成，会一直拿到 AsyncDeadlineExceeded）。
    const fd: i32 = sys_socket(2 as i32, 1 as i32, 6 as i32) catch {
        return error.UplinkFailed;
    };
    // ip 是点分文本（如 "127.0.0.1"），tcpx_sockaddr_v4 要的是 4 字节二进制。
    var b4: [byte: 4] = [0: 4];
    if !dnsx_parse_ipv4(ip, &b4[0]) {
        _ = sys_close(fd) catch {};
        return error.UplinkFailed;
    }
    var saddr: [byte: 16] = [0: 16];
    tcpx_sockaddr_v4(&b4[0], port, &saddr[0]);
    const cr: !i32 = sys_connect(fd, &saddr[0] as *void, 16 as u32);
    _ = cr catch |_| {
        _ = sys_close(fd) catch {};
        return error.UplinkFailed;
    };
    defer { tcpx_close(fd); }
    const fl: !i32 = sys_fcntl(fd, 3, 0);
    const flags: i32 = fl catch {
        0;
    };
    if flags != 0 {
        _ = sys_fcntl(fd, 4, flags & (0 -% 2049)) catch {};
    }
    var req: [byte: 4096] = [0: 4096];
    var rn: usize = 0;
    if !up_put(&req[0], 4096, &rn, method) {
        return error.UplinkFailed;
    }
    if !up_put(&req[0], 4096, &rn, &" "[0: 1]) {
        return error.UplinkFailed;
    }
    if !up_put(&req[0], 4096, &rn, path) {
        return error.UplinkFailed;
    }
    if !up_put(&req[0], 4096, &rn, &" HTTP/1.1\r\nHost: "[0: 17]) {
        return error.UplinkFailed;
    }
    if !up_put(&req[0], 4096, &rn, ip) {
        return error.UplinkFailed;
    }
    if !up_put(&req[0], 4096, &rn, &"\r\nContent-Type: application/json\r\nContent-Length: "[0: 50]) {
        return error.UplinkFailed;
    }
    var num: [byte: 24] = [0: 24];
    var nn: usize = 0;
    var v: u64 = body.len as u64;
    if v == 0 {
        num[0] = 48;
        nn = 1;
    } else {
        while v > 0 && nn < 24 {
            num[nn] = (48 +% (v % (10 as u64))) as byte;
            v = v / (10 as u64);
            nn = nn + 1;
        }
    }
    while nn > 0 {
        nn = nn - 1;
        var one: [byte: 1] = [0: 1];
        one[0] = num[nn];
        if !up_put(&req[0], 4096, &rn, one[0: 1]) {
            return error.UplinkFailed;
        }
    }
    if !up_put(&req[0], 4096, &rn, &"\r\nConnection: close\r\n\r\n"[0: 23]) {
        return error.UplinkFailed;
    }
    if body.len > 0 && !up_put(&req[0], 4096, &rn, body) {
        return error.UplinkFailed;
    }
    if !up_send_all(fd, req[0: rn]) {
        return error.UplinkFailed;
    }
    // 接收超时兜底（服务端未及时关连接时不至于永久阻塞）。
    var tv: UpTimeval = UpTimeval{ tv_sec: 2, tv_usec: 0 };
    _ = sys_setsockopt(fd, 1, 20, &tv as *void, 16) catch {};
    var resp: [byte: 16384] = [0: 16384];
    var got: usize = 0;
    var header_end: usize = 0;
    var cl: usize = 0;
    var have_cl: bool = false;
    while got < 16384 {
        const r: !isize = sys_read(fd, &resp[got], 16384 - got);
        const n: isize = r catch |_| {
            break;
        };
        if n <= 0 {
            break;
        }
        got = got +% (n as usize);
        if header_end == 0 {
            const he: usize = up_find(resp[0: got], &"\r\n\r\n"[0: 4], 0);
            if he < got {
                header_end = he + 4;
                const ci: usize = up_find(resp[0: he], &"Content-Length: "[0: 16], 0);
                if ci + 16 < he {
                    var cv: usize = 0;
                    var k: usize = ci + 16;
                    var dg: usize = 0;
                    while k < he && k < 16384 {
                        const c: byte = resp[k];
                        if c < ('0' as byte) || c > ('9' as byte) {
                            break;
                        }
                        cv = cv *% 10 +% ((c as usize) -% 48);
                        dg = dg + 1;
                        k = k + 1;
                    }
                    if dg > 0 {
                        cl = cv;
                        have_cl = true;
                    }
                }
            }
        }
        if header_end > 0 && have_cl && got >= header_end +% cl {
            break;
        }
    }
    if got == 0 {
        return error.UplinkFailed;
    }
    const all: &[byte] = resp[0: got];
    // 状态行 HTTP/1.1 200 OK
    const sp: usize = up_find(all, &" "[0: 1], 0);
    if sp >= all.len {
        return error.UplinkFailed;
    }
    var status: i32 = 0;
    var i: usize = sp + 1;
    var digits: usize = 0;
    while i < all.len {
        const c: byte = all[i];
        if c < ('0' as byte) || c > ('9' as byte) {
            break;
        }
        status = status *% 10 +% ((c as i32) -% 48);
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        return error.UplinkFailed;
    }
    const he: usize = up_find(all, &"\r\n\r\n"[0: 4], 0);
    var bs: usize = 0;
    if he < all.len {
        bs = he + 4;
    }
    var w: usize = 0;
    while bs + w < all.len && w < cap {
        out[w] = all[bs + w];
        w = w + 1;
    }
    out_len[0] = w;
    return status;
}

// ---------------------------------------------------------------
// B4：到节点的 SSE 流式读取（chunked / Content-Length 增量解码）
// ---------------------------------------------------------------

/// 一条流式上游连接。`state`：0=读 chunk 大小行，1=读数据，2=吃数据后的 CRLF。
export struct UpStream {
    fd: i32,
    status: i32,
    chunked: bool,
    rem: i64,
    chunk_left: usize,
    state: i32,
    done: bool,
    buf: [byte: 1024],
    buf_len: usize,
    buf_pos: usize,
}

fn ups_fill(s: &UpStream) bool {
    if s.buf_pos < s.buf_len {
        return true;
    }
    s.buf_pos = 0;
    s.buf_len = 0;
    const r: !isize = sys_read(s.fd, &s.buf[0], 1024);
    const n: isize = r catch {
        return false;
    };
    if n <= 0 {
        return false;
    }
    s.buf_len = n as usize;
    return true;
}

fn ups_byte(s: &UpStream, out: &byte) bool {
    if !ups_fill(s) {
        return false;
    }
    if s.buf_pos >= 1024 {
        return false;
    }
    out[0] = s.buf[s.buf_pos];
    s.buf_pos = s.buf_pos + 1;
    return true;
}

/// 从内部缓冲取最多 cap 字节；返回 0 表示连接结束。
fn ups_take(s: &UpStream, out: &byte, cap: usize) usize {
    if !ups_fill(s) {
        return 0;
    }
    var avail: usize = s.buf_len - s.buf_pos;
    var want: usize = cap;
    if want > avail {
        want = avail;
    }
    var i: usize = 0;
    var k: usize = s.buf_pos;
    while i < want && k < 1024 {
        out[i] = s.buf[k];
        i = i + 1;
        k = k + 1;
    }
    s.buf_pos = k;
    return i;
}

/// 读一行 chunk 大小（十六进制），跳过 CR；返回 0 表示空行/非法/EOF。
fn ups_size_line(s: &UpStream, out: &byte, cap: usize) usize {
    var n: usize = 0;
    while n < cap {
        var b: byte = 0;
        if !ups_byte(s, &b) {
            return 0;
        }
        if b == (13 as byte) {
            continue;
        }
        if b == (10 as byte) {
            return n;
        }
        var hex: bool = false;
        if b >= ('0' as byte) && b <= ('9' as byte) {
            hex = true;
        } else if b >= ('a' as byte) && b <= ('f' as byte) {
            hex = true;
        } else if b >= ('A' as byte) && b <= ('F' as byte) {
            hex = true;
        }
        if !hex {
            return 0;
        }
        out[n] = b;
        n = n + 1;
    }
    return 0;
}

/// 打开到节点的流式 GET：读并解析响应头，余下的 body 字节留在内部缓冲。
export fn uplink_stream_begin(ip: &[byte], port: u16, path: &[byte],
    timeout_ms: u32, s: &UpStream) !void {
    s.fd = 0 - 1;
    s.status = 0;
    s.chunked = false;
    s.rem = 0 - 1;
    s.chunk_left = 0;
    s.state = 0;
    s.done = false;
    s.buf_len = 0;
    s.buf_pos = 0;
    if ip.len == 0 || port == 0 {
        return error.UplinkFailed;
    }
    const fd: i32 = sys_socket(2 as i32, 1 as i32, 6 as i32) catch {
        return error.UplinkFailed;
    };
    var b4: [byte: 4] = [0: 4];
    if !dnsx_parse_ipv4(ip, &b4[0]) {
        _ = sys_close(fd) catch {};
        return error.UplinkFailed;
    }
    var saddr: [byte: 16] = [0: 16];
    tcpx_sockaddr_v4(&b4[0], port, &saddr[0]);
    const cr: !i32 = sys_connect(fd, &saddr[0] as *void, 16 as u32);
    _ = cr catch |_| {
        _ = sys_close(fd) catch {};
        return error.UplinkFailed;
    };
    var tv: UpTimeval = UpTimeval{
        tv_sec: (timeout_ms / 1000) as i64,
        tv_usec: ((timeout_ms % 1000) * 1000) as i64,
    };
    _ = sys_setsockopt(fd, 1, 20, &tv as *void, 16) catch {};
    var req: [byte: 512] = [0: 512];
    var rn: usize = 0;
    if !up_put(&req[0], 512, &rn, &"GET "[0: 4])
        || !up_put(&req[0], 512, &rn, path)
        || !up_put(&req[0], 512, &rn, &" HTTP/1.1\r\nHost: "[0: 17])
        || !up_put(&req[0], 512, &rn, ip)
        || !up_put(&req[0], 512, &rn, &"\r\nAccept: text/event-stream\r\nConnection: close\r\n\r\n"[0: 50]) {
        _ = sys_close(fd) catch {};
        return error.UplinkFailed;
    }
    if !up_send_all(fd, req[0: rn]) {
        _ = sys_close(fd) catch {};
        return error.UplinkFailed;
    }
    var hdr: [byte: 4096] = [0: 4096];
    var got: usize = 0;
    var hend: usize = 0;
    var scanning: bool = true;
    while scanning && got < 4096 {
        const r: !isize = sys_read(fd, &hdr[got], 4096 - got);
        var n: isize = 0;
        var bad: bool = false;
        n = r catch |_| {
            bad = true;
            0 as isize;
        };
        if bad || n <= 0 {
            break;
        }
        got = got +% (n as usize);
        hend = up_find(hdr[0: got], &"\r\n\r\n"[0: 4], 0);
        if hend < got {
            scanning = false;
        }
    }
    if got == 0 || hend >= got {
        _ = sys_close(fd) catch {};
        return error.UplinkFailed;
    }
    const all: &[byte] = hdr[0: got];
    const sp: usize = up_find(all, &" "[0: 1], 0);
    if sp >= all.len {
        _ = sys_close(fd) catch {};
        return error.UplinkFailed;
    }
    var status: i32 = 0;
    var i: usize = sp + 1;
    var digits: usize = 0;
    while i < all.len {
        const c: byte = all[i];
        if c < ('0' as byte) || c > ('9' as byte) {
            break;
        }
        status = status *% 10 +% ((c as i32) -% 48);
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        _ = sys_close(fd) catch {};
        return error.UplinkFailed;
    }
    s.status = status;
    const hpart: &[byte] = all[0: hend];
    if up_find(hpart, &"Transfer-Encoding: chunked"[0: 25], 0) < hpart.len {
        s.chunked = true;
    } else {
        const ci: usize = up_find(hpart, &"Content-Length: "[0: 16], 0);
        if ci + 16 < hpart.len {
            var cv: i64 = 0;
            var k: usize = ci + 16;
            var dg: usize = 0;
            while k < hpart.len {
                const c: byte = hpart[k];
                if c < ('0' as byte) || c > ('9' as byte) {
                    break;
                }
                cv = cv *% 10 +% ((c as i64) -% 48);
                dg = dg + 1;
                k = k + 1;
            }
            if dg > 0 {
                s.rem = cv;
            }
        }
    }
    const bs: usize = hend + 4;
    var w: usize = 0;
    while bs + w < all.len && w < 1024 {
        s.buf[w] = all[bs + w];
        w = w + 1;
    }
    s.buf_len = w;
    s.buf_pos = 0;
    s.fd = fd;
    return;
}

/// 读一段解码后的 body 字节；0 = 流结束（EOF / 最后一块）。
export fn uplink_stream_read(s: &UpStream, out: &byte, cap: usize) !usize {
    if s.fd < 0 || s.done || cap == 0 {
        return 0 as usize;
    }
    if !s.chunked {
        if s.rem == 0 {
            s.done = true;
            return 0 as usize;
        }
        var want: usize = cap;
        if s.rem > 0 && (s.rem as usize) < want {
            want = s.rem as usize;
        }
        const n: usize = ups_take(s, out, want);
        if n == 0 {
            s.done = true;
            return 0 as usize;
        }
        if s.rem > 0 {
            s.rem = s.rem -% (n as i64);
        }
        return n;
    }
    var guard: i32 = 0;
    while guard < 16 {
        guard = guard +% 1;
        if s.state == 1 {
            if s.chunk_left == 0 {
                s.state = 2;
                continue;
            }
            var want: usize = cap;
            if s.chunk_left < want {
                want = s.chunk_left;
            }
            const n: usize = ups_take(s, out, want);
            if n == 0 {
                s.done = true;
                return 0 as usize;
            }
            s.chunk_left = s.chunk_left -% n;
            return n;
        }
        if s.state == 2 {
            var c1: byte = 0;
            var c2: byte = 0;
            if !ups_byte(s, &c1) || !ups_byte(s, &c2) {
                s.done = true;
                return 0 as usize;
            }
            s.state = 0;
            continue;
        }
        var line: [byte: 32] = [0: 32];
        const ln: usize = ups_size_line(s, &line[0], 32);
        if ln == 0 {
            s.done = true;
            return 0 as usize;
        }
        var sz: usize = 0;
        var dg: usize = 0;
        var i: usize = 0;
        while i < ln {
            const c: byte = line[i];
            var dv: usize = 0;
            if c >= ('0' as byte) && c <= ('9' as byte) {
                dv = (c as usize) -% 48;
            } else if c >= ('a' as byte) && c <= ('f' as byte) {
                dv = (c as usize) -% 87;
            } else if c >= ('A' as byte) && c <= ('F' as byte) {
                dv = (c as usize) -% 55;
            } else {
                s.done = true;
                return 0 as usize;
            }
            sz = sz *% 16 +% dv;
            dg = dg + 1;
            i = i + 1;
        }
        if dg == 0 || sz == 0 {
            s.done = true;
            return 0 as usize;
        }
        s.chunk_left = sz;
        s.state = 1;
    }
    s.done = true;
    return 0 as usize;
}

/// 关掉流式连接。
export fn uplink_stream_close(s: &UpStream) void {
    if s.fd >= 0 {
        _ = sys_close(s.fd) catch {};
        s.fd = 0 - 1;
    }
}

/// POST /controller/register。
export fn uplink_register(ip: &[byte], port: u16, node_id: &[byte], role: &[byte],
    addr: &[byte], timeout_ms: u32) !i32 {
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"id"[0: 2]);
    jsonw_str(&w, node_id);
    jsonw_key(&w, &"role"[0: 4]);
    jsonw_str(&w, role);
    jsonw_key(&w, &"addr"[0: 4]);
    jsonw_str(&w, addr);
    jsonw_end_obj(&w);
    var out: [byte: 1024] = [0: 1024];
    var on: usize = 0;
    return uplink_request(ip, port, &"POST"[0: 4], &"/controller/register"[0: 20],
        jsonw_span(&w), timeout_ms, &out[0], 1024, &on);
}

/// GET /controller/config?node=<id>：拉 config 快照（版本 + epoch + 归属）。
export fn uplink_config_node(ip: &[byte], port: u16, node_id: &[byte],
    out: &byte, cap: usize, out_len: &usize, timeout_ms: u32) !i32 {
    var path: [byte: 96] = [0: 96];
    var pn: usize = 0;
    const pre: &[byte] = &"/controller/config?node="[0: 24];
    var i: usize = 0;
    while i < pre.len && pn < 96 {
        path[pn] = pre[i];
        pn = pn + 1;
        i = i + 1;
    }
    i = 0;
    while i < node_id.len && pn < 96 {
        path[pn] = node_id[i];
        pn = pn + 1;
        i = i + 1;
    }
    return uplink_request(ip, port, &"GET"[0: 3], path[0: pn],
        &""[0: 0], timeout_ms, out, cap, out_len);
}

/// POST /controller/ingest（node 重放 spool/journal 用）。
export fn uplink_inject(ip: &[byte], port: u16, node_id: &[byte],
    body: &[byte], body_len: usize, out: &byte, cap: usize, out_len: &usize,
    timeout_ms: u32) !i32 {
    var path: [byte: 96] = [0: 96];
    var pn: usize = 0;
    const pre: &[byte] = &"/controller/ingest?node="[0: 24];
    var i: usize = 0;
    while i < pre.len && pn < 96 {
        path[pn] = pre[i];
        pn = pn + 1;
        i = i + 1;
    }
    i = 0;
    while i < node_id.len && pn < 96 {
        path[pn] = node_id[i];
        pn = pn + 1;
        i = i + 1;
    }
    return uplink_request(ip, port, &"POST"[0: 4], path[0: pn],
        body[0: body_len], timeout_ms, out, cap, out_len);
}

/// POST /controller/heartbeat。
export fn uplink_heartbeat(ip: &[byte], port: u16, node_id: &[byte],
    journal_day: i64, entries: i64, timeout_ms: u32) !i32 {
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"id"[0: 2]);
    jsonw_str(&w, node_id);
    jsonw_key(&w, &"journal_day"[0: 11]);
    jsonw_i64(&w, journal_day);
    jsonw_key(&w, &"entries"[0: 7]);
    jsonw_i64(&w, entries);
    jsonw_end_obj(&w);
    var out: [byte: 1024] = [0: 1024];
    var on: usize = 0;
    return uplink_request(ip, port, &"POST"[0: 4], &"/controller/heartbeat"[0: 21],
        jsonw_span(&w), timeout_ms, &out[0], 1024, &on);
}

/// GET /controller/config，返回状态码，响应体写 out。
export fn uplink_config(ip: &[byte], port: u16, timeout_ms: u32,
    out: &byte, cap: usize, out_len: &usize) !i32 {
    return uplink_request(ip, port, &"GET"[0: 3], &"/controller/config"[0: 18],
        &""[0: 0], timeout_ms, out, cap, out_len);
}

// src/app.uya — aigw 入口：命令行分发（`serve` 与 `tls` 两个子命令）
//
// 用法：
//   aigw serve [--host 0.0.0.0] [--port 8080] [--db data/aigw.db] [--data-dir data]
//              [--max-body <bytes>] [--ca <pem>] [--admin-key <key>] ...
//   aigw tls probe <host> [--port N] [--ca <pem>]
//   aigw tls pin   <host> <sha256hex> [--file <tsv>]

use std.runtime.get_argv;
use libc.string;

fn arg_eq(p: &byte, lit: &byte) bool {
    return strcmp(p as *const byte, lit as *const byte) == 0;
}

fn arg_len(p: &byte) usize {
    return strlen(p as *const byte);
}

fn arg_u16(p: &byte) u16 {
    const v: i32 = atoi(p);
    if v <= 0 {
        return 0;
    }
    if v > 65535 {
        return 65535;
    }
    return v as u16;
}

// ---- D7：邮件（OTP 投递）开关的暂存区 ----
// 放全局 + 独立解析函数：`main()` 里多塞 7 个定长缓冲会让类型检查踩到编译器的一条
// 调试分支（DEBUG_BYTE_PTR_SUBSCRIPT_ERROR，和栈帧布局有关），挪出来最省事。
var g_ma: MailArgs = MailArgs{};

/// 把 argv[k] 的值拷进对应的暂存区（which 见调用点）。
fn mail_arg_set(which: i32, k: i32) void {
    const v: &byte = get_argv(k);
    const vn: usize = arg_len(v);
    var c: usize = 0;
    if which == 0 {
        while c < vn && c < MAIL_URL_MAX {
            g_ma.url[c] = v[c];
            c = c + 1;
        }
        g_ma.url_len = c;
    } else if which == 1 {
        while c < vn && c < SMTP_USER_MAX {
            g_ma.user[c] = v[c];
            c = c + 1;
        }
        g_ma.user_len = c;
    } else if which == 2 {
        while c < vn && c < SMTP_PASS_MAX {
            g_ma.pass[c] = v[c];
            c = c + 1;
        }
        g_ma.pass_len = c;
    } else if which == 3 {
        while c < vn && c < MAIL_FROM_MAX {
            g_ma.from[c] = v[c];
            c = c + 1;
        }
        g_ma.from_len = c;
    } else if which == 4 {
        while c < vn && c < SMTP_EHLO_MAX {
            g_ma.hostname[c] = v[c];
            c = c + 1;
        }
        g_ma.hostname_len = c;
    } else if which == 5 {
        while c < vn && c < MAIL_CA_MAX {
            g_ma.ca[c] = v[c];
            c = c + 1;
        }
        g_ma.ca_len = c;
    } else if which == 6 {
        while c < vn && c < MAIL_CMD_MAX {
            g_ma.cmd[c] = v[c];
            c = c + 1;
        }
        g_ma.cmd_len = c;
    }
}

/// 单独扫一遍 argv 取邮件开关（值缺失的交给 mailer_init 读环境变量）。
fn mail_args_scan(argc: i32) void {
    var k: i32 = 2;
    while k + 1 < argc {
        const f: &byte = get_argv(k);
        if arg_eq(f, "--smtp" as &const byte) {
            mail_arg_set(0, k + 1);
        } else if arg_eq(f, "--smtp-user" as &const byte) {
            mail_arg_set(1, k + 1);
        } else if arg_eq(f, "--smtp-pass" as &const byte) {
            mail_arg_set(2, k + 1);
        } else if arg_eq(f, "--mail-from" as &const byte) {
            mail_arg_set(3, k + 1);
        } else if arg_eq(f, "--mail-hostname" as &const byte) {
            mail_arg_set(4, k + 1);
        } else if arg_eq(f, "--mail-ca" as &const byte) {
            mail_arg_set(5, k + 1);
        } else if arg_eq(f, "--mail-relay-cmd" as &const byte) {
            mail_arg_set(6, k + 1);
        }
        // 逐个 token 扫（不是两两配对）：`--dev-otp` 这类无值开关会把配对错位。
        k = k + 1;
    }
}

fn usage() i32 {
    printf("usage:\n  aigw serve [--host 0.0.0.0] [--port 8080] [--db data/aigw.db] [--data-dir data] [--ca <pem>] [--proxy http://host:port] [--no-proxy a,b] [--max-body <bytes>] [--plugin-cmd \"cmd args\"]\n             [--smtp smtp://host[:port]|smtps://host] [--smtp-user u] [--smtp-pass p] [--mail-from a@b] [--mail-ca <pem>]\n  aigw tls probe <host> [--port N] [--ca <pem>]\n  aigw tls pin <host> <sha256hex> [--file <tsv>]\n  aigw smtp-relay          # 内部用法（mailer 子进程：stdin 读作业 JSON）\n" as *byte);
    return 2;
}

/// `aigw serve`：打开数据库（迁移 + journal 重放 + 每日备份）、起服务、跑单线程 epoll。
/// `--port 0` 让内核挑端口（回归脚本靠这条读取真实端口）。
fn serve_main(host: &[byte], port: u16, db_path: &[byte], data_dir: &[byte],
    ca_path: &[byte], dev_otp: bool, admin_key: &[byte], meta_path: &[byte],
    node_id: &[byte], uplink: &[byte], proxy: &[byte], no_proxy: &[byte],
    plugin_cmd: &[byte]) i32 {
    // B5：controller 先打开 usage 分片，runtime 的 journal 重放与 ingest 才能按 user_id 路由。
    if meta_path.len > 0 {
        shard_begin(data_dir) catch {
            printf("shard init failed\n" as *byte);
            return 1;
        };
    }
    runtime_setup(db_path, data_dir) catch |_| {
        printf("runtime init failed\n" as *byte);
        return 1;
    };
    defer { runtime_shutdown(); }
    defer { shard_end(); }
    // A4：结算先入队，事件循环按 200ms/512 行批量落库
    {
        var bdir: [byte: 256] = [0: 256];
        const bn: usize = runtime_dir_copy(&bdir[0], 256);
        batch_configure(runtime_db(), bdir[0: bn], srv_now_ms());
    }
    g_dev_otp = dev_otp;
    srv_admin_set(admin_key);
    srv_meta_setup(meta_path, node_id);
    srv_uplink_setup(uplink);
    htc_ctx_init(&g_up_ctx, TLSX_MODE_CHAIN);
    g_up_ctx.allow_private = true;
    // D4：出站代理。环境变量（HTTPS_PROXY/NO_PROXY）打底，`--proxy/--no-proxy` 覆盖。
    _ = htc_proxy_load_env(&g_up_ctx);
    if proxy.len > 0 {
        if !htc_proxy_set(&g_up_ctx, proxy.ptr, proxy.len, no_proxy.ptr, no_proxy.len) {
            printf("invalid --proxy (only http://host:port)\n" as *byte);
            return 1;
        }
    }
    if ca_path.len > 0 {
        _ = srv_load_ca(ca_path);
    }
    // D5：stdio 插件池（`--plugin-cmd` 或 AIGW_PLUGIN_CMD；不配则只能用 kind=http）
    if plugin_cmd.len > 0 {
        plugin_pool_init(plugin_cmd, 1, 4, 60000, 500) catch {
            printf("plugin pool init failed\n" as *byte);
            return 1;
        };
    }
    const lfd: i32 = serve_listen(host, port) catch |_| {
        printf("listen failed\n" as *byte);
        return 1;
    };
    const lport: u16 = serve_port(lfd);
    srv_addr_set(host, lport);
    printf("listen port=%d\n" as *byte, lport as i32);
    var stats: ServeStats = ServeStats{};
    // serve_run 自己负责关闭 lfd（停机时先摘监听再关）
    const r: i32 = serve_run(lfd, &stats) catch |_| {
        1;
    };
    // 停机前把队列里剩下的账落下去；失败交给下次启动的 journal 重放兜底。
    _ = batch_flush() catch {
        0 as usize;
    };
    if plugin_pool_ready() {
        plugin_pool_shutdown();
    }
    return r;
}

export fn main() i32 {
    var argc: i32 = 0;
    var i: i32 = 0;
    while i < 32 {
        const p: &byte = get_argv(i);
        if (p as usize) == 0 {
            break;
        }
        argc = argc + 1;
        i = i + 1;
    }
    if argc < 2 {
        return usage();
    }
    const a1: &byte = get_argv(1);

    // ---- serve ----
    if arg_eq(a1, "serve" as &const byte) {
        var host: [byte: 16] = [0: 16];
        host[0] = '0';
        host[1] = '.';
        host[2] = '0';
        host[3] = '.';
        host[4] = '0';
        host[5] = '.';
        host[6] = '0';
        var host_len: usize = 7;
        var dbf: [byte: 512] = [0: 512];
        dbf[0] = 'd';
        dbf[1] = 'a';
        dbf[2] = 't';
        dbf[3] = 'a';
        dbf[4] = '/';
        dbf[5] = 'a';
        dbf[6] = 'i';
        dbf[7] = 'g';
        dbf[8] = 'w';
        dbf[9] = '.';
        dbf[10] = 'd';
        dbf[11] = 'b';
        var dblen: usize = 12;
        var ca: [byte: 512] = [0: 512];
        var calen: usize = 0;
        var adm: [byte: 128] = [0: 128];
        var admlen: usize = 0;
        var meta: [byte: 512] = [0: 512];
        var metalen: usize = 0;
        var nid: [byte: 64] = [0: 64];
        var nidlen: usize = 0;
        var upl: [byte: 80] = [0: 80];
        var upllen: usize = 0;
        var prx: [byte: 512] = [0: 512];
        var prxlen: usize = 0;
        var npx: [byte: 512] = [0: 512];
        var npxlen: usize = 0;
        var plg: [byte: 512] = [0: 512];
        var plglen: usize = 0;
        var dat: [byte: 512] = [0: 512];
        dat[0] = 'd';
        dat[1] = 'a';
        dat[2] = 't';
        dat[3] = 'a';
        var datlen: usize = 4;
        var port: u16 = 8080;
        var dev_otp: bool = false;
        var k: i32 = 2;
        while k < argc {
            const f: &byte = get_argv(k);
            if arg_eq(f, "--dev-otp" as &const byte) {
                dev_otp = true;
                k = k + 1;
                continue;
            }
            if k + 1 >= argc {
                break;
            }
            const v: &byte = get_argv(k + 1);
            if arg_eq(f, "--port" as &const byte) {
                port = arg_u16(v);
            } else if arg_eq(f, "--host" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 16 {
                    host[m] = v[m];
                    m = m + 1;
                }
                host_len = m;
            } else if arg_eq(f, "--meta" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 512 {
                    meta[m] = v[m];
                    m = m + 1;
                }
                metalen = m;
            } else if arg_eq(f, "--uplink" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 80 {
                    upl[m] = v[m];
                    m = m + 1;
                }
                upllen = m;
            } else if arg_eq(f, "--node-id" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 64 {
                    nid[m] = v[m];
                    m = m + 1;
                }
                nidlen = m;
            } else if arg_eq(f, "--admin-key" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 128 {
                    adm[m] = v[m];
                    m = m + 1;
                }
                admlen = m;
            } else if arg_eq(f, "--ca" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 512 {
                    ca[m] = v[m];
                    m = m + 1;
                }
                calen = m;
            } else if arg_eq(f, "--db" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 512 {
                    dbf[m] = v[m];
                    m = m + 1;
                }
                dblen = m;
            } else if arg_eq(f, "--data-dir" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 512 {
                    dat[m] = v[m];
                    m = m + 1;
                }
                datlen = m;
            } else if arg_eq(f, "--proxy" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 512 {
                    prx[m] = v[m];
                    m = m + 1;
                }
                prxlen = m;
            } else if arg_eq(f, "--plugin-cmd" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 512 {
                    plg[m] = v[m];
                    m = m + 1;
                }
                plglen = m;
            } else if arg_eq(f, "--no-proxy" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 512 {
                    npx[m] = v[m];
                    m = m + 1;
                }
                npxlen = m;
            } else if arg_eq(f, "--max-body" as &const byte) {
                // 请求体上限（字节），同时同步 serve 抓包上限与 chat 重写上限。
                srv_body_max_set_arg(v);
            }
            k = k + 2;
        }
        if plglen == 0 {
            // 没给开关就看环境变量（容器/编排里更好传）
            const ev: &byte = getenv(&"AIGW_PLUGIN_CMD"[0] as &const byte);
            if (ev as usize) != 0 {
                var m: usize = 0;
                while ev[m] != (0 as byte) && m < 512 {
                    plg[m] = ev[m];
                    m = m + 1;
                }
                plglen = m;
            }
        }
        // D7：邮件（OTP 投递）开关单独扫一遍；URL/发信人非法就让启动失败，
        // 别带着坏配置跑起来再在登录时莫名其妙失败。
        mail_args_scan(argc);
        mailer_init(g_ma) catch {
            printf("invalid smtp config (--smtp expects smtp://host[:port] or smtps://host; --mail-from needs an address)\n" as *byte);
            return 1;
        };
        return serve_main(host[0: host_len], port, dbf[0: dblen], dat[0: datlen],
            ca[0: calen], dev_otp, adm[0: admlen], meta[0: metalen], nid[0: nidlen],
            upl[0: upllen], prx[0: prxlen], npx[0: npxlen], plg[0: plglen]);
    }

    // ---- smtp-relay：mailer fork 出来的子进程，从 stdin 读一条作业 JSON，阻塞发信 ----
    if arg_eq(a1, "smtp-relay" as &const byte) {
        return mailer_relay_main();
    }

    if argc < 4 {
        return usage();
    }
    const a2: &byte = get_argv(2);
    if !arg_eq(a1, "tls" as &const byte) {
        return usage();
    }
    const hostp: &byte = get_argv(3);
    const host_len: usize = arg_len(hostp);

    // ---- tls probe ----
    if arg_eq(a2, "probe" as &const byte) {
        var port: u16 = 443;
        var ca: [byte: 512] = [0: 512];
        var ca_len: usize = 0;
        var k: i32 = 4;
        while k + 1 < argc {
            const f: &byte = get_argv(k);
            const v: &byte = get_argv(k + 1);
            if arg_eq(f, "--port" as &const byte) {
                port = arg_u16(v);
            } else if arg_eq(f, "--ca" as &const byte) {
                const vn: usize = arg_len(v);
                var m: usize = 0;
                while m < vn && m < 512 {
                    ca[m] = v[m];
                    m = m + 1;
                }
                ca_len = m;
            }
            k = k + 2;
        }
        return tls_cmd_probe(hostp[0: host_len], port, ca[0: ca_len]);
    }

    // ---- tls pin ----
    if arg_eq(a2, "pin" as &const byte) {
        if argc < 5 {
            return usage();
        }
        const fpp: &byte = get_argv(4);
        var file: [byte: 512] = [0: 512];
        const dflt: &const byte = "data/tls_pins.tsv" as &const byte;
        var file_len: usize = arg_len(dflt as &byte);
        var m: usize = 0;
        while m < file_len && m < 512 {
            file[m] = dflt[m];
            m = m + 1;
        }
        var k: i32 = 5;
        while k + 1 < argc {
            const f: &byte = get_argv(k);
            const v: &byte = get_argv(k + 1);
            if arg_eq(f, "--file" as &const byte) {
                const vn: usize = arg_len(v);
                var q: usize = 0;
                while q < vn && q < 512 {
                    file[q] = v[q];
                    q = q + 1;
                }
                file_len = q;
            }
            k = k + 2;
        }
        return tls_cmd_pin(file[0: file_len], hostp[0: host_len], fpp[0: arg_len(fpp)]);
    }
    return usage();
}

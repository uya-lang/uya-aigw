// src/net/tlsx_conn.uya — TLS 连接：异步握手、指纹、链校验、四档信任、读写
//
// 依赖合并命名空间里的：
//   - tls/https + tls/ssl/*：异步握手与 record 读写；
//   - tlsx：指纹、pin、TOFU（多证书）；
//   - chainx：完整链校验；
//   - x509min：叶子解析与 SAN 主机名匹配。
//
// 信任判定（fail-closed）：
//   - 所有模式（除 none）先做 SAN 主机名匹配；
//   - chain：chainx 返回 CC_OK 才通过；
//   - pin：指纹在配置列表里才通过；
//   - tofu：已知指纹直接通过；同 host 新指纹只有 chainx 通过才追加；首用按 TOFU 记录；
//   - none：显式跳过（仅测试/排障）。

use libc.heap;
use libc.syscall;
use tls.https;
use tls.ssl.context;
use tls.ssl.handshake;
use tls.ssl.record;
use std.async;

export error TlsxHandshakeFailed;
export error TlsxNoLeaf;
export error TlsxBadCert;
export error TlsxHostMismatch;
export error TlsxChainFailed;
export error TlsxNoMemory;

export struct TlsxConn {
    fd: i32,
    hs: &HandshakeCtx,
    rec: &RecordCtx,
    ctx: &SslContext,
    fingerprint: [byte: 64],
    fingerprint_ok: bool,
    verified: bool,
}

export fn tlsx_conn_empty() TlsxConn {
    var c: TlsxConn = TlsxConn{};
    c.fd = -1;
    return c;
}

fn tlsx_conn_drop_ctx(c: &TlsxConn) void {
    if (c.ctx as usize) != 0 {
        free(c.ctx as &void);
        c.ctx = null as &SslContext;
    }
    if (c.hs as usize) != 0 {
        free(c.hs as &void);
        c.hs = null as &HandshakeCtx;
    }
    if (c.rec as usize) != 0 {
        free(c.rec as &void);
        c.rec = null as &RecordCtx;
    }
}

export fn tlsx_conn_free(c: &TlsxConn) void {
    tlsx_conn_drop_ctx(c);
    if c.fd >= 0 {
        _ = sys_close(c.fd) catch |_| { 0; };
        c.fd = -1;
    }
}

// ============================================================
// 可恢复握手（TLS-05A）
//
// https_handshake_async 每次 poll 重跑阻塞版握手（见 docs/design/tls-spike-findings.md），
// 不能用在非阻塞 fd 上。这里直接用 ssl_handshake_step 的状态机：
//   1) INIT -> ClientHello -> 写出；
//   2) 异步读完整 TLS record，累积到 ServerHelloDone（handshake type 14）；
//   3) step(flight) -> ClientFinished -> 写出；
//   4) 消费服务端 CCS + Finished（type 20/22），避免污染应用数据。
// ============================================================

const TLSX_HS_SEND_MAX: usize = 32768;
const TLSX_FLIGHT_MAX: usize = 65536;

@async_fn fn tlsx_read_exact_async(fd: i32, out: &byte, need: usize) Future<!bool> {
    var off: usize = 0;
    while off < need {
        const n: usize = try @await https_read_some_async(fd, &out[off], need - off);
        if n == 0 {
            return false;
        }
        off = off +% n;
    }
    return true;
}

/// 读一条完整 TLS record（5 字节头 + payload）。1=成功，0=连接关闭，-1=缓冲不够。
@async_fn fn tlsx_hs_read_record_async(fd: i32, rec: &byte, cap: usize,
    out_len: &usize) Future<!i32> {
    var hdr: [byte: 5] = [0: 5];
    const okh: bool = try @await tlsx_read_exact_async(fd, &hdr[0], 5);
    if !okh {
        return 0;
    }
    const len: usize = ((hdr[3] as usize) * 256) + (hdr[4] as usize);
    if (5 as usize) +% len > cap {
        return -1;
    }
    var i: usize = 0;
    while i < 5 {
        rec[i] = hdr[i];
        i = i + 1;
    }
    if len > 0 {
        const okp: bool = try @await tlsx_read_exact_async(fd, &rec[5], len);
        if !okp {
            return 0;
        }
    }
    out_len[0] = (5 as usize) +% len;
    return 1;
}

/// 扫描未加密的握手 flight，看到 ServerHelloDone（type 14）就说明第一条 flight 完整。
fn tlsx_flight_done(flight: &const byte, len: usize) bool {
    var p: usize = 0;
    while p +% 5 <= len {
        const rtype: byte = flight[p];
        const rlen: usize = ((flight[p + 3] as usize) * 256) + (flight[p + 4] as usize);
        if p +% 5 +% rlen > len {
            return false;
        }
        if rtype == (22 as byte) {
            var q: usize = p +% 5;
            const qend: usize = p +% 5 +% rlen;
            while q +% 4 <= qend {
                const mtype: byte = flight[q];
                const mlen: usize = ((flight[q + 1] as usize) * 65536)
                    + ((flight[q + 2] as usize) * 256) + (flight[q + 3] as usize);
                if q +% 4 +% mlen > qend {
                    break;
                }
                if mtype == (14 as byte) {
                    return true;
                }
                q = q +% 4 +% mlen;
            }
        }
        p = p +% 5 +% rlen;
    }
    return false;
}

@async_fn fn tlsx_handshake_async(fd: i32, ctx: &SslContext) Future<!i32> {
    var send: [byte: TLSX_HS_SEND_MAX] = [0: TLSX_HS_SEND_MAX];
    var empty: [byte: 1] = [0: 1];
    var slen: usize = 0;
    var st: i32 = ssl_handshake_step(ctx, &empty[0], 0, &send[0], TLSX_HS_SEND_MAX, &slen);
    if st == HS_STATUS_ERROR {
        return error.TlsxHandshakeFailed;
    }
    if slen > 0 {
        const w: usize = try @await https_write_all_async(fd, &send[0], slen);
        if w != slen {
            return error.TlsxHandshakeFailed;
        }
    }

    var flight: [byte: TLSX_FLIGHT_MAX] = [0: TLSX_FLIGHT_MAX];
    var flen: usize = 0;
    var got: bool = false;
    while flen < TLSX_FLIGHT_MAX {
        var rlen: usize = 0;
        const r: i32 = try @await tlsx_hs_read_record_async(fd, &flight[flen],
            TLSX_FLIGHT_MAX - flen, &rlen);
        if r != 1 {
            return error.TlsxHandshakeFailed;
        }
        flen = flen +% rlen;
        if tlsx_flight_done(&flight[0], flen) {
            got = true;
            break;
        }
    }
    if !got {
        return error.TlsxHandshakeFailed;
    }

    slen = 0;
    st = ssl_handshake_step(ctx, &flight[0], flen, &send[0], TLSX_HS_SEND_MAX, &slen);
    if st == HS_STATUS_ERROR {
        return error.TlsxHandshakeFailed;
    }
    if slen > 0 {
        const w2: usize = try @await https_write_all_async(fd, &send[0], slen);
        if w2 != slen {
            return error.TlsxHandshakeFailed;
        }
    }

    // 服务端第二 flight：CCS（明文）+ Finished（加密）。
    // Finished 必须经 record_decrypt 解一遍再丢弃，否则服务端方向的 read_seq 停在 0，
    // 之后的应用数据全部解不开（表现为 TLS record layer failure）。
    var ccs: [byte: 64] = [0: 64];
    var ccs_len: usize = 0;
    const cr: i32 = try @await tlsx_hs_read_record_async(fd, &ccs[0], 64, &ccs_len);
    if cr != 1 || ccs[0] != (20 as byte) {
        return error.TlsxHandshakeFailed;
    }
    var fin: [byte: 4096] = [0: 4096];
    var fin_len: usize = 0;
    const fr2: i32 = try @await tlsx_hs_read_record_async(fd, &fin[0], 4096, &fin_len);
    if fr2 != 1 {
        return error.TlsxHandshakeFailed;
    }
    // 把 CCS+Finished 拼回一条 flight，交给状态机的 WAIT_SERVER_FINISHED 分支解析。
    // 必须走状态机：Finished 是加密记录，只有 record_decrypt 才能把服务端方向的
    // read_seq 推到 1；自己解一遍再丢弃会让后续应用数据全部解不开。
    var second: [byte: 6144] = [0: 6144];
    var total: usize = 0;
    var i2: usize = 0;
    while i2 < ccs_len {
        second[i2] = ccs[i2];
        i2 = i2 + 1;
    }
    total = ccs_len;
    i2 = 0;
    while i2 < fin_len {
        second[total + i2] = fin[i2];
        i2 = i2 + 1;
    }
    total = total +% fin_len;
    ctx.hs.state = HS_STATE_WAIT_SERVER_FINISHED;
    var slen3: usize = 0;
    const st3: i32 = ssl_handshake_step(ctx, &second[0], total, &send[0],
        TLSX_HS_SEND_MAX, &slen3);
    if st3 == HS_STATUS_ERROR {
        return error.TlsxHandshakeFailed;
    }
    // 服务端方向的第一条加密记录是 Finished（seq 0），应用数据从 seq 1 开始。
    ctx.rec.read_seq = 1;
    ctx.rec.write_seq = 1;
    return 0;
}

/// 在已连通的 fd 上做 TLS 握手并完成信任判定。
/// 成功返回 0（conn.verified 表示是否真的校验过）；失败返回 error 并释放上下文。
export @async_fn fn tlsx_conn_open_async(fd: i32, host: &[byte], mode: u8,
    pins: &const byte, pin_count: usize, bundle: &const byte, bundle_len: usize,
    tofu: &TlsxPins, allow_tofu_learn: bool, now_ms: u64,
    conn: &TlsxConn) Future<!i32> {
    if fd < 0 || host.len == 0 {
        return error.TlsxBadCert;
    }
    conn.fd = fd;
    const hs: &HandshakeCtx = malloc(@size_of(HandshakeCtx)) as &HandshakeCtx;
    if (hs as usize) == 0 {
        return error.TlsxNoMemory;
    }
    hs[0] = HandshakeCtx{};
    const rec: &RecordCtx = malloc(@size_of(RecordCtx)) as &RecordCtx;
    if (rec as usize) == 0 {
        free(hs as &void);
        return error.TlsxNoMemory;
    }
    rec[0] = RecordCtx{};
    const ctx: &SslContext = malloc(@size_of(SslContext)) as &SslContext;
    if (ctx as usize) == 0 {
        free(hs as &void);
        free(rec as &void);
        return error.TlsxNoMemory;
    }
    ctx[0] = SslContext{ role: HS_ROLE_CLIENT, hs: hs, rec: rec };
    conn.hs = hs;
    conn.rec = rec;
    conn.ctx = ctx;
    ssl_init(ctx);
    ssl_set_insecure_skip_verify(ctx, true);
    ssl_set_skip_hostname_verify(ctx, true);
    ssl_set_hostname(ctx, &host[0], host.len);

    const hr: !i32 = @await tlsx_handshake_async(fd, ctx);
    _ = hr catch |_| {
        tlsx_conn_drop_ctx(conn);
        return error.TlsxHandshakeFailed;
    };

    const fl: usize = hs.server_flight_msg_len;
    if fl == 0 {
        tlsx_conn_drop_ctx(conn);
        return error.TlsxNoLeaf;
    }
    var fp: [byte: 64] = [0: 64];
    if !tlsx_leaf_fingerprint(&hs.server_flight_msg[0], fl, &fp[0]) {
        tlsx_conn_drop_ctx(conn);
        return error.TlsxNoLeaf;
    }
    var k: usize = 0;
    while k < 64 {
        conn.fingerprint[k] = fp[k];
        k = k + 1;
    }
    conn.fingerprint_ok = true;

    var off: usize = 0;
    var clen: usize = 0;
    if !cc_flight_cert(&hs.server_flight_msg[0], fl, 0, &off, &clen) {
        tlsx_conn_drop_ctx(conn);
        return error.TlsxNoLeaf;
    }
    var leaf: XmCert = xm_empty();
    if !xm_parse(&leaf, &hs.server_flight_msg[off], clen) {
        tlsx_conn_drop_ctx(conn);
        return error.TlsxBadCert;
    }
    if mode != TLSX_MODE_NONE && !xm_host_match(&leaf, &host[0], host.len) {
        tlsx_conn_drop_ctx(conn);
        return error.TlsxHostMismatch;
    }

    var chain_ok: bool = false;
    if mode == TLSX_MODE_CHAIN || mode == TLSX_MODE_TOFU {
        var res: i32 = 0;
        if bundle_len > 0 {
            res = chainx_verify_flight_bundle(&hs.server_flight_msg[0], fl,
                &host[0], host.len, bundle, bundle_len);
        } else {
            res = chainx_verify_flight_system(&hs.server_flight_msg[0], fl,
                &host[0], host.len);
        }
        chain_ok = res == CC_OK;
    }

    if mode == TLSX_MODE_NONE {
        conn.verified = false;
        return 0;
    }
    if mode == TLSX_MODE_PIN {
        if !tlsx_pin_match(&fp[0], pins, pin_count) {
            tlsx_conn_drop_ctx(conn);
            return error.TlsxPinMismatch;
        }
        conn.verified = true;
        return 0;
    }
    if mode == TLSX_MODE_CHAIN {
        if !chain_ok {
            tlsx_conn_drop_ctx(conn);
            return error.TlsxChainFailed;
        }
        conn.verified = true;
        return 0;
    }
    const d: i32 = tlsx_tofu_decide(tofu, host, &fp[0], chain_ok, allow_tofu_learn, now_ms);
    if d == TLSX_TOFU_MISMATCH {
        tlsx_conn_drop_ctx(conn);
        return error.TlsxTofuMismatch;
    }
    conn.verified = d == TLSX_TOFU_MATCH;
    return 0;
}

const TLSX_REC_MAX: usize = 17408;

/// 应用数据读：读一条完整 TLS record → record_decrypt → 明文。
export @async_fn fn tlsx_read_async(c: &TlsxConn, out: &byte, max: usize) Future<!usize> {
    var rec: [byte: TLSX_REC_MAX] = [0: TLSX_REC_MAX];
    while true {
        var rl: usize = 0;
        const r: i32 = try @await tlsx_hs_read_record_async(c.fd, &rec[0], TLSX_REC_MAX, &rl);
        if r != 1 {
            return 0 as usize;
        }
        const rtype: byte = rec[0];
        var plen: usize = 0;
        var cons: usize = 0;
        ssl_read(c.ctx, &rec[0], rl, out, max, &plen, &cons) catch |_| {
            return error.ConnectionClosed;
        };
        if rtype == (21 as byte) {
            return 0 as usize;      // alert：对端关闭
        }
        if rtype != (23 as byte) {
            continue;               // NewSessionTicket 等握手记录：解过（推进 seq）后丢弃
        }
        if plen > 0 {
            return plen;
        }
    }
}

const TLSX_POLL_SLICE_MS: i32 = 50;

/// 等 fd 可读，最多 `idle_ms`（0 = 不设超时）：1=可读，0=超时，-1=错误。
///
/// 做法照抄 uya-agent 的 `httpstream`（TUI 泵点那段）：**同步 `sys_poll` 切片**，
/// 每片 ≤50 ms，按累计时间判超时。为什么不用 `async_wait_readable`：
/// 它在外面再叠一层 Waker 注册，与本模块 record 读里的等待抢同一组 IO 槽
/// （`WAKER_IO_SLOT_MAX = 4`），实测流式首帧就返回 0（findings §9）。
@async_fn fn tlsx_wait_readable_idle_async(fd: i32, idle_ms: u64) Future<!i32> {
    var spent: u64 = 0;
    while true {
        var slice: i32 = TLSX_POLL_SLICE_MS;
        if idle_ms != 0 {
            if spent >= idle_ms {
                return 0;
            }
            const remain: u64 = idle_ms -% spent;
            if remain < (50 as u64) {
                slice = remain as i32;
                if slice <= 0 {
                    return 0;
                }
            }
        }
        var pfds: [PollFd: 1] = [PollFd{ fd: fd, events: POLLIN, revents: 0 }];
        const pr: i32 = sys_poll(&pfds[0], 1, slice) catch |_| {
            return -1;
        };
        if pr > 0 {
            return 1;
        }
        spent = spent +% (slice as u64);
    }
    return 0;
}

/// 在 idle_ms 内把 buf[0..need] 填满；超时/对端关闭返回 false。
@async_fn fn tlsx_fill_deadline_async(fd: i32, buf: &byte, need: usize,
    idle_ms: u64) Future<!bool> {
    var have: usize = 0;
    while have < need {
        const w: i32 = try @await tlsx_wait_readable_idle_async(fd, idle_ms);
        if w != 1 {
            return false;
        }
        while have < need {
            const rr: !usize = https_read_some(fd, &buf[have], need - have);
            const n: usize = rr catch |err| {
                if @error_id(err) == @error_id(error.ReadWouldBlock) {
                    break;                  // 假唤醒：回去再等一次
                }
                return false;
            };
            if n == 0 {
                return false;
            }
            have = have +% n;
        }
    }
    return true;
}

/// 带空闲超时的应用数据读（TLS-09E）。`idle_ms` 是**时长**（0 = 不设超时）。
/// 返回 0 表示「本轮结束」（超时、关闭、alert 都算）。
export @async_fn fn tlsx_read_deadline_async(c: &TlsxConn, out: &byte, max: usize,
    idle_ms: u64) Future<!usize> {
    if idle_ms == 0 {
        return try @await tlsx_read_async(c, out, max);
    }
    var rec: [byte: TLSX_REC_MAX] = [0: TLSX_REC_MAX];
    while true {
        const okh: bool = try @await tlsx_fill_deadline_async(c.fd, &rec[0], 5, idle_ms);
        if !okh {
            return 0 as usize;
        }
        const len: usize = ((rec[3] as usize) * 256) + (rec[4] as usize);
        if (5 as usize) +% len > TLSX_REC_MAX {
            return error.ConnectionClosed;
        }
        if len > 0 {
            const okp: bool = try @await tlsx_fill_deadline_async(c.fd, &rec[5], len, idle_ms);
            if !okp {
                return 0 as usize;
            }
        }
        const rl: usize = (5 as usize) +% len;
        const rtype: byte = rec[0];
        var plen: usize = 0;
        var cons: usize = 0;
        ssl_read(c.ctx, &rec[0], rl, out, max, &plen, &cons) catch |_| {
            return error.ConnectionClosed;
        };
        if rtype == (21 as byte) {
            return 0 as usize;              // alert
        }
        if rtype != (23 as byte) {
            continue;                       // NewSessionTicket 等：解过就丢
        }
        return plen;
    }
    return 0 as usize;
}

/// 应用数据写：record_encrypt → 写出密文（按 8 KiB 分片）。
export @async_fn fn tlsx_write_async(c: &TlsxConn, src: &const byte, n: usize) Future<!usize> {
    var cipher: [byte: TLSX_REC_MAX] = [0: TLSX_REC_MAX];
    var off: usize = 0;
    while off < n {
        var chunk: usize = n - off;
        if chunk > 8192 {
            chunk = 8192;
        }
        var clen: usize = 0;
        ssl_write(c.ctx, &src[off], chunk, &cipher[0], TLSX_REC_MAX, &clen) catch |_| {
            return error.ConnectionClosed;
        };
        const w: usize = try @await https_write_all_async(c.fd, &cipher[0], clen);
        if w != clen {
            return error.ConnectionClosed;
        }
        off = off +% chunk;
    }
    return n;
}

// ---------------------------------------------------------------
// A5：/v1/responses（previous_response_id + 非流式）
// ---------------------------------------------------------------

fn srv_responses(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var tok: [byte: 256] = [0: 256];
    const tn: usize = chat_bearer_span(&c.auth[0], c.auth_len, &tok[0], 256);
    if tn == 0 {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var key: StoreKey = StoreKey{ key_id: 0, user_id: 0, rpm: 0, tpm: 0 };
    // A4 快路径：同一 Key 的连续请求走单槽缓存（TTL 2s），省一次 DB 校验。
    store_verify_key_fast(runtime_db(), tok[0: tn], store_now(), &key) catch {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    };
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    const root: i32 = json_root(&d);
    var model: [byte: 128] = [0: 128];
    const mn: usize = json_str(&d, json_get(&d, root, &"model"[0: 5]), &model[0], 128);
    var input: [byte: RESP_INPUT_MAX] = [0: RESP_INPUT_MAX];
    const in_n: usize = json_str(&d, json_get(&d, root, &"input"[0: 5]), &input[0], RESP_INPUT_MAX);
    var prev: [byte: 64] = [0: 64];
    const pn: usize = json_str(&d, json_get(&d, root, &"previous_response_id"[0: 20]), &prev[0], 64);
    const stream: bool = json_bool(&d, json_get(&d, root, &"stream"[0: 6]));
    if mn == 0 || in_n == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    var r: RespRow = RespRow{};
    var prev_out: [byte: RESP_OUTPUT_MAX] = [0: RESP_OUTPUT_MAX];
    var prev_out_len: usize = 0;
    if pn > 0 {
        resp_get(runtime_db(), prev[0: pn], &r) catch {
            srv_static(c, 404, SRV_JSON_404, keep);
            return;
        };
        var i: usize = 0;
        while i < r.output_len && i < RESP_OUTPUT_MAX {
            prev_out[i] = r.output_text[i];
            i = i + 1;
        }
        prev_out_len = i;
    }
    var payload: [byte: 32768] = [0: 32768];
    const pln: usize = resp_build_chat(model[0: mn], prev_out[0: prev_out_len],
        input[0: in_n], stream, &payload[0], 32768);
    if pln == 0 {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    // A5：tools/tool_choice/reasoning 透传给上游（chat 路径原样转发，responses 需拼回）。
    var aug: [byte: 32768] = [0: 32768];
    const augn: usize = resp_augment_payload(payload[0: pln], c.body[0: c.body_len], &aug[0], 32768);
    var plan: ChatPlan = ChatPlan{};
    var use_payload: &[byte] = payload[0: pln];
    if augn > 0 {
        use_payload = aug[0: augn];
    }
    chat_prepare_session(runtime_db(), use_payload, tok[0: tn], store_now(), &plan) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    var cfg: HttppConfig = httpp_empty();
    if !upstream_config(&plan.host[0], plan.host_len, plan.port, plan.auth_type,
        &plan.secret[0], plan.secret_len, &cfg) {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    const nowu: u64 = now_ms() catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    var rid: [byte: 32] = [0: 32];
    var ridn: usize = 0;
    ridn = store_new_slug(&rid[0], 32) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    if plan.stream {
        srv_responses_stream(c, key.user_id, &plan, &cfg, rid[0: ridn],
            input[0: in_n], prev[0: pn]);
        return;
    }
    var resp: [byte: 8192] = [0: 8192];
    var st: i32 = 0;
    var rn: usize = 0;
    var failed: bool = false;
    upstream_post(&g_up_ctx, &cfg, plan.path[0: plan.path_len],
        plan.payload[0: plan.payload_len], nowu, nowu +% 60000,
        &resp[0], 8192, &st, &rn) catch {
        failed = true;
    };
    if failed {
        lb_report(plan.provider_id, false, store_now());
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    lb_report(plan.provider_id, true, store_now());
    if st != 200 {
        srv_static(c, st, resp[0: rn], keep);
        return;
    }
    var out_text: [byte: RESP_OUTPUT_MAX] = [0: RESP_OUTPUT_MAX];
    var usage: PriceUsage = PriceUsage{ input_tokens: 0, output_tokens: 0, cache_read_tokens: 0 };
    json_parse(&d, resp[0: rn]) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    const out_len: usize = resp_parse_output(&d, json_root(&d), &out_text[0], RESP_OUTPUT_MAX);
    const has_usage: bool = billing_usage_parse(&d, json_root(&d), &usage);
    var tcs: i32 = 0 - 1;
    var msg: i32 = 0 - 1;
    const ch0: i32 = json_arr_at(&d, json_get(&d, json_root(&d), &"choices"[0: 7]), 0);
    if ch0 >= 0 {
        msg = json_get(&d, ch0, &"message"[0: 7]);
    }
    if msg >= 0 {
        tcs = json_get(&d, msg, &"tool_calls"[0: 10]);
    }
    var tcn: usize = 0;
    if tcs >= 0 {
        tcn = json_arr_len(&d, tcs);
    }
    if (out_len == 0 && tcn == 0) || !has_usage {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    var settle: BillingResult = BillingResult{ cost_nano: 0, price_nano: 0, rate_version: 0, duplicate: false, found: false };
    billing_settle_deferred(rid[0: ridn], key.user_id, store_now(), 0,
        plan.model[0: plan.model_len], plan.provider_name[0: plan.provider_name_len],
        &usage, &settle) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    resp_store(runtime_db(), rid[0: ridn], key.user_id, store_now(), plan.model[0: plan.model_len],
        prev[0: pn], input[0: in_n], out_text[0: out_len], &"{}"[0: 2]) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"id"[0: 2]);
    jsonw_str(&w, rid[0: ridn]);
    jsonw_key(&w, &"object"[0: 6]);
    jsonw_str(&w, &"response"[0: 8]);
    jsonw_key(&w, &"created_at"[0: 10]);
    jsonw_i64(&w, store_now());
    jsonw_key(&w, &"model"[0: 5]);
    jsonw_str(&w, plan.model[0: plan.model_len]);
    jsonw_key(&w, &"previous_response_id"[0: 20]);
    jsonw_str(&w, prev[0: pn]);
    jsonw_key(&w, &"status"[0: 6]);
    jsonw_str(&w, &"completed"[0: 9]);
    jsonw_key(&w, &"output"[0: 6]);
    jsonw_arr(&w);
    if out_len > 0 || tcn == 0 {
        jsonw_obj(&w);
        jsonw_key(&w, &"type"[0: 4]);
        jsonw_str(&w, &"message"[0: 7]);
        jsonw_key(&w, &"role"[0: 4]);
        jsonw_str(&w, &"assistant"[0: 9]);
        jsonw_key(&w, &"content"[0: 7]);
        jsonw_arr(&w);
        jsonw_obj(&w);
        jsonw_key(&w, &"type"[0: 4]);
        jsonw_str(&w, &"output_text"[0: 11]);
        jsonw_key(&w, &"text"[0: 4]);
        jsonw_str(&w, out_text[0: out_len]);
        jsonw_end_obj(&w);
        jsonw_end_arr(&w);
        jsonw_end_obj(&w);
    }
    var ti: usize = 0;
    while ti < tcn {
        const tc: i32 = json_arr_at(&d, tcs, ti);
        var cid: [byte: 128] = [0: 128];
        const cn: usize = json_str(&d, json_get(&d, tc, &"id"[0: 2]), &cid[0], 128);
        var fname: [byte: 128] = [0: 128];
        var fargs: [byte: 2048] = [0: 2048];
        var fn_n: usize = 0;
        var fa_n: usize = 0;
        const fobj: i32 = json_get(&d, tc, &"function"[0: 8]);
        if fobj >= 0 {
            fn_n = json_str(&d, json_get(&d, fobj, &"name"[0: 4]), &fname[0], 128);
            fa_n = json_str(&d, json_get(&d, fobj, &"arguments"[0: 9]), &fargs[0], 2048);
        }
        jsonw_obj(&w);
        jsonw_key(&w, &"type"[0: 4]);
        jsonw_str(&w, &"function_call"[0: 13]);
        jsonw_key(&w, &"id"[0: 2]);
        jsonw_str(&w, cid[0: cn]);
        jsonw_key(&w, &"call_id"[0: 7]);
        jsonw_str(&w, cid[0: cn]);
        jsonw_key(&w, &"name"[0: 4]);
        jsonw_str(&w, fname[0: fn_n]);
        jsonw_key(&w, &"arguments"[0: 9]);
        jsonw_str(&w, fargs[0: fa_n]);
        jsonw_end_obj(&w);
        ti = ti + 1;
    }
    jsonw_end_arr(&w);
    jsonw_key(&w, &"usage"[0: 5]);
    jsonw_obj(&w);
    jsonw_key(&w, &"input_tokens"[0: 12]);
    jsonw_i64(&w, usage.input_tokens);
    jsonw_key(&w, &"output_tokens"[0: 13]);
    jsonw_i64(&w, usage.output_tokens);
    jsonw_key(&w, &"cost_nano"[0: 9]);
    jsonw_i64(&w, settle.cost_nano);
    jsonw_key(&w, &"price_nano"[0: 10]);
    jsonw_i64(&w, settle.price_nano);
    jsonw_end_obj(&w);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

// ---------------------------------------------------------------
// A7：MCP（JSON-RPC over HTTP POST /mcp，Bearer --admin-key）
// ---------------------------------------------------------------

fn srv_bytes_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn srv_mcp(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    const root: i32 = json_root(&d);
    const id: i64 = json_i64(&d, json_get(&d, root, &"id"[0: 2]));
    var method: [byte: 64] = [0: 64];
    const mn: usize = json_str(&d, json_get(&d, root, &"method"[0: 6]), &method[0], 64);
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"jsonrpc"[0: 7]);
    jsonw_str(&w, &"2.0"[0: 3]);
    jsonw_key(&w, &"id"[0: 2]);
    jsonw_i64(&w, id);
    if srv_bytes_eq(method[0: mn], &"initialize"[0: 10]) {
        jsonw_key(&w, &"result"[0: 6]);
        jsonw_obj(&w);
        jsonw_key(&w, &"protocolVersion"[0: 15]);
        jsonw_str(&w, &"2024-11-05"[0: 10]);
        jsonw_key(&w, &"capabilities"[0: 12]);
        jsonw_obj(&w);
        jsonw_key(&w, &"tools"[0: 5]);
        jsonw_obj(&w);
        jsonw_end_obj(&w);
        jsonw_end_obj(&w);
        jsonw_key(&w, &"serverInfo"[0: 10]);
        jsonw_obj(&w);
        jsonw_key(&w, &"name"[0: 4]);
        jsonw_str(&w, &"aigw"[0: 4]);
        jsonw_key(&w, &"version"[0: 7]);
        jsonw_str(&w, &"0.1"[0: 3]);
        jsonw_end_obj(&w);
        jsonw_end_obj(&w);
    } else if srv_bytes_eq(method[0: mn], &"tools/list"[0: 10]) {
        jsonw_key(&w, &"result"[0: 6]);
        jsonw_obj(&w);
        jsonw_key(&w, &"tools"[0: 5]);
        jsonw_arr(&w);
        jsonw_obj(&w);
        jsonw_key(&w, &"name"[0: 4]);
        jsonw_str(&w, &"pricing_get"[0: 11]);
        jsonw_key(&w, &"description"[0: 11]);
        jsonw_str(&w, &"query sell/cost rates"[0: 21]);
        jsonw_key(&w, &"inputSchema"[0: 11]);
        jsonw_obj(&w);
        jsonw_key(&w, &"type"[0: 4]);
        jsonw_str(&w, &"object"[0: 6]);
        jsonw_end_obj(&w);
        jsonw_end_obj(&w);
        jsonw_obj(&w);
        jsonw_key(&w, &"name"[0: 4]);
        jsonw_str(&w, &"billing_query"[0: 13]);
        jsonw_key(&w, &"description"[0: 11]);
        jsonw_str(&w, &"query usage rollup"[0: 18]);
        jsonw_key(&w, &"inputSchema"[0: 11]);
        jsonw_obj(&w);
        jsonw_key(&w, &"type"[0: 4]);
        jsonw_str(&w, &"object"[0: 6]);
        jsonw_end_obj(&w);
        jsonw_end_obj(&w);
        jsonw_obj(&w);
        jsonw_key(&w, &"name"[0: 4]);
        jsonw_str(&w, &"backup_status"[0: 13]);
        jsonw_key(&w, &"description"[0: 11]);
        jsonw_str(&w, &"backup status"[0: 13]);
        jsonw_key(&w, &"inputSchema"[0: 11]);
        jsonw_obj(&w);
        jsonw_key(&w, &"type"[0: 4]);
        jsonw_str(&w, &"object"[0: 6]);
        jsonw_end_obj(&w);
        jsonw_end_obj(&w);
        jsonw_end_arr(&w);
        jsonw_end_obj(&w);
    } else if srv_bytes_eq(method[0: mn], &"tools/call"[0: 10]) {
        const params: i32 = json_get(&d, root, &"params"[0: 6]);
        var name: [byte: 64] = [0: 64];
        const nn: usize = json_str(&d, json_get(&d, params, &"name"[0: 4]), &name[0], 64);
        const args: i32 = json_get(&d, params, &"arguments"[0: 9]);
        var iw: JsonW = JsonW{};
        jsonw_init(&iw);
        var known: bool = true;
        if srv_bytes_eq(name[0: nn], &"pricing_get"[0: 11]) {
            var model: [byte: 128] = [0: 128];
            const mlen: usize = json_str(&d, json_get(&d, args, &"model"[0: 5]), &model[0], 128);
            var prov: [byte: 128] = [0: 128];
            const plen: usize = json_str(&d, json_get(&d, args, &"provider"[0: 8]), &prov[0], 128);
            var uid: i64 = json_i64(&d, json_get(&d, args, &"user_id"[0: 7]));
            if uid < 0 {
                uid = 0;
            }
            var ts: i64 = json_i64(&d, json_get(&d, args, &"ts"[0: 2]));
            if ts <= 0 {
                ts = store_now();
            }
            var sell: PriceRates = PriceRates{ input_nano_per_mtok: 0, output_nano_per_mtok: 0, cache_read_nano_per_mtok: 0, per_request_nano: 0, permille: 1000, card_id: 0, version: 0, found: false };
            var cost: PriceRates = PriceRates{ input_nano_per_mtok: 0, output_nano_per_mtok: 0, cache_read_nano_per_mtok: 0, per_request_nano: 0, permille: 1000, card_id: 0, version: 0, found: false };
            var no_prov: [byte: 1] = [0: 1];
            price_lookup(runtime_db(), PRICE_KIND_SELL, model[0: mlen], no_prov[0: 0], uid, ts, 0, &sell) catch {
                known = false;
            };
            if known {
                price_lookup(runtime_db(), PRICE_KIND_COST, model[0: mlen], prov[0: plen], 0, ts, 0, &cost) catch {
                    known = false;
                };
            }
            if known {
                jsonw_obj(&iw);
                jsonw_key(&iw, &"model"[0: 5]);
                jsonw_str(&iw, model[0: mlen]);
                jsonw_key(&iw, &"ts"[0: 2]);
                jsonw_i64(&iw, ts);
                srv_rates_out(&iw, &"sell"[0: 4], &sell);
                srv_rates_out(&iw, &"cost"[0: 4], &cost);
                jsonw_end_obj(&iw);
            }
        } else if srv_bytes_eq(name[0: nn], &"billing_query"[0: 13]) {
            var uid: i64 = json_i64(&d, json_get(&d, args, &"user_id"[0: 7]));
            if uid < 0 {
                uid = 0;
            }
            var from_day: i64 = json_i64(&d, json_get(&d, args, &"from_day"[0: 8]));
            if from_day < 0 {
                from_day = 0;
            }
            var to_day: i64 = json_i64(&d, json_get(&d, args, &"to_day"[0: 6]));
            if to_day <= 0 {
                to_day = 999999;
            }
            var rows: [RollupRow: 64] = [];
            var rn: usize = 0;
            rn = srv_rollup_query(uid, from_day, to_day, &rows[0], 64);
            jsonw_obj(&iw);
            jsonw_key(&iw, &"rows"[0: 4]);
            jsonw_arr(&iw);
            var i: usize = 0;
            while i < rn {
                jsonw_obj(&iw);
                jsonw_key(&iw, &"day"[0: 3]);
                jsonw_i64(&iw, rows[i].day);
                jsonw_key(&iw, &"model"[0: 5]);
                jsonw_str(&iw, rows[i].model[0: rows[i].model_len]);
                jsonw_key(&iw, &"requests"[0: 8]);
                jsonw_i64(&iw, rows[i].requests);
                jsonw_key(&iw, &"cost_nano"[0: 9]);
                jsonw_i64(&iw, rows[i].cost_nano);
                jsonw_key(&iw, &"price_nano"[0: 10]);
                jsonw_i64(&iw, rows[i].price_nano);
                jsonw_end_obj(&iw);
                i = i + 1;
            }
            jsonw_end_arr(&iw);
            jsonw_end_obj(&iw);
        } else if srv_bytes_eq(name[0: nn], &"backup_status"[0: 13]) {
            jsonw_obj(&iw);
            jsonw_key(&iw, &"ok"[0: 2]);
            jsonw_bool(&iw, true);
            jsonw_key(&iw, &"last_backup_day"[0: 15]);
            jsonw_i64(&iw, runtime_last_backup_day());
            jsonw_end_obj(&iw);
        } else {
            known = false;
        }
        if !known {
            jsonw_key(&w, &"error"[0: 5]);
            jsonw_obj(&w);
            jsonw_key(&w, &"code"[0: 4]);
            jsonw_i64(&w, 0 - 32602);
            jsonw_key(&w, &"message"[0: 7]);
            jsonw_str(&w, &"invalid params"[0: 14]);
            jsonw_end_obj(&w);
        } else {
            jsonw_key(&w, &"result"[0: 6]);
            jsonw_obj(&w);
            jsonw_key(&w, &"content"[0: 7]);
            jsonw_arr(&w);
            jsonw_obj(&w);
            jsonw_key(&w, &"type"[0: 4]);
            jsonw_str(&w, &"text"[0: 4]);
            jsonw_key(&w, &"text"[0: 4]);
            jsonw_str(&w, jsonw_span(&iw));
            jsonw_end_obj(&w);
            jsonw_end_arr(&w);
            jsonw_end_obj(&w);
        }
    } else {
        jsonw_key(&w, &"error"[0: 5]);
        jsonw_obj(&w);
        jsonw_key(&w, &"code"[0: 4]);
        jsonw_i64(&w, 0 - 32601);
        jsonw_key(&w, &"message"[0: 7]);
        jsonw_str(&w, &"method not found"[0: 16]);
        jsonw_end_obj(&w);
    }
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

// A5：responses 流式事件（response.created / output_text.delta / completed）
fn srv_sse_frame(fd: i32, ev: &const byte, evn: usize, js: &[byte]) bool {
    var eb: [byte: 16384] = [0: 16384];
    var el: usize = 0;
    const pre: &[byte] = &"event: "[0: 7];
    var i: usize = 0;
    while i < 7 && el < 16380 {
        eb[el] = pre[i];
        el = el + 1;
        i = i + 1;
    }
    i = 0;
    while i < evn && el < 16380 {
        eb[el] = ev[i];
        el = el + 1;
        i = i + 1;
    }
    if el < 16380 {
        eb[el] = 10;
        el = el + 1;
    }
    const dp: &[byte] = &"data: "[0: 6];
    i = 0;
    while i < 6 && el < 16380 {
        eb[el] = dp[i];
        el = el + 1;
        i = i + 1;
    }
    i = 0;
    while i < js.len && el < 16380 {
        eb[el] = js[i];
        el = el + 1;
        i = i + 1;
    }
    if el < 16380 {
        eb[el] = 10;
        el = el + 1;
    }
    if el < 16380 {
        eb[el] = 10;
        el = el + 1;
    }
    var ob: [byte: 16400] = [0: 16400];
    const on: usize = hsrv_chunk(&ob[0], 16400, eb[0: el], el);
    return on > 0 && srv_send_all(fd, ob[0: on]);
}

// A5：流式工具事件（responses API）。最多跟踪 4 个并行 tool call：
//   output_item.added → function_call_arguments.delta… → output_item.done。
const SRV_TC_MAX: usize = 4;
const SRV_TC_ID_MAX: usize = 64;
const SRV_TC_NAME_MAX: usize = 64;
const SRV_TC_ARGS_MAX: usize = 2048;

struct SrvToolCall {
    started: bool,
    id: [byte: SRV_TC_ID_MAX],
    id_len: usize,
    name: [byte: SRV_TC_NAME_MAX],
    name_len: usize,
    args: [byte: SRV_TC_ARGS_MAX],
    args_len: usize,
}

fn srv_tc_copy(dst: &byte, cap: usize, src: &[byte]) usize {
    var i: usize = 0;
    while i < src.len && i < cap {
        dst[i] = src[i];
        i = i + 1;
    }
    return i;
}

fn srv_tc_item_id(tc: &SrvToolCall, idx: usize, out: &byte, cap: usize) usize {
    if tc.id_len > 0 {
        return srv_tc_copy(out, cap, tc.id[0: tc.id_len]);
    }
    if cap < 4 {
        return 0;
    }
    out[0] = 'f' as byte;
    out[1] = 'c' as byte;
    out[2] = '_' as byte;
    out[3] = (48 as i32 + (idx as i32) % 10) as byte;
    return 4;
}

fn srv_tc_emit_added(c: &SrvConn, tc: &SrvToolCall, idx: usize) bool {
    var ib: [byte: SRV_TC_ID_MAX] = [0: SRV_TC_ID_MAX];
    const il: usize = srv_tc_item_id(tc, idx, &ib[0], SRV_TC_ID_MAX);
    var jw: JsonW = JsonW{};
    jsonw_init(&jw);
    jsonw_obj(&jw);
    jsonw_key(&jw, &"type"[0: 4]);
    jsonw_str(&jw, &"response.output_item.added"[0: 26]);
    jsonw_key(&jw, &"item"[0: 4]);
    jsonw_obj(&jw);
    jsonw_key(&jw, &"type"[0: 4]);
    jsonw_str(&jw, &"function_call"[0: 13]);
    jsonw_key(&jw, &"id"[0: 2]);
    jsonw_str(&jw, ib[0: il]);
    jsonw_key(&jw, &"call_id"[0: 7]);
    jsonw_str(&jw, tc.id[0: tc.id_len]);
    jsonw_key(&jw, &"name"[0: 4]);
    jsonw_str(&jw, tc.name[0: tc.name_len]);
    jsonw_key(&jw, &"arguments"[0: 9]);
    jsonw_str(&jw, &""[0: 0]);
    jsonw_key(&jw, &"status"[0: 6]);
    jsonw_str(&jw, &"in_progress"[0: 11]);
    jsonw_end_obj(&jw);
    jsonw_end_obj(&jw);
    return srv_sse_frame(c.fd, &"response.output_item.added"[0: 26], 26, jsonw_span(&jw));
}

fn srv_tc_emit_delta(c: &SrvConn, tc: &SrvToolCall, idx: usize, chunk: &[byte]) bool {
    var ib: [byte: SRV_TC_ID_MAX] = [0: SRV_TC_ID_MAX];
    const il: usize = srv_tc_item_id(tc, idx, &ib[0], SRV_TC_ID_MAX);
    var jw: JsonW = JsonW{};
    jsonw_init(&jw);
    jsonw_obj(&jw);
    jsonw_key(&jw, &"type"[0: 4]);
    jsonw_str(&jw, &"response.function_call_arguments.delta"[0: 38]);
    jsonw_key(&jw, &"item_id"[0: 7]);
    jsonw_str(&jw, ib[0: il]);
    jsonw_key(&jw, &"delta"[0: 5]);
    jsonw_str(&jw, chunk);
    jsonw_end_obj(&jw);
    return srv_sse_frame(c.fd, &"response.function_call_arguments.delta"[0: 38], 38, jsonw_span(&jw));
}

fn srv_tc_write_item(w: &JsonW, tc: &SrvToolCall, idx: usize) void {
    var ib: [byte: SRV_TC_ID_MAX] = [0: SRV_TC_ID_MAX];
    const il: usize = srv_tc_item_id(tc, idx, &ib[0], SRV_TC_ID_MAX);
    jsonw_obj(w);
    jsonw_key(w, &"type"[0: 4]);
    jsonw_str(w, &"function_call"[0: 13]);
    jsonw_key(w, &"id"[0: 2]);
    jsonw_str(w, ib[0: il]);
    jsonw_key(w, &"call_id"[0: 7]);
    jsonw_str(w, tc.id[0: tc.id_len]);
    jsonw_key(w, &"name"[0: 4]);
    jsonw_str(w, tc.name[0: tc.name_len]);
    jsonw_key(w, &"arguments"[0: 9]);
    jsonw_str(w, tc.args[0: tc.args_len]);
    jsonw_key(w, &"status"[0: 6]);
    jsonw_str(w, &"completed"[0: 9]);
    jsonw_end_obj(w);
}

fn srv_tc_emit_done(c: &SrvConn, tc: &SrvToolCall, idx: usize) bool {
    var jw: JsonW = JsonW{};
    jsonw_init(&jw);
    jsonw_obj(&jw);
    jsonw_key(&jw, &"type"[0: 4]);
    jsonw_str(&jw, &"response.output_item.done"[0: 25]);
    jsonw_key(&jw, &"item"[0: 4]);
    srv_tc_write_item(&jw, tc, idx);
    jsonw_end_obj(&jw);
    return srv_sse_frame(c.fd, &"response.output_item.done"[0: 25], 25, jsonw_span(&jw));
}

fn srv_responses_stream(c: &SrvConn, uid: i64, plan: &ChatPlan, cfg: &const HttppConfig,
    rid: &[byte], input_text: &[byte], prev_id: &[byte]) void {
    var call: HtcCall = HtcCall{};
    htc_call_init(&call);
    defer { htc_call_free(&call); }
    const nowu: u64 = now_ms() catch {
        srv_static(c, 502, SRV_JSON_502, c.keep);
        return;
    };
    const o: !i32 = wait_i32(htc_open_async(cfg, &g_up_ctx, &"POST"[0: 4],
        plan.path[0: plan.path_len], plan.payload[0: plan.payload_len], true,
        nowu, nowu +% 10000, &call));
    const orc: i32 = o catch |_| {
        lb_report(plan.provider_id, false, store_now());
        srv_static(c, 502, SRV_JSON_502, c.keep);
        return;
    };
    if orc != 0 {
        lb_report(plan.provider_id, false, store_now());
        srv_static(c, 502, SRV_JSON_502, c.keep);
        return;
    }
    lb_report(plan.provider_id, true, store_now());
    const fl: !i32 = sys_fcntl(c.fd, 3, 0);
    const flags: i32 = fl catch {
        0;
    };
    if flags != 0 {
        _ = sys_fcntl(c.fd, 4, flags & (0 -% 2049)) catch {};
    }
    var head: [byte: 256] = [0: 256];
    const hn: usize = hsrv_resp_head(&head[0], 256, 200, &SRV_CTYPE_SSE[0: 17], 17,
        0 as i64, true, false);
    if !srv_send_all(c.fd, head[0: hn]) {
        srv_chat_close(c);
        return;
    }
    var jw: JsonW = JsonW{};
    // response.created
    {
        jsonw_init(&jw);
        jsonw_obj(&jw);
        jsonw_key(&jw, &"type"[0: 4]);
        jsonw_str(&jw, &"response.created"[0: 16]);
        jsonw_key(&jw, &"response"[0: 8]);
        jsonw_obj(&jw);
        jsonw_key(&jw, &"id"[0: 2]);
        jsonw_str(&jw, rid);
        jsonw_key(&jw, &"object"[0: 6]);
        jsonw_str(&jw, &"response"[0: 8]);
        jsonw_key(&jw, &"model"[0: 5]);
        jsonw_str(&jw, plan.model[0: plan.model_len]);
        jsonw_key(&jw, &"previous_response_id"[0: 20]);
        jsonw_str(&jw, prev_id);
        jsonw_end_obj(&jw);
        jsonw_end_obj(&jw);
        if !srv_sse_frame(c.fd, &"response.created"[0: 16], 16, jsonw_span(&jw)) {
            srv_chat_close(c);
            return;
        }
    }
    var jd: JsonDoc = JsonDoc{};
    var usage: PriceUsage = PriceUsage{ input_tokens: 0, output_tokens: 0, cache_read_tokens: 0 };
    var usage_found: bool = false;
    var out_text: [byte: RESP_OUTPUT_MAX] = [0: RESP_OUTPUT_MAX];
    var out_len: usize = 0;
    var events: i32 = 0;
    var done: bool = false;
    var closed: bool = false;
    var tcs: [SrvToolCall: SRV_TC_MAX] = [];
    while events < 4096 && !done && !closed {
        var has: bool = false;
        const r: !i32 = wait_i32(htc_next_event_async(&call, &has, 5000 as u64));
        const rr: i32 = r catch |_| {
            break;
        };
        if rr == 0 || !has {
            break;
        }
        if sse_is_done(&call.sse) {
            done = true;
        } else if call.sse.ev.data_len > 0 && call.sse.ev.data[0] == (123 as byte) {
            json_parse(&jd, call.sse.ev.data[0: call.sse.ev.data_len]) catch {};
            if billing_usage_parse(&jd, json_root(&jd), &usage) {
                usage_found = true;
            }
            const choices: i32 = json_get(&jd, json_root(&jd), &"choices"[0: 7]);
            const c0: i32 = json_arr_at(&jd, choices, 0);
            const delta: i32 = json_get(&jd, c0, &"delta"[0: 5]);
            const content: i32 = json_get(&jd, delta, &"content"[0: 7]);
            if json_kind(&jd, content) == JSON_STR {
                var chunk: [byte: 1024] = [0: 1024];
                const cn: usize = json_str(&jd, content, &chunk[0], 1024);
                if cn > 0 {
                    var i: usize = 0;
                    while i < cn && out_len < RESP_OUTPUT_MAX {
                        out_text[out_len] = chunk[i];
                        out_len = out_len + 1;
                        i = i + 1;
                    }
                    jsonw_init(&jw);
                    jsonw_obj(&jw);
                    jsonw_key(&jw, &"type"[0: 4]);
                    jsonw_str(&jw, &"response.output_text.delta"[0: 26]);
                    jsonw_key(&jw, &"delta"[0: 5]);
                    jsonw_str(&jw, chunk[0: cn]);
                    jsonw_end_obj(&jw);
                    if !srv_sse_frame(c.fd, &"response.output_text.delta"[0: 26], 26, jsonw_span(&jw)) {
                        closed = true;
                    }
                }
            }
            // A5：工具调用增量 → output_item.added / arguments.delta
            if !closed {
                const tca: i32 = json_get(&jd, delta, &"tool_calls"[0: 10]);
                if tca >= 0 {
                    const tn: usize = json_arr_len(&jd, tca);
                    var ti: usize = 0;
                    while ti < tn && ti < SRV_TC_MAX && !closed {
                        const el: i32 = json_arr_at(&jd, tca, ti);
                        const fnode: i32 = json_get(&jd, el, &"function"[0: 8]);
                        const raw_slot: i64 = json_i64(&jd, json_get(&jd, el, &"index"[0: 5]));
                        var slot: usize = 0;
                        if raw_slot > 0 && raw_slot < 4 {
                            slot = raw_slot as usize;
                        }
                        const tc: &SrvToolCall = &tcs[slot];
                        const cid: i32 = json_get(&jd, el, &"id"[0: 2]);
                        if cid >= 0 && json_kind(&jd, cid) == JSON_STR && tc.id_len == 0 {
                            var cb: [byte: SRV_TC_ID_MAX] = [0: SRV_TC_ID_MAX];
                            const cn: usize = json_str(&jd, cid, &cb[0], SRV_TC_ID_MAX);
                            tc.id_len = srv_tc_copy(&tc.id[0], SRV_TC_ID_MAX, cb[0: cn]);
                        }
                        const fname: i32 = json_get(&jd, fnode, &"name"[0: 4]);
                        if fname >= 0 && json_kind(&jd, fname) == JSON_STR && tc.name_len == 0 {
                            var nb: [byte: SRV_TC_NAME_MAX] = [0: SRV_TC_NAME_MAX];
                            const nn: usize = json_str(&jd, fname, &nb[0], SRV_TC_NAME_MAX);
                            tc.name_len = srv_tc_copy(&tc.name[0], SRV_TC_NAME_MAX, nb[0: nn]);
                        }
                        if !tc.started && (tc.id_len > 0 || tc.name_len > 0) {
                            tc.started = true;
                            if !srv_tc_emit_added(c, tc, slot) {
                                closed = true;
                            }
                        }
                        if !closed {
                            const farg: i32 = json_get(&jd, fnode, &"arguments"[0: 9]);
                            if farg >= 0 && json_kind(&jd, farg) == JSON_STR {
                                var ab: [byte: 512] = [0: 512];
                                const an: usize = json_str(&jd, farg, &ab[0], 512);
                                if an > 0 {
                                    var k: usize = 0;
                                    while k < an && tc.args_len < SRV_TC_ARGS_MAX {
                                        tc.args[tc.args_len] = ab[k];
                                        tc.args_len = tc.args_len + 1;
                                        k = k + 1;
                                    }
                                    if !srv_tc_emit_delta(c, tc, slot, ab[0: an]) {
                                        closed = true;
                                    }
                                }
                            }
                        }
                        ti = ti + 1;
                    }
                }
            }
        }
        if closed {
            break;
        }
        sse_consume(&call.sse);
        events = events + 1;
    }
    // A5：收尾事件（每个已开始的 tool call 一条 output_item.done）
    var di: usize = 0;
    while di < SRV_TC_MAX {
        if tcs[di].started && !closed {
            _ = srv_tc_emit_done(c, &tcs[di], di);
        }
        di = di + 1;
    }
    var settle: BillingResult = BillingResult{ cost_nano: 0, price_nano: 0, rate_version: 0, duplicate: false, found: false };
    if usage_found {
        billing_settle_deferred(rid, uid, store_now(), 0,
            plan.model[0: plan.model_len], plan.provider_name[0: plan.provider_name_len],
            &usage, &settle) catch {};
    }
    resp_store(runtime_db(), rid, uid, store_now(), plan.model[0: plan.model_len],
        prev_id, input_text, out_text[0: out_len], &"{}"[0: 2]) catch {};
    {
        jsonw_init(&jw);
        jsonw_obj(&jw);
        jsonw_key(&jw, &"type"[0: 4]);
        jsonw_str(&jw, &"response.completed"[0: 18]);
        jsonw_key(&jw, &"response"[0: 8]);
        jsonw_obj(&jw);
        jsonw_key(&jw, &"id"[0: 2]);
        jsonw_str(&jw, rid);
        jsonw_key(&jw, &"usage"[0: 5]);
        jsonw_obj(&jw);
        jsonw_key(&jw, &"input_tokens"[0: 12]);
        jsonw_i64(&jw, usage.input_tokens);
        jsonw_key(&jw, &"output_tokens"[0: 13]);
        jsonw_i64(&jw, usage.output_tokens);
        jsonw_key(&jw, &"cost_nano"[0: 9]);
        jsonw_i64(&jw, settle.cost_nano);
        jsonw_key(&jw, &"price_nano"[0: 10]);
        jsonw_i64(&jw, settle.price_nano);
        jsonw_end_obj(&jw);
        jsonw_key(&jw, &"output"[0: 6]);
        jsonw_arr(&jw);
        di = 0;
        while di < SRV_TC_MAX {
            if tcs[di].started {
                srv_tc_write_item(&jw, &tcs[di], di);
            }
            di = di + 1;
        }
        jsonw_end_arr(&jw);
        jsonw_end_obj(&jw);
        jsonw_end_obj(&jw);
        _ = srv_sse_frame(c.fd, &"response.completed"[0: 18], 18, jsonw_span(&jw));
    }
    _ = srv_send_all(c.fd, &"0\r\n\r\n"[0: 5]);
    srv_chat_close(c);
}

// ---------------------------------------------------------------
// B1：controller 控制面（meta.db；register/heartbeat/config/status）
// ---------------------------------------------------------------

fn srv_ctl_register(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !g_meta_ready {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var id: [byte: 64] = [0: 64];
    const idn: usize = srv_json_body_str(c, &"id"[0: 2], &id[0], 64);
    var role: [byte: 16] = [0: 16];
    const rn: usize = srv_json_body_str(c, &"role"[0: 4], &role[0], 16);
    var addr: [byte: 256] = [0: 256];
    const an: usize = srv_json_body_str(c, &"addr"[0: 4], &addr[0], 256);
    if idn == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    var role_s: [byte: 8] = [0: 8];
    var rs: &[byte] = role[0: rn];
    if rn == 0 {
        role_s[0] = 'e'; role_s[1] = 'd'; role_s[2] = 'g'; role_s[3] = 'e';
        rs = role_s[0: 4];
    }
    meta_node_register(&g_meta, id[0: idn], rs, addr[0: an], store_now()) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    var pb: [byte: 4096] = [0: 4096];
    var plen: usize = 0;
    var ver: i64 = 0;
    ver = meta_config_get(&g_meta, &pb[0], 4096, &plen) catch { 0 as i64; };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"ok"[0: 2]);
    jsonw_bool(&w, true);
    jsonw_key(&w, &"config_version"[0: 14]);
    jsonw_i64(&w, ver);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

fn srv_ctl_heartbeat(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !g_meta_ready {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    const root: i32 = json_root(&d);
    var id: [byte: 64] = [0: 64];
    const idn: usize = json_str(&d, json_get(&d, root, &"id"[0: 2]), &id[0], 64);
    if idn == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    const now: i64 = store_now();
    meta_node_heartbeat(&g_meta, id[0: idn], now) catch {
        srv_static(c, 404, SRV_JSON_404, keep);
        return;
    };
    const day: i64 = json_i64(&d, json_get(&d, root, &"journal_day"[0: 11]));
    const entries: i64 = json_i64(&d, json_get(&d, root, &"entries"[0: 7]));
    if day > 0 {
        meta_journal_index_put(&g_meta, id[0: idn], day, entries, now) catch {};
    }
    var pb: [byte: 4096] = [0: 4096];
    var plen: usize = 0;
    var ver: i64 = 0;
    ver = meta_config_get(&g_meta, &pb[0], 4096, &plen) catch { 0 as i64; };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"ok"[0: 2]);
    jsonw_bool(&w, true);
    jsonw_key(&w, &"config_version"[0: 14]);
    jsonw_i64(&w, ver);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

fn srv_ctl_config(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !g_meta_ready {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_len > 0 && c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    // POST（admin）写一版配置；GET 读当前版本
    if c.body_len > 0 {
        if !srv_admin_ok(c) {
            srv_static(c, 401, SRV_JSON_401, keep);
            return;
        }
        var d: JsonDoc = JsonDoc{};
        json_parse(&d, c.body[0: c.body_len]) catch {
            srv_static(c, 400, SRV_JSON_400, keep);
            return;
        };
        var payload: [byte: 4096] = [0: 4096];
        const pln: usize = json_str(&d, json_get(&d, json_root(&d), &"payload"[0: 7]), &payload[0], 4096);
        var ver: i64 = 0;
        ver = meta_config_put(&g_meta, payload[0: pln], store_now()) catch {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        };
        var w: JsonW = JsonW{};
        jsonw_init(&w);
        jsonw_obj(&w);
        jsonw_key(&w, &"ok"[0: 2]);
        jsonw_bool(&w, true);
        jsonw_key(&w, &"version"[0: 7]);
        jsonw_i64(&w, ver);
        jsonw_end_obj(&w);
        srv_static(c, 200, jsonw_span(&w), keep);
        return;
    }
    var pb: [byte: 4096] = [0: 4096];
    var plen: usize = 0;
    var ver: i64 = 0;
    ver = meta_config_get(&g_meta, &pb[0], 4096, &plen) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"version"[0: 7]);
    jsonw_i64(&w, ver);
    jsonw_key(&w, &"payload"[0: 7]);
    jsonw_str(&w, pb[0: plen]);
    var lbv: [byte: 64] = [0: 64];
    var lnv: usize = 0;
    lnv = elect_leader(&g_meta, store_now(), &lbv[0], 64) catch {
        0 as usize;
    };
    var lep: i64 = 0;
    if lnv > 0 {
        lep = meta_epoch_get(&g_meta, lbv[0: lnv]) catch {
            0 as i64;
        };
    }
    jsonw_key(&w, &"epoch"[0: 5]);
    jsonw_i64(&w, lep);
    var rows: [MetaAssign: 128] = [];
    var rn: usize = 0;
    rn = meta_assign_list(&g_meta, &rows[0], 128) catch {
        0 as usize;
    };
    jsonw_key(&w, &"assign"[0: 6]);
    jsonw_arr(&w);
    var i: usize = 0;
    while i < rn {
        jsonw_obj(&w);
        jsonw_key(&w, &"slug"[0: 4]);
        jsonw_str(&w, rows[i].slug[0: rows[i].slug_len]);
        jsonw_key(&w, &"node"[0: 4]);
        jsonw_str(&w, rows[i].node_id[0: rows[i].node_len]);
        jsonw_key(&w, &"epoch"[0: 5]);
        jsonw_i64(&w, rows[i].epoch);
        jsonw_end_obj(&w);
        i = i + 1;
    }
    jsonw_end_arr(&w);
    var nn2: usize = 0;
    var nodes2: [MetaNode: 32] = [];
    nn2 = meta_node_list(&g_meta, &nodes2[0], 32) catch {
        0 as usize;
    };
    jsonw_key(&w, &"nodes"[0: 5]);
    jsonw_arr(&w);
    var j: usize = 0;
    while j < nn2 {
        jsonw_obj(&w);
        jsonw_key(&w, &"id"[0: 2]);
        jsonw_str(&w, nodes2[j].id[0: nodes2[j].id_len]);
        jsonw_key(&w, &"addr"[0: 4]);
        jsonw_str(&w, nodes2[j].addr[0: nodes2[j].addr_len]);
        jsonw_key(&w, &"status"[0: 6]);
        jsonw_str(&w, nodes2[j].status[0: nodes2[j].status_len]);
        jsonw_end_obj(&w);
        j = j + 1;
    }
    jsonw_end_arr(&w);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

fn srv_ctl_status(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !g_meta_ready {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var nodes: [MetaNode: 32] = [];
    var n: usize = 0;
    n = meta_node_list(&g_meta, &nodes[0], 32) catch {
        0 as usize;
    };
    var lb: [byte: 64] = [0: 64];
    var ln: usize = 0;
    ln = elect_leader(&g_meta, store_now(), &lb[0], 64) catch {
        0 as usize;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"leader"[0: 6]);
    jsonw_str(&w, lb[0: ln]);
    jsonw_key(&w, &"nodes"[0: 5]);
    jsonw_arr(&w);
    var i: usize = 0;
    while i < n {
        jsonw_obj(&w);
        jsonw_key(&w, &"id"[0: 2]);
        jsonw_str(&w, nodes[i].id[0: nodes[i].id_len]);
        jsonw_key(&w, &"role"[0: 4]);
        jsonw_str(&w, nodes[i].role[0: nodes[i].role_len]);
        jsonw_key(&w, &"addr"[0: 4]);
        jsonw_str(&w, nodes[i].addr[0: nodes[i].addr_len]);
        jsonw_key(&w, &"status"[0: 6]);
        jsonw_str(&w, nodes[i].status[0: nodes[i].status_len]);
        jsonw_key(&w, &"last_seen"[0: 9]);
        jsonw_i64(&w, nodes[i].last_seen);
        jsonw_end_obj(&w);
        i = i + 1;
    }
    jsonw_end_arr(&w);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}


// B3：epoch / 归属 / drain 控制面
fn srv_ctl_epoch(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !g_meta_ready {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    var id: [byte: 64] = [0: 64];
    const idn: usize = json_str(&d, json_get(&d, json_root(&d), &"id"[0: 2]), &id[0], 64);
    if idn == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    var ep: i64 = 0;
    ep = meta_epoch_bump(&g_meta, id[0: idn], store_now()) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"ok"[0: 2]);
    jsonw_bool(&w, true);
    jsonw_key(&w, &"epoch"[0: 5]);
    jsonw_i64(&w, ep);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

fn srv_ctl_assign(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !g_meta_ready {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_len == 0 {
        var slug: [byte: 128] = [0: 128];
        const sn: usize = srv_query_str(&c.path[0], c.path_len, &"slug"[0: 4], 4, &slug[0], 128);
        if sn == 0 {
            srv_static(c, 400, SRV_JSON_400, keep);
            return;
        }
        var nb: [byte: 64] = [0: 64];
        var ep: i64 = 0;
        const nn: usize = meta_assign_get(&g_meta, slug[0: sn], &nb[0], 64, &ep) catch {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        };
        if nn == 0 {
            srv_static(c, 404, SRV_JSON_404, keep);
            return;
        }
        var w: JsonW = JsonW{};
        jsonw_init(&w);
        jsonw_obj(&w);
        jsonw_key(&w, &"slug"[0: 4]);
        jsonw_str(&w, slug[0: sn]);
        jsonw_key(&w, &"node_id"[0: 7]);
        jsonw_str(&w, nb[0: nn]);
        jsonw_key(&w, &"epoch"[0: 5]);
        jsonw_i64(&w, ep);
        jsonw_end_obj(&w);
        srv_static(c, 200, jsonw_span(&w), keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    const root: i32 = json_root(&d);
    var slug: [byte: 128] = [0: 128];
    const sn: usize = json_str(&d, json_get(&d, root, &"slug"[0: 4]), &slug[0], 128);
    var nb: [byte: 64] = [0: 64];
    const nn: usize = json_str(&d, json_get(&d, root, &"node_id"[0: 7]), &nb[0], 64);
    const ep: i64 = json_i64(&d, json_get(&d, root, &"epoch"[0: 5]));
    if sn == 0 || nn == 0 || ep <= 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    meta_assign(&g_meta, slug[0: sn], nb[0: nn], ep, store_now()) catch {
        srv_static(c, 421, SRV_JSON_421, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"ok"[0: 2]);
    jsonw_bool(&w, true);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

fn srv_ctl_drain(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !g_meta_ready {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    var id: [byte: 64] = [0: 64];
    const idn: usize = json_str(&d, json_get(&d, json_root(&d), &"id"[0: 2]), &id[0], 64);
    if idn == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    const now: i64 = store_now();
    meta_node_set_status(&g_meta, id[0: idn], &"draining"[0: 8], now) catch {
        srv_static(c, 404, SRV_JSON_404, keep);
        return;
    };
    // drain 语义：把该节点的 slug 全量迁到一台 active 节点（epoch 必须高于现有归属）。
    var nodes: [MetaNode: 64] = [];
    var n: usize = 0;
    n = meta_node_list(&g_meta, &nodes[0], 64) catch {
        0 as usize;
    };
    var tgt: [byte: 64] = [0: 64];
    var tn: usize = 0;
    var i: usize = 0;
    while i < n {
        if nodes[i].status_len == 6 && nodes[i].status[0] == ('a' as byte) && nodes[i].id_len > 0
            && !(nodes[i].id_len == idn && srv_slice_eq(nodes[i].id[0: nodes[i].id_len], id[0: idn])) {
            var k: usize = 0;
            while k < nodes[i].id_len && k < 64 {
                tgt[k] = nodes[i].id[k];
                k = k + 1;
            }
            tn = k;
            break;
        }
        i = i + 1;
    }
    var moved: i64 = 0;
    if tn > 0 {
        var attempt: usize = 0;
        while attempt < 8 && moved == 0 {
            var ep: i64 = 0;
            ep = meta_epoch_bump(&g_meta, tgt[0: tn], now) catch {
                0 as i64;
            };
            if ep <= 0 {
                break;
            }
            const mv: !i64 = meta_reassign_all(&g_meta, id[0: idn], tgt[0: tn], ep, now);
            moved = mv catch {
                0 as i64;
            };
            attempt = attempt + 1;
        }
    }
    srv_audit(&"drain"[0: 5], id[0: idn]);
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"ok"[0: 2]);
    jsonw_bool(&w, true);
    jsonw_key(&w, &"moved"[0: 5]);
    jsonw_i64(&w, moved);
    jsonw_key(&w, &"to"[0: 2]);
    jsonw_str(&w, tgt[0: tn]);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

/// `?node=<id>` 且该节点在 meta 里存在 → 视为可信节点。
fn srv_node_ok(c: &SrvConn) bool {
    if !g_meta_ready {
        return false;
    }
    var nid: [byte: 64] = [0: 64];
    const n: usize = srv_query_str(&c.path[0], c.path_len, &"node"[0: 4], 4, &nid[0], 64);
    if n == 0 {
        return false;
    }
    var nodes: [MetaNode: 64] = [];
    var cnt: usize = 0;
    cnt = meta_node_list(&g_meta, &nodes[0], 64) catch {
        0 as usize;
    };
    var i: usize = 0;
    while i < cnt {
        if nodes[i].id_len == n && srv_slice_eq(nodes[i].id[0: nodes[i].id_len], nid[0: n]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// 字节切片相等（长度 + 内容）。
fn srv_slice_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}


// B5：controller 幂等 ingest 入口（node 断网恢复后重放 journal/spool 用）。
fn srv_ctl_ingest(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    // 管理员可直推；已注册节点用 `?node=<id>` 免 admin key（节点重放 spool/journal）。
    if !srv_admin_ok(c) && !srv_node_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    const now: i64 = store_now();
    var st: IngestStats = IngestStats{ applied: 0, duplicate: 0, bad: 0 };
    st = ingest_apply_routed(runtime_db(), c.body[0: c.body_len], now) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"applied"[0: 7]);
    jsonw_i64(&w, st.applied);
    jsonw_key(&w, &"duplicate"[0: 9]);
    jsonw_i64(&w, st.duplicate);
    jsonw_key(&w, &"bad"[0: 3]);
    jsonw_i64(&w, st.bad);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}


// C1：静态壳（首页 + 脚本）。
const SRV_CTYPE_HTML: &[byte] = &"text/html; charset=utf-8"[0: 23];
const SRV_CTYPE_JS: &[byte] = &"application/javascript"[0: 22];


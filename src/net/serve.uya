// src/net/serve.uya — A1 单线程 epoll 事件循环（监听 / 连接状态机 / SSE / 优雅停机）
//
// 与首版（每连接 `@await` 到底、串行 accept）的区别：连接不再变成协程，而是
// **显式状态机**。一个线程、一个 epoll、一张连接槽表，事件来了推进对应槽的状态：
//
//   HEAD ──头部解析完成、有包体──► BODY ──排空──► WRITE ──写完──► HEAD（keep-alive）
//     └────────────无包体──────────┴──────────────► SSE（chunked 分块慢推）
//
// 为什么不用 `@async_fn` 写连接：TLS-09E 之后已知 `@async_fn` 的等待点是共享
// Waker 的 4 个 IO 槽，嵌套一深就会在真正需要等待时耗尽；一个连接一个 future
// 再叠 512 路并发，等于把这条约束放大 512 倍。状态机把「等待」退化成一个
// epoll 事件，没有嵌套、没有槽位竞争。
//
// 三条 Uya 0.11 硬约束仍然适用（详见 docs/design/tls-spike-findings.md §10）：
//   1. 切片字面量赋给局部变量/常量曾经生成 `&(struct uya_slice_X){...}`（已修，
//      但为了可读性这里只在模块级常量上用切片字面量）。
//   2. 位运算两侧类型必须一致（`EPOLLIN as u32` 之类）。
//   3. `i32` 溢出用 `+%`/`-%`；数组下标一律显式判界。
//
// 线程数恒 1：本文件不创建线程、不调用任何阻塞等待（accept/recv/send 全部
// 非阻塞，唯一会阻塞的是 `epoll_wait` 的毫秒超时）。

use libc.syscall;
use libc.signal;
use libc.errno;
use std.async;

/// 单连接读缓冲。请求头必须一次装下；包体按块流式排空，不需要整块驻留。
export const SRV_IO_CAP: usize = 16384;
/// 单连接待写缓冲（响应头 + 一块包体/一个 SSE 事件）。
export const SRV_OUT_CAP: usize = 8192;
/// 同时在线连接上限：验收要求 512 并发 SSE，留一倍余量给探活/管理请求。
export const SRV_MAX_CONNS: usize = 1024;
export const SRV_BACKLOG: i32 = 128;

/// 一次 `epoll_wait` 最多取回的事件数。
const SRV_EV_MAX: i32 = 64;
/// 有 SSE 在推、或正在停机时的轮询粒度（同时是 SSE 事件的定时精度）。
const SRV_TICK_MS: i32 = 5;
/// 全空闲时的轮询粒度（主要用于发现信号导致的停机）。
const SRV_IDLE_MS: i32 = 200;
/// 优雅停机的最长等待：超过就强行关连接。
const SRV_SHUTDOWN_MS: u64 = 2000;
/// A1 自测流：每个连接推多少个事件、相邻事件间隔多少毫秒。
const SRV_SSE_EVENTS: u32 = 20;
const SRV_SSE_GAP_MS: u64 = 20;
/// `CLOCK_MONOTONIC`（libc.pthread 里有同名常量，这里不引入整个模块）。
const SRV_CLOCK_MONOTONIC: i32 = 1;
/// libc.syscall 只导出了 EPOLLIN/EPOLLOUT/EPOLL_CTL_*，err/hup 位在这里补齐。
const SRV_EPOLLERR: u32 = 0x008;
const SRV_EPOLLHUP: u32 = 0x010;

// 连接状态
const ST_FREE: i32 = 0;
const ST_HEAD: i32 = 1;
const ST_BODY: i32 = 2;
const ST_WRITE: i32 = 3;
const ST_SSE: i32 = 4;

// chunked 包体解析阶段
const CH_SIZE: i32 = 0;
const CH_DATA: i32 = 1;
const CH_CRLF: i32 = 2;
const CH_TRAILER: i32 = 3;

// 路由编号（解析头部时定下来，包体排空后直接按编号回包）
const ROUTE_404: i32 = 0;
const ROUTE_HEALTH: i32 = 1;
const ROUTE_MODELS: i32 = 2;
const ROUTE_SSE: i32 = 3;
const ROUTE_CHAT: i32 = 4;
const ROUTE_USAGE: i32 = 5;
const ROUTE_OTP: i32 = 6;
const ROUTE_LOGIN: i32 = 7;
const ROUTE_KEYS: i32 = 8;
const ROUTE_ME: i32 = 9;
const ROUTE_ADMIN_HEALTH: i32 = 10;
const ROUTE_ADMIN_PRICING: i32 = 11;
const ROUTE_ADMIN_BILLING: i32 = 12;
const ROUTE_ADMIN_BACKUP: i32 = 13;
const ROUTE_RESPONSES: i32 = 14;
const ROUTE_MCP: i32 = 15;
const ROUTE_KEY_REVOKE: i32 = 24;
const ROUTE_CTL_INGEST: i32 = 25;
const ROUTE_ADMIN_USERS: i32 = 31;
const ROUTE_ADMIN_PROVIDERS: i32 = 32;
const ROUTE_ADMIN_PAGE: i32 = 33;
const ROUTE_ADMIN_JS: i32 = 34;
const ROUTE_EDGE_ROUTE: i32 = 35;
const ROUTE_EDGE_FAIL: i32 = 36;
const ROUTE_NODE_STATUS: i32 = 37;
const ROUTE_EDGE_PROXY: i32 = 38;
const ROUTE_NODE_SPOOL: i32 = 39;
const ROUTE_REQUESTS: i32 = 40;
const ROUTE_ADMIN_PRICES: i32 = 41;
const ROUTE_ADMIN_MODELS: i32 = 42;
const ROUTE_ADMIN_BIND: i32 = 43;
const ROUTE_ADMIN_AUDIT: i32 = 44;
const ROUTE_BUDGET: i32 = 30;
const ROUTE_ESTIMATE: i32 = 29;
const ROUTE_USAGE_CSV: i32 = 28;
const ROUTE_UI: i32 = 26;
const ROUTE_UI_JS: i32 = 27;
const ROUTE_NOTIFICATIONS: i32 = 45;
const ROUTE_CTL_EPOCH: i32 = 21;
const ROUTE_CTL_ASSIGN: i32 = 22;
const ROUTE_CTL_DRAIN: i32 = 23;
const ROUTE_CTL_REGISTER: i32 = 16;
const ROUTE_CTL_HEARTBEAT: i32 = 17;
const ROUTE_CTL_CONFIG: i32 = 18;
const ROUTE_CTL_STATUS: i32 = 19;

/// chat 请求体上限（与 CHAT_PAYLOAD_MAX 一致；超了回 413）。
const SRV_BODY_CAP: usize = 32768;

// 固定回包体（切片字面量放模块级常量：编译器已修，但这样也不会碰异步帧退化）
const SRV_JSON_HEALTH: &[byte] = &"{\"ok\":true}"[0: 11];
const SRV_JSON_MODELS: &[byte] = &"{\"object\":\"list\",\"data\":[]}"[0: 27];
const SRV_JSON_OK: &[byte] = &"{\"ok\":true}"[0: 11];
const SRV_JSON_404: &[byte] = &"{\"error\":\"not found\"}"[0: 21];
const SRV_JSON_400: &[byte] = &"{\"error\":\"bad request\"}"[0: 23];
const SRV_JSON_431: &[byte] = &"{\"error\":\"head too large\"}"[0: 26];
const SRV_JSON_501: &[byte] = &"{\"error\":\"chat not implemented\"}"[0: 32];
const SRV_JSON_401: &[byte] = &"{\"error\":\"unauthorized\"}"[0: 24];
const SRV_JSON_413: &[byte] = &"{\"error\":\"payload too large\"}"[0: 29];
const SRV_JSON_503: &[byte] = &"{\"error\":\"service unavailable\"}"[0: 31];
const SRV_JSON_502: &[byte] = &"{\"error\":\"upstream failed\"}"[0: 27];
const SRV_JSON_421: &[byte] = &"{\"error\":\"stale epoch\"}"[0: 23];
const SRV_CTYPE_JSON: &[byte] = &"application/json"[0: 16];
const SRV_CTYPE_SSE: &[byte] = &"text/event-stream"[0: 17];
const SRV_SSE_LINE: &[byte] = &"data: {}\n\n"[0: 10];

export error ListenFailed;
export error BadIp;

/// 服务计数。`active`/`max_active` 用来验证并发度，`rejected` 记录槽位打满。
export struct ServeStats {
    conns: u64,
    requests: u64,
    bad: u64,
    active: u64,
    max_active: u64,
    sse: u64,
    rejected: u64,
}

/// 一条连接的完整状态。槽表是模块级 `var`（.bss，按需提交），不放栈上。
struct SrvConn {
    fd: i32,
    state: i32,
    // 读缓冲：`[in_pos, in_len)` 是尚未消费的字节
    in: [byte: SRV_IO_CAP],
    in_len: usize,
    in_pos: usize,
    // 写缓冲：`[out_pos, out_len)` 是尚未发出的字节
    out: [byte: SRV_OUT_CAP],
    out_len: usize,
    out_pos: usize,
    route: i32,
    keep: bool,
    is_head_req: bool,
    is_get: bool,
    // chat：Authorization 头 + 请求体（仅 ROUTE_CHAT 采集，其他路由只排空）
    auth: [byte: 256],
    auth_len: usize,
    path: [byte: 1024],
    path_len: usize,
    body: [byte: SRV_BODY_CAP],
    body_len: usize,
    body_overflow: bool,
    // 包体
    body_left: u64,
    chunked: bool,
    chunk_left: u64,
    chunk_phase: i32,
    // SSE
    sse_left: u32,
    sse_next: u64,
}

var g_conns: [SrvConn: SRV_MAX_CONNS] = [];
/// B1 meta.db（`--meta` 时打开）与节点 id；用于 controller 选主/心跳/配置接口。
var g_meta: Db = Db{ h: null };
var g_meta_ready: bool = false;
var g_node_id: [byte: 64] = [0: 64];
var g_node_id_len: usize = 0;

fn srv_meta_setup(path: &[byte], node_id: &[byte]) void {
    g_meta_ready = false;
    g_node_id_len = 0;
    var i: usize = 0;
    while i < node_id.len && i < 64 {
        g_node_id[i] = node_id[i];
        i = i + 1;
    }
    g_node_id_len = i;
    if path.len == 0 {
        return;
    }
    meta_open(&g_meta, path) catch {
        return;
    };
    g_meta_ready = true;
    var nb: [byte: 64] = [0: 64];
    var m: usize = 0;
    while m < g_node_id_len && m < 64 {
        nb[m] = g_node_id[m];
        m = m + 1;
    }
    meta_node_register(&g_meta, nb[0: m], &"controller"[0: 10],
        &""[0: 0], store_now()) catch {};
}

/// 把节点 id 拷到局部缓冲（模块级数组不能直接做运行时切片）。
fn srv_node_copy(out: &byte, cap: usize) usize {
    var i: usize = 0;
    while i < g_node_id_len && i < cap {
        out[i] = g_node_id[i];
        i = i + 1;
    }
    return i;
}

/// B2：node → controller 的 uplink（--uplink ip:port）。
var g_uplink_ready: bool = false;
var g_uplink_ip: [byte: 64] = [0: 64];
var g_uplink_ip_len: usize = 0;
var g_uplink_port: u16 = 0;
var g_uplink_last_ms: u64 = 0;
var g_cfg_last_ms: u64 = 0;
var g_spool_last_ms: u64 = 0;
var g_self_addr: [byte: 128] = [0: 128];
var g_self_addr_len: usize = 0;
var g_cfg_version: i64 = 0;
var g_cfg_epoch: i64 = 0;
var g_rebalance_last_ms: u64 = 0;

/// B2：拉取并应用 controller 下发的 config 快照。
fn srv_cfg_pull(ip: &[byte], node_id: &[byte]) void {
    var raw: [byte: 8192] = [0: 8192];
    var rn: usize = 0;
    _ = uplink_config_node(ip, g_uplink_port, node_id, &raw[0], 8192, &rn, 2000) catch {
        0 as i32;
    };
    if rn == 0 {
        return;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, raw[0: rn]) catch {
        return;
    };
    const root: i32 = json_root(&d);
    g_cfg_version = json_i64(&d, json_get(&d, root, &"version"[0: 7]));
    g_cfg_epoch = json_i64(&d, json_get(&d, root, &"epoch"[0: 5]));
    const arr: i32 = json_get(&d, root, &"assign"[0: 6]);
    if arr < 0 {
        return;
    }
    const n: usize = json_arr_len(&d, arr);
    var nodes: [byte: 4096] = [0: 4096];
    _ = nodes;
    const narr: i32 = json_get(&d, root, &"nodes"[0: 5]);
    if narr >= 0 {
        const nn: usize = json_arr_len(&d, narr);
        edge_addr_clear();
        var k: usize = 0;
        while k < nn && k < 32 {
            const it2: i32 = json_arr_at(&d, narr, k);
            var nid: [byte: 64] = [0: 64];
            const nidl: usize = json_str(&d, json_get(&d, it2, &"id"[0: 2]), &nid[0], 64);
            var nad: [byte: 128] = [0: 128];
            const nadl: usize = json_str(&d, json_get(&d, it2, &"addr"[0: 4]), &nad[0], 128);
            if nidl > 0 && nadl > 0 {
                _ = edge_addr_put(nid[0: nidl], nad[0: nadl]);
            }
            k = k + 1;
        }
    }
    edge_snapshot_clear();
    var i: usize = 0;
    while i < n && i < 128 {
        const it: i32 = json_arr_at(&d, arr, i);
        var sl: [byte: 128] = [0: 128];
        const sln: usize = json_str(&d, json_get(&d, it, &"slug"[0: 4]), &sl[0], 128);
        var nd: [byte: 64] = [0: 64];
        const ndn: usize = json_str(&d, json_get(&d, it, &"node"[0: 4]), &nd[0], 64);
        _ = edge_snapshot_put(sl[0: sln], nd[0: ndn]);
        i = i + 1;
    }
}

/// 记录本节点对外地址（`ip:port`），用于 uplink 注册上报与代理自环判定。
export fn srv_addr_set(host: &[byte], port: u16) void {
    g_self_addr_len = 0;
    var i: usize = 0;
    while i < host.len && i < 100 {
        g_self_addr[i] = host[i];
        i = i + 1;
    }
    g_self_addr_len = i;
    if g_self_addr_len == 0 {
        g_self_addr[0] = '1' as byte;
        g_self_addr[1] = '2' as byte;
        g_self_addr[2] = '7' as byte;
        g_self_addr[3] = '.' as byte;
        g_self_addr[4] = '0' as byte;
        g_self_addr[5] = '.' as byte;
        g_self_addr[6] = '0' as byte;
        g_self_addr[7] = '.' as byte;
        g_self_addr[8] = '1' as byte;
        g_self_addr_len = 9;
    }
    if g_self_addr_len < 124 {
        g_self_addr[g_self_addr_len] = ':' as byte;
        g_self_addr_len = g_self_addr_len + 1;
        var num: [byte: 8] = [0: 8];
        var nn: usize = 0;
        var v: u16 = port;
        if v == 0 {
            num[0] = '0' as byte;
            nn = 1;
        } else {
            while v > 0 && nn < 8 {
                num[nn] = (48 +% ((v % (10 as u16)) as u16)) as byte;
                v = v / (10 as u16);
                nn = nn + 1;
            }
        }
        while nn > 0 && g_self_addr_len < 127 {
            nn = nn - 1;
            g_self_addr[g_self_addr_len] = num[nn];
            g_self_addr_len = g_self_addr_len + 1;
        }
    }
}

fn srv_self_addr_copy(out: &byte, cap: usize) usize {
    var k: usize = 0;
    while k < g_self_addr_len && k < cap {
        out[k] = g_self_addr[k];
        k = k + 1;
    }
    return k;
}

/// 把 `ip:port` 拆成 ip 文本 + 端口；失败返回 false。
fn srv_split_addr(spec: &[byte], ip: &byte, ipcap: usize, ip_len: &usize, port: &u16) bool {
    var colon: usize = spec.len;
    var i: usize = 0;
    while i < spec.len {
        if spec[i] == (':' as byte) {
            colon = i;
        }
        i = i + 1;
    }
    if colon == 0 || colon >= spec.len {
        return false;
    }
    var k: usize = 0;
    while k < colon && k < ipcap {
        ip[k] = spec[k];
        k = k + 1;
    }
    ip_len[0] = k;
    var p: u16 = 0;
    var dg: usize = 0;
    k = colon + 1;
    while k < spec.len {
        const c: byte = spec[k];
        if c < ('0' as byte) || c > ('9' as byte) {
            return false;
        }
        p = p *% (10 as u16) +% ((c as u16) -% 48);
        dg = dg + 1;
        k = k + 1;
    }
    port[0] = p;
    return dg > 0 && p > 0;
}

/// B5：spool 文件路径 `<data_dir>/spool.jsonl`。
fn srv_spool_path(out: &byte, cap: usize) usize {
    var d: [byte: 256] = [0: 256];
    const dn: usize = runtime_dir_copy(&d[0], 256);
    var n: usize = 0;
    var i: usize = 0;
    while i < dn && n < cap {
        out[n] = d[i];
        n = n + 1;
        i = i + 1;
    }
    const suffix: &[byte] = &"/spool.jsonl"[0: 12];
    i = 0;
    while i < suffix.len && n < cap {
        out[n] = suffix[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

fn srv_spool_pending() usize {
    var path: [byte: 320] = [0: 320];
    const pn: usize = srv_spool_path(&path[0], 320);
    var buf: [byte: 64] = [0: 64];
    var bn: usize = 0;
    const has: bool = spool_try_read(path[0: pn], &buf[0], 64, &bn);
    if !has || bn == 0 {
        return 0 as usize;
    }
    return 1 as usize;
}

/// 逐行重放 spool；全部成功才清空（失败留待下次，保证不丢）。
fn srv_spool_flush(ip: &[byte]) void {
    var path: [byte: 320] = [0: 320];
    const pn: usize = srv_spool_path(&path[0], 320);
    var buf: [byte: 16384] = [0: 16384];
    var bn: usize = 0;
    const has: bool = spool_try_read(path[0: pn], &buf[0], 16384, &bn);
    if !has || bn == 0 {
        return;
    }
    var out: [byte: 2048] = [0: 2048];
    var on: usize = 0;
    var off: usize = 0;
    var all_ok: bool = true;
    while off < bn {
        var end: usize = off;
        while end < bn && buf[end] != (10 as byte) {
            end = end + 1;
        }
        if end > off {
            var nid: [byte: 64] = [0: 64];
            const nidl: usize = srv_node_copy(&nid[0], 64);
            const st: i32 = uplink_inject(ip, g_uplink_port, nid[0: nidl],
                buf[off: end - off], end - off, &out[0], 2048, &on, 2000) catch {
                0;
            };
            if st != 200 {
                all_ok = false;
                break;
            }
        }
        off = end + 1;
    }
    if all_ok {
        spool_clear(path[0: pn]);
    }
}

fn srv_uplink_setup(spec: &[byte]) void {
    g_uplink_ready = false;
    g_uplink_port = 0;
    g_uplink_ip_len = 0;
    var i: usize = 0;
    while i < spec.len && spec[i] != (58 as byte) && i < 64 {
        g_uplink_ip[i] = spec[i];
        i = i + 1;
    }
    g_uplink_ip_len = i;
    if i >= spec.len || spec[i] != (58 as byte) {
        return;
    }
    i = i + 1;
    var port: u16 = 0;
    var digits: usize = 0;
    while i < spec.len {
        const c: byte = spec[i];
        if c < ('0' as byte) || c > ('9' as byte) {
            break;
        }
        port = port *% (10 as u16) +% ((c as u16) -% 48);
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 || port == 0 || g_uplink_ip_len == 0 {
        return;
    }
    g_uplink_port = port;
    g_uplink_ready = true;
}

fn srv_uplink_copy(out: &byte, cap: usize) usize {
    var i: usize = 0;
    while i < g_uplink_ip_len && i < cap {
        out[i] = g_uplink_ip[i];
        i = i + 1;
    }
    return i;
}

/// A4 上游 TLS 上下文（serve 启动时初始化；bundle 由 --ca 注入）。
var g_up_ctx: HtcCtx = HtcCtx{};

/// 读 PEM CA bundle 到上游上下文；文件缺失/过大返回 false（不阻塞启动）。
fn srv_load_ca(path: &[byte]) bool {
    if path.len == 0 || path.len >= 512 {
        return false;
    }
    var p: [byte: 512] = [0: 512];
    var i: usize = 0;
    while i < path.len {
        p[i] = path[i];
        i = i + 1;
    }
    p[i] = 0 as byte;
    const fd: i32 = sys_open(&p[0] as *const byte, 0 as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var off: usize = 0;
    while off < HTC_BUNDLE_MAX {
        const r: !isize = sys_read(fd, &g_up_ctx.bundle[off], HTC_BUNDLE_MAX - off);
        const n: isize = r catch {
            return false;
        };
        if n <= 0 {
            break;
        }
        off = off +% (n as usize);
    }
    g_up_ctx.bundle_len = off;
    return off > 0;
}
var g_stop: i32 = 0;
var g_listen_fd: i32 = 0 - 1;
var g_epfd: i32 = 0 - 1;

/// SIGTERM/SIGINT 只置一个标志：真正的收尾在主循环里做（信号处理里不能分配、不能加锁）。
fn srv_on_signal(signum: i32) void {
    _ = signum;
    g_stop = 1;
}

fn srv_stop_requested() i32 {
    return g_stop;
}

/// 单调时钟毫秒。取不到时返回 0（SSE 会退化成每轮都推，不影响正确性）。
/// A4：查询账本前先刷批量队列，保证「刚请求完就能查到」。
fn srv_batch_sync() void {
    if !batch_ready() {
        return;
    }
    _ = batch_flush() catch {
        0 as usize;
    };
}

export fn srv_now_ms() u64 {
    var ts: TimeSpec = TimeSpec{};
    const r: !i32 = sys_clock_gettime(SRV_CLOCK_MONOTONIC, &ts);
    _ = r catch {
        return 0;
    };
    const secs: u64 = (ts.tv_sec as u64) * (1000 as u64);
    const nanos: u64 = (ts.tv_nsec as u64) / (1000000 as u64);
    return secs + nanos;
}

/// 从切片取底层指针（普通函数：`&"lit"[a: n]` 做普通调用实参是安全的）。
fn srv_ptr(s: &[byte]) &const byte {
    return s.ptr;
}

// ---------------------------------------------------------------
// 监听
// ---------------------------------------------------------------

/// 点分十进制 → 打包的 4 字节（高位在前）。返回值而不是写 `&byte` 出参。
export fn serve_parse_ipv4(s: &[byte]) !u32 {
    var octet: usize = 0;
    var val: u32 = 0;
    var digits: usize = 0;
    var packed: u32 = 0;
    var i: usize = 0;
    while i < s.len {
        const c: byte = s[i];
        if c >= ('0' as byte) && c <= ('9' as byte) {
            val = val *% 10 +% ((c as u32) - 48);
            if val > 255 {
                return error.BadIp;
            }
            digits = digits + 1;
        } else if c == ('.' as byte) {
            if digits == 0 || octet >= 3 {
                return error.BadIp;
            }
            packed = (packed *% 256) +% val;
            octet = octet + 1;
            val = 0;
            digits = 0;
        } else {
            return error.BadIp;
        }
        i = i + 1;
    }
    if digits == 0 || octet != 3 {
        return error.BadIp;
    }
    packed = (packed *% 256) +% val;
    return packed;
}

/// 建监听 socket 并 listen（非阻塞）。失败统一折叠成 `error.ListenFailed`。
export fn serve_listen(ip: &[byte], port: u16) !i32 {
    const packed: u32 = serve_parse_ipv4(ip) catch |_| {
        return error.BadIp;
    };
    const fd: i32 = try sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    var one: i32 = 1;
    _ = sys_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch |_| {
        _ = sys_close(fd) catch {};
        return error.ListenFailed;
    };
    var ipb: [byte: 4] = [0: 4];
    ipb[0] = ((packed >> 24) & 255u32) as byte;
    ipb[1] = ((packed >> 16) & 255u32) as byte;
    ipb[2] = ((packed >> 8) & 255u32) as byte;
    ipb[3] = (packed & 255u32) as byte;
    var addr: [byte: 16] = [0: 16];
    tcpx_sockaddr_v4(&ipb[0], port, &addr[0]);
    _ = sys_bind(fd, &addr[0] as &void, 16 as u32) catch |_| {
        _ = sys_close(fd) catch {};
        return error.ListenFailed;
    };
    _ = sys_listen(fd, SRV_BACKLOG) catch |_| {
        _ = sys_close(fd) catch {};
        return error.ListenFailed;
    };
    tcpx_set_nonblocking(fd) catch |_| {};
    return fd;
}

/// 监听口的本地端口（`port` 传 0 时由内核选）。
export fn serve_port(fd: i32) u16 {
    var alen: u32 = 16;
    var out: [byte: 16] = [0: 16];
    _ = sys_getsockname(fd, &out[0] as &void, &alen) catch |_| {
        return 0;
    };
    return ((out[2] as u16) * 256) + (out[3] as u16);
}

// ---------------------------------------------------------------
// 槽表
// ---------------------------------------------------------------

fn srv_slot_of(fd: i32) i32 {
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        if g_conns[i].fd == fd && g_conns[i].state != ST_FREE {
            return i as i32;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn srv_alloc_slot() i32 {
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        if g_conns[i].state == ST_FREE {
            return i as i32;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn srv_active_count() u64 {
    var n: u64 = 0;
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        if g_conns[i].state != ST_FREE {
            n = n +% 1;
        }
        i = i + 1;
    }
    return n;
}

fn srv_close_slot(slot: i32) void {
    if slot < 0 || (slot as usize) >= SRV_MAX_CONNS {
        return;
    }
    const i: usize = slot as usize;
    const fd: i32 = g_conns[i].fd;
    if fd >= 0 {
        _ = sys_epoll_ctl_del(g_epfd, fd) catch {};
        tcpx_close(fd);
    }
    g_conns[i].fd = 0 - 1;
    g_conns[i].state = ST_FREE;
    g_conns[i].in_len = 0;
    g_conns[i].in_pos = 0;
    g_conns[i].out_len = 0;
    g_conns[i].out_pos = 0;
    g_conns[i].sse_left = 0;
    g_conns[i].chunked = false;
    g_conns[i].body_left = 0;
    g_conns[i].chunk_left = 0;
    g_conns[i].chunk_phase = CH_SIZE;
}

/// 调整 fd 的 epoll 关注事件：平时只关心可读，有待写数据时加 EPOLLOUT。
fn srv_set_interest(c: &SrvConn, want_write: bool) void {
    var evs: u32 = EPOLLIN as u32;
    if want_write {
        evs = evs | (EPOLLOUT as u32);
    }
    var ev: EpollEvent = epoll_event_with_fd(evs, c.fd);
    _ = sys_epoll_ctl(g_epfd, EPOLL_CTL_MOD, c.fd, &ev) catch {};
}

// ---------------------------------------------------------------
// 缓冲与解析小工具
// ---------------------------------------------------------------

/// 把 `[in_pos, in_len)` 挪到缓冲区开头。
fn srv_compact(c: &SrvConn) void {
    if c.in_pos == 0 {
        return;
    }
    var n: usize = 0;
    var i: usize = c.in_pos;
    while i < c.in_len && n < SRV_IO_CAP {
        const v: byte = c.in[i];
        c.in[n] = v;
        n = n + 1;
        i = i + 1;
    }
    c.in_len = n;
    c.in_pos = 0;
}

/// 从 `from` 起找 CRLF，返回其下标；没有返回 -1。
fn srv_find_crlf(c: &SrvConn, from: usize) i64 {
    var i: usize = from;
    while i + 1 < c.in_len {
        if i + 1 >= SRV_IO_CAP {
            return 0 - 1;
        }
        if c.in[i] == (13 as byte) && c.in[i + 1] == (10 as byte) {
            return i as i64;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// 解析 `[from, end)` 的十六进制块长度（`;` 之后是扩展，忽略）。
fn srv_hex_size(c: &SrvConn, from: usize, end: usize) i64 {
    var v: i64 = 0;
    var any: bool = false;
    var i: usize = from;
    while i < end && i < SRV_IO_CAP {
        const ch: byte = c.in[i];
        var d: i64 = 0 - 1;
        if ch >= ('0' as byte) && ch <= ('9' as byte) {
            d = (ch as i64) - 48;
        } else if ch >= ('a' as byte) && ch <= ('f' as byte) {
            d = (ch as i64) - 87;
        } else if ch >= ('A' as byte) && ch <= ('F' as byte) {
            d = (ch as i64) - 55;
        } else if ch == (';' as byte) {
            break;
        } else {
            return 0 - 1;
        }
        v = v *% 16 +% d;
        if v < 0 {
            return 0 - 1;
        }
        any = true;
        i = i + 1;
    }
    if !any {
        return 0 - 1;
    }
    return v;
}

fn srv_path_is(req: &HsrvReq, lit: &[byte]) bool {
    if req.path_len < lit.len {
        return false;
    }
    var i: usize = 0;
    while i < lit.len {
        if i >= HSRV_PATH_MAX {
            return false;
        }
        if req.path[i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    if req.path_len == lit.len {
        return true;
    }
    const q: usize = lit.len;
    var next_is_query: bool = false;
    if q < HSRV_PATH_MAX {
        next_is_query = req.path[q] == ('?' as byte);
    }
    return next_is_query;
}

fn srv_route_of(req: &HsrvReq) i32 {
    if srv_path_is(req, &"/healthz"[0: 8]) {
        return ROUTE_HEALTH;
    }
    if srv_path_is(req, &"/v1/models"[0: 10]) {
        return ROUTE_MODELS;
    }
    if srv_path_is(req, &"/v1/_sse"[0: 8]) {
        return ROUTE_SSE;
    }
    if srv_path_is(req, &"/v1/chat/completions"[0: 20]) {
        return ROUTE_CHAT;
    }
    if srv_path_is(req, &"/v1/usage"[0: 9]) {
        return ROUTE_USAGE;
    }
    if srv_path_is(req, &"/v1/auth/otp"[0: 12]) {
        return ROUTE_OTP;
    }
    if srv_path_is(req, &"/v1/auth/login"[0: 14]) {
        return ROUTE_LOGIN;
    }
    if srv_path_is(req, &"/v1/keys/revoke"[0: 15]) {
        return ROUTE_KEY_REVOKE;
    }
    if srv_path_is(req, &"/v1/requests"[0: 12]) {
        return ROUTE_REQUESTS;
    }
    if srv_path_is(req, &"/node/spool"[0: 11]) {
        return ROUTE_NODE_SPOOL;
    }
    if srv_path_is(req, &"/edge/proxy"[0: 11]) {
        return ROUTE_EDGE_PROXY;
    }
    if srv_path_is(req, &"/node/status"[0: 12]) {
        return ROUTE_NODE_STATUS;
    }
    if srv_path_is(req, &"/edge/fail"[0: 10]) {
        return ROUTE_EDGE_FAIL;
    }
    if srv_path_is(req, &"/edge/route"[0: 11]) {
        return ROUTE_EDGE_ROUTE;
    }
    if srv_path_is(req, &"/ui/admin.js"[0: 12]) {
        return ROUTE_ADMIN_JS;
    }
    if srv_path_is(req, &"/admin/users"[0: 12]) {
        return ROUTE_ADMIN_USERS;
    }
    if srv_path_is(req, &"/admin/providers"[0: 16]) {
        return ROUTE_ADMIN_PROVIDERS;
    }
    if srv_path_is(req, &"/admin"[0: 6]) {
        return ROUTE_ADMIN_PAGE;
    }
    if srv_path_is(req, &"/v1/keys"[0: 8]) {
        return ROUTE_KEYS;
    }
    if srv_path_is(req, &"/v1/me"[0: 6]) {
        return ROUTE_ME;
    }
    if srv_path_is(req, &"/v1/budget"[0: 10]) {
        return ROUTE_BUDGET;
    }
    if srv_path_is(req, &"/v1/notifications"[0: 17]) {
        return ROUTE_NOTIFICATIONS;
    }
    if srv_path_is(req, &"/v1/estimate"[0: 12]) {
        return ROUTE_ESTIMATE;
    }
    if srv_path_is(req, &"/v1/usage.csv"[0: 13]) {
        return ROUTE_USAGE_CSV;
    }
    if srv_path_is(req, &"/ui/app.js"[0: 10]) {
        return ROUTE_UI_JS;
    }
    if srv_path_is(req, &"/"[0: 1]) || srv_path_is(req, &"/ui"[0: 3]) {
        return ROUTE_UI;
    }
    if srv_path_is(req, &"/controller/ingest"[0: 18]) {
        return ROUTE_CTL_INGEST;
    }
    if srv_path_is(req, &"/controller/epoch"[0: 17]) {
        return ROUTE_CTL_EPOCH;
    }
    if srv_path_is(req, &"/controller/assign"[0: 18]) {
        return ROUTE_CTL_ASSIGN;
    }
    if srv_path_is(req, &"/controller/drain"[0: 17]) {
        return ROUTE_CTL_DRAIN;
    }
    if srv_path_is(req, &"/controller/register"[0: 20]) {
        return ROUTE_CTL_REGISTER;
    }
    if srv_path_is(req, &"/controller/heartbeat"[0: 21]) {
        return ROUTE_CTL_HEARTBEAT;
    }
    if srv_path_is(req, &"/controller/config"[0: 18]) {
        return ROUTE_CTL_CONFIG;
    }
    if srv_path_is(req, &"/controller/status"[0: 18]) {
        return ROUTE_CTL_STATUS;
    }
    if srv_path_is(req, &"/mcp"[0: 4]) {
        return ROUTE_MCP;
    }
    if srv_path_is(req, &"/v1/responses"[0: 13]) {
        return ROUTE_RESPONSES;
    }
    if srv_path_is(req, &"/admin/health"[0: 13]) {
        return ROUTE_ADMIN_HEALTH;
    }
    if srv_path_is(req, &"/admin/pricing"[0: 14]) {
        return ROUTE_ADMIN_PRICING;
    }
    if srv_path_is(req, &"/admin/price-entries"[0: 20]) {
        return ROUTE_ADMIN_PRICES;
    }
    if srv_path_is(req, &"/admin/models"[0: 13]) {
        return ROUTE_ADMIN_MODELS;
    }
    if srv_path_is(req, &"/admin/bind"[0: 11]) {
        return ROUTE_ADMIN_BIND;
    }
    if srv_path_is(req, &"/admin/audit"[0: 12]) {
        return ROUTE_ADMIN_AUDIT;
    }
    if srv_path_is(req, &"/admin/billing"[0: 14]) {
        return ROUTE_ADMIN_BILLING;
    }
    if srv_path_is(req, &"/admin/backup"[0: 13]) {
        return ROUTE_ADMIN_BACKUP;
    }
    return ROUTE_404;
}

// ---------------------------------------------------------------
// 响应构造
// ---------------------------------------------------------------

fn srv_put(out: &byte, cap: usize, off: &usize, data: &[byte]) bool {
    var i: usize = 0;
    while i < data.len {
        if off[0] >= cap {
            return false;
        }
        out[off[0]] = data[i];
        off[0] = off[0] + 1;
        i = i + 1;
    }
    return true;
}

/// 组装静态回包（头 + body），并进入 WRITE。
/// C6：HTML/JS 响应的安全头（CSP 只允许同源脚本，禁止内联；无 cookie 故无 CSRF 面）。
const SRV_SEC_HEADERS: &[byte] = &"Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\nX-Frame-Options: DENY\r\n"[0: 249];

fn srv_static_ct(c: &SrvConn, status: i32, body: &[byte], keep: bool,
    ctype: &[byte], ctype_len: usize) void {
    var n: usize = 0;
    if ctype_len == 23 || ctype_len == 22 {
        n = hsrv_resp_head_extra(&c.out[0], SRV_OUT_CAP, status, ctype, ctype_len,
            body.len as i64, false, keep, SRV_SEC_HEADERS[0: 249], 249);
    } else {
        n = hsrv_resp_head(&c.out[0], SRV_OUT_CAP, status, ctype, ctype_len,
            body.len as i64, false, keep);
    }
    var off2: usize = n;
    _ = srv_put(&c.out[0], SRV_OUT_CAP, &off2, body);
    c.out_len = off2;
    c.out_pos = 0;
    c.state = ST_WRITE;
}

fn srv_static(c: &SrvConn, status: i32, body: &[byte], keep: bool) void {
    srv_static_ct(c, status, body, keep, SRV_CTYPE_JSON[0: 16], 16);
}

/// SSE 结束/出错：直接切到 ST_WRITE 并关闭连接（流式响应已绕过 out 缓冲）。
fn srv_chat_close(c: &SrvConn) void {
    c.keep = false;
    c.out_len = 0;
    c.out_pos = 0;
    c.state = ST_WRITE;
}

/// 阻塞发送（流式路径把 fd 临时切成阻塞，写完即关连接）。
fn srv_send_all(fd: i32, data: &[byte]) bool {
    var off: usize = 0;
    while off < data.len {
        const r: !isize = sys_send(fd, &data.ptr[off], data.len - off, 0);
        const n: isize = r catch |err| {
            if @error_id(err) as i32 == EINTR {
                continue;
            }
            return false;
        };
        if n <= 0 {
            return false;
        }
        off = off +% (n as usize);
    }
    return true;
}

/// 流式 chat：打开上游 → 逐事件 chunk 透传 → 终止块。阻塞，写完关连接。
fn srv_chat_stream(c: &SrvConn, plan: &ChatPlan, cfg: &const HttppConfig, nowu: u64,
    user_id: i64) void {
    var call: HtcCall = HtcCall{};
    htc_call_init(&call);
    defer { htc_call_free(&call); }
    const deadline: u64 = nowu +% 10000;
    const o: !i32 = wait_i32(htc_open_async(cfg, &g_up_ctx, &"POST"[0: 4],
        plan.path[0: plan.path_len], plan.payload[0: plan.payload_len], true, nowu, deadline, &call));
    const orc: i32 = o catch |_| {
        lb_report(plan.provider_id, false, store_now());
        srv_static(c, 502, SRV_JSON_502, c.keep);
        return;
    };
    if orc != 0 {
        lb_report(plan.provider_id, false, store_now());
        srv_static(c, 502, SRV_JSON_502, c.keep);
        return;
    }
    lb_report(plan.provider_id, true, store_now());
    // 临时阻塞发送：SSE 期间不参与 epoll 写事件
    const fl: !i32 = sys_fcntl(c.fd, 3, 0);
    const flags: i32 = fl catch {
        0;
    };
    if flags != 0 {
        _ = sys_fcntl(c.fd, 4, flags & (0 -% 2049)) catch {};
    }
    var head: [byte: 256] = [0: 256];
    const hn: usize = hsrv_resp_head(&head[0], 256, 200, &SRV_CTYPE_SSE[0: 17], 17,
        0 as i64, true, false);
    if !srv_send_all(c.fd, head[0: hn]) {
        srv_chat_close(c);
        return;
    }
    var events: i32 = 0;
    var done: bool = false;
    var jd: JsonDoc = JsonDoc{};
    var usage: PriceUsage = PriceUsage{ input_tokens: 0, output_tokens: 0, cache_read_tokens: 0 };
    var usage_found: bool = false;
    while events < 4096 && !done {
        var has: bool = false;
        const r: !i32 = wait_i32(htc_next_event_async(&call, &has, 5000 as u64));
        const rr: i32 = r catch |_| {
            break;
        };
        if rr == 0 || !has {
            break;
        }
        if sse_is_done(&call.sse) {
            done = true;
        } else {
            const dl0: usize = call.sse.ev.data_len;
            if dl0 > 0 && call.sse.ev.data[0] == (123 as byte) {
                json_parse(&jd, call.sse.ev.data[0: dl0]) catch {};
                if billing_usage_parse(&jd, json_root(&jd), &usage) {
                    usage_found = true;
                }
            }
        }
        var eb: [byte: 16384] = [0: 16384];
        var el: usize = 0;
        const pre: &[byte] = &"data: "[0: 6];
        var i: usize = 0;
        while i < 6 {
            eb[el] = pre[i];
            el = el + 1;
            i = i + 1;
        }
        const dl: usize = call.sse.ev.data_len;
        i = 0;
        while i < dl && el < 16380 {
            eb[el] = call.sse.ev.data[i];
            el = el + 1;
            i = i + 1;
        }
        if el == 0 || eb[el - 1] != (10 as byte) {
            eb[el] = 10 as byte;
            el = el + 1;
        }
        eb[el] = 10 as byte;
        el = el + 1;
        var ob: [byte: 16400] = [0: 16400];
        const on: usize = hsrv_chunk(&ob[0], 16400, eb[0: el], el);
        if on == 0 || !srv_send_all(c.fd, ob[0: on]) {
            srv_chat_close(c);
            return;
        }
        sse_consume(&call.sse);
        events = events + 1;
    }
    _ = srv_send_all(c.fd, &"0\r\n\r\n"[0: 5]);
    if usage_found {
        var rid: [byte: 32] = [0: 32];
        var ridn: usize = 0;
        ridn = store_new_slug(&rid[0], 32) catch {
            0 as usize;
        };
        if ridn > 0 {
            var settle: BillingResult = BillingResult{ cost_nano: 0, price_nano: 0, rate_version: 0, duplicate: false, found: false };
            // A4：只查价 + 入队，批量落库在事件循环里做
            billing_settle_deferred(rid[0: ridn], user_id, store_now(), 0,
                plan.model[0: plan.model_len],
                plan.provider_name[0: plan.provider_name_len], &usage, &settle) catch {};
        }
    }
    srv_chat_close(c);
}

/// A6：/v1/models 从 enabled 供应商的模型映射里取（公开，便于客户端探活）。
fn srv_models(c: &SrvConn) void {
    const keep: bool = c.keep;
    if !runtime_ready() {
        srv_static(c, 200, SRV_JSON_MODELS, keep);
        return;
    }
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"object"[0: 6]);
    jsonw_str(&w, &"list"[0: 4]);
    jsonw_key(&w, &"data"[0: 4]);
    jsonw_arr(&w);
    var st: DbStmt = dbx_prepare(runtime_db(),
        "select distinct m.model from provider_models m join providers p on p.id = m.provider_id where p.enabled = 1 order by m.model limit 256" as &const byte) catch {
        jsonw_end_arr(&w);
        jsonw_end_obj(&w);
        srv_static(c, 200, jsonw_span(&w), keep);
        return;
    };
    var n: i32 = 0;
    while n < 256 {
        if dbx_step(&st) != 1 {
            break;
        }
        var mbuf: [byte: 64] = [0: 64];
        const mn: usize = dbx_col_text(&st, 0, &mbuf[0], 64);
        jsonw_obj(&w);
        jsonw_key(&w, &"id"[0: 2]);
        jsonw_str(&w, mbuf[0: mn]);
        jsonw_key(&w, &"object"[0: 6]);
        jsonw_str(&w, &"model"[0: 5]);
        jsonw_key(&w, &"owned_by"[0: 8]);
        jsonw_str(&w, &"aigw"[0: 4]);
        jsonw_end_obj(&w);
        n = n + 1;
    }
    dbx_finalize(&st);
    jsonw_end_arr(&w);
    jsonw_end_obj(&w);
    if !jsonw_ok(&w) {
        srv_static(c, 200, SRV_JSON_MODELS, keep);
        return;
    }
    srv_static(c, 200, jsonw_span(&w), keep);
}

/// 从 query 里取一个整数值（`?a=1&b=2`）；没有返回 -1。
fn srv_query_day(path: &const byte, n: usize, key: &const byte, kn: usize) i64 {
    var i: usize = 0;
    while i < n && path[i] != (63 as byte) {
        i = i + 1;
    }
    if i >= n {
        return 0 - 1;
    }
    var j: usize = i + 1;
    while j + kn + 1 <= n {
        var same: bool = true;
        var k: usize = 0;
        while k < kn {
            if path[j + k] != key[k] {
                same = false;
                break;
            }
            k = k + 1;
        }
        if same && path[j + kn] == (61 as byte) {
            var v: i64 = 0;
            var digits: usize = 0;
            var m: usize = j + kn + 1;
            while m < n {
                const c: byte = path[m];
                if c < ('0' as byte) || c > ('9' as byte) {
                    break;
                }
                v = v *% (10 as i64) +% ((c as i64) -% 48);
                digits = digits + 1;
                m = m + 1;
            }
            if digits > 0 {
                return v;
            }
            return 0 - 1;
        }
        j = j + 1;
    }
    return 0 - 1;
}

/// A6：/v1/usage 读 usage_daily 汇总（按天，用户级）。
/// B5：把一行 rollup 拷到目标（结构体含数组，逐字段/逐字节复制）。
fn srv_rollup_copy(dst: &RollupRow, src: &RollupRow) void {
    dst.day = src.day;
    dst.user_id = src.user_id;
    dst.model_len = src.model_len;
    dst.provider_len = src.provider_len;
    dst.period_len = src.period_len;
    dst.requests = src.requests;
    dst.input_tokens = src.input_tokens;
    dst.output_tokens = src.output_tokens;
    dst.cache_read_tokens = src.cache_read_tokens;
    dst.cost_nano = src.cost_nano;
    dst.price_nano = src.price_nano;
    var i: usize = 0;
    while i < ROLLUP_MODEL_MAX {
        dst.model[i] = src.model[i];
        i = i + 1;
    }
    i = 0;
    while i < ROLLUP_PROVIDER_MAX {
        dst.provider[i] = src.provider[i];
        i = i + 1;
    }
    i = 0;
    while i < ROLLUP_PERIOD_MAX {
        dst.period[i] = src.period[i];
        i = i + 1;
    }
}

/// B5：controller 分片模式下合并各分片；node/单机直接查 runtime DB。
fn srv_rollup_query(uid: i64, from_day: i64, to_day: i64, out: &RollupRow,
    cap: usize) usize {
    if !shard_active() {
        return rollup_query(runtime_db(), uid, from_day, to_day, out, cap) catch {
            0 as usize;
        };
    }
    var n: usize = 0;
    var k: i32 = 0;
    while k < SHARD_K {
        if uid <= 0 || shard_of(uid) == k {
            var part: [RollupRow: 64] = [];
            const pn: usize = rollup_query(shard_db(k), uid, from_day, to_day, &part[0], 64) catch {
                0 as usize;
            };
            var j: usize = 0;
            while j < pn && j < 64 && n < cap {
                srv_rollup_copy(&out[n], &part[j]);
                n = n + 1;
                j = j + 1;
            }
        }
        k = k + 1;
    }
    return n;
}

fn srv_usage(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    srv_batch_sync();
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    var tok: [byte: 256] = [0: 256];
    const tn: usize = chat_bearer_span(&c.auth[0], c.auth_len, &tok[0], 256);
    if tn == 0 {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var key: StoreKey = StoreKey{ key_id: 0, user_id: 0, rpm: 0, tpm: 0 };
    // A4 快路径：同一 Key 的连续请求走单槽缓存（TTL 2s），省一次 DB 校验。
    store_verify_key_fast(runtime_db(), tok[0: tn], store_now(), &key) catch {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    };
    const today: i64 = store_now() / (86400 as i64);
    var from_day: i64 = srv_query_day(&c.path[0], c.path_len, &"from_day"[0: 8], 8);
    if from_day < 0 {
        from_day = today -% 6;
    }
    var to_day: i64 = srv_query_day(&c.path[0], c.path_len, &"to_day"[0: 6], 6);
    if to_day < 0 {
        to_day = today;
    }
    if from_day < 0 || to_day < from_day {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    var rows: [RollupRow: 64] = [];
    var n: usize = 0;
    n = srv_rollup_query(key.user_id, from_day, to_day, &rows[0], 64);
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"object"[0: 6]);
    jsonw_str(&w, &"list"[0: 4]);
    jsonw_key(&w, &"from_day"[0: 8]);
    jsonw_i64(&w, from_day);
    jsonw_key(&w, &"to_day"[0: 6]);
    jsonw_i64(&w, to_day);
    jsonw_key(&w, &"data"[0: 4]);
    jsonw_arr(&w);
    var t_req: i64 = 0;
    var t_in: i64 = 0;
    var t_out: i64 = 0;
    var t_cache: i64 = 0;
    var t_cost: i64 = 0;
    var t_price: i64 = 0;
    var i: usize = 0;
    while i < n {
        jsonw_obj(&w);
        jsonw_key(&w, &"day"[0: 3]);
        jsonw_i64(&w, rows[i].day);
        jsonw_key(&w, &"model"[0: 5]);
        jsonw_str(&w, rows[i].model[0: rows[i].model_len]);
        jsonw_key(&w, &"provider"[0: 8]);
        jsonw_str(&w, rows[i].provider[0: rows[i].provider_len]);
        jsonw_key(&w, &"period"[0: 6]);
        jsonw_str(&w, rows[i].period[0: rows[i].period_len]);
        jsonw_key(&w, &"requests"[0: 8]);
        jsonw_i64(&w, rows[i].requests);
        jsonw_key(&w, &"input_tokens"[0: 12]);
        jsonw_i64(&w, rows[i].input_tokens);
        jsonw_key(&w, &"output_tokens"[0: 13]);
        jsonw_i64(&w, rows[i].output_tokens);
        jsonw_key(&w, &"cache_read_tokens"[0: 17]);
        jsonw_i64(&w, rows[i].cache_read_tokens);
        jsonw_key(&w, &"cost_nano"[0: 9]);
        jsonw_i64(&w, rows[i].cost_nano);
        jsonw_key(&w, &"price_nano"[0: 10]);
        jsonw_i64(&w, rows[i].price_nano);
        jsonw_end_obj(&w);
        t_req = t_req +% rows[i].requests;
        t_in = t_in +% rows[i].input_tokens;
        t_out = t_out +% rows[i].output_tokens;
        t_cache = t_cache +% rows[i].cache_read_tokens;
        t_cost = t_cost +% rows[i].cost_nano;
        t_price = t_price +% rows[i].price_nano;
        i = i + 1;
    }
    jsonw_end_arr(&w);
    jsonw_key(&w, &"totals"[0: 6]);
    jsonw_obj(&w);
    jsonw_key(&w, &"requests"[0: 8]);
    jsonw_i64(&w, t_req);
    jsonw_key(&w, &"input_tokens"[0: 12]);
    jsonw_i64(&w, t_in);
    jsonw_key(&w, &"output_tokens"[0: 13]);
    jsonw_i64(&w, t_out);
    jsonw_key(&w, &"cache_read_tokens"[0: 17]);
    jsonw_i64(&w, t_cache);
    jsonw_key(&w, &"cost_nano"[0: 9]);
    jsonw_i64(&w, t_cost);
    jsonw_key(&w, &"price_nano"[0: 10]);
    jsonw_i64(&w, t_price);
    jsonw_key(&w, &"profit_nano"[0: 11]);
    jsonw_i64(&w, t_price -% t_cost);
    jsonw_end_obj(&w);
    jsonw_end_obj(&w);
    if !jsonw_ok(&w) {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    srv_static(c, 200, jsonw_span(&w), keep);
}

/// chat：鉴权 → 解析/路由 → 非流式结算 / 流式透传。
fn srv_chat(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var tok: [byte: 256] = [0: 256];
    const tn: usize = chat_bearer_span(&c.auth[0], c.auth_len, &tok[0], 256);
    if tn == 0 {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var key: StoreKey = StoreKey{ key_id: 0, user_id: 0, rpm: 0, tpm: 0 };
    // A4 快路径：同一 Key 的连续请求走单槽缓存（TTL 2s），省一次 DB 校验。
    store_verify_key_fast(runtime_db(), tok[0: tn], store_now(), &key) catch {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    };
    var plan: ChatPlan = ChatPlan{};
    chat_prepare_span_session(runtime_db(), &c.body[0], c.body_len, tok[0: tn],
        store_now(), &plan) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    var attempts: i32 = 0;
    while true {
        var cfg: HttppConfig = httpp_empty();
        if !upstream_config(&plan.host[0], plan.host_len, plan.port, plan.auth_type,
            &plan.secret[0], plan.secret_len, &cfg) {
            srv_static(c, 400, SRV_JSON_400, keep);
            return;
        }
        const nowu: u64 = now_ms() catch {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        };
        if plan.stream {
            srv_chat_stream(c, &plan, &cfg, nowu, key.user_id);
            return;
        }
        var resp: [byte: 8192] = [0: 8192];
        var st: i32 = 0;
        var rn: usize = 0;
        var failed: bool = false;
        upstream_post(&g_up_ctx, &cfg, plan.path[0: plan.path_len],
            plan.payload[0: plan.payload_len], nowu, nowu +% 60000,
            &resp[0], 8192, &st, &rn) catch {
            failed = true;
        };
        if failed {
            lb_report(plan.provider_id, false, store_now());
            // A8：硬失败后先熔断该 provider，重试才会换下一家（否则同 session 亲和会挑回同一家）。
            lb_block_for(plan.provider_id, store_now(), 30);
            var dbgb: [byte: 48] = [0: 48];
            var di: usize = 0;
            while di < 24 {
                dbgb[di] = 0;
                di = di + 1;
            }
            attempts = attempts +% 1;
            if attempts >= 3 {
                srv_static(c, 502, SRV_JSON_502, keep);
                return;
            }
            chat_prepare_span_session(runtime_db(), &c.body[0], c.body_len, tok[0: tn],
                store_now(), &plan) catch {
                srv_static(c, 502, SRV_JSON_502, keep);
                return;
            };
            continue;
        }
        lb_report(plan.provider_id, true, store_now());
        if st != 200 {
            srv_static(c, st, resp[0: rn], keep);
            return;
        }
        var rid: [byte: 32] = [0: 32];
        var ridn: usize = 0;
        ridn = store_new_slug(&rid[0], 32) catch {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        };
        var settle: BillingResult = BillingResult{ cost_nano: 0, price_nano: 0, rate_version: 0, duplicate: false, found: false };
        chat_settle_deferred(rid[0: ridn], key.user_id, store_now(), 0,
            &plan, resp[0: rn], &settle) catch {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        };
        srv_static(c, st, resp[0: rn], keep);
        return;
    }
}

/// 按解析出来的路由号出响应。
fn srv_begin_response(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    if c.is_head_req {
        srv_static(c, 200, &"x"[0: 0], keep);
        return;
    }
    if c.route == ROUTE_HEALTH {
        stats.requests = stats.requests +% 1;
        srv_static(c, 200, SRV_JSON_HEALTH, keep);
        return;
    }
    if c.route == ROUTE_MODELS {
        stats.requests = stats.requests +% 1;
        srv_models(c);
        return;
    }
    if c.route == ROUTE_SSE {
        stats.requests = stats.requests +% 1;
        stats.sse = stats.sse +% 1;
        const hn: usize = hsrv_resp_head(&c.out[0], SRV_OUT_CAP, 200, &SRV_CTYPE_SSE[0: 17], 17,
            0 as i64, true, true);
        var off: usize = hn;
        off = off +% hsrv_chunk(&c.out[off], SRV_OUT_CAP - off, SRV_SSE_LINE, SRV_SSE_LINE.len);
        c.out_len = off;
        c.out_pos = 0;
        c.sse_left = SRV_SSE_EVENTS -| 1;
        c.sse_next = srv_now_ms() +% SRV_SSE_GAP_MS;
        c.state = ST_SSE;
        return;
    }
    if c.route == ROUTE_CHAT {
        srv_chat(c, stats);
        return;
    }
    if c.route == ROUTE_USAGE {
        srv_usage(c, stats);
        return;
    }
    if c.route == ROUTE_OTP {
        srv_otp(c, stats);
        return;
    }
    if c.route == ROUTE_LOGIN {
        srv_login(c, stats);
        return;
    }
    if c.route == ROUTE_KEY_REVOKE {
        srv_key_revoke(c, stats);
        return;
    }
    if c.route == ROUTE_KEYS {
        srv_keys(c, stats);
        return;
    }
    if c.route == ROUTE_ME {
        srv_me(c, stats);
        return;
    }
    if c.route == ROUTE_ADMIN_PRICES {
        srv_admin_prices(c, stats);
        return;
    }
    if c.route == ROUTE_ADMIN_MODELS {
        srv_admin_models(c, stats);
        return;
    }
    if c.route == ROUTE_ADMIN_AUDIT {
        srv_admin_audit(c, stats);
        return;
    }
    if c.route == ROUTE_ADMIN_BIND {
        srv_admin_bind(c, stats);
        return;
    }
    if c.route == ROUTE_REQUESTS {
        srv_requests(c, stats);
        return;
    }
    if c.route == ROUTE_NODE_SPOOL {
        srv_node_spool(c, stats);
        return;
    }
    if c.route == ROUTE_EDGE_PROXY {
        srv_edge_proxy(c, stats);
        return;
    }
    if c.route == ROUTE_NODE_STATUS {
        srv_node_status(c, stats);
        return;
    }
    if c.route == ROUTE_EDGE_FAIL {
        srv_edge_fail(c, stats);
        return;
    }
    if c.route == ROUTE_EDGE_ROUTE {
        srv_edge_route(c, stats);
        return;
    }
    if c.route == ROUTE_ADMIN_JS {
        srv_admin_js(c, stats);

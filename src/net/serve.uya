// src/net/serve.uya — A1 单线程 epoll 事件循环（监听 / 连接状态机 / SSE / 优雅停机）
//
// 与首版（每连接 `@await` 到底、串行 accept）的区别：连接不再变成协程，而是
// **显式状态机**。一个线程、一个 epoll、一张连接槽表，事件来了推进对应槽的状态：
//
//   HEAD ──头部解析完成、有包体──► BODY ──排空──► WRITE ──写完──► HEAD（keep-alive）
//     └────────────无包体──────────┴──────────────► SSE（chunked 分块慢推）
//
// 为什么不用 `@async_fn` 写连接：TLS-09E 之后已知 `@async_fn` 的等待点是共享
// Waker 的 4 个 IO 槽，嵌套一深就会在真正需要等待时耗尽；一个连接一个 future
// 再叠 512 路并发，等于把这条约束放大 512 倍。状态机把「等待」退化成一个
// epoll 事件，没有嵌套、没有槽位竞争。
//
// 三条 Uya 0.11 硬约束仍然适用（详见 docs/design/tls-spike-findings.md §10）：
//   1. 切片字面量赋给局部变量/常量曾经生成 `&(struct uya_slice_X){...}`（已修，
//      但为了可读性这里只在模块级常量上用切片字面量）。
//   2. 位运算两侧类型必须一致（`EPOLLIN as u32` 之类）。
//   3. `i32` 溢出用 `+%`/`-%`；数组下标一律显式判界。
//
// 线程数恒 1：本文件不创建线程、不调用任何阻塞等待（accept/recv/send 全部
// 非阻塞，唯一会阻塞的是 `epoll_wait` 的毫秒超时）。

use libc.syscall;
use libc.signal;
use libc.errno;

/// 单连接读缓冲。请求头必须一次装下；包体按块流式排空，不需要整块驻留。
export const SRV_IO_CAP: usize = 16384;
/// 单连接待写缓冲（响应头 + 一块包体/一个 SSE 事件）。
export const SRV_OUT_CAP: usize = 8192;
/// 同时在线连接上限：验收要求 512 并发 SSE，留一倍余量给探活/管理请求。
export const SRV_MAX_CONNS: usize = 1024;
export const SRV_BACKLOG: i32 = 128;

/// 一次 `epoll_wait` 最多取回的事件数。
const SRV_EV_MAX: i32 = 64;
/// 有 SSE 在推、或正在停机时的轮询粒度（同时是 SSE 事件的定时精度）。
const SRV_TICK_MS: i32 = 5;
/// 全空闲时的轮询粒度（主要用于发现信号导致的停机）。
const SRV_IDLE_MS: i32 = 200;
/// 优雅停机的最长等待：超过就强行关连接。
const SRV_SHUTDOWN_MS: u64 = 2000;
/// A1 自测流：每个连接推多少个事件、相邻事件间隔多少毫秒。
const SRV_SSE_EVENTS: u32 = 20;
const SRV_SSE_GAP_MS: u64 = 20;
/// `CLOCK_MONOTONIC`（libc.pthread 里有同名常量，这里不引入整个模块）。
const SRV_CLOCK_MONOTONIC: i32 = 1;
/// libc.syscall 只导出了 EPOLLIN/EPOLLOUT/EPOLL_CTL_*，err/hup 位在这里补齐。
const SRV_EPOLLERR: u32 = 0x008;
const SRV_EPOLLHUP: u32 = 0x010;

// 连接状态
const ST_FREE: i32 = 0;
const ST_HEAD: i32 = 1;
const ST_BODY: i32 = 2;
const ST_WRITE: i32 = 3;
const ST_SSE: i32 = 4;

// chunked 包体解析阶段
const CH_SIZE: i32 = 0;
const CH_DATA: i32 = 1;
const CH_CRLF: i32 = 2;
const CH_TRAILER: i32 = 3;

// 路由编号（解析头部时定下来，包体排空后直接按编号回包）
const ROUTE_404: i32 = 0;
const ROUTE_HEALTH: i32 = 1;
const ROUTE_MODELS: i32 = 2;
const ROUTE_SSE: i32 = 3;
const ROUTE_CHAT: i32 = 4;

/// chat 请求体上限（与 CHAT_PAYLOAD_MAX 一致；超了回 413）。
const SRV_BODY_CAP: usize = 32768;

// 固定回包体（切片字面量放模块级常量：编译器已修，但这样也不会碰异步帧退化）
const SRV_JSON_HEALTH: &[byte] = &"{\"ok\":true}"[0: 11];
const SRV_JSON_MODELS: &[byte] = &"{\"object\":\"list\",\"data\":[]}"[0: 27];
const SRV_JSON_404: &[byte] = &"{\"error\":\"not found\"}"[0: 21];
const SRV_JSON_400: &[byte] = &"{\"error\":\"bad request\"}"[0: 23];
const SRV_JSON_431: &[byte] = &"{\"error\":\"head too large\"}"[0: 26];
const SRV_JSON_501: &[byte] = &"{\"error\":\"chat not implemented\"}"[0: 32];
const SRV_JSON_401: &[byte] = &"{\"error\":\"unauthorized\"}"[0: 24];
const SRV_JSON_413: &[byte] = &"{\"error\":\"payload too large\"}"[0: 29];
const SRV_JSON_503: &[byte] = &"{\"error\":\"service unavailable\"}"[0: 31];
const SRV_CTYPE_JSON: &[byte] = &"application/json"[0: 16];
const SRV_CTYPE_SSE: &[byte] = &"text/event-stream"[0: 17];
const SRV_SSE_LINE: &[byte] = &"data: {}\n\n"[0: 10];

export error ListenFailed;
export error BadIp;

/// 服务计数。`active`/`max_active` 用来验证并发度，`rejected` 记录槽位打满。
export struct ServeStats {
    conns: u64,
    requests: u64,
    bad: u64,
    active: u64,
    max_active: u64,
    sse: u64,
    rejected: u64,
}

/// 一条连接的完整状态。槽表是模块级 `var`（.bss，按需提交），不放栈上。
struct SrvConn {
    fd: i32,
    state: i32,
    // 读缓冲：`[in_pos, in_len)` 是尚未消费的字节
    in: [byte: SRV_IO_CAP],
    in_len: usize,
    in_pos: usize,
    // 写缓冲：`[out_pos, out_len)` 是尚未发出的字节
    out: [byte: SRV_OUT_CAP],
    out_len: usize,
    out_pos: usize,
    route: i32,
    keep: bool,
    is_head_req: bool,
    // chat：Authorization 头 + 请求体（仅 ROUTE_CHAT 采集，其他路由只排空）
    auth: [byte: 256],
    auth_len: usize,
    body: [byte: SRV_BODY_CAP],
    body_len: usize,
    body_overflow: bool,
    // 包体
    body_left: u64,
    chunked: bool,
    chunk_left: u64,
    chunk_phase: i32,
    // SSE
    sse_left: u32,
    sse_next: u64,
}

var g_conns: [SrvConn: SRV_MAX_CONNS] = [];
var g_stop: i32 = 0;
var g_listen_fd: i32 = 0 - 1;
var g_epfd: i32 = 0 - 1;

/// SIGTERM/SIGINT 只置一个标志：真正的收尾在主循环里做（信号处理里不能分配、不能加锁）。
fn srv_on_signal(signum: i32) void {
    _ = signum;
    g_stop = 1;
}

fn srv_stop_requested() i32 {
    return g_stop;
}

/// 单调时钟毫秒。取不到时返回 0（SSE 会退化成每轮都推，不影响正确性）。
fn srv_now_ms() u64 {
    var ts: TimeSpec = TimeSpec{};
    const r: !i32 = sys_clock_gettime(SRV_CLOCK_MONOTONIC, &ts);
    _ = r catch {
        return 0;
    };
    const secs: u64 = (ts.tv_sec as u64) * (1000 as u64);
    const nanos: u64 = (ts.tv_nsec as u64) / (1000000 as u64);
    return secs + nanos;
}

/// 从切片取底层指针（普通函数：`&"lit"[a: n]` 做普通调用实参是安全的）。
fn srv_ptr(s: &[byte]) &const byte {
    return s.ptr;
}

// ---------------------------------------------------------------
// 监听
// ---------------------------------------------------------------

/// 点分十进制 → 打包的 4 字节（高位在前）。返回值而不是写 `&byte` 出参。
export fn serve_parse_ipv4(s: &[byte]) !u32 {
    var octet: usize = 0;
    var val: u32 = 0;
    var digits: usize = 0;
    var packed: u32 = 0;
    var i: usize = 0;
    while i < s.len {
        const c: byte = s[i];
        if c >= ('0' as byte) && c <= ('9' as byte) {
            val = val *% 10 +% ((c as u32) - 48);
            if val > 255 {
                return error.BadIp;
            }
            digits = digits + 1;
        } else if c == ('.' as byte) {
            if digits == 0 || octet >= 3 {
                return error.BadIp;
            }
            packed = (packed *% 256) +% val;
            octet = octet + 1;
            val = 0;
            digits = 0;
        } else {
            return error.BadIp;
        }
        i = i + 1;
    }
    if digits == 0 || octet != 3 {
        return error.BadIp;
    }
    packed = (packed *% 256) +% val;
    return packed;
}

/// 建监听 socket 并 listen（非阻塞）。失败统一折叠成 `error.ListenFailed`。
export fn serve_listen(ip: &[byte], port: u16) !i32 {
    const packed: u32 = serve_parse_ipv4(ip) catch |_| {
        return error.BadIp;
    };
    const fd: i32 = try sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    var one: i32 = 1;
    _ = sys_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch |_| {
        _ = sys_close(fd) catch {};
        return error.ListenFailed;
    };
    var ipb: [byte: 4] = [0: 4];
    ipb[0] = ((packed >> 24) & 255u32) as byte;
    ipb[1] = ((packed >> 16) & 255u32) as byte;
    ipb[2] = ((packed >> 8) & 255u32) as byte;
    ipb[3] = (packed & 255u32) as byte;
    var addr: [byte: 16] = [0: 16];
    tcpx_sockaddr_v4(&ipb[0], port, &addr[0]);
    _ = sys_bind(fd, &addr[0] as &void, 16 as u32) catch |_| {
        _ = sys_close(fd) catch {};
        return error.ListenFailed;
    };
    _ = sys_listen(fd, SRV_BACKLOG) catch |_| {
        _ = sys_close(fd) catch {};
        return error.ListenFailed;
    };
    tcpx_set_nonblocking(fd) catch |_| {};
    return fd;
}

/// 监听口的本地端口（`port` 传 0 时由内核选）。
export fn serve_port(fd: i32) u16 {
    var alen: u32 = 16;
    var out: [byte: 16] = [0: 16];
    _ = sys_getsockname(fd, &out[0] as &void, &alen) catch |_| {
        return 0;
    };
    return ((out[2] as u16) * 256) + (out[3] as u16);
}

// ---------------------------------------------------------------
// 槽表
// ---------------------------------------------------------------

fn srv_slot_of(fd: i32) i32 {
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        if g_conns[i].fd == fd && g_conns[i].state != ST_FREE {
            return i as i32;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn srv_alloc_slot() i32 {
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        if g_conns[i].state == ST_FREE {
            return i as i32;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn srv_active_count() u64 {
    var n: u64 = 0;
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        if g_conns[i].state != ST_FREE {
            n = n +% 1;
        }
        i = i + 1;
    }
    return n;
}

fn srv_close_slot(slot: i32) void {
    if slot < 0 || (slot as usize) >= SRV_MAX_CONNS {
        return;
    }
    const i: usize = slot as usize;
    const fd: i32 = g_conns[i].fd;
    if fd >= 0 {
        _ = sys_epoll_ctl_del(g_epfd, fd) catch {};
        tcpx_close(fd);
    }
    g_conns[i].fd = 0 - 1;
    g_conns[i].state = ST_FREE;
    g_conns[i].in_len = 0;
    g_conns[i].in_pos = 0;
    g_conns[i].out_len = 0;
    g_conns[i].out_pos = 0;
    g_conns[i].sse_left = 0;
    g_conns[i].chunked = false;
    g_conns[i].body_left = 0;
    g_conns[i].chunk_left = 0;
    g_conns[i].chunk_phase = CH_SIZE;
}

/// 调整 fd 的 epoll 关注事件：平时只关心可读，有待写数据时加 EPOLLOUT。
fn srv_set_interest(c: &SrvConn, want_write: bool) void {
    var evs: u32 = EPOLLIN as u32;
    if want_write {
        evs = evs | (EPOLLOUT as u32);
    }
    var ev: EpollEvent = epoll_event_with_fd(evs, c.fd);
    _ = sys_epoll_ctl(g_epfd, EPOLL_CTL_MOD, c.fd, &ev) catch {};
}

// ---------------------------------------------------------------
// 缓冲与解析小工具
// ---------------------------------------------------------------

/// 把 `[in_pos, in_len)` 挪到缓冲区开头。
fn srv_compact(c: &SrvConn) void {
    if c.in_pos == 0 {
        return;
    }
    var n: usize = 0;
    var i: usize = c.in_pos;
    while i < c.in_len && n < SRV_IO_CAP {
        const v: byte = c.in[i];
        c.in[n] = v;
        n = n + 1;
        i = i + 1;
    }
    c.in_len = n;
    c.in_pos = 0;
}

/// 从 `from` 起找 CRLF，返回其下标；没有返回 -1。
fn srv_find_crlf(c: &SrvConn, from: usize) i64 {
    var i: usize = from;
    while i + 1 < c.in_len {
        if i + 1 >= SRV_IO_CAP {
            return 0 - 1;
        }
        if c.in[i] == (13 as byte) && c.in[i + 1] == (10 as byte) {
            return i as i64;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// 解析 `[from, end)` 的十六进制块长度（`;` 之后是扩展，忽略）。
fn srv_hex_size(c: &SrvConn, from: usize, end: usize) i64 {
    var v: i64 = 0;
    var any: bool = false;
    var i: usize = from;
    while i < end && i < SRV_IO_CAP {
        const ch: byte = c.in[i];
        var d: i64 = 0 - 1;
        if ch >= ('0' as byte) && ch <= ('9' as byte) {
            d = (ch as i64) - 48;
        } else if ch >= ('a' as byte) && ch <= ('f' as byte) {
            d = (ch as i64) - 87;
        } else if ch >= ('A' as byte) && ch <= ('F' as byte) {
            d = (ch as i64) - 55;
        } else if ch == (';' as byte) {
            break;
        } else {
            return 0 - 1;
        }
        v = v *% 16 +% d;
        if v < 0 {
            return 0 - 1;
        }
        any = true;
        i = i + 1;
    }
    if !any {
        return 0 - 1;
    }
    return v;
}

fn srv_path_is(req: &HsrvReq, lit: &[byte]) bool {
    if req.path_len < lit.len {
        return false;
    }
    var i: usize = 0;
    while i < lit.len {
        if i >= HSRV_PATH_MAX {
            return false;
        }
        if req.path[i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    if req.path_len == lit.len {
        return true;
    }
    const q: usize = lit.len;
    var next_is_query: bool = false;
    if q < HSRV_PATH_MAX {
        next_is_query = req.path[q] == ('?' as byte);
    }
    return next_is_query;
}

fn srv_route_of(req: &HsrvReq) i32 {
    if srv_path_is(req, &"/healthz"[0: 8]) {
        return ROUTE_HEALTH;
    }
    if srv_path_is(req, &"/v1/models"[0: 10]) {
        return ROUTE_MODELS;
    }
    if srv_path_is(req, &"/v1/_sse"[0: 8]) {
        return ROUTE_SSE;
    }
    if srv_path_is(req, &"/v1/chat/completions"[0: 20]) {
        return ROUTE_CHAT;
    }
    return ROUTE_404;
}

// ---------------------------------------------------------------
// 响应构造
// ---------------------------------------------------------------

fn srv_put(out: &byte, cap: usize, off: &usize, data: &[byte]) bool {
    var i: usize = 0;
    while i < data.len {
        if off[0] >= cap {
            return false;
        }
        out[off[0]] = data[i];
        off[0] = off[0] + 1;
        i = i + 1;
    }
    return true;
}

/// 组装静态回包（头 + body），并进入 WRITE。
fn srv_static(c: &SrvConn, status: i32, body: &[byte], keep: bool) void {
    const n: usize = hsrv_resp_head(&c.out[0], SRV_OUT_CAP, status, &SRV_CTYPE_JSON[0: 16], 16,
        body.len as i64, false, keep);
    var off: usize = n;
    _ = srv_put(&c.out[0], SRV_OUT_CAP, &off, body);
    c.out_len = off;
    c.out_pos = 0;
    c.state = ST_WRITE;
}

/// chat：鉴权 → 解析/路由 → （上游传输下一步接）占位 501。
fn srv_chat(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var tok: [byte: 256] = [0: 256];
    const tn: usize = chat_bearer_span(&c.auth[0], c.auth_len, &tok[0], 256);
    if tn == 0 {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var key: StoreKey = StoreKey{ key_id: 0, user_id: 0, rpm: 0, tpm: 0 };
    store_verify_key(runtime_db(), tok[0: tn], &key) catch {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    };
    var plan: ChatPlan = ChatPlan{};
    chat_prepare_span(runtime_db(), &c.body[0], c.body_len, store_now(), &plan) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    srv_static(c, 501, SRV_JSON_501, keep);
}

/// 按解析出来的路由号出响应。
fn srv_begin_response(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    if c.is_head_req {
        srv_static(c, 200, &"x"[0: 0], keep);
        return;
    }
    if c.route == ROUTE_HEALTH {
        stats.requests = stats.requests +% 1;
        srv_static(c, 200, SRV_JSON_HEALTH, keep);
        return;
    }
    if c.route == ROUTE_MODELS {
        stats.requests = stats.requests +% 1;
        srv_static(c, 200, SRV_JSON_MODELS, keep);
        return;
    }
    if c.route == ROUTE_SSE {
        stats.requests = stats.requests +% 1;
        stats.sse = stats.sse +% 1;
        const hn: usize = hsrv_resp_head(&c.out[0], SRV_OUT_CAP, 200, &SRV_CTYPE_SSE[0: 17], 17,
            0 as i64, true, true);
        var off: usize = hn;
        off = off +% hsrv_chunk(&c.out[off], SRV_OUT_CAP - off, SRV_SSE_LINE, SRV_SSE_LINE.len);
        c.out_len = off;
        c.out_pos = 0;
        c.sse_left = SRV_SSE_EVENTS -| 1;
        c.sse_next = srv_now_ms() +% SRV_SSE_GAP_MS;
        c.state = ST_SSE;
        return;
    }
    if c.route == ROUTE_CHAT {
        srv_chat(c, stats);
        return;
    }
    stats.requests = stats.requests +% 1;
    srv_static(c, 404, SRV_JSON_404, keep);
}

// ---------------------------------------------------------------
// 状态机
// ---------------------------------------------------------------

/// 排空包体：1=排完，0=还要更多数据，-1=协议错误。
/// chat 路由：把包体字节采集到连接缓冲（其他路由只排空，不占内存时间）。
fn srv_capture(c: &SrvConn, start: usize, take: usize) void {
    if c.route != ROUTE_CHAT {
        return;
    }
    var i: usize = 0;
    while i < take {
        const src: usize = start + i;
        if src < SRV_IO_CAP {
            if c.body_len < SRV_BODY_CAP {
                c.body[c.body_len] = c.in[src];
                c.body_len = c.body_len + 1;
            } else {
                c.body_overflow = true;
            }
        }
        i = i + 1;
    }
}

fn srv_body_step(c: &SrvConn) i32 {
    if !c.chunked {
        const avail: usize = c.in_len -| c.in_pos;
        if avail == 0 {
            return 0;
        }
        // 不用 `const x = if ... else ...`：分支带 `as` 强制转换时会生成
        // `const size_t __uya_ifexpr_N;` 再赋值（只读变量赋值，编译不过）。
        var take: usize = avail;
        if (avail as u64) > c.body_left {
            take = c.body_left as usize;
        }
        srv_capture(c, c.in_pos, take);
        c.in_pos = c.in_pos +% take;
        c.body_left = c.body_left -% (take as u64);
        if c.body_left == 0 {
            return 1;
        }
        return 0;
    }
    var guard: i32 = 0;
    while guard < 1000000 {
        guard = guard + 1;
        if c.chunk_phase == CH_SIZE {
            const crlf: i64 = srv_find_crlf(c, c.in_pos);
            if crlf < 0 {
                return 0;
            }
            const cl: usize = crlf as usize;
            const sz: i64 = srv_hex_size(c, c.in_pos, cl);
            if sz < 0 {
                return 0 - 1;
            }
            c.in_pos = cl +% 2;
            if sz == 0 {
                c.chunk_phase = CH_TRAILER;
            } else {
                c.chunk_left = sz as u64;
                c.chunk_phase = CH_DATA;
            }
            continue;
        }
        if c.chunk_phase == CH_DATA {
            const avail: usize = c.in_len -| c.in_pos;
            if avail == 0 {
                return 0;
            }
            var take: usize = avail;
            if (avail as u64) > c.chunk_left {
                take = c.chunk_left as usize;
            }
            srv_capture(c, c.in_pos, take);
            c.in_pos = c.in_pos +% take;
            c.chunk_left = c.chunk_left -% (take as u64);
            if c.chunk_left == 0 {
                c.chunk_phase = CH_CRLF;
            }
            continue;
        }
        if c.chunk_phase == CH_CRLF {
            if c.in_len -| c.in_pos < 2 {
                return 0;
            }
            c.in_pos = c.in_pos +% 2;
            c.chunk_phase = CH_SIZE;
            continue;
        }
        // CH_TRAILER：读到空行为止
        const crlf2: i64 = srv_find_crlf(c, c.in_pos);
        if crlf2 < 0 {
            return 0;
        }
        const cl2: usize = crlf2 as usize;
        if cl2 == c.in_pos {
            c.in_pos = c.in_pos +% 2;
            return 1;
        }
        c.in_pos = cl2 +% 2;
    }
    return 0 - 1;
}

/// 把待写数据尽量发出去：1=发完，0=对端暂时写不动，-1=出错。
fn srv_flush(c: &SrvConn) i32 {
    while c.out_pos < c.out_len {
        const r: !isize = sys_send(c.fd, &c.out[c.out_pos], c.out_len - c.out_pos, 0);
        const n: isize = r catch |err| {
            const eid: i32 = @error_id(err) as i32;
            if eid == EAGAIN || eid == EWOULDBLOCK {
                return 0;
            }
            return 0 - 1;
        };
        if n <= 0 {
            return 0 - 1;
        }
        c.out_pos = c.out_pos +% (n as usize);
    }
    c.out_pos = 0;
    c.out_len = 0;
    return 1;
}

/// 推进一个连接，直到「需要更多数据」或「等待可写」。
fn srv_drive(c: &SrvConn, stats: &ServeStats) void {
    var guard: i32 = 0;
    while guard < 256 {
        guard = guard + 1;
        if c.state == ST_HEAD {
            srv_compact(c);
            var req: HsrvReq = HsrvReq{};
            const pr: i32 = hsrv_parse_head(&c.in[0], c.in_len, SRV_IO_CAP, &req);
            if pr == 0 {
                if c.in_len >= SRV_IO_CAP {
                    stats.bad = stats.bad +% 1;
                    srv_static(c, 431, SRV_JSON_431, false);
                    continue;
                }
                srv_set_interest(c, false);
                return;
            }
            if pr < 0 {
                stats.bad = stats.bad +% 1;
                srv_static(c, 400, SRV_JSON_400, false);
                continue;
            }
            c.keep = req.keep_alive;
            c.route = srv_route_of(&req);
            c.is_head_req = req.method_len == 4 && req.method[0] == ('H' as byte);
            c.auth_len = 0;
            var ai: usize = 0;
            while ai < req.auth_len && ai < 256 {
                c.auth[ai] = req.auth[ai];
                ai = ai + 1;
            }
            c.auth_len = ai;
            c.body_len = 0;
            c.body_overflow = false;
            c.in_pos = req.head_len;
            c.chunked = req.chunked;
            c.chunk_left = 0;
            c.chunk_phase = CH_SIZE;
            c.body_left = 0;
            if !req.chunked && req.content_length > 0 {
                c.body_left = req.content_length as u64;
            }
            if req.expect_continue && (req.chunked || req.content_length > 0) {
                // 尽力而为：25 字节几乎不会半发；半发也只能等客户端自己超时重发
                const cont: !isize = sys_send(c.fd, srv_ptr(&"HTTP/1.1 100 Continue\r\n\r\n"[0: 25]), 25, 0);
                _ = cont catch |_| {
                    0 as isize;
                };
            }
            if c.chunked || c.body_left > 0 {
                c.state = ST_BODY;
                continue;
            }
            srv_begin_response(c, stats);
            continue;
        }
        if c.state == ST_BODY {
            const bd: i32 = srv_body_step(c);
            if bd == 0 {
                srv_set_interest(c, false);
                return;
            }
            if bd < 0 {
                stats.bad = stats.bad +% 1;
                srv_static(c, 400, SRV_JSON_400, false);
                continue;
            }
            srv_begin_response(c, stats);
            continue;
        }
        if c.state == ST_WRITE {
            const fr: i32 = srv_flush(c);
            if fr == 0 {
                srv_set_interest(c, true);
                return;
            }
            if fr < 0 {
                srv_close_slot(srv_slot_of(c.fd));
                return;
            }
            if !c.keep {
                srv_close_slot(srv_slot_of(c.fd));
                return;
            }
            c.state = ST_HEAD;
            c.is_head_req = false;
            c.route = ROUTE_404;
            continue;
        }
        if c.state == ST_SSE {
            if c.out_len > c.out_pos {
                const fr2: i32 = srv_flush(c);
                if fr2 == 0 {
                    srv_set_interest(c, true);
                    return;
                }
                if fr2 < 0 {
                    srv_close_slot(srv_slot_of(c.fd));
                    return;
                }
            }
            if c.sse_left > 0 {
                srv_set_interest(c, false);
                return;
            }
            // 事件推完：补最后一个 chunk，然后按 keep=false 收尾
            c.out_pos = 0;
            c.out_len = hsrv_chunk_last(&c.out[0], SRV_OUT_CAP);
            c.keep = false;
            c.state = ST_WRITE;
            continue;
        }
        srv_close_slot(srv_slot_of(c.fd));
        return;
    }
}

/// 可读事件：尽量读到 EAGAIN，然后推进状态机。
fn srv_on_readable(c: &SrvConn, stats: &ServeStats) void {
    var guard: i32 = 0;
    while guard < 1024 {
        guard = guard + 1;
        if c.state == ST_FREE {
            return;
        }
        if c.state == ST_SSE {
            return;
        }
        srv_compact(c);
        if c.in_len >= SRV_IO_CAP {
            srv_drive(c, stats);
            if c.state == ST_FREE {
                return;
            }
            if c.state != ST_HEAD && c.state != ST_BODY {
                return;
            }
            if c.in_len >= SRV_IO_CAP {
                stats.bad = stats.bad +% 1;
                srv_static(c, 431, SRV_JSON_431, false);
                srv_drive(c, stats);
                return;
            }
            continue;
        }
        if c.in_len >= SRV_IO_CAP {
            return;
        }
        const r: !isize = sys_recv(c.fd, &c.in[c.in_len], SRV_IO_CAP - c.in_len, 0);
        const n: isize = r catch |err| {
            const eid: i32 = @error_id(err) as i32;
            if eid == EAGAIN || eid == EWOULDBLOCK {
                srv_drive(c, stats);
                return;
            }
            srv_close_slot(srv_slot_of(c.fd));
            return;
        };
        if n == 0 {
            srv_close_slot(srv_slot_of(c.fd));
            return;
        }
        c.in_len = c.in_len +% (n as usize);
        srv_drive(c, stats);
        if c.state == ST_WRITE {
            return;
        }
    }
}

/// epoll 事件分发。
fn srv_on_event(fd: i32, evs: u32, stats: &ServeStats) void {
    const slot: i32 = srv_slot_of(fd);
    if slot < 0 || (slot as usize) >= SRV_MAX_CONNS {
        return;
    }
    const c: &SrvConn = &g_conns[slot as usize];
    if (evs & (SRV_EPOLLERR | SRV_EPOLLHUP)) != 0 {
        srv_close_slot(slot);
        return;
    }
    if (evs & (EPOLLOUT as u32)) != 0 && c.out_len > c.out_pos {
        srv_drive(c, stats);
        if c.state == ST_FREE {
            return;
        }
    }
    if (evs & (EPOLLIN as u32)) != 0 {
        srv_on_readable(c, stats);
    }
}

fn srv_accept_all(stats: &ServeStats) void {
    var guard: i32 = 0;
    while guard < 256 {
        guard = guard + 1;
        const slot: i32 = srv_alloc_slot();
        if slot < 0 || (slot as usize) >= SRV_MAX_CONNS {
            stats.rejected = stats.rejected +% 1;
            return;
        }
        var alen: u32 = 16;
        var peer: [byte: 16] = [0: 16];
        const acc: !i32 = sys_accept(g_listen_fd, &peer[0] as &void, &alen);
        const cfd: i32 = acc catch |_| {
            return;
        };
        tcpx_set_nodelay(cfd);
        tcpx_set_nonblocking(cfd) catch |_| {};
        const i: usize = slot as usize;
        g_conns[i].fd = cfd;
        g_conns[i].state = ST_HEAD;
        g_conns[i].in_len = 0;
        g_conns[i].in_pos = 0;
        g_conns[i].out_len = 0;
        g_conns[i].out_pos = 0;
        g_conns[i].route = ROUTE_404;
        g_conns[i].keep = false;
        g_conns[i].is_head_req = false;
        g_conns[i].body_left = 0;
        g_conns[i].chunked = false;
        g_conns[i].chunk_left = 0;
        g_conns[i].chunk_phase = CH_SIZE;
        g_conns[i].sse_left = 0;
        g_conns[i].sse_next = 0;
        var ev: EpollEvent = epoll_event_with_fd(EPOLLIN as u32, cfd);
        const ar: !i32 = sys_epoll_ctl(g_epfd, EPOLL_CTL_ADD, cfd, &ev);
        _ = ar catch |_| {
            g_conns[i].fd = 0 - 1;
            g_conns[i].state = ST_FREE;
            _ = sys_close(cfd) catch {};
            continue;
        };
        stats.conns = stats.conns +% 1;
        stats.active = stats.active +% 1;
        if stats.active > stats.max_active {
            stats.max_active = stats.active;
        }
    }
}

/// SSE 定时推进：到点的连接补一个 chunk，再交给状态机去发。
fn srv_tick_sse(now: u64, stats: &ServeStats) void {
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        const c: &SrvConn = &g_conns[i];
        if c.state == ST_SSE && c.sse_left > 0 && now >= c.sse_next && c.out_len == c.out_pos {
            c.out_pos = 0;
            c.out_len = hsrv_chunk(&c.out[0], SRV_OUT_CAP, SRV_SSE_LINE, SRV_SSE_LINE.len);
            c.sse_left = c.sse_left -| 1;
            c.sse_next = now +% SRV_SSE_GAP_MS;
            srv_drive(c, stats);
        }
        i = i + 1;
    }
}

/// 停机扫尾：空闲连接直接关，有在途响应的标记 keep=false 让它自然收尾。
fn srv_shutdown_sweep() void {
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        if g_conns[i].state != ST_FREE {
            if g_conns[i].state == ST_HEAD && g_conns[i].in_len == 0
                && g_conns[i].out_len == g_conns[i].out_pos {
                srv_close_slot(i as i32);
            } else {
                g_conns[i].keep = false;
            }
        }
        i = i + 1;
    }
}

/// 单线程事件循环。`lfd` 由 `serve_listen` 建好（非阻塞）。
/// 收到 SIGTERM/SIGINT 后：停止 accept → 等空闲连接关闭/在途请求收尾（最多 2 s）→ 返回 0。
export fn serve_run(lfd: i32, stats: &ServeStats) !i32 {
    _ = signal(SIGTERM, &srv_on_signal as &void);
    _ = signal(SIGINT, &srv_on_signal as &void);
    _ = signal(SIGPIPE, SIG_IGN as &void);
    _ = SIGTERM;
    g_stop = 0;
    g_listen_fd = lfd;
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        g_conns[i].fd = 0 - 1;
        g_conns[i].state = ST_FREE;
        g_conns[i].in_len = 0;
        g_conns[i].in_pos = 0;
        g_conns[i].out_len = 0;
        g_conns[i].out_pos = 0;
        g_conns[i].sse_left = 0;
        g_conns[i].chunk_phase = CH_SIZE;
        i = i + 1;
    }
    const epfd: i32 = try sys_epoll_create1(EPOLL_CLOEXEC);
    g_epfd = epfd;
    var lev: EpollEvent = epoll_event_with_fd(EPOLLIN as u32, lfd);
    _ = try sys_epoll_ctl(epfd, EPOLL_CTL_ADD, lfd, &lev);

    var events: [EpollEvent: 64] = [];
    var stopping: i32 = 0;
    var stop_at: u64 = 0;
    var rc: i32 = 0;
    while true {
        // A2 接线：每日备份 / journal 清理；未初始化运行时是 no-op。
        runtime_tick();
        if srv_stop_requested() != 0 && stopping == 0 {
            stopping = 1;
            stop_at = srv_now_ms() +% SRV_SHUTDOWN_MS;
            if g_listen_fd >= 0 {
                _ = sys_epoll_ctl_del(epfd, g_listen_fd) catch {};
                _ = sys_close(g_listen_fd) catch {};
                g_listen_fd = 0 - 1;
            }
            srv_shutdown_sweep();
        }
        const now: u64 = srv_now_ms();
        srv_tick_sse(now, stats);
        stats.active = srv_active_count();
        if stopping != 0 {
            if stats.active == 0 || now >= stop_at {
                break;
            }
        }
        var tmo: i32 = SRV_IDLE_MS;
        if stats.sse > 0 || stopping != 0 {
            tmo = SRV_TICK_MS;
        }
        const waited: !i32 = sys_epoll_wait(epfd, &events[0], SRV_EV_MAX, tmo);
        const n: i32 = waited catch |_| {
            continue;
        };
        var k: i32 = 0;
        while k < n {
            const fd: i32 = epoll_event_fd(&events[k as usize]);
            const evs: u32 = events[k as usize].events;
            if fd == g_listen_fd {
                srv_accept_all(stats);
            } else {
                srv_on_event(fd, evs, stats);
            }
            k = k + 1;
        }
    }
    // 收尾：关掉所有还挂着的连接与 epoll
    var j: usize = 0;
    while j < SRV_MAX_CONNS {
        if g_conns[j].state != ST_FREE {
            srv_close_slot(j as i32);
        }
        j = j + 1;
    }
    if g_listen_fd >= 0 {
        _ = sys_close(g_listen_fd) catch {};
        g_listen_fd = 0 - 1;
    }
    _ = sys_close(epfd) catch {};
    g_epfd = 0 - 1;
    rc = 0;
    return rc;
}

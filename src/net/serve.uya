// C2：用量 CSV 导出（与 /v1/usage 同一份汇总数据）。
const SRV_CTYPE_CSV: &[byte] = &"text/csv; charset=utf-8"[0: 22];

fn csv_put(b: &Buf, s: &[byte]) void {
    _ = buf_append_slice(b, s);
}

fn csv_i64(b: &Buf, v: i64) void {
    _ = buf_append_i64(b, v);
}

fn csv_field(b: &Buf, s: &[byte]) void {
    _ = buf_append_slice(b, s);
}

fn srv_usage_csv(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    srv_batch_sync();
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    var tok: [byte: 256] = [0: 256];
    const tn: usize = chat_bearer_span(&c.auth[0], c.auth_len, &tok[0], 256);
    if tn == 0 {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var key: StoreKey = StoreKey{ key_id: 0, user_id: 0, rpm: 0, tpm: 0 };
    // A4 快路径：同一 Key 的连续请求走单槽缓存（TTL 2s），省一次 DB 校验。
    store_verify_key_fast(runtime_db(), tok[0: tn], store_now(), &key) catch {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    };
    const today: i64 = store_now() / (86400 as i64);
    var from_day: i64 = srv_query_day(&c.path[0], c.path_len, &"from_day"[0: 8], 8);
    if from_day < 0 {
        from_day = today -% 6;
    }
    var to_day: i64 = srv_query_day(&c.path[0], c.path_len, &"to_day"[0: 6], 6);
    if to_day < 0 {
        to_day = today;
    }
    if from_day < 0 || to_day < from_day {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    var rows: [RollupRow: 64] = [];
    var n: usize = 0;
    n = srv_rollup_query(key.user_id, from_day, to_day, &rows[0], 64);
    var b: Buf = buf_new(8192);
    defer { buf_free(&b); }
    if !buf_valid(&b) {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    csv_put(&b, &"day,model,provider,period,requests,input_tokens,output_tokens,cache_read_tokens,cost_nano,price_nano,profit_nano\n"[0: 105]);
    var i: usize = 0;
    while i < n {
        csv_i64(&b, rows[i].day);
        csv_put(&b, &","[0: 1]);
        csv_field(&b, rows[i].model[0: rows[i].model_len]);
        csv_put(&b, &","[0: 1]);
        csv_field(&b, rows[i].provider[0: rows[i].provider_len]);
        csv_put(&b, &","[0: 1]);
        csv_field(&b, rows[i].period[0: rows[i].period_len]);
        csv_put(&b, &","[0: 1]);
        csv_i64(&b, rows[i].requests);
        csv_put(&b, &","[0: 1]);
        csv_i64(&b, rows[i].input_tokens);
        csv_put(&b, &","[0: 1]);
        csv_i64(&b, rows[i].output_tokens);
        csv_put(&b, &","[0: 1]);
        csv_i64(&b, rows[i].cache_read_tokens);
        csv_put(&b, &","[0: 1]);
        csv_i64(&b, rows[i].cost_nano);
        csv_put(&b, &","[0: 1]);
        csv_i64(&b, rows[i].price_nano);
        csv_put(&b, &","[0: 1]);
        csv_i64(&b, rows[i].price_nano -% rows[i].cost_nano);
        csv_put(&b, &"\n"[0: 1]);
        i = i + 1;
    }
    if b.len <= 0 || b.cap == 0 {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    srv_static_ct(c, 200, b.ptr[0: b.len], keep, SRV_CTYPE_CSV[0: 22], 22);
}


// C3：费用估算（不落账，只按当前价目/时段算一遍）。
fn srv_estimate(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    var tok: [byte: 256] = [0: 256];
    const tn: usize = chat_bearer_span(&c.auth[0], c.auth_len, &tok[0], 256);
    if tn == 0 {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var key: StoreKey = StoreKey{ key_id: 0, user_id: 0, rpm: 0, tpm: 0 };
    // A4 快路径：同一 Key 的连续请求走单槽缓存（TTL 2s），省一次 DB 校验。
    store_verify_key_fast(runtime_db(), tok[0: tn], store_now(), &key) catch {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    };
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    const root: i32 = json_root(&d);
    var model: [byte: 128] = [0: 128];
    var mn: usize = json_str(&d, json_get(&d, root, &"model"[0: 5]), &model[0], 128);
    if mn == 0 {
        const def: &[byte] = &"default"[0: 7];
        var k: usize = 0;
        while k < 7 {
            model[k] = def[k];
            k = k + 1;
        }
        mn = 7;
    }
    var prov: [byte: 128] = [0: 128];
    const pn: usize = json_str(&d, json_get(&d, root, &"provider"[0: 8]), &prov[0], 128);
    const in_t: i64 = json_i64(&d, json_get(&d, root, &"prompt_tokens"[0: 13]));
    const out_t: i64 = json_i64(&d, json_get(&d, root, &"completion_tokens"[0: 15]));
    const cache_t: i64 = json_i64(&d, json_get(&d, root, &"cached_tokens"[0: 13]));
    if in_t < 0 || out_t < 0 || cache_t < 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    var usage: PriceUsage = PriceUsage{ input_tokens: in_t, output_tokens: out_t, cache_read_tokens: cache_t };
    var res: BillingResult = BillingResult{ cost_nano: 0, price_nano: 0, rate_version: 0, duplicate: false, found: false };
    billing_quote(runtime_db(), model[0: mn], prov[0: pn], key.user_id, store_now(), 0,
        &usage, &res) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    if !res.found {
        srv_static(c, 404, SRV_JSON_404, keep);
        return;
    }
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"model"[0: 5]);
    jsonw_str(&w, model[0: mn]);
    jsonw_key(&w, &"input_tokens"[0: 12]);
    jsonw_i64(&w, in_t);
    jsonw_key(&w, &"output_tokens"[0: 13]);
    jsonw_i64(&w, out_t);
    jsonw_key(&w, &"cost_nano"[0: 9]);
    jsonw_i64(&w, res.cost_nano);
    jsonw_key(&w, &"price_nano"[0: 10]);
    jsonw_i64(&w, res.price_nano);
    jsonw_key(&w, &"profit_nano"[0: 11]);
    jsonw_i64(&w, res.price_nano -% res.cost_nano);
    jsonw_key(&w, &"rate_version"[0: 12]);
    jsonw_i64(&w, res.rate_version);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}


// C4：预算（GET 读当前额度与当月已用；POST 设置，需会话或 Key）。
/// C4：站内通知（JSONL，按用户隔离；无通知返回空 body）。
fn srv_notifications(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    var uid: i64 = 0;
    if !srv_bearer_uid(c, &uid) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var dir: [byte: 256] = [0: 256];
    const dn: usize = runtime_dir_copy(&dir[0], 256);
    var buf: [byte: 16384] = [0: 16384];
    var bn: usize = 0;
    _ = notify_read(dir[0: dn], uid, &buf[0], 16384, &bn);
    srv_static_ct(c, 200, buf[0: bn], keep, &"text/plain"[0: 10], 10);
}

fn srv_budget(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    srv_batch_sync();
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    var uid: i64 = 0;
    if !srv_bearer_uid(c, &uid) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    const now: i64 = store_now();
    if !c.is_get {
        if c.body_overflow {
            srv_static(c, 413, SRV_JSON_413, keep);
            return;
        }
        var d: JsonDoc = JsonDoc{};
        json_parse(&d, c.body[0: c.body_len]) catch {
            srv_static(c, 400, SRV_JSON_400, keep);
            return;
        };
        const v: i64 = json_i64(&d, json_get(&d, json_root(&d), &"monthly_nano"[0: 12]));
        if v < 0 {
            srv_static(c, 400, SRV_JSON_400, keep);
            return;
        }
        budget_set(runtime_db(), uid, v, now) catch {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        };
    }
    const limit: i64 = budget_get(runtime_db(), uid) catch {
        0 as i64;
    };
    var bdb: &Db = runtime_db();
    if shard_active() {
        bdb = shard_db_for(uid);
    }
    const spent: i64 = budget_month_spent(bdb, uid, now) catch {
        0 as i64;
    };
    var over: bool = false;
    if limit > 0 && spent >= limit {
        over = true;
    }
    if !c.is_get && over {
        var dir: [byte: 256] = [0: 256];
        const dn: usize = runtime_dir_copy(&dir[0], 256);
        var dayv: i64 = 0;
        const day: i64 = budget_month(now, &dayv);
        _ = notify_budget_over(dir[0: dn], uid, day, spent, limit, now) catch {
            false;
        };
    }
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"user_id"[0: 7]);
    jsonw_i64(&w, uid);
    jsonw_key(&w, &"monthly_nano"[0: 12]);
    jsonw_i64(&w, limit);
    jsonw_key(&w, &"spent_nano"[0: 10]);
    jsonw_i64(&w, spent);
    jsonw_key(&w, &"over_budget"[0: 11]);
    jsonw_bool(&w, over);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}


// C5：管理后台（用户/供应商列表 + 静态页）。
fn srv_admin_users(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var rows: [StoreUserRow: 64] = [];
    var n: usize = 0;
    n = store_list_users(runtime_db(), &rows[0], 64) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"data"[0: 4]);
    jsonw_arr(&w);
    var i: usize = 0;
    while i < n {
        jsonw_obj(&w);
        jsonw_key(&w, &"id"[0: 2]);
        jsonw_i64(&w, rows[i].id);
        jsonw_key(&w, &"email"[0: 5]);
        jsonw_str(&w, rows[i].email[0: rows[i].email_len]);
        jsonw_key(&w, &"status"[0: 6]);
        jsonw_i64(&w, rows[i].status as i64);
        jsonw_key(&w, &"created_at"[0: 10]);
        jsonw_i64(&w, rows[i].created_at);
        jsonw_end_obj(&w);
        i = i + 1;
    }
    jsonw_end_arr(&w);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

fn srv_admin_providers(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var rows: [StoreProvider: 32] = [];
    var n: usize = 0;
    n = store_list_providers(runtime_db(), &rows[0], 32) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"data"[0: 4]);
    jsonw_arr(&w);
    var i: usize = 0;
    while i < n {
        jsonw_obj(&w);
        jsonw_key(&w, &"id"[0: 2]);
        jsonw_i64(&w, rows[i].id);
        jsonw_key(&w, &"name"[0: 4]);
        jsonw_str(&w, rows[i].name[0: rows[i].name_len]);
        jsonw_key(&w, &"host"[0: 4]);
        jsonw_str(&w, rows[i].host[0: rows[i].host_len]);
        jsonw_key(&w, &"port"[0: 4]);
        jsonw_i64(&w, rows[i].port as i64);
        jsonw_key(&w, &"enabled"[0: 7]);
        jsonw_bool(&w, rows[i].enabled);
        jsonw_key(&w, &"priority"[0: 8]);
        jsonw_i64(&w, rows[i].priority as i64);
        jsonw_key(&w, &"weight"[0: 6]);
        jsonw_i64(&w, rows[i].weight as i64);
        jsonw_end_obj(&w);
        i = i + 1;
    }
    jsonw_end_arr(&w);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

fn srv_admin_page(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    var buf: [byte: 16384] = [0: 16384];
    const n: usize = admin_page(&buf[0], 16384);
    srv_static_ct(c, 200, buf[0: n], keep, SRV_CTYPE_HTML[0: 23], 23);
}


fn srv_admin_js(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    var buf: [byte: 16384] = [0: 16384];
    const n: usize = admin_js(&buf[0], 16384);
    srv_static_ct(c, 200, buf[0: n], keep, SRV_CTYPE_JS[0: 22], 22);
}


/// B6：edge 路由查询（`?slug=..&session=..`），用于 e2e 验证归属与亲和。
fn srv_edge_route(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !g_meta_ready && !g_uplink_ready {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    var slug: [byte: 128] = [0: 128];
    const sn: usize = srv_query_str(&c.path[0], c.path_len, &"slug"[0: 4], 4, &slug[0], 128);
    var sess: [byte: 128] = [0: 128];
    const ssn: usize = srv_query_str(&c.path[0], c.path_len, &"session"[0: 7], 7, &sess[0], 128);
    var nb: [byte: 64] = [0: 64];
    // 归属在 meta.db（边缘节点是本地快照），不是业务库。
    var nn: usize = 0;
    if g_meta_ready {
        nn = edge_route(&g_meta, slug[0: sn], sess[0: ssn], &nb[0], 64);
    } else {
        nn = edge_route_snapshot(slug[0: sn], sess[0: ssn], &nb[0], 64);
    }
    if nn == 0 {
        srv_static(c, 404, SRV_JSON_404, keep);
        return;
    }
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"slug"[0: 4]);
    jsonw_str(&w, slug[0: sn]);
    jsonw_key(&w, &"node"[0: 4]);
    jsonw_str(&w, nb[0: nn]);
    // slug 归属校验：带 self= 时回答「这个 slug 是不是我的」。
    var sf: [byte: 64] = [0: 64];
    const sfn: usize = srv_query_str(&c.path[0], c.path_len, &"self"[0: 4], 4, &sf[0], 64);
    if sfn > 0 {
        jsonw_key(&w, &"mine"[0: 4]);
        jsonw_bool(&w, sfn == nn && srv_slice_eq(sf[0: sfn], nb[0: nn]));
    }
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

/// B6：手动失效某 session 亲和（模拟节点故障后重试）。
fn srv_edge_fail(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    var sess: [byte: 128] = [0: 128];
    const sn: usize = srv_query_str(&c.path[0], c.path_len, &"session"[0: 7], 7, &sess[0], 128);
    edge_fail(sess[0: sn]);
    srv_static(c, 200, SRV_JSON_OK, keep);
}


/// B2：本节点视角的集群状态（配置版本 / epoch / 本地归属快照条数）。
fn srv_node_status(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    var nb: [byte: 64] = [0: 64];
    const nn: usize = srv_node_copy(&nb[0], 64);
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"node"[0: 4]);
    jsonw_str(&w, nb[0: nn]);
    jsonw_key(&w, &"config_version"[0: 14]);
    jsonw_i64(&w, g_cfg_version);
    jsonw_key(&w, &"epoch"[0: 5]);
    jsonw_i64(&w, g_cfg_epoch);
    jsonw_key(&w, &"assignments"[0: 11]);
    jsonw_i64(&w, edge_snapshot_count() as i64);
    jsonw_key(&w, &"meta"[0: 4]);
    jsonw_bool(&w, g_meta_ready);
    jsonw_key(&w, &"uplink"[0: 6]);
    jsonw_bool(&w, g_uplink_ready);
    jsonw_key(&w, &"spool_pending"[0: 13]);
    jsonw_i64(&w, srv_spool_pending() as i64);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}


/// B4：把请求代理给 slug 的归属节点（`?slug=&path=&session=`），失败清亲和后重试一次。
/// B4：edge→node 的 SSE 流式转发：边读边刷，首事件不必等整个响应。
fn srv_edge_proxy_stream(c: &SrvConn, ip: &[byte], port: u16, path: &[byte]) void {
    const keep: bool = c.keep;
    _ = keep;
    var us: UpStream = UpStream{};
    uplink_stream_begin(ip, port, path, 5000, &us) catch {
        srv_static(c, 502, SRV_JSON_502, c.keep);
        return;
    };
    defer { uplink_stream_close(&us); }
    if us.status != 200 {
        srv_static(c, 502, SRV_JSON_502, c.keep);
        return;
    }
    const fl: !i32 = sys_fcntl(c.fd, 3, 0);
    const flags: i32 = fl catch {
        0;
    };
    if flags != 0 {
        _ = sys_fcntl(c.fd, 4, flags & (0 -% 2049)) catch {};
    }
    var head: [byte: 256] = [0: 256];
    const hn: usize = hsrv_resp_head(&head[0], 256, 200, &SRV_CTYPE_SSE[0: 17], 17,
        0 as i64, true, false);
    if !srv_send_all(c.fd, head[0: hn]) {
        srv_chat_close(c);
        return;
    }
    var buf: [byte: 4096] = [0: 4096];
    var ob: [byte: 4200] = [0: 4200];
    var guard: i32 = 0;
    while guard < 100000 {
        guard = guard +% 1;
        const got: !usize = uplink_stream_read(&us, &buf[0], 4096);
        var n: usize = 0;
        n = got catch {
            0 as usize;
        };
        if n == 0 {
            break;
        }
        const on: usize = hsrv_chunk(&ob[0], 4200, buf[0: n], n);
        if on == 0 || !srv_send_all(c.fd, ob[0: on]) {
            break;
        }
    }
    _ = srv_send_all(c.fd, &"0\r\n\r\n"[0: 5]);
    srv_chat_close(c);
}

fn srv_edge_proxy(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !g_meta_ready && !g_uplink_ready {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    var slug: [byte: 128] = [0: 128];
    const sn: usize = srv_query_str(&c.path[0], c.path_len, &"slug"[0: 4], 4, &slug[0], 128);
    var sess: [byte: 128] = [0: 128];
    const ssn: usize = srv_query_str(&c.path[0], c.path_len, &"session"[0: 7], 7, &sess[0], 128);
    var pth: [byte: 256] = [0: 256];
    const pn: usize = srv_query_str(&c.path[0], c.path_len, &"path"[0: 4], 4, &pth[0], 256);
    if sn == 0 || pn == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    var nb: [byte: 64] = [0: 64];
    var nn: usize = 0;
    if g_meta_ready {
        nn = edge_route(&g_meta, slug[0: sn], sess[0: ssn], &nb[0], 64);
    } else {
        nn = edge_route_snapshot(slug[0: sn], sess[0: ssn], &nb[0], 64);
    }
    if nn == 0 {
        srv_static(c, 404, SRV_JSON_404, keep);
        return;
    }
    var self: [byte: 128] = [0: 128];
    const selfn: usize = srv_self_addr_copy(&self[0], 128);
    var nbaddr: [byte: 128] = [0: 128];
    var an: usize = edge_addr_get(nb[0: nn], &nbaddr[0], 128);
    if an == 0 && g_meta_ready {
        // controller 本地可直接从 meta 查地址
        var nodes: [MetaNode: 64] = [];
        var cnt: usize = 0;
        cnt = meta_node_list(&g_meta, &nodes[0], 64) catch {
            0 as usize;
        };
        var i: usize = 0;
        while i < cnt {
            if nodes[i].id_len == nn && srv_slice_eq(nodes[i].id[0: nodes[i].id_len], nb[0: nn]) {
                an = nodes[i].addr_len;
                var k: usize = 0;
                while k < an && k < 128 {
                    nbaddr[k] = nodes[i].addr[k];
                    k = k + 1;
                }
                break;
            }
            i = i + 1;
        }
    }
    _ = selfn;
    _ = self;
    if an == 0 {
        // 不知道归属节点地址：让调用方先查 /edge/route（避免误判 502）。
        srv_static(c, 424, SRV_JSON_502, keep);
        return;
    }
    var ipb: [byte: 64] = [0: 64];
    var ipl: usize = 0;
    var port: u16 = 0;
    if !srv_split_addr(nbaddr[0: an], &ipb[0], 64, &ipl, &port) {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    // B4：`stream=1` 走 SSE 流式转发（不等整个节点响应）
    var stb: [byte: 8] = [0: 8];
    const stn: usize = srv_query_str(&c.path[0], c.path_len, &"stream"[0: 6], 6, &stb[0], 8);
    if stn == 1 && stb[0] == ('1' as byte) {
        srv_edge_proxy_stream(c, ipb[0: ipl], port, pth[0: pn]);
        return;
    }
    var out: [byte: 16384] = [0: 16384];
    var on: usize = 0;
    const r1: !i32 = uplink_request(ipb[0: ipl], port, &"GET"[0: 3], pth[0: pn],
        &""[0: 0], 2000, &out[0], 16384, &on);
    var ok: bool = false;
    var st: i32 = 0;
    const st1: i32 = r1 catch {
        0;
    };
    if st1 > 0 {
        st = st1;
        ok = true;
    }
    if !ok {
        // 归属节点不可达：清亲和后按最新归属重试一次。
        edge_fail(sess[0: ssn]);
        var nb2: [byte: 64] = [0: 64];
        var nn2: usize = 0;
        if g_meta_ready {
            nn2 = edge_route(&g_meta, slug[0: sn], sess[0: ssn], &nb2[0], 64);
        } else {
            nn2 = edge_route_snapshot(slug[0: sn], sess[0: ssn], &nb2[0], 64);
        }
        if nn2 == 0 || !srv_slice_eq(nb2[0: nn2], nb[0: nn]) {
            var a2: [byte: 128] = [0: 128];
            const a2n: usize = edge_addr_get(nb2[0: nn2], &a2[0], 128);
            if a2n > 0 && srv_split_addr(a2[0: a2n], &ipb[0], 64, &ipl, &port) {
                const r2: !i32 = uplink_request(ipb[0: ipl], port, &"GET"[0: 3], pth[0: pn],
                    &""[0: 0], 2000, &out[0], 16384, &on);
                const st2: i32 = r2 catch {
                    0;
                };
                if st2 > 0 {
                    st = st2;
                    ok = true;
                }
            }
        }
    }
    if !ok {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    _ = st;
    srv_static(c, 200, out[0: on], keep);
}


/// B5：把一批 usage 落到本地 spool（controller 不可达时先攒着）。
fn srv_node_spool(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if c.body_len == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    var path: [byte: 320] = [0: 320];
    const pn: usize = srv_spool_path(&path[0], 320);
    if pn == 0 {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    if !spool_try_append(path[0: pn], c.body[0: c.body_len]) {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    }
    srv_static(c, 200, SRV_JSON_OK, keep);
}


/// C2：请求列表（分页）/ 详情（`?id=`）。
fn srv_requests(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    srv_batch_sync();
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    var tok: [byte: 256] = [0: 256];
    const tn: usize = chat_bearer_span(&c.auth[0], c.auth_len, &tok[0], 256);
    if tn == 0 {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var key: StoreKey = StoreKey{ key_id: 0, user_id: 0, rpm: 0, tpm: 0 };
    // A4 快路径：同一 Key 的连续请求走单槽缓存（TTL 2s），省一次 DB 校验。
    store_verify_key_fast(runtime_db(), tok[0: tn], store_now(), &key) catch {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    // B5：分片模式下账本在用户的固定分片；否则在 runtime DB。
    var ldb: &Db = runtime_db();
    if shard_active() {
        ldb = shard_db_for(key.user_id);
    }
    var rid: [byte: 128] = [0: 128];
    const rn: usize = srv_query_str(&c.path[0], c.path_len, &"id"[0: 2], 2, &rid[0], 128);
    if rn > 0 {
        var row: StoreLedgerRow = StoreLedgerRow{};
        const found: bool = store_get_ledger(ldb, key.user_id, rid[0: rn], &row) catch {
            false;
        };
        if !found {
            srv_static(c, 404, SRV_JSON_404, keep);
            return;
        }
        jsonw_obj(&w);
        srv_request_json(&w, &row);
        jsonw_end_obj(&w);
        srv_static(c, 200, jsonw_span(&w), keep);
        return;
    }
    var limit: i64 = srv_query_day(&c.path[0], c.path_len, &"limit"[0: 5], 5);
    if limit <= 0 || limit > 100 {
        limit = 20;
    }
    var offset: i64 = srv_query_day(&c.path[0], c.path_len, &"offset"[0: 6], 6);
    if offset < 0 {
        offset = 0;
    }
    var rows: [StoreLedgerRow: 100] = [];
    var n: usize = 0;
    n = store_list_ledger(ldb, key.user_id, limit, offset, &rows[0], 100) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    jsonw_obj(&w);
    jsonw_key(&w, &"data"[0: 4]);
    jsonw_arr(&w);
    var i: usize = 0;
    while i < n {
        jsonw_obj(&w);
        srv_request_json(&w, &rows[i]);
        jsonw_end_obj(&w);
        i = i + 1;
    }
    jsonw_end_arr(&w);
    jsonw_key(&w, &"limit"[0: 5]);
    jsonw_i64(&w, limit);
    jsonw_key(&w, &"offset"[0: 6]);
    jsonw_i64(&w, offset);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

fn srv_request_json(w: &JsonW, r: &StoreLedgerRow) void {
    jsonw_key(w, &"request_id"[0: 10]);
    jsonw_str(w, r.request_id[0: r.request_id_len]);
    jsonw_key(w, &"ts"[0: 2]);
    jsonw_i64(w, r.ts);
    jsonw_key(w, &"model"[0: 5]);
    jsonw_str(w, r.model[0: r.model_len]);
    jsonw_key(w, &"provider"[0: 8]);
    jsonw_str(w, r.provider[0: r.provider_len]);
    jsonw_key(w, &"input_tokens"[0: 12]);
    jsonw_i64(w, r.input_tokens);
    jsonw_key(w, &"output_tokens"[0: 13]);
    jsonw_i64(w, r.output_tokens);
    jsonw_key(w, &"cache_read_tokens"[0: 17]);
    jsonw_i64(w, r.cache_read_tokens);
    jsonw_key(w, &"cost_nano"[0: 9]);
    jsonw_i64(w, r.cost_nano);
    jsonw_key(w, &"period"[0: 6]);
    jsonw_str(w, r.period[0: r.period_len]);
}


/// C5：审计日志（`<data_dir>/audit.jsonl`，一行一条，复用 spool 的追加/读取）。
fn srv_audit_path(out: &byte, cap: usize) usize {
    var d: [byte: 256] = [0: 256];
    const dn: usize = runtime_dir_copy(&d[0], 256);
    var n: usize = 0;
    var i: usize = 0;
    while i < dn && n < cap {
        out[n] = d[i];
        n = n + 1;
        i = i + 1;
    }
    const suffix: &[byte] = &"/audit.jsonl"[0: 12];
    i = 0;
    while i < suffix.len && n < cap {
        out[n] = suffix[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// 追加一条审计（actor 可指定：admin / user）：`{"ts":..,"actor":..,"action":..,"target":..}`。
fn srv_audit_actor(actor: &[byte], action: &[byte], target: &[byte]) void {
    var path: [byte: 320] = [0: 320];
    const pn: usize = srv_audit_path(&path[0], 320);
    if pn == 0 {
        return;
    }
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"ts"[0: 2]);
    jsonw_i64(&w, store_now());
    jsonw_key(&w, &"actor"[0: 5]);
    jsonw_str(&w, actor);
    jsonw_key(&w, &"action"[0: 6]);
    jsonw_str(&w, action);
    jsonw_key(&w, &"target"[0: 6]);
    jsonw_str(&w, target);
    jsonw_end_obj(&w);
    _ = spool_try_append(path[0: pn], jsonw_span(&w));
}

/// 管理端写操作的审计（actor 固定 admin）。
fn srv_audit(action: &[byte], target: &[byte]) void {
    srv_audit_actor(&"admin"[0: 5], action, target);
}

/// 非负整数转文本（审计 target 里的 key id 用）。
fn srv_i64_text(v: i64, out: &byte, cap: usize) usize {
    var x: u64 = 0;
    if v > 0 {
        x = v as u64;
    }
    var digits: [byte: 20] = [0: 20];
    var d: usize = 0;
    if x == 0 {
        digits[0] = 48;
        d = 1;
    } else {
        while x > 0 && d < 20 {
            digits[d] = (48 +% (x % (10 as u64))) as byte;
            x = x / (10 as u64);
            d = d + 1;
        }
    }
    var n: usize = 0;
    while d > 0 && n < cap {
        d = d - 1;
        out[n] = digits[d];
        n = n + 1;
    }
    return n;
}

/// C5：审计列表（最近 N 行，text/plain 的 JSONL）。
fn srv_admin_audit(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var path: [byte: 320] = [0: 320];
    const pn: usize = srv_audit_path(&path[0], 320);
    var buf: [byte: 16384] = [0: 16384];
    var bn: usize = 0;
    _ = spool_try_read(path[0: pn], &buf[0], 16384, &bn);
    srv_static_ct(c, 200, buf[0: bn], keep, &"text/plain"[0: 10], 10);
}

/// C3：读取当前生效的价目卡 id（不存在则建一张）。
fn srv_price_card() i64 {
    var card: PriceCard = PriceCard{ id: 0, kind: 0, version: 0, effective_from: 0 };
    const lk: !void = price_card_lookup(runtime_db(), 0, store_now(), &card);
    var ok: bool = true;
    _ = lk catch |_| {
        ok = false;
    };
    if ok && card.id > 0 {
        return card.id;
    }
    const now: i64 = store_now();
    var made: PriceCard = PriceCard{ id: 0, kind: 0, version: 0, effective_from: 0 };
    price_card_create(runtime_db(), 0, 1, now -% 86400, store_now(), &"ui"[0: 2], &made) catch {
        return 0 as i64;
    };
    return made.id;
}

/// C3：价目表（GET）/ 改价（POST {model, provider, input, output, cache_read}）。
fn srv_admin_prices(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    const card: i64 = srv_price_card();
    if c.body_len > 0 {
        if card <= 0 {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        }
        var d: JsonDoc = JsonDoc{};
        json_parse(&d, c.body[0: c.body_len]) catch {
            srv_static(c, 400, SRV_JSON_400, keep);
            return;
        };
        const root: i32 = json_root(&d);
        var model: [byte: 96] = [0: 96];
        const mn: usize = json_str(&d, json_get(&d, root, &"model"[0: 5]), &model[0], 96);
        var prov: [byte: 64] = [0: 64];
        const pn: usize = json_str(&d, json_get(&d, root, &"provider"[0: 8]), &prov[0], 64);
        const inr: i64 = json_i64(&d, json_get(&d, root, &"input"[0: 5]));
        const outr: i64 = json_i64(&d, json_get(&d, root, &"output"[0: 6]));
        const cr: i64 = json_i64(&d, json_get(&d, root, &"cache_read"[0: 10]));
        const pr: i64 = json_i64(&d, json_get(&d, root, &"per_request"[0: 11]));
        var sched: [byte: 256] = [0: 256];
        const sn: usize = json_str(&d, json_get(&d, root, &"schedule"[0: 8]), &sched[0], 256);
        if mn == 0 {
            srv_static(c, 400, SRV_JSON_400, keep);
            return;
        }
        // 分时规则先解析校验：坏规则不入库（避免请求时才失败）。
        if sn > 0 {
            var sc: Sched = Sched{ rules: [], count: 0 };
            schedule_parse(sched[0: sn], &sc) catch {
                srv_static(c, 400, SRV_JSON_400, keep);
                return;
            };
        }
        price_entry_put(runtime_db(), card, prov[0: pn], model[0: mn], 0, inr, outr, cr, pr,
            sched[0: sn]) catch {
            srv_static(c, 400, SRV_JSON_400, keep);
            return;
        };
        srv_audit(&"price.put"[0: 9], model[0: mn]);
        if sn > 0 {
            srv_audit(&"schedule.put"[0: 12], model[0: mn]);
        }
        srv_static(c, 200, SRV_JSON_OK, keep);
        return;
    }
    var rows: [PriceEntryRow: 64] = [];
    var n: usize = 0;
    n = price_entry_list(runtime_db(), card, &rows[0], 64) catch {
        0 as usize;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"card_id"[0: 7]);
    jsonw_i64(&w, card);
    jsonw_key(&w, &"data"[0: 4]);
    jsonw_arr(&w);
    var i: usize = 0;
    while i < n {
        jsonw_obj(&w);
        jsonw_key(&w, &"provider"[0: 8]);
        jsonw_str(&w, rows[i].provider[0: rows[i].provider_len]);
        jsonw_key(&w, &"model"[0: 5]);
        jsonw_str(&w, rows[i].model[0: rows[i].model_len]);
        jsonw_key(&w, &"input"[0: 5]);
        jsonw_i64(&w, rows[i].input_nano_per_mtok);
        jsonw_key(&w, &"output"[0: 6]);
        jsonw_i64(&w, rows[i].output_nano_per_mtok);
        jsonw_key(&w, &"cache_read"[0: 10]);
        jsonw_i64(&w, rows[i].cache_read_nano_per_mtok);
        jsonw_key(&w, &"per_request"[0: 11]);
        jsonw_i64(&w, rows[i].per_request_nano);
        jsonw_key(&w, &"schedule"[0: 8]);
        jsonw_str(&w, rows[i].schedule[0: rows[i].schedule_len]);
        jsonw_end_obj(&w);
        i = i + 1;
    }
    jsonw_end_arr(&w);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

/// C3：模型绑定列表（GET）/ 绑定（POST {provider, model, upstream_model}）。
fn srv_admin_models(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var rows: [StoreModelRow: 64] = [];
    var n: usize = 0;
    n = store_list_provider_models(runtime_db(), &rows[0], 64) catch {
        0 as usize;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"data"[0: 4]);
    jsonw_arr(&w);
    var i: usize = 0;
    while i < n {
        jsonw_obj(&w);
        jsonw_key(&w, &"provider_id"[0: 11]);
        jsonw_i64(&w, rows[i].provider_id);
        jsonw_key(&w, &"provider"[0: 8]);
        jsonw_str(&w, rows[i].provider_name[0: rows[i].provider_name_len]);
        jsonw_key(&w, &"model"[0: 5]);
        jsonw_str(&w, rows[i].model[0: rows[i].model_len]);
        jsonw_key(&w, &"upstream_model"[0: 14]);
        jsonw_str(&w, rows[i].upstream_model[0: rows[i].upstream_len]);
        jsonw_end_obj(&w);
        i = i + 1;
    }
    jsonw_end_arr(&w);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

/// C3：把 model 绑到供应商（admin）。
fn srv_admin_bind(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if !srv_admin_ok(c) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    const root: i32 = json_root(&d);
    var prov: [byte: 64] = [0: 64];
    const pn: usize = json_str(&d, json_get(&d, root, &"provider"[0: 8]), &prov[0], 64);
    var model: [byte: 96] = [0: 96];
    const mn: usize = json_str(&d, json_get(&d, root, &"model"[0: 5]), &model[0], 96);
    var up: [byte: 96] = [0: 96];
    const un: usize = json_str(&d, json_get(&d, root, &"upstream_model"[0: 14]), &up[0], 96);
    if pn == 0 || mn == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    const pid: i64 = store_provider_id_by_name(runtime_db(), prov[0: pn]) catch {
        0 as i64;
    };
    if pid <= 0 {
        srv_static(c, 404, SRV_JSON_404, keep);
        return;
    }
    var upb: [byte: 96] = [0: 96];
    var upn: usize = un;
    if un == 0 {
        var k: usize = 0;
        while k < mn && k < 96 {
            upb[k] = model[k];
            k = k + 1;
        }
        upn = k;
    } else {
        var k: usize = 0;
        while k < un && k < 96 {
            upb[k] = up[k];
            k = k + 1;
        }
    }
    store_provider_model_put(runtime_db(), pid, model[0: mn], upb[0: upn], store_now()) catch {
        srv_static(c, 500, SRV_JSON_502, keep);
        return;
    };
    srv_audit(&"bind"[0: 4], model[0: mn]);
    srv_static(c, 200, SRV_JSON_OK, keep);
}

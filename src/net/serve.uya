    if c.route == ROUTE_CTL_REGISTER {
        srv_ctl_register(c, stats);
        return;
    }
    if c.route == ROUTE_CTL_HEARTBEAT {
        srv_ctl_heartbeat(c, stats);
        return;
    }
    if c.route == ROUTE_CTL_CONFIG {
        srv_ctl_config(c, stats);
        return;
    }
    if c.route == ROUTE_CTL_STATUS {
        srv_ctl_status(c, stats);
        return;
    }
    if c.route == ROUTE_MCP {
        srv_mcp(c, stats);
        return;
    }
    if c.route == ROUTE_RESPONSES {
        srv_responses(c, stats);
        return;
    }
    if c.route == ROUTE_ADMIN_HEALTH {
        srv_admin_health(c, stats);
        return;
    }
    if c.route == ROUTE_ADMIN_PRICING {
        if c.is_head_req {
            srv_static(c, 200, &"x"[0: 0], c.keep);
            return;
        }
        srv_admin_pricing_get(c, stats);
        return;
    }
    if c.route == ROUTE_ADMIN_BILLING {
        srv_admin_billing(c, stats);
        return;
    }
    if c.route == ROUTE_ADMIN_BACKUP {
        srv_admin_backup(c, stats);
        return;
    }
    stats.requests = stats.requests +% 1;
    srv_static(c, 404, SRV_JSON_404, keep);
}

// ---------------------------------------------------------------
// 状态机
// ---------------------------------------------------------------

/// 排空包体：1=排完，0=还要更多数据，-1=协议错误。
/// chat 路由：把包体字节采集到连接缓冲（其他路由只排空，不占内存时间）。
fn srv_capture(c: &SrvConn, start: usize, take: usize) void {
    if c.body_overflow {
        return;
    }
    var i: usize = 0;
    while i < take {
        const src: usize = start + i;
        if src < SRV_IO_CAP {
            if c.body_len < SRV_BODY_CAP {
                c.body[c.body_len] = c.in[src];
                c.body_len = c.body_len + 1;
            } else {
                c.body_overflow = true;
            }
        }
        i = i + 1;
    }
}

fn srv_body_step(c: &SrvConn) i32 {
    if !c.chunked {
        const avail: usize = c.in_len -| c.in_pos;
        if avail == 0 {
            return 0;
        }
        // 不用 `const x = if ... else ...`：分支带 `as` 强制转换时会生成
        // `const size_t __uya_ifexpr_N;` 再赋值（只读变量赋值，编译不过）。
        var take: usize = avail;
        if (avail as u64) > c.body_left {
            take = c.body_left as usize;
        }
        srv_capture(c, c.in_pos, take);
        c.in_pos = c.in_pos +% take;
        c.body_left = c.body_left -% (take as u64);
        if c.body_left == 0 {
            return 1;
        }
        return 0;
    }
    var guard: i32 = 0;
    while guard < 1000000 {
        guard = guard + 1;
        if c.chunk_phase == CH_SIZE {
            const crlf: i64 = srv_find_crlf(c, c.in_pos);
            if crlf < 0 {
                return 0;
            }
            const cl: usize = crlf as usize;
            const sz: i64 = srv_hex_size(c, c.in_pos, cl);
            if sz < 0 {
                return 0 - 1;
            }
            c.in_pos = cl +% 2;
            if sz == 0 {
                c.chunk_phase = CH_TRAILER;
            } else {
                c.chunk_left = sz as u64;
                c.chunk_phase = CH_DATA;
            }
            continue;
        }
        if c.chunk_phase == CH_DATA {
            const avail: usize = c.in_len -| c.in_pos;
            if avail == 0 {
                return 0;
            }
            var take: usize = avail;
            if (avail as u64) > c.chunk_left {
                take = c.chunk_left as usize;
            }
            srv_capture(c, c.in_pos, take);
            c.in_pos = c.in_pos +% take;
            c.chunk_left = c.chunk_left -% (take as u64);
            if c.chunk_left == 0 {
                c.chunk_phase = CH_CRLF;
            }
            continue;
        }
        if c.chunk_phase == CH_CRLF {
            if c.in_len -| c.in_pos < 2 {
                return 0;
            }
            c.in_pos = c.in_pos +% 2;
            c.chunk_phase = CH_SIZE;
            continue;
        }
        // CH_TRAILER：读到空行为止
        const crlf2: i64 = srv_find_crlf(c, c.in_pos);
        if crlf2 < 0 {
            return 0;
        }
        const cl2: usize = crlf2 as usize;
        if cl2 == c.in_pos {
            c.in_pos = c.in_pos +% 2;
            return 1;
        }
        c.in_pos = cl2 +% 2;
    }
    return 0 - 1;
}

/// 把待写数据尽量发出去：1=发完，0=对端暂时写不动，-1=出错。
fn srv_flush(c: &SrvConn) i32 {
    while c.out_pos < c.out_len {
        const r: !isize = sys_send(c.fd, &c.out[c.out_pos], c.out_len - c.out_pos, 0);
        const n: isize = r catch |err| {
            const eid: i32 = @error_id(err) as i32;
            if eid == EAGAIN || eid == EWOULDBLOCK {
                return 0;
            }
            return 0 - 1;
        };
        if n <= 0 {
            return 0 - 1;
        }
        c.out_pos = c.out_pos +% (n as usize);
    }
    c.out_pos = 0;
    c.out_len = 0;
    return 1;
}

/// 推进一个连接，直到「需要更多数据」或「等待可写」。
fn srv_drive(c: &SrvConn, stats: &ServeStats) void {
    var guard: i32 = 0;
    while guard < 256 {
        guard = guard + 1;
        if c.state == ST_HEAD {
            srv_compact(c);
            var req: HsrvReq = HsrvReq{};
            const pr: i32 = hsrv_parse_head(&c.in[0], c.in_len, SRV_IO_CAP, &req);
            if pr == 0 {
                if c.in_len >= SRV_IO_CAP {
                    stats.bad = stats.bad +% 1;
                    srv_static(c, 431, SRV_JSON_431, false);
                    continue;
                }
                srv_set_interest(c, false);
                return;
            }
            if pr < 0 {
                stats.bad = stats.bad +% 1;
                srv_static(c, 400, SRV_JSON_400, false);
                continue;
            }
            c.keep = req.keep_alive;
            c.route = srv_route_of(&req);
            c.is_head_req = req.method_len == 4 && req.method[0] == ('H' as byte);
            c.is_get = req.method_len == 3 && req.method[0] == ('G' as byte);
            c.auth_len = 0;
            var ai: usize = 0;
            while ai < req.auth_len && ai < 256 {
                c.auth[ai] = req.auth[ai];
                ai = ai + 1;
            }
            c.auth_len = ai;
            c.path_len = 0;
            var pi: usize = 0;
            while pi < req.path_len && pi < 1024 {
                c.path[pi] = req.path[pi];
                pi = pi + 1;
            }
            c.path_len = pi;
            c.body_len = 0;
            c.body_overflow = false;
            c.in_pos = req.head_len;
            c.chunked = req.chunked;
            c.chunk_left = 0;
            c.chunk_phase = CH_SIZE;
            c.body_left = 0;
            if !req.chunked && req.content_length > 0 {
                c.body_left = req.content_length as u64;
            }
            if req.expect_continue && (req.chunked || req.content_length > 0) {
                // 尽力而为：25 字节几乎不会半发；半发也只能等客户端自己超时重发
                const cont: !isize = sys_send(c.fd, srv_ptr(&"HTTP/1.1 100 Continue\r\n\r\n"[0: 25]), 25, 0);
                _ = cont catch |_| {
                    0 as isize;
                };
            }
            if c.chunked || c.body_left > 0 {
                c.state = ST_BODY;
                continue;
            }
            srv_begin_response(c, stats);
            continue;
        }
        if c.state == ST_BODY {
            const bd: i32 = srv_body_step(c);
            if bd == 0 {
                srv_set_interest(c, false);
                return;
            }
            if bd < 0 {
                stats.bad = stats.bad +% 1;
                srv_static(c, 400, SRV_JSON_400, false);
                continue;
            }
            srv_begin_response(c, stats);
            continue;
        }
        if c.state == ST_WRITE {
            const fr: i32 = srv_flush(c);
            if fr == 0 {
                srv_set_interest(c, true);
                return;
            }
            if fr < 0 {
                srv_close_slot(srv_slot_of(c.fd));
                return;
            }
            if !c.keep {
                srv_close_slot(srv_slot_of(c.fd));
                return;
            }
            c.state = ST_HEAD;
            c.is_head_req = false;
            c.route = ROUTE_404;
            continue;
        }
        if c.state == ST_SSE {
            if c.out_len > c.out_pos {
                const fr2: i32 = srv_flush(c);
                if fr2 == 0 {
                    srv_set_interest(c, true);
                    return;
                }
                if fr2 < 0 {
                    srv_close_slot(srv_slot_of(c.fd));
                    return;
                }
            }
            if c.sse_left > 0 {
                srv_set_interest(c, false);
                return;
            }
            // 事件推完：补最后一个 chunk，然后按 keep=false 收尾
            c.out_pos = 0;
            c.out_len = hsrv_chunk_last(&c.out[0], SRV_OUT_CAP);
            c.keep = false;
            c.state = ST_WRITE;
            continue;
        }
        srv_close_slot(srv_slot_of(c.fd));
        return;
    }
}

/// 可读事件：尽量读到 EAGAIN，然后推进状态机。
fn srv_on_readable(c: &SrvConn, stats: &ServeStats) void {
    var guard: i32 = 0;
    while guard < 1024 {
        guard = guard + 1;
        if c.state == ST_FREE {
            return;
        }
        if c.state == ST_SSE {
            return;
        }
        srv_compact(c);
        if c.in_len >= SRV_IO_CAP {
            srv_drive(c, stats);
            if c.state == ST_FREE {
                return;
            }
            if c.state != ST_HEAD && c.state != ST_BODY {
                return;
            }
            if c.in_len >= SRV_IO_CAP {
                stats.bad = stats.bad +% 1;
                srv_static(c, 431, SRV_JSON_431, false);
                srv_drive(c, stats);
                return;
            }
            continue;
        }
        if c.in_len >= SRV_IO_CAP {
            return;
        }
        const r: !isize = sys_recv(c.fd, &c.in[c.in_len], SRV_IO_CAP - c.in_len, 0);
        const n: isize = r catch |err| {
            const eid: i32 = @error_id(err) as i32;
            if eid == EAGAIN || eid == EWOULDBLOCK {
                srv_drive(c, stats);
                return;
            }
            srv_close_slot(srv_slot_of(c.fd));
            return;
        };
        if n == 0 {
            srv_close_slot(srv_slot_of(c.fd));
            return;
        }
        c.in_len = c.in_len +% (n as usize);
        srv_drive(c, stats);
        if c.state == ST_WRITE {
            return;
        }
    }
}

/// epoll 事件分发。
fn srv_on_event(fd: i32, evs: u32, stats: &ServeStats) void {
    const slot: i32 = srv_slot_of(fd);
    if slot < 0 || (slot as usize) >= SRV_MAX_CONNS {
        return;
    }
    const c: &SrvConn = &g_conns[slot as usize];
    if (evs & (SRV_EPOLLERR | SRV_EPOLLHUP)) != 0 {
        srv_close_slot(slot);
        return;
    }
    if (evs & (EPOLLOUT as u32)) != 0 && c.out_len > c.out_pos {
        srv_drive(c, stats);
        if c.state == ST_FREE {
            return;
        }
    }
    if (evs & (EPOLLIN as u32)) != 0 {
        srv_on_readable(c, stats);
    }
}

fn srv_accept_all(stats: &ServeStats) void {
    var guard: i32 = 0;
    while guard < 256 {
        guard = guard + 1;
        const slot: i32 = srv_alloc_slot();
        if slot < 0 || (slot as usize) >= SRV_MAX_CONNS {
            stats.rejected = stats.rejected +% 1;
            return;
        }
        var alen: u32 = 16;
        var peer: [byte: 16] = [0: 16];
        const acc: !i32 = sys_accept(g_listen_fd, &peer[0] as &void, &alen);
        const cfd: i32 = acc catch |_| {
            return;
        };
        tcpx_set_nodelay(cfd);
        tcpx_set_nonblocking(cfd) catch |_| {};
        const i: usize = slot as usize;
        g_conns[i].fd = cfd;
        g_conns[i].state = ST_HEAD;
        g_conns[i].in_len = 0;
        g_conns[i].in_pos = 0;
        g_conns[i].out_len = 0;
        g_conns[i].out_pos = 0;
        g_conns[i].route = ROUTE_404;
        g_conns[i].keep = false;
        g_conns[i].is_head_req = false;
        g_conns[i].is_get = false;
        g_conns[i].body_left = 0;
        g_conns[i].chunked = false;
        g_conns[i].chunk_left = 0;
        g_conns[i].chunk_phase = CH_SIZE;
        g_conns[i].sse_left = 0;
        g_conns[i].sse_next = 0;
        var ev: EpollEvent = epoll_event_with_fd(EPOLLIN as u32, cfd);
        const ar: !i32 = sys_epoll_ctl(g_epfd, EPOLL_CTL_ADD, cfd, &ev);
        _ = ar catch |_| {
            g_conns[i].fd = 0 - 1;
            g_conns[i].state = ST_FREE;
            _ = sys_close(cfd) catch {};
            continue;
        };
        stats.conns = stats.conns +% 1;
        stats.active = stats.active +% 1;
        if stats.active > stats.max_active {
            stats.max_active = stats.active;
        }
    }
}

/// SSE 定时推进：到点的连接补一个 chunk，再交给状态机去发。
fn srv_tick_sse(now: u64, stats: &ServeStats) void {
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        const c: &SrvConn = &g_conns[i];
        if c.state == ST_SSE && c.sse_left > 0 && now >= c.sse_next && c.out_len == c.out_pos {
            c.out_pos = 0;
            c.out_len = hsrv_chunk(&c.out[0], SRV_OUT_CAP, SRV_SSE_LINE, SRV_SSE_LINE.len);
            c.sse_left = c.sse_left -| 1;
            c.sse_next = now +% SRV_SSE_GAP_MS;
            srv_drive(c, stats);
        }
        i = i + 1;
    }
}

/// 停机扫尾：空闲连接直接关，有在途响应的标记 keep=false 让它自然收尾。
fn srv_shutdown_sweep() void {
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        if g_conns[i].state != ST_FREE {
            if g_conns[i].state == ST_HEAD && g_conns[i].in_len == 0
                && g_conns[i].out_len == g_conns[i].out_pos {
                srv_close_slot(i as i32);
            } else {
                g_conns[i].keep = false;
            }
        }
        i = i + 1;
    }
}

/// 单线程事件循环。`lfd` 由 `serve_listen` 建好（非阻塞）。
/// 收到 SIGTERM/SIGINT 后：停止 accept → 等空闲连接关闭/在途请求收尾（最多 2 s）→ 返回 0。
export fn serve_run(lfd: i32, stats: &ServeStats) !i32 {
    _ = signal(SIGTERM, &srv_on_signal as &void);
    _ = signal(SIGINT, &srv_on_signal as &void);
    _ = signal(SIGPIPE, SIG_IGN as &void);
    _ = SIGTERM;
    g_stop = 0;
    g_listen_fd = lfd;
    var i: usize = 0;
    while i < SRV_MAX_CONNS {
        g_conns[i].fd = 0 - 1;
        g_conns[i].state = ST_FREE;
        g_conns[i].in_len = 0;
        g_conns[i].in_pos = 0;
        g_conns[i].out_len = 0;
        g_conns[i].out_pos = 0;
        g_conns[i].sse_left = 0;
        g_conns[i].chunk_phase = CH_SIZE;
        i = i + 1;
    }
    const epfd: i32 = try sys_epoll_create1(EPOLL_CLOEXEC);
    g_epfd = epfd;
    var lev: EpollEvent = epoll_event_with_fd(EPOLLIN as u32, lfd);
    _ = try sys_epoll_ctl(epfd, EPOLL_CTL_ADD, lfd, &lev);

    var events: [EpollEvent: 64] = [];
    var stopping: i32 = 0;
    var stop_at: u64 = 0;
    var rc: i32 = 0;
    while true {
        // A2 接线：每日备份 / journal 清理；未初始化运行时是 no-op。
        if g_meta_ready {
        const mnow: i64 = store_now();
        var nb: [byte: 64] = [0: 64];
        const nn: usize = srv_node_copy(&nb[0], 64);
        const role: i32 = elect_tick_or(&g_meta, nb[0: nn], mnow, 30);
        runtime_set_backup_allowed(elect_may_backup(role));
        meta_node_heartbeat(&g_meta, nb[0: nn], mnow) catch {};
        const rms: u64 = srv_now_ms();
        if rms > g_rebalance_last_ms +% 3000 {
            g_rebalance_last_ms = rms;
            _ = meta_rebalance(&g_meta, mnow, 3) catch {
                0 as i64;
            };
        }
    }
    if g_uplink_ready {
        const ums: u64 = srv_now_ms();
        if ums > g_uplink_last_ms +% 1000 {
            g_uplink_last_ms = ums;
            var ipb: [byte: 64] = [0: 64];
            const ipn: usize = srv_uplink_copy(&ipb[0], 64);
            var nb: [byte: 64] = [0: 64];
            const nn: usize = srv_node_copy(&nb[0], 64);
            var ab: [byte: 128] = [0: 128];
            const an: usize = srv_self_addr_copy(&ab[0], 128);
            _ = uplink_register(ipb[0: ipn], g_uplink_port, nb[0: nn],
                &"edge"[0: 4], ab[0: an], 2000) catch {};
            uplink_heartbeat(ipb[0: ipn], g_uplink_port, nb[0: nn], 0, 0, 2000) catch {};
        }
        // B5：每 2s 把本地 spool 里的 batch 重放到 controller（断网恢复后对账）。
        if ums > g_spool_last_ms +% 2000 {
            g_spool_last_ms = ums;
            var ipb3: [byte: 64] = [0: 64];
            const ipn3: usize = srv_uplink_copy(&ipb3[0], 64);
            srv_spool_flush(ipb3[0: ipn3]);
        }
        // B2：每 3s 拉一次 config 快照（版本/epoch/归属），边缘节点据此本地路由。
        if ums > g_cfg_last_ms +% 3000 {
            g_cfg_last_ms = ums;
            var ipb2: [byte: 64] = [0: 64];
            const ipn2: usize = srv_uplink_copy(&ipb2[0], 64);
            var nb2: [byte: 64] = [0: 64];
            const nn2: usize = srv_node_copy(&nb2[0], 64);
            srv_cfg_pull(ipb2[0: ipn2], nb2[0: nn2]);
        }
    }
    runtime_tick();
        batch_tick(srv_now_ms());
        if srv_stop_requested() != 0 && stopping == 0 {
            stopping = 1;
            stop_at = srv_now_ms() +% SRV_SHUTDOWN_MS;
            if g_listen_fd >= 0 {
                _ = sys_epoll_ctl_del(epfd, g_listen_fd) catch {};
                _ = sys_close(g_listen_fd) catch {};
                g_listen_fd = 0 - 1;
            }
            srv_shutdown_sweep();
        }
        const now: u64 = srv_now_ms();
        srv_tick_sse(now, stats);
        stats.active = srv_active_count();
        if stopping != 0 {
            if stats.active == 0 || now >= stop_at {
                break;
            }
        }
        var tmo: i32 = SRV_IDLE_MS;
        if stats.sse > 0 || stopping != 0 {
            tmo = SRV_TICK_MS;
        }
        const waited: !i32 = sys_epoll_wait(epfd, &events[0], SRV_EV_MAX, tmo);
        const n: i32 = waited catch |_| {
            continue;
        };
        var k: i32 = 0;
        while k < n {
            const fd: i32 = epoll_event_fd(&events[k as usize]);
            const evs: u32 = events[k as usize].events;
            if fd == g_listen_fd {
                srv_accept_all(stats);
            } else {
                srv_on_event(fd, evs, stats);
            }
            k = k + 1;
        }
    }
    // 收尾：关掉所有还挂着的连接与 epoll
    var j: usize = 0;
    while j < SRV_MAX_CONNS {
        if g_conns[j].state != ST_FREE {
            srv_close_slot(j as i32);
        }
        j = j + 1;
    }
    if g_listen_fd >= 0 {
        _ = sys_close(g_listen_fd) catch {};
        g_listen_fd = 0 - 1;
    }
    _ = sys_close(epfd) catch {};
    g_epfd = 0 - 1;
    rc = 0;
    return rc;
}

// ---------------------------------------------------------------
// A2：OTP / 登录 / 建 Key / me（HTTP 认证入口）
// ---------------------------------------------------------------

/// 开发模式：OTP 响应里带验证码（默认关闭）。
var g_dev_otp: bool = false;

/// A7 管理接口的 Bearer Key（`--admin-key`）；空 = 禁用管理接口。
var g_admin_key: [byte: 128] = [0: 128];
var g_admin_len: usize = 0;

export fn srv_admin_set(key: &[byte]) void {
    g_admin_len = 0;
    var i: usize = 0;
    while i < key.len && i < 128 {
        g_admin_key[i] = key[i];
        i = i + 1;
    }
    g_admin_len = i;
}

fn srv_json_body_str(c: &SrvConn, key: &[byte], out: &byte, cap: usize) usize {
    if c.body_len == 0 {
        return 0;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        return 0;
    };
    const v: i32 = json_get(&d, json_root(&d), key);
    if json_kind(&d, v) != JSON_STR {
        return 0;
    }
    return json_str(&d, v, out, cap);
}

/// 从 Authorization 解析会话或 API Key，写回 user_id。
fn srv_bearer_uid(c: &SrvConn, uid: &i64) bool {
    var tok: [byte: 256] = [0: 256];
    const tn: usize = chat_bearer_span(&c.auth[0], c.auth_len, &tok[0], 256);
    if tn == 0 {
        return false;
    }
    var su: i64 = 0;
    store_verify_session(runtime_db(), tok[0: tn], store_now(), &su) catch {
        var k: StoreKey = StoreKey{ key_id: 0, user_id: 0, rpm: 0, tpm: 0 };
        store_verify_key(runtime_db(), tok[0: tn], &k) catch {
            return false;
        };
        uid[0] = k.user_id;
        return true;
    };
    uid[0] = su;
    return true;
}

/// POST /v1/auth/otp：发验证码（`--dev-otp` 时响应里带 code）
fn srv_otp(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var email: [byte: 128] = [0: 128];
    const en: usize = srv_json_body_str(c, &"email"[0: 5], &email[0], 128);
    if en == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    var code: [byte: 16] = [0: 16];
    const cn: usize = store_request_otp(runtime_db(), email[0: en], store_now(),
        600, &code[0], 16) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"ok"[0: 2]);
    jsonw_bool(&w, true);
    if g_dev_otp {
        jsonw_key(&w, &"code"[0: 4]);
        jsonw_str(&w, code[0: cn]);
    }
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

/// POST /v1/auth/login：校验 OTP（用户不存在则建），发会话 token。
fn srv_login(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var email: [byte: 128] = [0: 128];
    const en: usize = srv_json_body_str(c, &"email"[0: 5], &email[0], 128);
    var code: [byte: 16] = [0: 16];
    const cn: usize = srv_json_body_str(c, &"code"[0: 4], &code[0], 16);
    if en == 0 || cn == 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    store_verify_otp(runtime_db(), email[0: en], code[0: cn], store_now()) catch {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    };
    var u: StoreUser = StoreUser{ id: 0, status: 0, found: false };
    store_find_user(runtime_db(), email[0: en], &u) catch {
        var slug: [byte: 16] = [0: 16];
        const sn: usize = store_new_slug(&slug[0], 16) catch {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        };
        store_create_user(runtime_db(), email[0: en], slug[0: sn], store_now(), &u) catch {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        };
    };
    var tok: [byte: 64] = [0: 64];
    const tn: usize = store_create_session(runtime_db(), u.id, store_now(),
        604800, &tok[0], 64) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"session"[0: 7]);
    jsonw_str(&w, tok[0: tn]);
    jsonw_key(&w, &"user_id"[0: 7]);
    jsonw_i64(&w, u.id);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

/// POST /v1/keys/revoke：撤销自己的 Key（越权/不存在 → 404）。
fn srv_key_revoke(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var uid: i64 = 0;
    if !srv_bearer_uid(c, &uid) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    var d: JsonDoc = JsonDoc{};
    json_parse(&d, c.body[0: c.body_len]) catch {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    };
    const kid: i64 = json_i64(&d, json_get(&d, json_root(&d), &"key_id"[0: 6]));
    if kid <= 0 {
        srv_static(c, 400, SRV_JSON_400, keep);
        return;
    }
    const ok: bool = store_revoke_key_owned(runtime_db(), kid, uid, store_now()) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    if !ok {
        srv_static(c, 404, SRV_JSON_404, keep);
        return;
    }
    var tb: [byte: 24] = [0: 24];
    const tn: usize = srv_i64_text(kid, &tb[0], 24);
    srv_audit_actor(&"user"[0: 4], &"key.revoke"[0: 10], tb[0: tn]);
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"ok"[0: 2]);
    jsonw_bool(&w, true);
    jsonw_key(&w, &"key_id"[0: 6]);
    jsonw_i64(&w, kid);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}

/// POST /v1/keys：会话鉴权后建 Key；GET 列自己的 Key。
fn srv_keys(c: &SrvConn, stats: &ServeStats) void {
    const keep: bool = c.keep;
    stats.requests = stats.requests +% 1;
    if !runtime_ready() {
        srv_static(c, 503, SRV_JSON_503, keep);
        return;
    }
    if c.body_overflow {
        srv_static(c, 413, SRV_JSON_413, keep);
        return;
    }
    var uid: i64 = 0;
    if !srv_bearer_uid(c, &uid) {
        srv_static(c, 401, SRV_JSON_401, keep);
        return;
    }
    if c.is_get {
        var rows: [StoreKeyRow: 32] = [];
        var n: usize = 0;
        n = store_list_keys(runtime_db(), uid, &rows[0], 32) catch {
            srv_static(c, 502, SRV_JSON_502, keep);
            return;
        };
        var w: JsonW = JsonW{};
        jsonw_init(&w);
        jsonw_obj(&w);
        jsonw_key(&w, &"data"[0: 4]);
        jsonw_arr(&w);
        var i: usize = 0;
        while i < n {
            jsonw_obj(&w);
            jsonw_key(&w, &"id"[0: 2]);
            jsonw_i64(&w, rows[i].key_id);
            jsonw_key(&w, &"prefix"[0: 6]);
            jsonw_str(&w, rows[i].prefix[0: rows[i].prefix_len]);
            jsonw_key(&w, &"name"[0: 4]);
            jsonw_str(&w, rows[i].name[0: rows[i].name_len]);
            jsonw_key(&w, &"created_at"[0: 10]);
            jsonw_i64(&w, rows[i].created_at);
            jsonw_key(&w, &"revoked_at"[0: 10]);
            jsonw_i64(&w, rows[i].revoked_at);
            jsonw_end_obj(&w);
            i = i + 1;
        }
        jsonw_end_arr(&w);
        jsonw_end_obj(&w);
        srv_static(c, 200, jsonw_span(&w), keep);
        return;
    }
    var name: [byte: 64] = [0: 64];
    const nn: usize = srv_json_body_str(c, &"name"[0: 4], &name[0], 64);
    var kb: [byte: 64] = [0: 64];
    const kn: usize = store_create_key(runtime_db(), uid, name[0: nn], store_now(),
        &kb[0], 64) catch {
        srv_static(c, 502, SRV_JSON_502, keep);
        return;
    };
    srv_audit_actor(&"user"[0: 4], &"key.create"[0: 10], name[0: nn]);
    var w: JsonW = JsonW{};
    jsonw_init(&w);
    jsonw_obj(&w);
    jsonw_key(&w, &"key"[0: 3]);
    jsonw_str(&w, kb[0: kn]);
    jsonw_key(&w, &"user_id"[0: 7]);
    jsonw_i64(&w, uid);
    jsonw_end_obj(&w);
    srv_static(c, 200, jsonw_span(&w), keep);
}


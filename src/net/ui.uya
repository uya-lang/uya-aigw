// src/net/ui.uya — C1 静态壳：登录/资料/接入点（单页，无构建步骤）
//
// 页面只做三件事：邮箱验证码登录、建/列 Key、给出接入点 URL 与 curl 示例。
// 所有数据都走已发布的 /v1 接口，UI 自身无状态。

export const UI_INDEX_MAX: usize = 16384;

/// 首页 HTML（写进 out，返回长度）。
export fn ui_index(out: &byte, cap: usize) usize {
    const html: &const byte = "<!doctype html><html lang=\"zh\"><head><meta charset=\"utf-8\">" as &const byte;
    var n: usize = 0;
    n = ui_put(out, cap, n, html);
    n = ui_put(out, cap, n, "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">" as &const byte);
    n = ui_put(out, cap, n, "<title>aigw 控制台</title></head><body>" as &const byte);
    n = ui_put(out, cap, n, "<h1 id=\"title\">aigw 控制台</h1>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"login\"><h2>登录</h2>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"email\" placeholder=\"email\" autocomplete=\"username\">" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"send-otp\">发送验证码</button>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"code\" placeholder=\"验证码\">" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"login\">登录</button><p id=\"msg\"></p></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"profile\" hidden><h2>资料</h2><p id=\"uid\"></p>" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"logout\">退出</button></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"keys\" hidden><h2>密钥</h2>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"key-name\" placeholder=\"名称\"><button id=\"new-key\">新建</button>" as &const byte);
    n = ui_put(out, cap, n, "<ul id=\"key-list\"></ul><p id=\"new-key-val\"></p></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"endpoint\" hidden><h2>接入点</h2>" as &const byte);
    n = ui_put(out, cap, n, "<code id=\"base-url\"></code><pre id=\"curl\"></pre></section>" as &const byte);
    n = ui_put(out, cap, n, "<script src=\"/ui/app.js\"></script></body></html>" as &const byte);
    return n;
}

fn ui_put(out: &byte, cap: usize, at: usize, s: &const byte) usize {
    var i: usize = 0;
    while s[i] != (0 as byte) && at + i < cap {
        out[at + i] = s[i];
        i = i + 1;
    }
    return at + i;
}

/// 前端脚本（登录/建 Key/接入点）。
export fn ui_app_js(out: &byte, cap: usize) usize {
    var n: usize = 0;
    n = ui_put(out, cap, n, "const $=id=>document.getElementById(id);" as &const byte);
    n = ui_put(out, cap, n, "let tok=localStorage.getItem('aigw_session')||'';" as &const byte);
    n = ui_put(out, cap, n, "const api=(p,b,t)=>fetch(p,{method:b?'POST':'GET',headers:Object.assign({'Content-Type':'application/json'},t?{Authorization:'Bearer '+t}:{}),body:b?JSON.stringify(b):undefined});" as &const byte);
    n = ui_put(out, cap, n, "async function sendOtp(){const r=await api('/v1/auth/otp',{email:$('email').value});const j=await r.json();$('msg').textContent=j.dev_code?('验证码(开发):'+j.dev_code):'已发送';}" as &const byte);
    n = ui_put(out, cap, n, "async function login(){const r=await api('/v1/auth/login',{email:$('email').value,code:$('code').value});const j=await r.json();if(!r.ok){$('msg').textContent=j.error||'登录失败';return;}tok=j.session;localStorage.setItem('aigw_session',tok);show();}" as &const byte);
    n = ui_put(out, cap, n, "async function show(){if(!tok)return;const r=await api('/v1/me',null,tok);if(!r.ok){tok='';localStorage.removeItem('aigw_session');return;}const j=await r.json();$('profile').hidden=false;$('keys').hidden=false;$('endpoint').hidden=false;$('uid').textContent='user_id: '+j.user_id;$('base-url').textContent=location.origin;$('curl').textContent='curl '+location.origin+'/v1/chat/completions -H \"Authorization: Bearer <key>\" -H \"Content-Type: application/json\" -d \\'{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}\\'';list();}" as &const byte);
    n = ui_put(out, cap, n, "async function list(){const r=await api('/v1/keys',null,tok);if(!r.ok)return;const j=await r.json();$('key-list').innerHTML='';(j.data||[]).forEach(k=>{const li=document.createElement('li');li.textContent=k.name+' '+k.prefix+(k.revoked_at?' (已撤销)':'');if(!k.revoked_at){const b=document.createElement('button');b.textContent='撤销';b.onclick=async()=>{await api('/v1/keys/revoke',{key_id:k.id},tok);list();};li.appendChild(b);}$('key-list').appendChild(li);});}" as &const byte);
    n = ui_put(out, cap, n, "async function newKey(){const r=await api('/v1/keys',{name:$('key-name').value||'ui'},tok);const j=await r.json();$('new-key-val').textContent=j.key?('新 Key：'+j.key):'创建失败';list();}" as &const byte);
    n = ui_put(out, cap, n, "$('send-otp').onclick=sendOtp;$('login').onclick=login;$('new-key').onclick=newKey;$('logout').onclick=()=>{tok='';localStorage.removeItem('aigw_session');location.reload();};" as &const byte);
    n = ui_put(out, cap, n, "show();" as &const byte);
    return n;
}

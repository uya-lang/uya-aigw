// src/net/ui.uya — C1 静态壳：登录/资料/接入点（单页，无构建步骤）
//
// 页面只做三件事：邮箱验证码登录、建/列 Key、给出接入点 URL 与 curl 示例。
// 所有数据都走已发布的 /v1 接口，UI 自身无状态。

export const UI_INDEX_MAX: usize = 16384;

/// 首页 HTML（写进 out，返回长度）。
export fn ui_index(out: &byte, cap: usize) usize {
    const html: &const byte = "<!doctype html><html lang=\"zh\"><head><meta charset=\"utf-8\">" as &const byte;
    var n: usize = 0;
    n = ui_put(out, cap, n, html);
    n = ui_put(out, cap, n, "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">" as &const byte);
    n = ui_put(out, cap, n, "<title>aigw 控制台</title></head><body>" as &const byte);
    n = ui_put(out, cap, n, "<h1 id=\"title\">aigw 控制台</h1>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"login\"><h2>登录</h2>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"email\" placeholder=\"email\" autocomplete=\"username\">" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"send-otp\">发送验证码</button>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"code\" placeholder=\"验证码\">" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"login\">登录</button><p id=\"msg\"></p></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"profile\" hidden><h2>资料</h2><p id=\"uid\"></p>" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"logout\">退出</button></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"keys\" hidden><h2>密钥</h2>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"key-name\" placeholder=\"名称\"><button id=\"new-key\">新建</button>" as &const byte);
    n = ui_put(out, cap, n, "<ul id=\"key-list\"></ul><p id=\"new-key-val\"></p></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"overview\" hidden><h2>概览</h2>" as &const byte);
    n = ui_put(out, cap, n, "<p id=\"totals\"></p><table id=\"usage-table\"><thead><tr>" as &const byte);
    n = ui_put(out, cap, n, "<th>day</th><th>model</th><th>requests</th><th>cost_nano</th><th>price_nano</th>" as &const byte);
    n = ui_put(out, cap, n, "</tr></thead><tbody></tbody></table>" as &const byte);
    n = ui_put(out, cap, n, "<a id=\"csv\" href=\"/v1/usage.csv\">导出 CSV</a>" as &const byte);
    n = ui_put(out, cap, n, "<h3>请求列表</h3><table id=\"req-table\"><thead><tr><th>request_id</th><th>ts</th><th>model</th><th>in</th><th>out</th><th>cost_nano</th></tr></thead><tbody></tbody></table>" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"req-prev\">上一页</button><button id=\"req-next\">下一页</button><pre id=\"req-detail\"></pre></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"billing\" hidden><h2>账单与预算</h2>" as &const byte);
    n = ui_put(out, cap, n, "<p id=\"budget-state\"></p>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"budget-nano\" placeholder=\"月度预算(nano)\">" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"budget-save\">保存</button></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"playground\" hidden><h2>Playground</h2>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"pg-model\" value=\"mock-model\">" as &const byte);
    n = ui_put(out, cap, n, "<textarea id=\"pg-prompt\" rows=\"3\">hello</textarea>" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"pg-send\">发送</button>" as &const byte);
    n = ui_put(out, cap, n, "<pre id=\"pg-out\"></pre><p id=\"pg-metrics\"></p></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"estimate\" hidden><h2>费用估算</h2>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"est-prompt\" placeholder=\"输入 tokens\" value=\"1000\">" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"est-completion\" placeholder=\"输出 tokens\" value=\"500\">" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"estimate-go\">估算</button><p id=\"est-out\"></p></section>" as &const byte);
    n = ui_put(out, cap, n, "<section id=\"endpoint\" hidden><h2>接入点</h2>" as &const byte);
    n = ui_put(out, cap, n, "<code id=\"base-url\"></code><pre id=\"curl\"></pre></section>" as &const byte);
    n = ui_put(out, cap, n, "<script src=\"/ui/app.js\"></script></body></html>" as &const byte);
    return n;
}

fn ui_put(out: &byte, cap: usize, at: usize, s: &const byte) usize {
    var i: usize = 0;
    while s[i] != (0 as byte) && at + i < cap {
        out[at + i] = s[i];
        i = i + 1;
    }
    return at + i;
}

/// 前端脚本（登录/建 Key/接入点）。
export fn ui_app_js(out: &byte, cap: usize) usize {
    var n: usize = 0;
    n = ui_put(out, cap, n, "const $=id=>document.getElementById(id);" as &const byte);
    n = ui_put(out, cap, n, "let tok=localStorage.getItem('aigw_session')||'';" as &const byte);
    n = ui_put(out, cap, n, "const api=(p,b,t)=>fetch(p,{method:b?'POST':'GET',headers:Object.assign({'Content-Type':'application/json'},t?{Authorization:'Bearer '+t}:{}),body:b?JSON.stringify(b):undefined});" as &const byte);
    n = ui_put(out, cap, n, "async function sendOtp(){const r=await api('/v1/auth/otp',{email:$('email').value});const j=await r.json();$('msg').textContent=j.dev_code?('验证码(开发):'+j.dev_code):'已发送';}" as &const byte);
    n = ui_put(out, cap, n, "async function login(){const r=await api('/v1/auth/login',{email:$('email').value,code:$('code').value});const j=await r.json();if(!r.ok){$('msg').textContent=j.error||'登录失败';return;}tok=j.session;localStorage.setItem('aigw_session',tok);show();}" as &const byte);
    n = ui_put(out, cap, n, "async function show(){if(!tok)return;const r=await api('/v1/me',null,tok);if(!r.ok){tok='';localStorage.removeItem('aigw_session');return;}const j=await r.json();$('profile').hidden=false;$('keys').hidden=false;$('endpoint').hidden=false;$('overview').hidden=false;$('estimate').hidden=false;$('playground').hidden=false;$('billing').hidden=false;$('uid').textContent='user_id: '+j.user_id;$('base-url').textContent=location.origin;$('curl').textContent='curl '+location.origin+'/v1/chat/completions -H \"Authorization: Bearer <key>\" -H \"Content-Type: application/json\" -d \\'{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}\\'';list();usage();budget();reqs();}" as &const byte);
    n = ui_put(out, cap, n, "async function usage(){const r=await api('/v1/usage',null,tok);if(!r.ok)return;const j=await r.json();const t=j.totals||{};$('totals').textContent='请求 '+t.requests+' · 输入 '+t.input_tokens+' · 输出 '+t.output_tokens+' · 成本 '+t.cost_nano+' · 收费 '+t.price_nano+' · 毛利 '+t.profit_nano;const tb=document.querySelector('#usage-table tbody');tb.innerHTML='';(j.data||[]).forEach(x=>{const tr=document.createElement('tr');[x.day,x.model,x.requests,x.cost_nano,x.price_nano].forEach(v=>{const td=document.createElement('td');td.textContent=v;tr.appendChild(td);});tb.appendChild(tr);});}" as &const byte);
    n = ui_put(out, cap, n, "async function budget(){const r=await api('/v1/budget',null,tok);if(!r.ok)return;const j=await r.json();$('budget-state').textContent='当月已用 '+j.spent_nano+' / 预算 '+(j.monthly_nano||'未设置')+' nano'+(j.over_budget?'（已超预算）':'');}" as &const byte);
    n = ui_put(out, cap, n, "async function saveBudget(){await api('/v1/budget',{monthly_nano:+$('budget-nano').value},tok);budget();}" as &const byte);
    n = ui_put(out, cap, n, "let roff=0;async function reqs(){const r=await api('/v1/requests?limit=20&offset='+roff,null,tok);if(!r.ok)return;const j=await r.json();const tb=document.querySelector('#req-table tbody');tb.innerHTML='';(j.data||[]).forEach(x=>{const tr=document.createElement('tr');[x.request_id,x.ts,x.model,x.input_tokens,x.output_tokens,x.cost_nano].forEach(v=>{const td=document.createElement('td');td.textContent=v;tr.appendChild(td);});tr.style.cursor='pointer';tr.onclick=async()=>{const d=await api('/v1/requests?id='+encodeURIComponent(x.request_id),null,tok);$('req-detail').textContent=JSON.stringify(await d.json(),null,2);};tb.appendChild(tr);});}" as &const byte);
    n = ui_put(out, cap, n, "$('req-prev').onclick=()=>{roff=Math.max(0,roff-20);reqs();};$('req-next').onclick=()=>{roff+=20;reqs();};" as &const byte);
    n = ui_put(out, cap, n, "async function play(){const t0=performance.now();$('pg-out').textContent='';$('pg-metrics').textContent='';const r=await fetch('/v1/chat/completions',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+tok},body:JSON.stringify({model:$('pg-model').value,stream:true,messages:[{role:'user',content:$('pg-prompt').value}]})});const rd=r.body.getReader();const dec=new TextDecoder();let buf='',chars=0,first=0;for(;;){const {value,done}=await rd.read();if(done)break;buf+=dec.decode(value,{stream:true});const parts=buf.split('\\n\\n');buf=parts.pop();for(const p of parts){const m=p.match(/^data: (.*)$/m);if(!m||m[1]==='[DONE]')continue;try{const j=JSON.parse(m[1]);const d=(j.choices&&j.choices[0]&&j.choices[0].delta&&j.choices[0].delta.content)||'';if(d&&!first){first=performance.now()-t0;}$('pg-out').textContent+=d;chars+=d.length;if(j.usage){$('pg-metrics').textContent='tokens in '+j.usage.prompt_tokens+' / out '+j.usage.completion_tokens;}const c=j.choices&&j.choices[0]&&j.choices[0].cost_nano;if(c!==undefined)$('pg-metrics').textContent+=' cost '+c+' nano';}catch(e){}}}$('pg-metrics').textContent+=' · 首字 '+(first?first.toFixed(0):0)+'ms · '+chars+' 字符 · 总 '+(performance.now()-t0).toFixed(0)+'ms';}" as &const byte);
    n = ui_put(out, cap, n, "async function estimate(){const r=await api('/v1/estimate',{prompt_tokens:+$('est-prompt').value,completion_tokens:+$('est-completion').value,model:'default'},tok);const j=await r.json();$('est-out').textContent=r.ok?('成本 '+j.cost_nano+' nano · 收费 '+j.price_nano+' nano'):('失败：'+(j.error||r.status));}" as &const byte);
    n = ui_put(out, cap, n, "async function list(){const r=await api('/v1/keys',null,tok);if(!r.ok)return;const j=await r.json();$('key-list').innerHTML='';(j.data||[]).forEach(k=>{const li=document.createElement('li');li.textContent=k.name+' '+k.prefix+(k.revoked_at?' (已撤销)':'');if(!k.revoked_at){const b=document.createElement('button');b.textContent='撤销';b.onclick=async()=>{await api('/v1/keys/revoke',{key_id:k.id},tok);list();};li.appendChild(b);}$('key-list').appendChild(li);});}" as &const byte);
    n = ui_put(out, cap, n, "async function newKey(){const r=await api('/v1/keys',{name:$('key-name').value||'ui'},tok);const j=await r.json();$('new-key-val').textContent=j.key?('新 Key：'+j.key):'创建失败';list();usage();budget();reqs();}" as &const byte);
    n = ui_put(out, cap, n, "$('send-otp').onclick=sendOtp;$('login').onclick=login;$('new-key').onclick=newKey;$('estimate-go').onclick=estimate;$('pg-send').onclick=play;$('budget-save').onclick=saveBudget;$('logout').onclick=()=>{tok='';localStorage.removeItem('aigw_session');location.reload();};" as &const byte);
    n = ui_put(out, cap, n, "show();" as &const byte);
    return n;
}

/// C5 管理后台页面（用户/供应商/定价/备份，admin key 存 localStorage）。
export fn admin_page(out: &byte, cap: usize) usize {
    var n: usize = 0;
    n = ui_put(out, cap, n, "<!doctype html><html lang=\"zh\"><head><meta charset=\"utf-8\">" as &const byte);
    n = ui_put(out, cap, n, "<title>aigw 管理后台</title></head><body>" as &const byte);
    n = ui_put(out, cap, n, "<h1 id=\"admin-title\">aigw 管理后台</h1>" as &const byte);
    n = ui_put(out, cap, n, "<input id=\"admin-key\" placeholder=\"admin key\" type=\"password\">" as &const byte);
    n = ui_put(out, cap, n, "<button id=\"admin-load\">加载</button><p id=\"admin-msg\"></p>" as &const byte);
    n = ui_put(out, cap, n, "<h2>用户</h2><table id=\"admin-users\"><tbody></tbody></table>" as &const byte);
    n = ui_put(out, cap, n, "<h2>供应商</h2><table id=\"admin-providers\"><tbody></tbody></table>" as &const byte);
    n = ui_put(out, cap, n, "<h2>节点</h2><table id=\"admin-nodes\"><tbody></tbody></table>" as &const byte);
    n = ui_put(out, cap, n, "<h2>备份</h2><pre id=\"admin-backup\"></pre>" as &const byte);
    n = ui_put(out, cap, n, "<h2>定价</h2><pre id=\"admin-pricing\"></pre>" as &const byte);
    n = ui_put(out, cap, n, "<script src=\"/ui/admin.js\"></script></body></html>" as &const byte);
    return n;
}

/// C5 管理后台脚本。
export fn admin_js(out: &byte, cap: usize) usize {
    var n: usize = 0;
    n = ui_put(out, cap, n, "const $=id=>document.getElementById(id);" as &const byte);
    n = ui_put(out, cap, n, "let k=localStorage.getItem('aigw_admin')||'';" as &const byte);
    n = ui_put(out, cap, n, "const ag=(p,o)=>fetch(p,Object.assign({headers:{Authorization:'Bearer '+k}},o||{}));" as &const byte);
    n = ui_put(out, cap, n, "const rows=(tb,arr,cols)=>{tb.innerHTML='';(arr||[]).forEach(x=>{const tr=document.createElement('tr');cols.forEach(c=>{const td=document.createElement('td');td.textContent=x[c];tr.appendChild(td);});tb.appendChild(tr);});};" as &const byte);
    n = ui_put(out, cap, n, "async function load(){k=$('admin-key').value||k;localStorage.setItem('aigw_admin',k);const u=await ag('/admin/users');if(u.status===401){$('admin-msg').textContent='admin key 无效';return;}$('admin-msg').textContent='已加载';const uj=await u.json();rows(document.querySelector('#admin-users tbody'),uj.data,['id','email','status']);const p=await ag('/admin/providers');const pj=await p.json();rows(document.querySelector('#admin-providers tbody'),pj.data,['id','name','host','port','enabled','priority']);const s=await ag('/controller/status');const sj=await s.json();rows(document.querySelector('#admin-nodes tbody'),sj.nodes,['id','role','status','last_seen']);const b=await ag('/admin/backup');$('admin-backup').textContent=await b.text();const pr=await ag('/admin/pricing');$('admin-pricing').textContent=await pr.text();}" as &const byte);
    n = ui_put(out, cap, n, "$('admin-load').onclick=load;if(k){$('admin-key').value=k;load();}" as &const byte);
    return n;
}

// tests/test_epoch.uya — B3 epoch/fencing 与 drain
use std.testing.assert_eq_i32;
use std.testing.assert_eq_i64;
use std.testing.assert_eq_bool;
use std.testing.run_test;

const T0: i64 = 1700000000;

fn open_meta(d: &Db) !void {
    try meta_open(d, &":memory:"[0: 8]);
}

fn eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_epoch_bump() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_meta(&d);
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 1);
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 2);
    try assert_eq_i64(try meta_epoch_bump(&d, &"b"[0: 1], T0), 1);
    try assert_eq_i64(try meta_epoch_get(&d, &"a"[0: 1]), 2);
}

fn test_fencing() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_meta(&d);
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 1);
    try meta_assign(&d, &"s1"[0: 2], &"a"[0: 1], 1, T0);
    var nb: [byte: 16] = [0: 16];
    var ep: i64 = 0;
    var n: usize = try meta_assign_get(&d, &"s1"[0: 2], &nb[0], 16, &ep);
    try assert_eq_bool(eq(nb[0: n], &"a"[0: 1]), true);
    try assert_eq_i64(ep, 1);
    // 旧 epoch 写不进去
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 2);
    var stale: bool = false;
    meta_assign(&d, &"s1"[0: 2], &"a"[0: 1], 1, T0) catch |_| {
        stale = true;
    };
    try assert_eq_bool(stale, true);
    // 新 epoch 可以覆盖
    try meta_assign(&d, &"s1"[0: 2], &"a"[0: 1], 2, T0);
    // b 的 epoch=1 小于已有 2：fencing 拒绝
    try assert_eq_i64(try meta_epoch_bump(&d, &"b"[0: 1], T0), 1);
    stale = false;
    meta_assign(&d, &"s1"[0: 2], &"b"[0: 1], 1, T0) catch |_| {
        stale = true;
    };
    try assert_eq_bool(stale, true);
    // a 的 epoch=3 可以迁走
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 3);
    try meta_assign(&d, &"s1"[0: 2], &"a"[0: 1], 3, T0);
    n = try meta_assign_get(&d, &"s1"[0: 2], &nb[0], 16, &ep);
    try assert_eq_bool(eq(nb[0: n], &"a"[0: 1]), true);
    try assert_eq_i64(ep, 3);
}

fn test_drain() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_meta(&d);
    try meta_node_register(&d, &"n1"[0: 2], &"edge"[0: 4], &"127.0.0.1:1"[0: 11], T0);
    try meta_node_set_status(&d, &"n1"[0: 2], &"draining"[0: 8], T0);
    var nodes: [MetaNode: 4] = [];
    var n: usize = try meta_node_list(&d, &nodes[0], 4);
    try assert_eq_i32(n as i32, 1);
    try assert_eq_bool(eq(nodes[0].status[0: nodes[0].status_len], &"draining"[0: 8]), true);
    var missing: bool = false;
    meta_node_set_status(&d, &"nope"[0: 4], &"draining"[0: 8], T0) catch |_| {
        missing = true;
    };
    try assert_eq_bool(missing, true);
}

test "epoch_bump" { run_test("epoch_bump", test_epoch_bump); }
test "fencing" { run_test("fencing", test_fencing); }
test "drain" { run_test("drain", test_drain); }

// tests/test_edge.uya — B4 edge slug 路由与 session 亲和
use std.testing.assert_eq_i32;
use std.testing.assert_eq_i64;
use std.testing.assert_eq_bool;
use std.testing.run_test;

const T0: i64 = 1700000000;

fn open_meta(d: &Db) !void {
    try meta_open(d, &":memory:"[0: 8]);
}

fn eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_route_affinity() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_meta(&d);
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 1);
    try meta_assign(&d, &"s1"[0: 2], &"a"[0: 1], 1, T0);
    edge_reset();
    var nb: [byte: 16] = [0: 16];
    var n: usize = edge_route(&d, &"s1"[0: 2], &"sess"[0: 4], &nb[0], 16);
    try assert_eq_i32(n as i32, 1);
    try assert_eq_bool(eq(nb[0: n], &"a"[0: 1]), true);
    // 归属迁到 b，但 session 亲和还在 → 仍回 a
    try assert_eq_i64(try meta_epoch_bump(&d, &"b"[0: 1], T0), 1);
    try assert_eq_i64(try meta_epoch_bump(&d, &"b"[0: 1], T0), 2);
    try meta_assign(&d, &"s1"[0: 2], &"b"[0: 1], 2, T0);
    n = edge_route(&d, &"s1"[0: 2], &"sess"[0: 4], &nb[0], 16);
    try assert_eq_bool(eq(nb[0: n], &"a"[0: 1]), true);
    // 失败清亲和 → 回最新归属 b
    edge_fail(&"sess"[0: 4]);
    n = edge_route(&d, &"s1"[0: 2], &"sess"[0: 4], &nb[0], 16);
    try assert_eq_bool(eq(nb[0: n], &"b"[0: 1]), true);
    // 不同 session 各自解析
    n = edge_route(&d, &"s1"[0: 2], &"other"[0: 5], &nb[0], 16);
    try assert_eq_bool(eq(nb[0: n], &"b"[0: 1]), true);
}

fn test_unknown() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_meta(&d);
    edge_reset();
    var nb: [byte: 16] = [0: 16];
    try assert_eq_i32(edge_route(&d, &"nope"[0: 4], &"x"[0: 1], &nb[0], 16) as i32, 0);
    try assert_eq_i32(edge_route(&d, &""[0: 0], &"x"[0: 1], &nb[0], 16) as i32, 0);
}

fn test_snapshot() !void {
    edge_reset();
    edge_snapshot_clear();
    try assert_eq_i32(edge_snapshot_count() as i32, 0);
    _ = edge_snapshot_put(&"s1"[0: 2], &"edge-1"[0: 6]);
    _ = edge_snapshot_put(&"s2"[0: 2], &"edge-2"[0: 6]);
    try assert_eq_i32(edge_snapshot_count() as i32, 2);
    // 覆盖同一 slug 不新增条目
    _ = edge_snapshot_put(&"s1"[0: 2], &"edge-3"[0: 6]);
    try assert_eq_i32(edge_snapshot_count() as i32, 2);
    var nb: [byte: 16] = [0: 16];
    var n: usize = edge_route_snapshot(&"s1"[0: 2], &""[0: 0], &nb[0], 16);
    try assert_eq_bool(eq(nb[0: n], &"edge-3"[0: 6]), true);
    // session 亲和：同一 session 固定到首次解析的节点
    n = edge_route_snapshot(&"s2"[0: 2], &"k"[0: 1], &nb[0], 16);
    try assert_eq_bool(eq(nb[0: n], &"edge-2"[0: 6]), true);
    edge_fail(&"k"[0: 1]);
    n = edge_route_snapshot(&"s1"[0: 2], &"k"[0: 1], &nb[0], 16);
    try assert_eq_bool(eq(nb[0: n], &"edge-3"[0: 6]), true);
    // 快照里没有的 slug
    try assert_eq_i32(edge_route_snapshot(&"zz"[0: 2], &""[0: 0], &nb[0], 16) as i32, 0);
    // 空参数
    try assert_eq_i32(edge_snapshot_put(&""[0: 0], &"x"[0: 1]) as i32, 0);
    try assert_eq_i32(edge_snapshot_put(&"s3"[0: 2], &""[0: 0]) as i32, 0);
    edge_snapshot_clear();
    try assert_eq_i32(edge_snapshot_count() as i32, 0);
}

fn test_snapshot_vs_meta() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_meta(&d);
    edge_reset();
    edge_snapshot_clear();
    try meta_node_register(&d, &"b"[0: 1], &"edge"[0: 4], &""[0: 0], 1000);
    _ = meta_epoch_bump(&d, &"b"[0: 1], 1000) catch { 0 as i64; };
    try meta_assign(&d, &"m1"[0: 2], &"b"[0: 1], 1, 1000);
    // 快照说 m1 在 edge-9，但 meta 有归属 → meta 优先
    _ = edge_snapshot_put(&"m1"[0: 2], &"edge-9"[0: 6]);
    var nb: [byte: 16] = [0: 16];
    const n: usize = edge_route(&d, &"m1"[0: 2], &""[0: 0], &nb[0], 16);
    try assert_eq_bool(eq(nb[0: n], &"b"[0: 1]), true);
    edge_snapshot_clear();
}

fn test_addr() !void {
    edge_addr_clear();
    var ab: [byte: 128] = [0: 128];
    try assert_eq_i32(edge_addr_get(&"n1"[0: 2], &ab[0], 128) as i32, 0);
    _ = edge_addr_put(&"n1"[0: 2], &"127.0.0.1:8001"[0: 14]);
    _ = edge_addr_put(&"n2"[0: 2], &"127.0.0.1:8002"[0: 14]);
    const n: usize = edge_addr_get(&"n1"[0: 2], &ab[0], 128);
    try assert_eq_bool(eq(ab[0: n], &"127.0.0.1:8001"[0: 14]), true);
    // 覆盖同 id 不新增
    _ = edge_addr_put(&"n1"[0: 2], &"10.0.0.1:9"[0: 10]);
    const n2: usize = edge_addr_get(&"n1"[0: 2], &ab[0], 128);
    try assert_eq_bool(eq(ab[0: n2], &"10.0.0.1:9"[0: 10]), true);
    try assert_eq_i32(edge_addr_put(&""[0: 0], &"x"[0: 1]) as i32, 0);
    edge_addr_clear();
    try assert_eq_i32(edge_addr_get(&"n1"[0: 2], &ab[0], 128) as i32, 0);
}

test "route_affinity" { run_test("route_affinity", test_route_affinity); }
test "unknown" { run_test("unknown", test_unknown); }
test "snapshot" { run_test("snapshot", test_snapshot); }
test "addr" { run_test("addr", test_addr); }
test "snapshot_vs_meta" { run_test("snapshot_vs_meta", test_snapshot_vs_meta); }

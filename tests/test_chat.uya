// tests/test_chat.uya — A4 chat 编排：路由、上游请求重写、usage 结算
use std.testing.assert_eq_i32;
use std.testing.assert_eq_i64;
use std.testing.assert_eq_bool;
use std.testing.run_test;
use libc.syscall;

const T0: i64 = 1700000000;
const DIR: &[byte] = &"/tmp/aigw_chat_test"[0: 19];

fn open_db(d: &Db) !void {
    _ = try schema_open(d, &":memory:"[0: 8]);
}

fn prep() void {
    _ = sys_mkdir("/tmp/aigw_chat_test" as *const byte, 493) catch {};
    var p: [byte: 512] = [0: 512];
    const pn: usize = journal_path(DIR, T0, &p[0], 512);
    _ = pn;
    _ = sys_unlink(&p[0] as *const byte) catch {};
}

fn setup(d: &Db) !void {
    var p: StoreProvider = StoreProvider{};
    try store_provider_create(d, &"mock"[0: 4], &"127.0.0.1"[0: 9], 18080, T0, &p);
    try store_provider_model_put(d, p.id, &"gpt-4o"[0: 6], &"gpt-4o-2024"[0: 11], T0);
    var sell: PriceCard = PriceCard{ id: 0, kind: 0, version: 0, effective_from: 0, found: false };
    try price_card_create(d, PRICE_KIND_SELL, 1, 0, T0, &"v1"[0: 2], &sell);
    try price_entry_put(d, sell.id, &""[0: 0], &"gpt-4o"[0: 6], 0, 1000, 2000, 500, 100, &""[0: 0]);
    var cost: PriceCard = PriceCard{ id: 0, kind: 0, version: 0, effective_from: 0, found: false };
    try price_card_create(d, PRICE_KIND_COST, 1, 0, T0, &"v1"[0: 2], &cost);
    try price_entry_put(d, cost.id, &"mock"[0: 4], &"gpt-4o"[0: 6], 0, 600, 1200, 300, 50, &""[0: 0]);
}

fn contains(hay: &[byte], needle: &[byte]) bool {
    if needle.len == 0 || hay.len < needle.len {
        return false;
    }
    var i: usize = 0;
    while i + needle.len <= hay.len {
        var j: usize = 0;
        var same: bool = true;
        while j < needle.len {
            if hay[i + j] != needle[j] {
                same = false;
                break;
            }
            j = j + 1;
        }
        if same {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn test_prepare() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_db(&d);
    try setup(&d);
    var plan: ChatPlan = ChatPlan{};
    try chat_prepare(&d, &"{\"model\":\"gpt-4o\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"[0: 76], T0, &plan);
    try assert_eq_i32(plan.model_len as i32, 6);
    try assert_eq_i32(plan.upstream_len as i32, 11);
    try assert_eq_bool(contains(plan.upstream_model[0: plan.upstream_len], &"gpt-4o-2024"[0: 11]), true);
    try assert_eq_bool(contains(plan.host[0: plan.host_len], &"127.0.0.1"[0: 9]), true);
    try assert_eq_i32(plan.port, 18080);
    try assert_eq_bool(plan.stream, true);
    try assert_eq_i32(plan.path_len as i32, 20);
    try assert_eq_bool(contains(plan.path[0: plan.path_len], &"/v1/chat/completions"[0: 20]), true);
    // 上游请求体：model 已换成上游名，messages 原样保留
    try assert_eq_bool(contains(plan.payload[0: plan.payload_len], &"\"model\":\"gpt-4o-2024\""[0: 21]), true);
    try assert_eq_bool(contains(plan.payload[0: plan.payload_len], &"\"messages\""[0: 10]), true);

    // 非流式
    var plan2: ChatPlan = ChatPlan{};
    try chat_prepare(&d, &"{\"model\":\"gpt-4o\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"[0: 62], T0, &plan2);
    try assert_eq_bool(plan2.stream, false);
    try assert_eq_bool(contains(plan2.payload[0: plan2.payload_len], &"\"model\":\"gpt-4o-2024\""[0: 21]), true);
}

fn test_prepare_errors() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_db(&d);
    try setup(&d);
    var plan: ChatPlan = ChatPlan{};
    var bad: bool = false;
    _ = chat_prepare(&d, &"{"[0: 1], T0, &plan) catch |_| {
        bad = true;
    };
    try assert_eq_bool(bad, true);
    bad = false;
    _ = chat_prepare(&d, &"{\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"[0: 45], T0, &plan) catch |_| {
        bad = true;
    };
    try assert_eq_bool(bad, true);
    bad = false;
    _ = chat_prepare(&d, &"{\"model\":\"unknown\",\"messages\":[]}"[0: 33], T0, &plan) catch |_| {
        bad = true;
    };
    try assert_eq_bool(bad, true);
}

fn test_settle() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_db(&d);
    try setup(&d);
    prep();
    var plan: ChatPlan = ChatPlan{};
    try chat_prepare(&d, &"{\"model\":\"gpt-4o\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"[0: 76], T0, &plan);
    var r: BillingResult = BillingResult{ cost_nano: 0, price_nano: 0, rate_version: 0, duplicate: false, found: false };
    try chat_settle(&d, DIR, &"chat-1"[0: 6], 7, T0, 0, &plan,
        &"{\"id\":\"chatcmpl-1\",\"usage\":{\"prompt_tokens\":100000,\"completion_tokens\":50000,\"prompt_tokens_details\":{\"cached_tokens\":10000}}}"[0: 126], &r);
    try assert_eq_bool(r.found, true);
    try assert_eq_bool(r.duplicate, false);
    try assert_eq_i64(r.cost_nano, 173);
    try assert_eq_i64(r.price_nano, 305);
    var n: i64 = 0;
    try assert_eq_i32(dbx_scalar_i64(&d, &"select count(*) from usage_ledger"[0: 33], &n), 0);
    try assert_eq_i64(n, 1);

    // 重复请求幂等
    try chat_settle(&d, DIR, &"chat-1"[0: 6], 7, T0, 0, &plan,
        &"{\"id\":\"chatcmpl-1\",\"usage\":{\"prompt_tokens\":100000,\"completion_tokens\":50000,\"prompt_tokens_details\":{\"cached_tokens\":10000}}}"[0: 126], &r);
    try assert_eq_bool(r.duplicate, true);

    // 没有 usage → ChatNoUsage
    var bad: bool = false;
    _ = chat_settle(&d, DIR, &"chat-2"[0: 6], 7, T0, 0, &plan, &"{\"id\":\"x\"}"[0: 10], &r) catch |_| {
        bad = true;
    };
    try assert_eq_bool(bad, true);
}

fn test_bearer() !void {
    var tok: [byte: 64] = [0: 64];
    try assert_eq_i32(chat_bearer(&"Bearer sk-abc"[0: 13], &tok[0], 64) as i32, 6);
    try assert_eq_i32(tok[0] as i32, 's' as i32);
    try assert_eq_i32(tok[5] as i32, 'c' as i32);
    try assert_eq_i32(chat_bearer(&"bearer   tok"[0: 12], &tok[0], 64) as i32, 3);
    try assert_eq_i32(chat_bearer(&"Basic sk"[0: 8], &tok[0], 64) as i32, 0);
    try assert_eq_i32(chat_bearer(&"Bearer"[0: 6], &tok[0], 64) as i32, 0);
}

const FAST_A: &[byte] = &"{\"model\" : \"gpt-4o\", \"stream\" : true, \"messages\" : [{\"role\":\"user\",\"content\":\"hi model\"}]}"[0: 90];
const FAST_B: &[byte] = &"{\"model\":\"gpt-4o\",\"messages\":[{\"model\":\"nested\",\"content\":\"hi\"}]}"[0: 65];
const FAST_C: &[byte] = &"{\"model\":\"gpt\\u002d4o\",\"messages\":[]}"[0: 37];
const FAST_D: &[byte] = &"[{\"model\":\"gpt-4o\"}]"[0: 20];
const FAST_E: &[byte] = &"{\"model\":\"gpt-4o\",\"model\":\"gpt-4o\"}"[0: 35];
const FAST_F: &[byte] = &"{\"model\":123}"[0: 13];
const FAST_G: &[byte] = &"{\"model\":\"gpt-4o\",\"stream\":\"true\"}"[0: 34];
const FAST_H: &[byte] = &"{\"model\":\"gpt-4o\""[0: 17];
const FAST_I: &[byte] = &"{\"messages\":[{\"model\":\"x\"}]}"[0: 28];
const FAST_J: &[byte] = &"{\"model\":\"gpt-4o\",\"messages\":[]}"[0: 32];

fn eq_bytes(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_fast_path() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_db(&d);
    try setup(&d);

    // 带空白/乱序字段/嵌套 content 的请求：快路径可用，且与完整解析结果一致
    var fast: ChatPlan = ChatPlan{};
    const ok: bool = try chat_prepare_fast(&d, FAST_A, &""[0: 0], T0, &fast);
    try assert_eq_bool(ok, true);
    try assert_eq_bool(fast.stream, true);
    try assert_eq_i32(fast.model_len as i32, 6);
    try assert_eq_i32(fast.upstream_len as i32, 11);
    try assert_eq_bool(contains(fast.payload[0: fast.payload_len], &"\"model\" : \"gpt-4o-2024\""[0: 23]), true);
    try assert_eq_bool(contains(fast.payload[0: fast.payload_len], &"hi model"[0: 8]), true);
    var slow: ChatPlan = ChatPlan{};
    try chat_prepare_session(&d, FAST_A, &""[0: 0], T0, &slow);
    try assert_eq_bool(eq_bytes(fast.payload[0: fast.payload_len], slow.payload[0: slow.payload_len]), true);
    try assert_eq_bool(eq_bytes(fast.model[0: fast.model_len], slow.model[0: slow.model_len]), true);

    // 嵌套的 model 键不参与改写
    var b: ChatPlan = ChatPlan{};
    try assert_eq_bool(try chat_prepare_fast(&d, FAST_B, &""[0: 0], T0, &b), true);
    try assert_eq_bool(contains(b.payload[0: b.payload_len], &"\"model\":\"gpt-4o-2024\""[0: 21]), true);
    try assert_eq_bool(contains(b.payload[0: b.payload_len], &"\"model\":\"nested\""[0: 16]), true);

    // 没有 stream 字段 → 非流式
    var j: ChatPlan = ChatPlan{};
    try assert_eq_bool(try chat_prepare_fast(&d, FAST_J, &""[0: 0], T0, &j), true);
    try assert_eq_bool(j.stream, false);

    // 不适合快路径的形态一律回退（false），不误判
    var p: ChatPlan = ChatPlan{};
    try assert_eq_bool(try chat_prepare_fast(&d, FAST_C, &""[0: 0], T0, &p), false);
    try assert_eq_bool(try chat_prepare_fast(&d, FAST_D, &""[0: 0], T0, &p), false);
    try assert_eq_bool(try chat_prepare_fast(&d, FAST_E, &""[0: 0], T0, &p), false);
    try assert_eq_bool(try chat_prepare_fast(&d, FAST_F, &""[0: 0], T0, &p), false);
    try assert_eq_bool(try chat_prepare_fast(&d, FAST_G, &""[0: 0], T0, &p), false);
    try assert_eq_bool(try chat_prepare_fast(&d, FAST_I, &""[0: 0], T0, &p), false);

    // 回退后完整解析能把 \u002d 还原成 '-'，仍然路由到同一个上游模型
    var esc: ChatPlan = ChatPlan{};
    try chat_prepare_span_session(&d, FAST_C.ptr, FAST_C.len, &""[0: 0], T0, &esc);
    try assert_eq_i32(esc.model_len as i32, 6);
    try assert_eq_bool(contains(esc.model[0: esc.model_len], &"gpt-4o"[0: 6]), true);
    try assert_eq_i32(esc.upstream_len as i32, 11);

    // 结构损坏 / 只有嵌套 model → 拒绝
    var bad: bool = false;
    _ = chat_prepare(&d, FAST_H, T0, &p) catch |_| {
        bad = true;
    };
    try assert_eq_bool(bad, true);
    bad = false;
    _ = chat_prepare(&d, FAST_I, T0, &p) catch |_| {
        bad = true;
    };
    try assert_eq_bool(bad, true);
}

test "prepare" { run_test("prepare", test_prepare); }
test "fast_path" { run_test("fast_path", test_fast_path); }
test "bearer" { run_test("bearer", test_bearer); }
test "prepare_errors" { run_test("prepare_errors", test_prepare_errors); }
test "settle" { run_test("settle", test_settle); }

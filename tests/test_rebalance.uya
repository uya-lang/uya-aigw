// tests/test_rebalance.uya — B3 归属迁移/清空与 epoch 校验
use std.testing.assert_eq_i32;
use std.testing.assert_eq_i64;
use std.testing.assert_eq_bool;
use std.testing.run_test;

const T0: i64 = 1700000000;

fn open_meta(d: &Db) !void {
    try meta_open(d, &":memory:"[0: 8]);
}

fn eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn owner(d: &Db, slug: &[byte], out: &byte, cap: usize) !usize {
    var ep: i64 = 0;
    return meta_assign_get(d, slug, out, cap, &ep);
}

fn test_reassign() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_meta(&d);
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 1);
    try meta_assign(&d, &"s1"[0: 2], &"a"[0: 1], 1, T0);
    try meta_assign(&d, &"s2"[0: 2], &"a"[0: 1], 1, T0);
    try assert_eq_i64(try meta_assign_count(&d, &"a"[0: 1]), 2);
    // b 的 epoch=2 高于 a 的 1：可以迁移
    try assert_eq_i64(try meta_epoch_bump(&d, &"b"[0: 1], T0), 1);
    try assert_eq_i64(try meta_epoch_bump(&d, &"b"[0: 1], T0), 2);
    try assert_eq_i64(try meta_reassign_all(&d, &"a"[0: 1], &"b"[0: 1], 2, T0), 2);
    try assert_eq_i64(try meta_assign_count(&d, &"a"[0: 1]), 0);
    try assert_eq_i64(try meta_assign_count(&d, &"b"[0: 1]), 2);
    var nb: [byte: 16] = [0: 16];
    var n: usize = try owner(&d, &"s1"[0: 2], &nb[0], 16);
    try assert_eq_bool(eq(nb[0: n], &"b"[0: 1]), true);
}

fn test_fencing_on_reassign() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_meta(&d);
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 1);
    try meta_assign(&d, &"s1"[0: 2], &"a"[0: 1], 1, T0);
    // b 的 epoch 与传入不符 → StaleEpoch
    var bad: bool = false;
    var moved: i64 = 0;
    moved = meta_reassign_all(&d, &"a"[0: 1], &"b"[0: 1], 1, T0) catch |_| {
        bad = true;
        0 as i64;
    };
    _ = moved;
    try assert_eq_bool(bad, true);
    // b epoch=1，但 a 的归属 epoch 已提升到 2 → 只迁 epoch ≤1，迁不动
    try assert_eq_i64(try meta_epoch_bump(&d, &"b"[0: 1], T0), 1);
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 2);
    try meta_assign(&d, &"s1"[0: 2], &"a"[0: 1], 2, T0);
    try assert_eq_i64(try meta_reassign_all(&d, &"a"[0: 1], &"b"[0: 1], 1, T0), 0);
}

fn test_clear() !void {
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_meta(&d);
    try assert_eq_i64(try meta_epoch_bump(&d, &"a"[0: 1], T0), 1);
    try meta_assign(&d, &"s1"[0: 2], &"a"[0: 1], 1, T0);
    try meta_node_register(&d, &"a"[0: 1], &"edge"[0: 4], &""[0: 0], T0);
    try meta_node_set_status(&d, &"a"[0: 1], &"draining"[0: 8], T0);
    try assert_eq_i64(try meta_clear_node(&d, &"a"[0: 1]), 1);
    try assert_eq_i64(try meta_assign_count(&d, &"a"[0: 1]), 0);
}

test "reassign" { run_test("reassign", test_reassign); }
test "fencing_on_reassign" { run_test("fencing_on_reassign", test_fencing_on_reassign); }
test "clear" { run_test("clear", test_clear); }

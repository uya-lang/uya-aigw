// tests/test_pool.uya — A3 插件池：复用、min/max、缩容、崩溃退避、cancel、ping/pong
use std.testing.assert_eq_i32;
use std.testing.assert_eq_bool;
use std.testing.run_test;
use libc.syscall;

const CMD: &[byte] = &"python3 tests/plugin_echo.py"[0: 28];

fn send_body(idx: i32, body: &[byte]) !void {
    try plugin_pool_send(idx, body);
    try plugin_pool_send(idx, &"\n"[0: 1]);
}

fn test_reuse() !void {
    plugin_pool_shutdown();
    try plugin_pool_init_at(CMD, 1, 2, 60000, 500, 1000);
    try assert_eq_i32(plugin_pool_live(), 1);
    try assert_eq_bool(plugin_pool_ready(), true);
    const a: i32 = try plugin_pool_acquire(1000);
    const pa: i32 = plugin_pool_pid_of(a);
    try assert_eq_i32(plugin_pool_state_of(a), PLUGIN_POOL_STATE_BUSY);
    try plugin_pool_ping(a, 5000);
    plugin_pool_release(a, 1001);
    try assert_eq_i32(plugin_pool_state_of(a), PLUGIN_POOL_STATE_IDLE);
    // 归还后再取：还是同一个进程（插件 prompt cache 的前提）
    const b: i32 = try plugin_pool_acquire(1002);
    try assert_eq_i32(b, a);
    try assert_eq_i32(plugin_pool_pid_of(b), pa);
    try plugin_pool_ping(b, 5000);
    plugin_pool_release(b, 1003);
    const c: i32 = try plugin_pool_acquire(1004);
    try assert_eq_i32(plugin_pool_pid_of(c), pa);
    plugin_pool_release(c, 1005);
    plugin_pool_shutdown();
    try assert_eq_bool(plugin_pool_ready(), false);
}

fn test_max_and_exhausted() !void {
    plugin_pool_shutdown();
    try plugin_pool_init_at(CMD, 0, 1, 60000, 500, 2000);
    try assert_eq_i32(plugin_pool_live(), 0);
    const a: i32 = try plugin_pool_acquire(2000);
    try assert_eq_i32(plugin_pool_live(), 1);
    var exhausted: bool = false;
    var dummy: i32 = 0;
    dummy = plugin_pool_acquire(2000) catch |_| {
        exhausted = true;
        0;
    };
    _ = dummy;
    try assert_eq_bool(exhausted, true);
    plugin_pool_release(a, 2001);
    const b: i32 = try plugin_pool_acquire(2002);
    try assert_eq_i32(b, a);
    plugin_pool_release(b, 2003);
    plugin_pool_shutdown();
}

fn test_crash_backoff() !void {
    plugin_pool_shutdown();
    try plugin_pool_init_at(CMD, 0, 2, 60000, 1000, 3000);
    const a: i32 = try plugin_pool_acquire(3000);
    const pa: i32 = plugin_pool_pid_of(a);
    try send_body(a, &"{\"id\":1,\"method\":\"crash\"}"[0: 25]);
    // 插件退出 → 读端 EOF
    var line: [byte: 128] = [0: 128];
    var eof: bool = false;
    var got: usize = 0;
    got = plugin_pool_read_line(a, &line[0], 128, 5000) catch |_| {
        eof = true;
        0 as usize;
    };
    _ = got;
    try assert_eq_bool(eof, true);
    plugin_pool_mark_dead(a, 3000);
    try assert_eq_i32(plugin_pool_crashes_of(a), 1);
    // 退避窗口内拿不到
    var blocked: bool = false;
    var dummy2: i32 = 0;
    dummy2 = plugin_pool_acquire(3000) catch |_| {
        blocked = true;
        0;
    };
    _ = dummy2;
    try assert_eq_bool(blocked, true);
    // 窗口过后扩容出新进程
    const b: i32 = try plugin_pool_acquire(4001);
    try assert_eq_bool(plugin_pool_pid_of(b) != pa, true);
    try plugin_pool_ping(b, 5000);
    plugin_pool_release(b, 4002);
    plugin_pool_shutdown();
}

fn test_idle_eviction() !void {
    plugin_pool_shutdown();
    try plugin_pool_init_at(CMD, 1, 2, 1000, 500, 5000);
    try assert_eq_i32(plugin_pool_live(), 1);
    const a: i32 = try plugin_pool_acquire(5000); // 预热槽
    const b: i32 = try plugin_pool_acquire(5000); // 扩容槽
    try assert_eq_i32(plugin_pool_live(), 2);
    plugin_pool_release(a, 5000);
    plugin_pool_release(b, 5000);
    plugin_pool_tick_at(5001); // 还没到 idle，不缩
    try assert_eq_i32(plugin_pool_live(), 2);
    plugin_pool_tick_at(7000); // 都超时 → 缩到 min=1
    try assert_eq_i32(plugin_pool_live(), 1);
    plugin_pool_tick_at(7001); // 稳定
    try assert_eq_i32(plugin_pool_live(), 1);
    const c: i32 = try plugin_pool_acquire(7002);
    try plugin_pool_ping(c, 5000);
    plugin_pool_release(c, 7003);
    plugin_pool_shutdown();
}

fn test_cancel() !void {
    plugin_pool_shutdown();
    try plugin_pool_init_at(CMD, 0, 2, 60000, 500, 8000);
    const a: i32 = try plugin_pool_acquire(8000);
    const pa: i32 = plugin_pool_pid_of(a);
    try send_body(a, &"{\"id\":9,\"method\":\"slow\"}"[0: 24]);
    plugin_pool_cancel(a);
    try assert_eq_i32(plugin_pool_state_of(a), PLUGIN_POOL_STATE_FREE);
    try assert_eq_i32(plugin_pool_live(), 0);
    // cancel 不计崩溃、不进退避：立刻能再取
    const b: i32 = try plugin_pool_acquire(8001);
    try assert_eq_bool(plugin_pool_pid_of(b) != pa, true);
    try plugin_pool_ping(b, 5000);
    plugin_pool_release(b, 8002);
    plugin_pool_shutdown();
}

const PING1: &[byte] = &"{\"id\":1,\"method\":\"ping\"}\n"[0: 25];
const PING2: &[byte] = &"{\"id\":2,\"method\":\"ping\"}\n"[0: 25];
const SLOW1: &[byte] = &"{\"id\":3,\"method\":\"slow\"}\n"[0: 25];

fn contains(hay: &[byte], needle: &[byte]) bool {
    if needle.len == 0 || hay.len < needle.len {
        return false;
    }
    var i: usize = 0;
    while i + needle.len <= hay.len {
        var j: usize = 0;
        var same: bool = true;
        while j < needle.len {
            if hay[i + j] != needle[j] {
                same = false;
                break;
            }
            j = j + 1;
        }
        if same {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn test_rebind() !void {
    plugin_pool_shutdown();
    try plugin_pool_init_at(CMD, 1, 2, 60000, 500, 9000);
    const a: i32 = try plugin_pool_acquire(9000);
    const pa: i32 = plugin_pool_pid_of(a);
    try assert_eq_i32(plugin_pool_state_of(a), PLUGIN_POOL_STATE_BUSY);
    // 模拟供应商插件被外部杀掉
    _ = sys_kill(pa as i64, 9) catch { 0; };
    var nap: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 30000000 };
    var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_nanosleep(&nap, &rem) catch { 0; };

    // 同一槽位调用：检测到 EOF/EPIPE → 收尸 → 重绑 → 重试成功
    var idx: i32 = a;
    var line: [byte: 128] = [0: 128];
    const n: usize = try plugin_pool_call(&idx, PING1, &line[0], 128, 5000, 9001);
    try assert_eq_bool(n > 0, true);
    try assert_eq_bool(contains(line[0: n], &"\"pong\""[0: 6]), true);
    try assert_eq_i32(idx, a);
    try assert_eq_bool(plugin_pool_pid_of(idx) != pa, true);
    try assert_eq_i32(plugin_pool_state_of(idx), PLUGIN_POOL_STATE_BUSY);
    // 重绑后的进程继续服务同一个槽
    var line2: [byte: 128] = [0: 128];
    const n2: usize = try plugin_pool_call(&idx, PING2, &line2[0], 128, 5000, 9002);
    try assert_eq_bool(contains(line2[0: n2], &"pong"[0: 4]), true);
    plugin_pool_release(idx, 9003);

    // 超时只是慢，不算进程坏：call 返回超时但 pid/状态不变
    const b: i32 = try plugin_pool_acquire(9700); // 越过上一次崩溃的退避窗口
    const pb: i32 = plugin_pool_pid_of(b);
    var idx2: i32 = b;
    var to: bool = false;
    _ = plugin_pool_call(&idx2, SLOW1, &line[0], 128, 150, 9701) catch |_| {
        to = true;
        0 as usize;
    };
    try assert_eq_bool(to, true);
    try assert_eq_i32(plugin_pool_pid_of(idx2), pb);
    try assert_eq_i32(plugin_pool_state_of(idx2), PLUGIN_POOL_STATE_BUSY);
    plugin_pool_cancel(idx2);
    plugin_pool_shutdown();
}

test "reuse" { run_test("reuse", test_reuse); }
test "max_and_exhausted" { run_test("max_and_exhausted", test_max_and_exhausted); }
test "crash_backoff" { run_test("crash_backoff", test_crash_backoff); }
test "idle_eviction" { run_test("idle_eviction", test_idle_eviction); }
test "cancel" { run_test("cancel", test_cancel); }
test "rebind" { run_test("rebind", test_rebind); }

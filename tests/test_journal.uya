// tests/test_journal.uya — A2 计费 journal：路径 / 写入 / 幂等重放 / 坏行 / 保留
use std.testing.assert_eq_i32;
use std.testing.assert_eq_i64;
use std.testing.assert_eq_bool;
use std.testing.run_test;

const T0: i64 = 1704067200; // 2024-01-01T00:00:00Z
const EMPTY: &[byte] = &"x"[0: 0];

fn unlink_if_exists(c: &const byte) void {
    _ = sys_unlink(c as *const byte) catch {};
}

fn prep() void {
    _ = sys_mkdir("/tmp/aigw_journal_test" as *const byte, 493 as i32) catch {};
    unlink_if_exists("/tmp/aigw_journal_test/aigw-journal-20240101.log" as &const byte);
    unlink_if_exists("/tmp/aigw_journal_test/aigw-journal-20231231.log" as &const byte);
    unlink_if_exists("/tmp/aigw_journal_test/aigw-journal-20231224.log" as &const byte);
    unlink_if_exists("/tmp/aigw_journal_test/aigw-journal-20231223.log" as &const byte);
}

fn open_db(d: &Db) !void {
    _ = try schema_open(d, &":memory:"[0: 8]);
}

fn scalar(d: &Db, sql: &const byte) i64 {
    var st: DbStmt = dbx_prepare(d, sql) catch {
        return 0 - 1;
    };
    defer { dbx_finalize(&st); }
    if dbx_step(&st) != 1 {
        return 0 - 1;
    }
    return dbx_col_i64(&st, 0);
}

fn test_path_and_format() !void {
    prep();
    var p: [byte: 512] = [0: 512];
    const n: usize = journal_path(&"data/db"[0: 7], T0, &p[0], 512);
    try assert_eq_i32(n as i32, 33);
    try assert_eq_i32(p[0] as i32, 'd' as i32);
    try assert_eq_i32(p[7] as i32, '/' as i32);
    try assert_eq_i32(p[21] as i32, '2' as i32);
    try assert_eq_i32(p[24] as i32, '4' as i32);
    try assert_eq_i32(p[28] as i32, '1' as i32);
    try assert_eq_i32(p[29] as i32, '.' as i32);
    try assert_eq_i32(p[32] as i32, 'g' as i32);

    var line: [byte: 1024] = [0: 1024];
    const ln: usize = journal_format(&"req-1"[0: 5], 7, &"gpt-4o"[0: 6],
        &"up"[0: 2], T0, 10, 5, 2, 111, 222, EMPTY, 3, &line[0], 1024);
    try assert_eq_bool(ln > 0, true);
    var f: JournalFields = JournalFields{ starts: [], ends: [], count: 0 };
    journal_split(line[0: ln - 1], &f);
    try assert_eq_i32(f.count as i32, 13);
    try assert_eq_i32((f.ends[0] - f.starts[0]) as i32, 1);
    try assert_eq_i32((f.ends[1] - f.starts[1]) as i32, 5);
    try assert_eq_i32((f.ends[2] - f.starts[2]) as i32, 1);
    try assert_eq_i32(line[f.starts[2]] as i32, '7' as i32);
    try assert_eq_i32((f.ends[3] - f.starts[3]) as i32, 10);
    try assert_eq_i32(line[0] as i32, '1' as i32);
    try assert_eq_i32(line[1] as i32, 9);
    try assert_eq_i32(line[ln - 1] as i32, 10);

    // 超长行返回 0
    var tiny: [byte: 8] = [0: 8];
    try assert_eq_i32(journal_format(&"req-1"[0: 5], 7, &"gpt-4o"[0: 6],
        &"up"[0: 2], T0, 10, 5, 2, 111, 222, EMPTY, 3, &tiny[0], 8) as i32, 0);
}

fn append_one(path: &[byte], rid: &[byte], uid: i64, cost: i64, price: i64) !void {
    try journal_append(path, rid, uid, &"gpt-4o"[0: 6], &"up"[0: 2], T0,
        10, 5, 2, cost, price, EMPTY, 3);
}

fn test_append_replay_idempotent() !void {
    prep();
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_db(&d);
    var p: [byte: 512] = [0: 512];
    const pn: usize = journal_path(&"/tmp/aigw_journal_test"[0: 22], T0, &p[0], 512);
    const path: &[byte] = p[0: pn];
    try append_one(path, &"req1"[0: 4], 1, 100, 200);
    try append_one(path, &"req2"[0: 4], 1, 300, 400);
    try append_one(path, &"req3"[0: 4], 2, 500, 600);

    var s: JournalStats = JournalStats{ lines: 0, applied: 0, duplicate: 0, bad: 0 };
    try journal_replay(&d, path, &s);
    try assert_eq_i64(s.lines as i64, 3);
    try assert_eq_i64(s.bad as i64, 0);
    try assert_eq_i64(s.applied as i64, 3);
    try assert_eq_i64(s.duplicate as i64, 0);
    try assert_eq_i64(s.bad as i64, 0);
    try assert_eq_i64(scalar(&d, "select count(*) from usage_ledger" as &const byte), 3);
    try assert_eq_i64(scalar(&d, "select sum(price_nano) from usage_ledger" as &const byte), 1200);

    // 再放一遍：全部幂等
    var s2: JournalStats = JournalStats{ lines: 0, applied: 0, duplicate: 0, bad: 0 };
    try journal_replay(&d, path, &s2);
    try assert_eq_i64(s2.applied as i64, 0);
    try assert_eq_i64(s2.duplicate as i64, 3);
    try assert_eq_i64(scalar(&d, "select count(*) from usage_ledger" as &const byte), 3);

    // 字段逐项对得上
    var st: DbStmt = try dbx_prepare(&d,
        "select user_id, ts, input_tokens, output_tokens, cache_read_tokens, cost_nano, price_nano, model, provider, period, rate_version from usage_ledger where request_id = 'req1'" as &const byte);
    defer { dbx_finalize(&st); }
    try assert_eq_i32(dbx_step(&st), 1);
    try assert_eq_i64(dbx_col_i64(&st, 0), 1);
    try assert_eq_i64(dbx_col_i64(&st, 1), T0);
    try assert_eq_i64(dbx_col_i64(&st, 2), 10);
    try assert_eq_i64(dbx_col_i64(&st, 3), 5);
    try assert_eq_i64(dbx_col_i64(&st, 4), 2);
    try assert_eq_i64(dbx_col_i64(&st, 5), 100);
    try assert_eq_i64(dbx_col_i64(&st, 6), 200);
    var model: [byte: 32] = [0: 32];
    try assert_eq_i64(dbx_col_text(&st, 7, &model[0], 32) as i64, 6);
    try assert_eq_i32(model[0] as i32, 'g' as i32);
    var prov: [byte: 32] = [0: 32];
    try assert_eq_i64(dbx_col_text(&st, 8, &prov[0], 32) as i64, 2);
    try assert_eq_i64(dbx_col_text(&st, 9, &model[0], 32) as i64, 0);
    try assert_eq_i64(dbx_col_i64(&st, 10), 3);
}

fn test_bad_lines_and_partial_tail() !void {
    prep();
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_db(&d);
    var p: [byte: 512] = [0: 512];
    const pn: usize = journal_path(&"/tmp/aigw_journal_test"[0: 22], T0 - 86400, &p[0], 512);
    const path: &[byte] = p[0: pn];

    var line: [byte: 1024] = [0: 1024];
    const ln: usize = journal_format(&"ok1"[0: 3], 1, &"m"[0: 1], EMPTY, T0, 1, 2, 3, 4, 5, EMPTY, 9, &line[0], 1024);
    try journal_append_bytes(path, line[0: ln]);
    // 版本不认识
    var bad1: [byte: 32] = [0: 32];
    const b1: &[byte] = &"2\tr\t1\t0\t0\t0\t0\t0\t0\t0\t0\tm\t\t\n"[0: 26];
    var i: usize = 0;
    while i < b1.len {
        bad1[i] = b1[i];
        i = i + 1;
    }
    try journal_append_bytes(path, bad1[0: b1.len]);
    // 字段数不对
    try journal_append_bytes(path, &"hello\n"[0: 6]);
    // 末尾半行（没有 LF）：不应用
    try journal_append_bytes(path, &"1\treq-tail\t1\t0\t0\t0\t0\t0\t0\t0\t0\tm\t\t"[0: 32]);

    var s: JournalStats = JournalStats{ lines: 0, applied: 0, duplicate: 0, bad: 0 };
    try journal_replay(&d, path, &s);
    try assert_eq_i64(s.lines as i64, 3);
    try assert_eq_i64(s.applied as i64, 1);
    try assert_eq_i64(s.bad as i64, 3);
    try assert_eq_i64(scalar(&d, "select count(*) from usage_ledger" as &const byte), 1);
}

fn test_replay_days_and_prune() !void {
    prep();
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    try open_db(&d);
    var p: [byte: 512] = [0: 512];
    var pn: usize = journal_path(&"/tmp/aigw_journal_test"[0: 22], T0, &p[0], 512);
    try append_one(p[0: pn], &"today"[0: 5], 1, 1, 2);
    pn = journal_path(&"/tmp/aigw_journal_test"[0: 22], T0 - 86400, &p[0], 512);
    try append_one(p[0: pn], &"yesterday"[0: 9], 1, 3, 4);
    var s: JournalStats = JournalStats{ lines: 0, applied: 0, duplicate: 0, bad: 0 };
    try journal_replay_days(&d, &"/tmp/aigw_journal_test"[0: 22], T0, 2, &s);
    try assert_eq_i64(s.applied as i64, 2);
    try assert_eq_i64(scalar(&d, "select count(*) from usage_ledger" as &const byte), 2);

    // 保留：T0 时刻 keep=8，应删掉 T0-8 和 T0-9，保留昨天的
    var q: [byte: 512] = [0: 512];
    var qn: usize = journal_path(&"/tmp/aigw_journal_test"[0: 22], T0 - 8 * 86400, &q[0], 512);
    try journal_append_bytes(q[0: qn], &"x\n"[0: 2]);
    qn = journal_path(&"/tmp/aigw_journal_test"[0: 22], T0 - 9 * 86400, &q[0], 512);
    try journal_append_bytes(q[0: qn], &"x\n"[0: 2]);
    const removed: i32 = journal_prune(&"/tmp/aigw_journal_test"[0: 22], T0, 8);
    try assert_eq_i32(removed, 2);
    // 昨天的文件还在
    const keep_r: !i32 = sys_open(&p[0] as *const byte, 0 as i32, 0);
    const keep_fd: i32 = keep_r catch {
        0 - 1;
    };
    try assert_eq_bool(keep_fd >= 0, true);
    if keep_fd >= 0 {
        _ = sys_close(keep_fd) catch {};
    }
}

test "path_and_format" { run_test("path_and_format", test_path_and_format); }
test "append_replay_idempotent" { run_test("append_replay_idempotent", test_append_replay_idempotent); }
test "bad_lines_and_partial_tail" { run_test("bad_lines_and_partial_tail", test_bad_lines_and_partial_tail); }
test "replay_days_and_prune" { run_test("replay_days_and_prune", test_replay_days_and_prune); }

// tests/seed_main.uya — e2e 夹具：建用户/Key/供应商/模型/价目，或查 usage_ledger 行数
//
// 用环境变量传参，避免 argv 依赖：
//   AIGW_MODE=seed|count  AIGW_DB=<path>  AIGW_UPSTREAM_PORT=<port>（seed 需要）
use libc.stdlib;

extern "libc" fn printf(fmt: *byte, ...) i32;

fn zlen(p: &byte) usize {
    var n: usize = 0;
    while p[n] != (0 as byte) {
        n = n + 1;
    }
    return n;
}

fn parse_u16(s: &[byte]) u16 {
    var v: u16 = 0;
    var i: usize = 0;
    while i < s.len {
        const c: byte = s[i];
        if c >= ('0' as byte) && c <= ('9' as byte) {
            v = v *% (10 as u16) +% ((c as u16) -% (48 as u16));
        }
        i = i + 1;
    }
    return v;
}

export fn main() i32 {
    const m: &byte = getenv("AIGW_MODE" as &const byte);
    const dbp: &byte = getenv("AIGW_DB" as &const byte);
    if (m as usize) == 0 || (dbp as usize) == 0 {
        return 1;
    }
    const mn: usize = zlen(m);
    const dn: usize = zlen(dbp);
    var d: Db = Db{ h: null };
    defer { dbx_close(&d); }
    schema_open(&d, dbp[0: dn]) catch {
        return 2;
    };
    if mn == 5 && m[0] == ('c' as byte) { // count
        var n: i64 = 0;
        if dbx_scalar_i64(&d, &"select count(*) from usage_ledger"[0: 33], &n) != 0 {
            return 3;
        }
        printf("COUNT=%d\n" as *byte, n as i32);
        return 0;
    }
    const ps: &byte = getenv("AIGW_UPSTREAM_PORT" as &const byte);
    if (ps as usize) == 0 {
        return 1;
    }
    const port: u16 = parse_u16(ps[0: zlen(ps)]);
    const now: i64 = store_now();
    var u: StoreUser = StoreUser{ id: 0, status: 0, found: false };
    store_create_user(&d, &"e2e@example.com"[0: 15], &"u0000000001"[0: 11], now, &u) catch {
        return 4;
    };
    var tok: [byte: 64] = [0: 64];
    const tn: usize = store_create_key(&d, u.id, &"e2e"[0: 3], now, &tok[0], 64) catch {
        return 5;
    };
    tok[tn] = 0 as byte;
    var p: StoreProvider = StoreProvider{};
    store_provider_create(&d, &"mock"[0: 4], &"localhost"[0: 9], port as i32, now, &p) catch {
        return 6;
    };
    store_provider_model_put(&d, p.id, &"mock-model"[0: 10], &"upstream-model"[0: 14], now) catch {
        return 7;
    };
    var sell: PriceCard = PriceCard{ id: 0, kind: 0, version: 0, effective_from: 0, found: false };
    price_card_create(&d, PRICE_KIND_SELL, 1, 0, now, &"v1"[0: 2], &sell) catch {
        return 8;
    };
    price_entry_put(&d, sell.id, &""[0: 0], &"mock-model"[0: 10], 0, 1000, 2000, 500, 100, &""[0: 0]) catch {
        return 9;
    };
    var cost: PriceCard = PriceCard{ id: 0, kind: 0, version: 0, effective_from: 0, found: false };
    price_card_create(&d, PRICE_KIND_COST, 1, 0, now, &"v1"[0: 2], &cost) catch {
        return 10;
    };
    price_entry_put(&d, cost.id, &"mock"[0: 4], &"mock-model"[0: 10], 0, 600, 1200, 300, 50, &""[0: 0]) catch {
        return 11;
    };
    printf("TOKEN=%s\n" as *byte, &tok[0]);
    printf("USER=%d\n" as *byte, u.id as i32);
    return 0;
}
